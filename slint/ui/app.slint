                // page; the map and the footer run on down through it.
                bleed-bottom: max(root.safe-area-insets.bottom, root.kb-overlap);
                pinch-begin => { root.map-pinch-begin(); }
                pinched(f, x, y) => { root.map-pinched(f, x, y); }
                pinch-end => { root.map-pinch-end(); }
                who: root.mp-who; own: root.mp-own; live: root.mp-live; ended: root.mp-ended;
                stoppable: root.mp-stoppable; openable: true; status-text: root.mp-status;
                remaining-label: root.mp-remaining; lat: root.mp-lat; lon: root.mp-lon;
                description: root.mp-desc; self-marker: root.mp-self;
                sender-initials: root.mp-initials; sender-tint: root.mp-tint;
                map-image: root.mp-map;
                sender-avatar: root.mp-avatar;
                tiles: root.mp-tiles;
                pin-x: root.mp-pin-x;
                pin-y: root.mp-pin-y;
                viewport(w, h) => { root.map-viewport(w, h); }
                panned(dx, dy) => { root.map-panned(dx, dy); }
                zoom-at(s, x, y) => { root.map-zoom-at(s, x, y); }
                closed => { root.go-back(); }
                stop-live => { root.act("stop-live", "", ""); }
                open-osm(u) => { root.act("open-link", u, ""); }
                zoom-requested(d) => { root.act("map-zoom", d > 0 ? "in" : "out", ""); }
            } }
        // Staging sits over the conversation it will send into, and it wants
        // the whole window: the page draws its own header and its own caption
        // row, safe areas included by the window's own insets.
        staging-holder := PageHolder { active: root.in-session && root.nav == "staging"; ground: root.page-ground;
            slides: Theme.mode == "desktop";
            staging-page := StagingPage {
                bottom-inset: root.bottom-inset;
                width: 100%; height: 100%;
                to-name: root.room-name;
                items: root.sg-items;
                cur <=> root.sg-cur;
                caption <=> root.sg-caption;
                emoji-rows: root.emoji-rows;
                emoji-cat-rows: root.emoji-cat-rows;
                closed => { root.go-back(); }
                removed(i) => { root.act("staging-remove", "" + i, ""); }
                add-more => { root.act("staging-add", "", ""); }
                send(c) => { root.act("staging-send", c, ""); }
                load-emoji => { root.act("emoji-search", "", ""); }
            } }
        doc-holder := PageHolder { active: root.in-session && root.nav == "doc"; ground: root.page-ground;
            DocPage {
                width: 100%; height: 100%;
                file-name: root.dc-name; status: root.dc-status; error: root.dc-error;
                size-label: root.dc-size; kind: root.dc-kind; subtitle: root.dc-subtitle;
                blocks: root.dc-blocks; pdf-pages: root.dc-pdf; pages: root.dc-pages;
                page-aspect: root.dc-aspect; sheets: root.dc-sheets; sheet-rows: root.dc-rows;
                sheet-cols: root.dc-cols; toast: root.dc-toast;
                closed => { root.go-back(); }
                download-requested => { root.act("doc-download", "", ""); }
                page-requested(i, w) => { root.act("doc-page", "" + i, "" + (w / 1px)); }
                sheet-picked(i) => { root.act("doc-sheet", "" + i, ""); }
            } }
        audio-holder := PageHolder { active: root.in-session && root.nav == "audio"; ground: root.page-ground;
            AudioPage {
                width: 100%; height: 100%;
                title: root.au-title; size-label: root.au-size; status: root.au-status;
                art: root.au-art; have-art: root.au-have-art; tone: root.au-tone;
                duration: root.au-duration; playing: root.au-playing; position: root.au-position;
                toast: root.au-toast;
                closed => { root.go-back(); }
                toggle-requested => { root.act("audio-toggle", "", ""); }
                seek-requested(s) => { root.act("audio-seek", "" + s, ""); }
                download-requested => { root.act("audio-download", "", ""); }
            } }

        members-holder := PageHolder { active: root.in-session && root.nav == "members"; ground: root.page-ground;
            MembersPage {
                width: 100%; height: 100%;
                members: root.me-members; filter-level: root.me-filter; all-count: root.me-all;
                closed => { root.go-back(); }
                invite => { root.add-return = "members"; root.go("addpeople"); }
                member-clicked(uid, name) => { root.act("member-choice-open", uid, name); }
            } }
        addpeople-holder := PageHolder { active: root.in-session && root.nav == "addpeople"; ground: root.page-ground;
            addpeople-page := AddPeoplePage {
                width: 100%; height: 100%;
                results: root.ap-results;
                note <=> root.ap-note;
                closed => { root.go-back(); }
                search(q) => { root.act("dir-search", q, ""); }
                invite-user(uid) => { root.act("invite-user", uid, ""); }
            } }
        notifications-holder := PageHolder { active: root.in-session && root.nav == "notifications"; ground: root.page-ground;
            NotificationsPage {
                width: 100%; height: 100%;
                mode: root.no-mode; encrypted: root.rs-model.encrypted;
                busy: root.no-busy; error: root.no-error;
                closed => { root.go-back(); }
                set-mode(m) => { root.act("notif-mode", m, ""); }
            } }
        admins-holder := PageHolder { active: root.in-session && root.nav == "admins"; ground: root.page-ground;
            AdminsPage {
                width: 100%; height: 100%;
                members: root.ad-members; can-change: root.ad-can; admin-count: root.ad-admins;
                my-user-id: root.my-user-id; busy: root.ad-busy;
                note <=> root.ad-note;
                closed => { root.go-back(); }
                set-admin(uid, on) => { root.act("set-admin", uid, on ? "true" : "false"); }
            } }
        privacy-holder := PageHolder { active: root.in-session && root.nav == "privacy"; ground: root.page-ground;
            PrivacyPage {
                width: 100%; height: 100%;
                is-dm: root.rs-model.is-dm; member-count: root.rs-model.member-count;
                server: root.pv-server; epochs: root.pv-epochs;
                closed => { root.go-back(); }
            } }
        settings-holder := PageHolder { active: root.in-session && root.nav == "settings"; ground: root.page-ground;
            SettingsPage {
                width: 100%; height: 100%;
                my-name: root.my-name; my-user-id: root.my-user-id; my-initials: root.my-initials;
                my-avatar: root.my-avatar; my-tint: root.my-tint; server: root.door-server;
                recovery-state: root.recovery-state; backup-state: root.backup-state;
                recovery-escrow: root.recovery-escrow;
                clocked-seconds: root.shape-clocked; socks-proxy: root.shape-proxy;
                link-previews: root.shape-previews;
                notify-enabled: root.notify-enabled; notify-dms: root.notify-dms;
                notify-mentions: root.notify-mentions; notify-calls: root.notify-calls;
                scan-state: root.scan-state; scan-sas: root.scan-sas; scan-error: root.scan-error;
                busy: root.settings-busy; version: root.app-version;
                closed => { root.go-back(); }
                open-recovery-code => { root.recovery-copy(); root.recovery-open = true; }
                open-password => { root.password-open = true; }
                set-clocked(n) => { root.set-clocked(n); }
                set-proxy(p) => { root.set-proxy(p); }
                set-previews(on) => { root.set-previews(on); }
                set-notify(k, on) => { root.set-notify(k, on); }
                link-scan(offer) => { root.link-scan(offer); }
                link-confirm(ok) => { root.link-confirm(ok); }
                sign-out => { root.sign-out(); }
            } }
        start-holder := PageHolder { active: root.in-session && root.nav == "start"; ground: root.page-ground;
            start-page := StartPage {
                width: 100%; height: 100%;
                people: root.st-people; busy: root.st-busy; error: root.st-error;
                closed => { root.go-back(); }
                search-edited(q) => { root.act("dir-search-start", q, ""); }
                start-dm(uid) => { root.act("start-dm", uid, ""); }
                submit-extra(mode, value) => { root.act("start-submit", mode, value); }
            } }
        forward-holder := PageHolder { active: root.in-session && root.nav == "forward"; ground: root.page-ground;
            forward-page := ForwardPage {
                width: 100%; height: 100%;
                mode: root.fw-mode; chats: root.fw-chats;
                closed => { root.go-back(); }
                search-edited(q) => { root.act("forward-search", q, ""); }
                picked(id) => { root.act("forward-picked", id, ""); }
            } }
        // The call page over everything while it is open; the pill while
        // the call runs behind the conversation. Panel.qml:1161-1218: an
        // always-present holder on its own opaque ground that slides in
        // from the right and parks off screen while inactive. Minimising
        // (Panel.qml:113-125, 152-160) scales it about the PiP's centre
        // down to the tile — 230ms InOutCubic, opacity out 210ms InCubic —
        // then parks it without sliding; expanding (Panel.qml:127-150)
        // snaps it back onto the tile and grows it, OutCubic on the way in.
        call-holder := Rectangle {
            property <bool> active: root.in-call && root.call-page-open;
            property <bool> shrinking: false;
            property <bool> instant: false;   // Behaviors off while snapping to the tile
            property <bool> min-out: false;   // minimise in flight: held at 0 while it scales away
            property <bool> grow-in: false;   // expand in flight: parked at 0 before the grow
            property <bool> snap: false;      // x moves without sliding
            property <bool> settled: false;
            property <length> shrink-ox: 0px;
            property <length> shrink-oy: 0px;
            property <float> shrink-scale: 0.2;
            property <length> probe;          // a read that starts an animation at the gated duration
            property <float> probe-f;
            width: 100%; height: 100%;
            // Panel.qml:1166-1204: 0 while active, `width` otherwise, on
            // PageHolder's slide (d×0.26 per frame ≈ 200ms, hard early decel).
            x: (self.active || self.min-out || self.grow-in) ? 0px : root.width;
            animate x { duration: (self.settled && !self.snap) ? 200ms : 0ms; easing: cubic-bezier(0.25, 1, 0.35, 1); }
            // Panel.qml:1197: a resize while inactive parks it at once.
            changed width => {
                if (!self.active) { self.settled = false; self.probe = self.x; }
                self.settled = true;
            }
            visible: self.x < root.width - 0.5px;
            // Panel.qml:1176-1190: scale about the PiP's centre; opacity
            // fades late on the way out, early on the way back in.
            transform-scale: self.shrinking ? self.shrink-scale : 1;
            transform-origin: { x: self.shrink-ox, y: self.shrink-oy };
            animate transform-scale { duration: self.instant ? 0ms : 230ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
            opacity: self.shrinking ? 0 : 1;
            animate opacity { duration: self.instant ? 0ms : 210ms; easing: self.shrinking ? cubic-bezier(0.32, 0, 0.67, 0) : cubic-bezier(0.33, 1, 0.68, 1); }
            // Panel.qml:152-160: shrunk into the tile, so park rather than slide out.
            shrink-done := Timer {
                interval: 230ms;
                running: false;
                triggered => {
                    self.running = false;
                    call-holder.snap = true;
                    call-holder.min-out = false;
                    call-holder.probe = call-holder.x;
                    call-holder.snap = false;
                    call-holder.instant = true;
                    call-holder.shrinking = false;
                    call-holder.probe-f = call-holder.transform-scale;
                    call-holder.probe-f = call-holder.opacity;
                    call-holder.instant = false;
                }
            }
            // Panel.qml:150: one frame after the snap, the grow runs.
            grow-start := Timer {
                interval: 16ms;
                running: false;
                triggered => {
                    self.running = false;
                    call-holder.instant = false;
                    call-holder.shrinking = false;
                    call-holder.grow-in = false;
                }
            }
            // Panel.qml:1205-1210: the page ground and an input sink behind the page.
            Rectangle {
                width: 100%; height: 100%;
                background: root.page-ground;
                TouchArea { }
            }
            CallPage {
                width: 100%; height: 100%;
                shown: call-holder.active;
                // Panel.qml:1216: the room's chat theme colour when it has one.
                accent: root.ct-accent != "" ? root.ct-color : Theme.accent;
                state: root.call-state;
                status-text: root.call-status;
                error: root.call-error;
                encrypted: root.call-encrypted;
                mic-muted: root.call-mic-muted;
                camera-on: root.call-camera-on;
                screen-sharing: root.call-screen-sharing;
                tiles: root.call-tiles;
                spotlight-idx: root.call-spotlight-idx;
                featured: root.call-featured;
                has-featured: root.call-has-featured;
                local-cam: root.call-local-cam;
                has-local-cam: root.call-has-local-cam;
                group-mode: root.call-group-mode;
                video-mode: root.call-video-mode;
                peer-name: root.call-peer-name;
                peer-avatar: root.call-peer-avatar;
                peer-initials: root.call-peer-initials;
                peer-tint: root.call-peer-tint;
                peer-speaking: root.call-peer-speaking;
                mics: root.call-mics;
                speakers: root.call-speakers;
                // CallPage.qml:25: nothing floats while the page is hidden.
                floaters: call-holder.active ? root.call-floaters : [];
                set-mic(on) => { root.act("set-mic", on ? "true" : "false", ""); }
                set-camera(on) => { root.act("set-camera", on ? "true" : "false", ""); }
                set-screenshare(on) => { root.act("set-screenshare", on ? "true" : "false", ""); }
                // CallPage.qml:492 + Panel.qml:1218: hanging up closes the page.
                hang-up => { root.act("hang-up", "", ""); root.call-page-open = false; }
                select-device(kind, id) => { root.act("select-device", kind, id); }
                react(e) => { root.act("call-react", e, ""); }
                // Panel.qml:113-125 minimizeCall(): the origin is resolved
                // here, at the moment the gesture starts.
                minimize => {
                    call-holder.shrink-ox = call-pip.x + call-pip.width / 2;
                    call-holder.shrink-oy = call-pip.y + call-pip.height / 2;
                    call-holder.shrink-scale = call-pip.width / max(1px, call-holder.width);
                    call-holder.shrinking = true;
                    call-holder.min-out = true;
                    shrink-done.running = true;
                    root.act("call-minimize", "", "");
                }
            }
        }
        // Minimised call (Panel.qml:1380-1392): the featured remote's tile in
        // the room's colours; its position is the PiP's own business.
        call-pip := CallPip {
            shown: root.in-call && !root.call-page-open;
            parent-width: root.width;
            parent-height: root.height;
            featured: root.call-pip-featured;
            duration-label: root.call-pip-duration;
            accent: root.ct-accent != "" ? root.ct-color : Theme.accent;
            // Panel.qml:127-150 maximizeCall(): park the holder, then resolve
            // the origin, snap onto the tile with the Behaviors off, and grow.
            expand-requested => {
                call-holder.instant = true;
                call-holder.snap = true;
                call-holder.grow-in = true;
                call-holder.probe = call-holder.x;
                call-holder.shrink-ox = call-pip.x + call-pip.width / 2;
                call-holder.shrink-oy = call-pip.y + call-pip.height / 2;
                call-holder.shrink-scale = call-pip.width / max(1px, call-holder.width);
                call-holder.shrinking = true;
                call-holder.probe-f = call-holder.transform-scale;
                call-holder.probe-f = call-holder.opacity;
                root.act("call-expand", "", "");
                call-holder.snap = false;
                grow-start.running = true;
            }
            // Panel.qml:1391: hang up and drop the minimised state.
            hangup-requested => { root.act("hang-up", "", ""); root.call-page-open = false; }
        }
        // CallBanner.qml:14-17: top-centred, 440 wide (or the panel minus
        // 20), Style.gapsOut (10 in the port) below the top edge.
        if root.call-incoming : CallBanner {
            width: min(root.width - 20px, 440px);
            x: (root.width - self.width) / 2;
            y: 10px;
            caller-name: root.call-incoming-name;
            caller-initials: root.call-incoming-initials;
            caller-avatar: root.call-incoming-avatar;
            caller-tint: root.call-incoming-tint;
            room-name: root.call-room-name;
            video-intent: root.call-incoming-video;
            accept => { root.act("call-accept", "false", ""); }
            accept-video => { root.act("call-accept", "true", ""); }
            decline => { root.act("call-decline", "", ""); }
        }
        // Always mounted so the open fade and the flight from the tapped
        // thumbnail can play (ImageViewer.qml:31-53); `shown` drives it.
        viewer := ImageViewer {
            width: 100%; height: 100%;
            shown: root.viewer-open;
            from-x: root.vw-from-x; from-y: root.vw-from-y;
            from-w: root.vw-from-w; from-h: root.vw-from-h;
            scrim-radius: root.card-frame ? 22px : 0px;
            items: root.vw-items;
            cur <=> root.vw-cur;
            forward-names: root.vw-forward-names;
            toast: root.vw-toast;
            playing-event: root.vw-playing-event;
            video-frame: root.vw-frame;
            play-pos: root.vw-play-pos;
            play-duration: root.vw-play-duration;
            closed => { root.viewer-open = false; root.act("viewer-closed", "", ""); }
            page-changed(i) => { root.act("viewer-page", "" + i, ""); }
            download-requested => { root.act("viewer-download", "", ""); }
            delete-requested => { root.act("viewer-delete", "", ""); }
            share-requested => { root.act("viewer-share", "", ""); }
            forward-to(i) => { root.act("viewer-forward", "" + i, ""); }
            react(e) => { root.act("viewer-react", e, ""); }
            toggle-playback => { root.act("viewer-playback", "", ""); }
            seek-requested(sec) => { root.act("viewer-seek", "" + sec, ""); }
            scrub-state(on, pos) => { root.act("viewer-scrub", on ? "true" : "false", "" + pos); }
        }
        }
    }
    }

    contact-sheet := ChoiceSheet {
        width: 100%; height: 100%;
        title: "Contact";
        open <=> root.contact-open;
        model: [{ t: "Message", v: "dm", sub: "" }, { t: "Save to contacts", v: "save", sub: "" }];
        chose(v) => { root.contact-open = false; root.act("contact-choice", v, ""); }
    }
    member-sheet := ChoiceSheet {
        width: 100%; height: 100%;
        title: root.member-name;
        open <=> root.member-open;
        model: [{ t: "Message", v: "dm", sub: "" }, { t: "Share their contact here", v: "share", sub: "As a card in this conversation" }];
        chose(v) => { root.member-open = false; root.act("member-choice", v, ""); }
    }
}
