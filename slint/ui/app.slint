            hold: root.nav == "threads" && !root.chat-is-thread ? 0ms : 320ms;
            chat := ChatPage {
                width: 100%; height: 100%;
                opened: chat-holder.active;
                // The page is arriving over the thread browser, not over home:
                // the bar it morphs out of is the browser's, and the ground it
                // rises over is the room's, not home's card. The browser's
                // holder is still drawn for its whole 460ms hold, which outlasts
                // this page's 440ms arrival.
                over-threads: threads-holder.visible;
                my-initials: root.my-initials;
                my-tint: root.my-tint;
                room-name: root.room-name;
                room-subtitle: root.room-subtitle;
                boot-epoch-s: root.boot-epoch-s;
                room-encrypted: root.room-encrypted;
                room-initials: root.room-initials;
                room-avatar: root.room-avatar;
                room-tint: root.room-tint;
                themed: root.ct-accent != "";
                accent: root.ct-accent != "" ? root.ct-color : Theme.accent;
                // The two inline composer panels live inside the page now
