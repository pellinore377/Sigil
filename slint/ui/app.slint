                voice-staged-duration: root.voice-staged-duration;
                voice-staged-wave: root.voice-staged-wave;
                clip-frac: root.chat-clip-frac;
                clip-playing <=> root.chat-clip-playing;
                fx-count: root.chat-fx-count;
                ac-items: root.chat-ac-items;
                ac-index <=> root.chat-ac-index;
                toast <=> root.chat-toast;
                items: root.items;
                sheet-backdrop: root.sheet-backdrop;
