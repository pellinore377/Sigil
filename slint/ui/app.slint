                // bridge, drive and shots read and set.
                attach-open <=> root.attach-open;
                recorder-open <=> root.recorder-open;
                visible-to-user: root.in-session && (root.nav == "chat" || root.nav == "thread");
                rec-state: root.rec-state;
                rec-elapsed: root.rec-elapsed;
                rec-clip-duration: root.rec-clip-duration;
                rec-levels: root.rec-levels;
                rec-clip-waveform: root.rec-clip-waveform;
                stickers: root.at-stickers;
                stickers-loaded: root.at-stickers-loaded;
                sticker-dir: root.at-sticker-dir;
                at-page <=> root.at-page;
                lp-map: root.lp-map;
                lp-unavailable: root.lp-unavailable;
                lp-have-fix: root.lp-have-fix;
                lp-lat: root.lp-lat;
                lp-lon: root.lp-lon;
                lp-error: root.lp-error;
                lp-marked: root.lp-marked;
                lp-mark-lat: root.lp-mark-lat;
                lp-mark-lon: root.lp-mark-lon;
                my-avatar: root.my-avatar;
