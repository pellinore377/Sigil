                load-stickers => { root.act("load-stickers", "", ""); }
                load-emoji => { root.act("emoji-search", "", ""); }
                rec-record => { root.act("voice-record", "", ""); }
                rec-stop => { root.act("voice-stop", "", ""); }
                rec-restart => { root.act("voice-restart", "", ""); }
                rec-attach => { root.act("voice-attach", "", ""); }
                rec-cancel => { root.act("voice-cancel", "", ""); }
                clip-seek(frac) => { root.act("voice-preview-seek", "" + frac, ""); }
                ac-picked(i) => { root.act("autocomplete-pick", "" + i, ""); }
                accept-invite => { root.act("accept-invite", "", ""); }
                decline-invite => { root.act("decline-invite", "", ""); }
                paginate => { root.act("paginate", "", ""); }
                menu-action(action, ev) => { root.act("menu-action", action, ev); }
                react(ev, key) => { root.act("react", ev, key); }
                open-image(item) => { root.act("viewer-open", item.event-id, ""); }
                play-video(item) => { root.act("viewer-open", item.event-id, "video"); }
                open-document(item) => { root.act("open-doc", item.event-id, ""); root.go("doc"); }
                open-contact(item) => { root.act("open-contact", item.event-id, ""); }
                contact-save(u, n, saved) => { root.act(saved ? "contact-unsave" : "contact-save", u, n); }
                contact-share(u, n) => { root.act("contact-share", u, n); }
                copy-text(t) => { root.act("copy-text", t, ""); }
                spoiler-revealed(id) => { root.act("spoiler-revealed", id, ""); }
                open-audio(item) => { root.act("open-audio-page", item.event-id, ""); root.go("audio"); }
                open-location(item) => { root.act("open-map", item.event-id, ""); root.go("map"); }
                // Every way into a thread goes through the browser: it is the
                // thread's parent page (go-back walks thread → threads → chat),
                // it is what the rising thread has to rise OVER, and stepping
                // through it is what closes the conversation page so its own
                // three beats play again for the thread. The engine answers
                // `open-thread` by switching the timeline and setting nav.
                open-thread(rootId) => { root.go("threads"); root.act("open-thread", rootId, ""); }
