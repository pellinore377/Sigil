                bleed-top: root.safe-area-insets.top + status-strip.height;
                // The page now reaches the window's own bottom edge, so there
                // is no strip below it for the frost to cover.
                bleed-bottom: 0px;
                typing-line: root.typing-line;
                typing-avatar: root.typing-avatar;
                typing-initials: root.typing-initials;
                typing-tint: root.typing-tint;
                is-dm: root.chat-is-dm;
                is-invite: root.chat-is-invite;
                is-thread: root.chat-is-thread;
                pagination-state: root.pagination-state;
                in-call: root.in-call;
                call-here: root.call-here;
                sheet-actions: root.sheet-actions;
                emoji-rows: root.emoji-rows;
                emoji-cat-rows: root.emoji-cat-rows;
                quick-emoji: root.quick-emoji;
                // The gesture bar (or the keyboard) is the page's own to keep
                // clear: the composer stands that far up from the bottom.
                bottom-inset: root.bottom-inset;
                back => { root.go-back(); }
                send(text) => { root.send-message(text); }
                send-reply(ev, text) => { root.act("send-reply", ev, text); }
                send-edit(ev, text) => { root.act("send-edit", ev, text); }
                send-caption(ev, text) => { root.act("send-caption", ev, text); }
                open-link(url) => { root.act("open-link", url, ""); }
                send-voice(caption) => { root.act("voice-send", caption, ""); }
                voice-discard => { root.act("voice-discard", "", ""); }
                voice-preview(play) => { root.act("voice-preview", play ? "1" : "0", ""); }
                composer-edited(text) => { root.composer-edited(text); }
                cp-cells: root.cp-cells; cp-styled: root.cp-styled;
                cp-caret-x: root.cp-caret-x; cp-caret-y: root.cp-caret-y; cp-epoch: root.cp-epoch;
                cp-caret-fx: root.cp-caret-fx; cp-caret-fy: root.cp-caret-fy;
                composer-cursor-moved(b) => { root.composer-cursor-moved(b); }
                start-call(video) => { root.act("start-call", video ? "true" : "false", ""); }
                join-call => { root.act("join-call", "", ""); }
                nav-requested(page) => { root.go(page); }
