// Recovery, Sigil style. Two pages in the RecoveryPage.qml column layout:
// the printed recovery code, shown once after an account is created with a
// password and again from Settings; and the backup password, set or
// changed. There is no key to type in — restoring happens at the doors.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, SButton, TextWell } from "components.slint";

// The urgent line at the foot of a group (RecoveryPage.qml:62-67).
component ErrorText inherits Text {
    color: Theme.urgent;
    font-family: Theme.font-ui;
    font-size: Theme.body-small;
    horizontal-alignment: center;
    wrap: word-wrap;
}

export component RecoveryCodePage inherits Rectangle {
    in property <string> code;
    in property <bool> first-time;
    callback copy;
    callback done;

    background: Theme.menu-background;

    VerticalLayout {
        alignment: center;
        // RecoveryPage.qml:17-18: a centred column min(parent.width - 80, 480) wide
        x: (root.width - self.width) / 2;
        width: min(root.width - 80px, 480px);
        spacing: Theme.sp-xl;

        IconLabel {
            text: Icons.recoveryKey;
            filled: false;
            font-size: 40px;
            color: Theme.menu-text;
            horizontal-alignment: center;
        }
        Text {
            text: "Your recovery code";
            color: Theme.menu-text;
            font-family: Theme.font-ui;
            font-size: Theme.heading;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.first-time
                ? "Write this down and keep it somewhere safe. With your password and this code, a new device gets everything back. Sigil cannot show it to you if you lose it."
                : "Your password and this code restore everything on a new device. Keep it somewhere safe; it is the same code as before.";
            color: Theme.menu-text.with-alpha(0.7);
            font-family: Theme.font-ui;
            font-size: Theme.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        code-well := Rectangle {
            height: code-text.preferred-height + 24px;
            border-radius: 10px;
            background: Theme.menu-text.with-alpha(0.06);
            border-width: 1px;
            border-color: Theme.menu-text.with-alpha(0.12);
            code-text := Text {
                x: 12px; y: 12px;
                width: parent.width - 24px;
                text: root.code;
                color: Theme.menu-text;
                font-family: Theme.font-mono;
                font-size: Theme.title;
                horizontal-alignment: center;
                wrap: char-wrap;
            }
        }
        // RecoveryPage.qml:56-61: the primary bordered, the secondary plain
        HorizontalLayout {
            alignment: center;
            spacing: Theme.sp-lg;
            SButton { text: "Copy"; icon: Icons.copy; clicked => { root.copy(); } }
            SButton { text: root.first-time ? "I wrote it down" : "Done"; bordered: false; clicked => { root.done(); } }
        }
    }
}

export component BackupPasswordPage inherits Rectangle {
    /// disabled | pending | enabled, from recovery.status
    in property <string> backup-state;
    in property <bool> has-password;
    in property <bool> busy;
    in property <string> error;
    callback set-password(string);
    callback closed;

    background: Theme.menu-background;
    in-out property <bool> reveal: false;

    VerticalLayout {
        alignment: center;
        // RecoveryPage.qml:17-18: a centred column min(parent.width - 80, 480) wide
        x: (root.width - self.width) / 2;
        width: min(root.width - 80px, 480px);
        spacing: Theme.sp-xl;

        IconLabel {
            text: Icons.lock;
            filled: false;
            font-size: 40px;
            color: Theme.menu-text;
            horizontal-alignment: center;
        }
        Text {
            text: root.has-password ? "Change your password" : "Set a backup password";
            color: Theme.menu-text;
            font-family: Theme.font-ui;
            font-size: Theme.heading;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.has-password
                ? (root.backup-state == "enabled" ? "Your backup is up to date. A new password takes effect for the next backup; the recovery code stays the same."
                   : root.backup-state == "pending" ? "A backup is waiting to upload. A new password takes effect for it; the recovery code stays the same."
                   : "A new password takes effect for the next backup; the recovery code stays the same.")
                : "The password locks an encrypted copy of everything on this device, kept on your server, which cannot open it. You will be shown a recovery code to write down.";
            color: Theme.menu-text.with-alpha(0.7);
            font-family: Theme.font-ui;
            font-size: Theme.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        VerticalLayout {
            spacing: Theme.sp-md;
            // RecoveryPage.qml:75 focusInput(): the first field takes focus on entry
            init => { pw1.focus-input(); }
            Text { text: "Password"; color: Theme.menu-text.with-alpha(0.6); font-family: Theme.font-ui; font-size: Theme.caption; }
            // the eye inside each field (RecoveryPage.qml:47-54) instead of a link
            pw1 := TextWell {
                placeholder: "a good password";
                password: !root.reveal;
                reveal-toggle: true;
                reveal <=> root.reveal;
                enabled: !root.busy;
                // Enter walks on to the second field
                accepted => { pw2.focus-input(); }
            }
            Text { text: "Again"; color: Theme.menu-text.with-alpha(0.6); font-family: Theme.font-ui; font-size: Theme.caption; }
            pw2 := TextWell {
                placeholder: "the same password";
                password: !root.reveal;
                reveal-toggle: true;
                reveal <=> root.reveal;
                enabled: !root.busy;
                // the terminal field submits (RecoveryPage.qml:45)
                accepted => { if (save-btn.enabled) { save-btn.clicked(); } }
            }
        }
        // RecoveryPage.qml:56-67: the button row at the column's xl step, the
        // errors md under it (LoginPage.qml:100-105)
        VerticalLayout {
            spacing: Theme.sp-md;
            HorizontalLayout {
                alignment: center;
                spacing: Theme.sp-lg;
                save-btn := SButton {
                    text: root.busy ? "Saving…" : (root.has-password ? "Change password" : "Set password");
                    enabled: !root.busy && pw1.text != "" && pw1.text == pw2.text;
                    clicked => { root.set-password(pw1.text); }
                }
                SButton { text: "Back"; bordered: false; enabled: !root.busy; clicked => { root.closed(); } }
            }
            if pw2.text != "" && pw1.text != pw2.text : ErrorText { text: "The two passwords differ."; }
            if root.error != "" : ErrorText { text: root.error; }
        }
    }
}
