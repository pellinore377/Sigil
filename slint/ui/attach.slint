// Attachment sheet under the composer — mobile/AttachMenu.qml. Each category
// opens its own page inside the same panel, the three location pages
// included (LocationPicker.qml in three modes, over the engine's
// location.map crop). The emoji page body is whatever the host puts in
// @children (ChatPage mounts the shared EmojiPicker there).

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";
import { SelfPin } from "pages/map.slint";

export struct StickerItem { path: string, art: image, body: string, url: string, w: int, h: int }

// AttachMenu.qml's poll field: a 10px-radius chip well whose fill LIGHTENS on
// focus (no border), question at body size, options at body-small. Insets are
// 12 left and 10 right for options, 12/12 for the question (:264, :234).
// The phone takes the same well at a finger's size instead: 48 for the
// question and 46 for an option, both at body, with 14px corners to sit with
// the composer's own wells.
component PollField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <length> font-px: Theme.body-small;
    in property <length> pad-right: 10px;
    in property <color> fg;
    in property <color> chip;
    /// Every keystroke, so the page can grow a row under the last option.
    callback edited;
    property <bool> phone: Theme.mode != "desktop";
    height: 32px;
    border-radius: root.phone ? 14px : 10px;
    background: input.has-focus ? root.chip.brighter(0.15) : root.chip;
    HorizontalLayout {
        padding-left: root.phone ? 14px : 12px;
        padding-right: root.phone ? 14px : root.pad-right;
        Rectangle {
            clip: true;
            input := TextInput {
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: root.font-px;
                vertical-alignment: center;
                height: 100%; width: 100%;
                single-line: true;
                edited => { root.edited(); }
            }
            // x: 0 — an unplaced child of a Rectangle is centred in Slint,
            // and a centred placeholder does not sit where the caret will.
            if input.text == "" : Text {
                x: 0px;
                text: root.placeholder;
                color: root.fg.with-alpha(0.55);
                font-family: Theme.font-ui;
                font-size: root.font-px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}

// A poll option row: the field, and the "×" remove disc a filled row shows
// once there are more than two options (AttachMenu.qml:259, :283). With the
// disc the field gives up the disc's width and 6 beside it — the QML Row,
// except that the disc ends flush with the right edge so the fields line up
// under the question's. The phone's disc is 34 in a 46 row.
//
// A row that is not `shown` has no height and no opacity: the slot the page
// grows into. Both animate, and the field keeps its full height, hanging
// from the row's foot inside the clip, so it drops into the opening as the
// row makes room rather than stretching with it.
component PollOptionRow inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> removable;
    in property <bool> shown: true;
    in property <color> fg;
    in property <color> chip;
    callback remove;
    callback edited;
    property <bool> phone: Theme.mode != "desktop";
    property <length> row-h: root.phone ? 46px : 32px;
    property <length> disc: root.phone ? 34px : 28px;
    property <length> gap: root.disc + 6px;
    /// The space to the row under it: the list's column runs at zero spacing
    /// so a closed slot takes no room at all.
    property <length> gap-below: root.phone ? 8px : 6px;
    property <length> lift: root.height - root.gap-below - root.row-h;
    height: root.shown ? root.row-h + root.gap-below : 0px;
    opacity: root.shown ? 1.0 : 0.0;
    clip: true;
    animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    field := PollField {
        x: 0; y: root.lift;
        height: root.row-h;
        width: root.removable ? root.width - root.gap : root.width;
        placeholder: root.placeholder; text <=> root.text;
        font-px: root.phone ? Theme.body : Theme.body-small;
        fg: root.fg; chip: root.chip;
        edited => { root.edited(); }
    }
    if root.removable : Rectangle {
        x: root.width - root.disc;
        y: root.lift + (root.row-h - root.disc) / 2;
        width: root.disc; height: root.disc; border-radius: root.disc / 2;
        background: rm-t.pressed || rm-t.has-hover ? root.chip.brighter(0.2) : root.chip;
        // A literal multiplication sign in the UI face at body size (:283).
        Text { text: "\u{00d7}"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
        rm-t := TouchArea { clicked => { root.remove(); } }
    }
}

// One switch line in the poll page: a label, the state's own sentence under
// it, and the 38 × 22 pill the settings pages wear (furniture.slint's
// SettingsRow), without that page's 22/56/20 columns — the sheet's body is
// already inset 20 from the edge.
component PollToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> sublabel;
    in property <bool> on;
    in property <color> fg;
    callback toggled;
    property <bool> phone: Theme.mode != "desktop";
    height: max(root.phone ? 52px : 40px, txt.preferred-height + 12px);
    Rectangle {
        x: -8px; width: root.width + 16px;
        border-radius: 12px;
        background: t.pressed ? root.fg.with-alpha(0.06) : transparent;
    }
    txt := VerticalLayout {
        x: 0px;
        width: root.width - 38px - 14px;
        height: root.height;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: root.phone ? Theme.body : Theme.body-small;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.sublabel;
            color: root.fg.with-alpha(0.55);
            font-family: Theme.font-ui;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
    }
    Rectangle {
        x: root.width - 38px;
        y: (root.height - 22px) / 2;
        width: 38px; height: 22px;
        border-radius: 11px;
        background: root.on ? Theme.accent.with-alpha(0.8) : root.fg.with-alpha(0.15);
        animate background { duration: 120ms; }
        Rectangle {
            width: 16px; height: 16px; border-radius: 8px;
            y: 3px;
            x: root.on ? 38px - 16px - 3px : 3px;
            background: root.fg;
            animate x { duration: 120ms; }
        }
    }
    t := TouchArea { clicked => { root.toggled(); } }
}

// On the phone a tile is a grid cell (112 tall, width from the row) holding
// the QML pill scaled up: 96 × 64 at radius 32 with a 24dp glyph, the label
// 14sp centred 8 below it. Five of them do not fit a phone's width at that
// size, so the pill keeps the 3:2 shape and takes the cell less an 8 gap
// (67 × 45 on a 400-wide window), growing to the full 96 × 64 where the row
// allows.
component AttachTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <float> icon-scale: 1.0;
    in property <color> fg;
    in property <color> chip;
    in property <bool> phone: false;
    callback clicked;
    width: 62px; height: root.phone ? 116px : 72px;
    // The platform messenger's tile, measured off its own sheet: a 72 × 56
    // stadium (radius = half the height) with the label 8 below.
    property <length> pill-w: root.phone ? 72px : 58px;
    property <length> pill-h: root.phone ? 56px : 40px;
    disc := Rectangle {
        // Top of the tile (QML anchors only horizontalCenter): a sized child
        // outside a layout is otherwise centred by default in Slint.
        x: (root.width - self.width) / 2; y: 0;
        width: root.pill-w; height: root.pill-h;
        border-radius: root.pill-h / 2;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: tile-t.has-hover ? 1.05 : 1.0;
        transform-scale-y: tile-t.has-hover ? 1.05 : 1.0;
        animate transform-scale-x, transform-scale-y { duration: 110ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        // Lightens on hover only (AttachMenu.qml:121); a press changes nothing.
        background: tile-t.has-hover ? root.chip.brighter(0.2) : root.chip;
        IconLabel {
            text: root.icon;
            color: root.fg;
            font-size: root.phone ? 24px : Theme.icon-size * root.icon-scale;
            width: 100%; height: 100%;
        }
    }
    Text {
        y: root.phone ? root.pill-h + 8px : 45px;
        width: root.width;
        text: root.label;
        color: root.phone ? root.fg : root.fg.with-alpha(0.75);
        font-family: Theme.font-ui;
        font-size: root.phone ? 14px : 10px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    tile-t := TouchArea { clicked => { root.clicked(); } }
}

// The attachment sheet's three location pages — LocationPicker.qml, one
// picker in three modes:
//   "current" — your position, avatar marker, share once
//   "live"    — your position plus how long to keep sharing it
//   "pin"     — tap the map to place a point, then share that
// The map is the engine's location.map crop, CENTRED on the pin (or the
// fix), so the marker always stands at the middle of the box; a tap goes up
// as box-local pixels and the bridge turns them into lat/lon and re-crops.
component LocationPages inherits Rectangle {
    in property <string> mode: "pin";          // current | live | pin
    in property <color> fg;
    in property <color> accent;
    in property <color> chip;
    /// The location.map composite at 2× the map box; empty while pending.
    in property <image> map-img;
    /// location.map answered "unavailable": no style on this server.
    in property <bool> map-unavailable;
    in property <bool> have-fix;
    in property <float> fix-lat;
    in property <float> fix-lon;
    in property <string> position-error;
    /// Pin mode: where the last tap landed (bridge-computed).
    in property <bool> marked;
    in property <float> mark-lat;
    in property <float> mark-lon;
    in property <image> my-avatar;
    callback back-requested;
    callback map-tapped(length, length);       // logical px inside the map box
    callback zoom-requested(int);              // +1 / −1; the bridge clamps 3..19
    callback recentre-requested;               // re-crop at the fix
    callback retry-position;                   // position.refresh
    callback share-requested(float, float, float, string); // lat, lon, durationMs, mode

    property <bool> pin-mode: root.mode == "pin";
    property <bool> live-mode: root.mode == "live";
    property <bool> can-share: root.pin-mode ? root.marked : root.have-fix;
    // stands in for QML's mapReady (LocationPicker.qml:32): the style exists
    // until the engine says otherwise.
    property <bool> map-ready: !root.map-unavailable;
    property <int> duration-index: 0;
    property <[string]> duration-labels: ["Share for 15m", "Share for 1h", "Share for 8h"];
    property <[float]> duration-ms: [900000, 3600000, 28800000];
    in-out property <bool> duration-open: false;
    // LocationPicker.qml:20-22 — `menuSurface`, with its alpha forced to 1.
    // AttachMenu.qml:362 hands that the sheet's DEEP chip (ChatPage.qml:56-59:
    // the chip's own tone with its luminance sunk to 0.19), so the duration
    // field and its menu are a well cut into the sheet, darker than the round
    // chips over the map — not a card raised off it. The port keeps that on
    // the dark and desktop palettes, where `fg` is light over a near-black
    // well; the phone's light palette has a dark `fg`, and there the popup
    // ground stands in rather than hiding the label in the well.
    property <color> menu-solid: Theme.mode == "light" ? Theme.popup-background
        : root.chip.with-alpha(1.0);

    background: transparent;

    // LocationPicker.qml:86-103 — the map box: 16 in from the sides and top,
    // 14 above the bottom bar, radius 14, fg@0.10 ground. Its height is a
    // constant per mode (340px, 294px live) that src/actions.rs mirrors when
    // sizing the location.map request — keep them in step.
    map-box := Rectangle {
        x: 16px; y: 16px;
        width: root.width - 32px;
        height: bottom-bar.y - 14px - 16px;
        border-radius: 14px;
        background: root.fg.with-alpha(0.10);
        clip: true;

        if root.map-ready && root.map-img.width > 0 : Image {
            width: 100%; height: 100%;
            source: root.map-img;
            image-fit: cover;
        }

        // The tiles' tap handler (LocationPicker.qml:128-131 mapTapped):
        // pin mode only; chips are declared after so they stay on top.
        map-tap := TouchArea {
            enabled: root.pin-mode && root.map-ready;
            clicked => { root.map-tapped(self.pressed-x, self.pressed-y); }
        }

        // The marker MapView.qml would place (:117-127): the crop is centred
        // on the point, so its tip stands at the middle of the box. Your face
        // in the pin outside pin mode (:122-124); a plain pin once marked
        // (markerAvatar is "" in pin mode — SelfPin without a face is one).
        if root.map-ready && !root.pin-mode && root.have-fix : self-marker := SelfPin {
            x: map-box.width / 2 - 24px;
            y: map-box.height / 2 - 48px;
            pin-color: root.accent;
            avatar: root.my-avatar;
        }
        if root.map-ready && root.pin-mode && root.marked : pin-marker := SelfPin {
            x: map-box.width / 2 - 24px;
            y: map-box.height / 2 - 48px;
            pin-color: root.accent;
        }

        // LocationPicker.qml:135-150 — the no-map column, parent − 40 wide,
        // spacing 8; ours appears when the engine has no style configured.
        if !root.map-ready : VerticalLayout {
            x: 20px;
            width: map-box.width - 40px;
            y: (map-box.height - self.preferred-height) / 2;
            height: self.preferred-height;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                if !root.pin-mode && root.have-fix : SelfPin {
                    pin-color: root.accent;
                    avatar: root.my-avatar;
                }
                // :140-141 — the no-map glyph: filled `place`, 36px, accent@0.8.
                if root.pin-mode || !root.have-fix : IconLabel {
                    text: Icons.location;
                    filled: true;
                    color: root.accent.with-alpha(0.8);
                    font-size: 36px;
                    width: 36px; height: 36px;
                }
            }
            Text {
                text: "Maps are not set up on this server";
                color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // LocationPicker.qml:154-161 — back chip: a 30px disc at 8/8 in the
        // chip fill, the outlined `back` glyph at icon size.
        back-chip := Rectangle {
            x: 8px; y: 8px;
            width: 30px; height: 30px;
            border-radius: 15px;
            background: root.chip;
            IconLabel {
                text: Icons.back;
                color: root.fg;
                font-size: Theme.icon-size;
                width: 100%; height: 100%;
            }
            TouchArea { clicked => { root.back-requested(); } }
        }

        // :163-178 — recentre chip, top right: filled glyph, accent once
        // there is anything to centre on, fg@0.4 otherwise.
        recentre-chip := Rectangle {
            x: map-box.width - 30px - 8px; y: 8px;
            width: 30px; height: 30px;
            border-radius: 15px;
            background: root.chip;
            visible: root.map-ready;
            IconLabel {
                text: Icons.recentre;
                filled: true;
                color: root.have-fix || root.marked ? root.accent : root.fg.with-alpha(0.4);
                font-size: Theme.icon-size;
                width: 100%; height: 100%;
            }
            TouchArea { clicked => { root.recentre-requested(); } }
        }

        // :180-203 — zoom chips, bottom right, pin mode only: 28px squares,
        // radius 8, spacing 4.
        zoom-col := VerticalLayout {
            x: map-box.width - 28px - 8px;
            y: map-box.height - 28px * 2 - 4px - 8px;
            width: 28px;
            spacing: 4px;
            visible: root.pin-mode && root.map-ready;
            Rectangle {
                width: 28px; height: 28px; border-radius: 8px;
                background: root.chip;
                Text { text: "+"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.zoom-requested(1); } }
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: 8px;
                background: root.chip;
                Text { text: "−"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.zoom-requested(-1); } }
            }
        }

        // :205-228 — the hint pill, top centre at 8: 26 tall, text + 20 wide,
        // chip fill, caption. Tapping it retries a missing fix.
        hint-pill := Rectangle {
            x: (map-box.width - self.width) / 2;
            y: 8px;
            width: hint.preferred-width + 20px;
            height: 26px;
            border-radius: 13px;
            background: root.chip;
            visible: root.map-ready && (root.pin-mode || !root.have-fix);
            hint := Text {
                text: root.pin-mode
                    ? (root.marked ? "Click to move the pin" : "Click to drop a pin")
                    : (root.position-error != "" ? "Location unavailable — tap to retry" : "Finding your location…");
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
            TouchArea {
                enabled: !root.pin-mode && !root.have-fix;
                clicked => { root.retry-position(); }
            }
        }
    }

    // LocationPicker.qml:231-287 — the bottom bar: 16 in and 16 up, spacing 8
    // between the duration field and the share pill.
    bottom-bar := VerticalLayout {
        x: 16px;
        width: root.width - 32px;
        y: root.height - 16px - self.preferred-height;
        height: self.preferred-height;
        spacing: 8px;

        // :239-261 — how long to keep sharing, live mode only: a 38px field,
        // radius 11, popup ground; label bodySmall, chevron fg@0.7.
        if root.live-mode : duration-field := Rectangle {
            height: 38px;
            border-radius: 11px;
            background: root.menu-solid;
            Text {
                x: 14px; height: 100%;
                width: parent.width - 14px - 12px - 14px;
                text: root.duration-labels[root.duration-index];
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
                vertical-alignment: center;
                overflow: elide;
            }
            IconLabel {
                x: parent.width - 12px - 14px;
                width: 14px; height: 100%;
                text: root.duration-open ? Icons.chevronUp : Icons.chevronDown;
                color: root.fg.with-alpha(0.7);
                font-size: Theme.icon-size;
            }
            TouchArea { clicked => { root.duration-open = !root.duration-open; } }
        }

        // :263-286 — Share: the accent pill once there is something to share.
        share-btn := Rectangle {
            height: 44px;
            border-radius: 22px;
            background: root.can-share ? root.accent.with-alpha(0.92) : root.chip;
            opacity: root.can-share ? 1 : 0.6;
            Text {
                text: "Share location";
                color: root.can-share ? #141414 : root.fg.with-alpha(0.7);
                font-family: Theme.font-ui;
                font-size: Theme.body;
                font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
            TouchArea {
                enabled: root.can-share;
                clicked => {
                    root.share-requested(
                        root.pin-mode ? root.mark-lat : root.fix-lat,
                        root.pin-mode ? root.mark-lon : root.fix-lon,
                        root.live-mode ? root.duration-ms[root.duration-index] : 0,
                        root.mode);
                }
            }
        }
    }

    // LocationPicker.qml:289-324 — the duration card: the bar's width, its
    // bottom 56 above the bar's bottom, radius 12, popup ground, rows of 34
    // at radius 9 inside a 4px margin; selected accent@0.25, hover fg@0.08.
    if root.duration-open && root.live-mode : dur-card := Rectangle {
        x: 16px;
        width: root.width - 32px;
        height: dur-col.preferred-height + 8px;
        y: root.height - 16px - 56px - self.height;
        border-radius: 12px;
        background: root.menu-solid;
        dur-col := VerticalLayout {
            x: 4px; y: 4px;
            width: dur-card.width - 8px;
            height: self.preferred-height;
            for label[i] in root.duration-labels : dur-row := Rectangle {
                height: 34px;
                border-radius: 9px;
                background: i == root.duration-index ? root.accent.with-alpha(0.25)
                          : dur-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                Text {
                    x: 12px; height: 100%;
                    text: label;
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                }
                dur-t := TouchArea { clicked => { root.duration-index = i; root.duration-open = false; } }
            }
        }
    }
}

export component AttachMenu inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <color> surface: Theme.menu-text.with-alpha(0.07);
    // ChatPage.qml chipC (unthemed): alpha(darker(menu.background, 2.1), 0.96)
    // ≈ rgba(36,36,36,0.96). Slint's darker(f) divides V by 1+f, so 1.1.
    in property <color> chip: Theme.menu-background.darker(1.1).with-alpha(0.96);
    /// The room wears a chat theme: `surface` and `chip` are then its own
    /// tones and the phone's sheet takes them instead of the neutral grounds.
    in property <bool> themed: false;

    // grid | poll | stickers | emoji | note | pin | current | live — a
    // location tile emits open-location and the bridge answers by setting
    // `page` to the mode (AttachMenu.qml:53-55 does both at once; ours
    // resets the picker state on the Rust side first).
    in-out property <string> page: "grid";
    in-out property <string> note: "";
    in property <[StickerItem]> stickers;
    in property <bool> stickers-loaded: false;
    /// Where packs live on this device (stickers.list tells us).
    in property <string> sticker-dir;

    // The location pages' feed (see LocationPages above).
    in property <image> lp-map;
    in property <bool> lp-unavailable;
    in property <bool> lp-have-fix;
    in property <float> lp-lat;
    in property <float> lp-lon;
    in property <string> lp-error;
    in property <bool> lp-marked;
    in property <float> lp-mark-lat;
    in property <float> lp-mark-lon;
    in property <image> my-avatar;

    callback pick-files;
    /// Capture and gallery, which the sheet leads with: the QML had neither,
    /// so these follow the platform messenger's own arrangement.
    callback pick-camera;
    callback pick-gallery;
    callback pick-video;
    callback open-location(string); // "pin" | "current" | "live"
    callback loc-tap(length, length);   // map tap, logical px in the map box
    callback loc-zoom(int);             // +1 / −1
    callback loc-recentre;
    callback loc-retry;                 // position.refresh
    callback share-location(float, float, float, string); // lat, lon, ms, mode
    callback insert-emoji(string);
    callback create-poll(string, [string], bool, bool); // question, options, closed, multiple answers
    callback send-sticker(int);     // index into stickers
    callback load-stickers;
    callback load-emoji;
    callback close-requested;

    property <bool> location-page: root.page == "pin" || root.page == "current" || root.page == "live";
    property <bool> phone: Theme.mode != "desktop";
    // The phone's sheet: the room's own surface when themed, else the card
    // ground; its tiles the room's chip, else a stranger's bubble tone.
    property <color> sheet-c: root.phone && !root.themed ? Theme.card-ground : root.surface;
    property <color> tile-c: root.phone && !root.themed ? Theme.bubble-other : root.chip;
    /// The poll page's wells and pills. A well is inset, so it wants to be
    /// darker than the sheet — which the chip already is over a dark ground,
    /// while over the light palette that same chip is a slab of mid grey
    /// (menu-background darkened 2.1×). There the neutral container stands in.
    property <color> well-c: root.phone && !root.themed && Theme.mode == "light"
        ? Theme.bubble-other : root.chip;
    // Phone grid: 16 top, two 116 rows, 16 below — 264, and not a pixel more.
    // It read 396 for a while, which is where the "ton of top margin" came
    // from: `grid-block` is a layout placed by hand, so with no height of its
    // own it fills the sheet, and the 132 of surplus was shared out between
    // the two tile rows — 37 of it above the first one, under a lead-in that
    // is supposed to be 16. The block below now states its own height as
    // well, so the sheet can never push it around again.
    // The camera chooser is a shutter over its Photo/Video selector: 46 to
    // the body, 72 shutter, 24, the 40 selector, 24 below.
    // The emoji page stands in for a keyboard, so it is the tallest of them:
    // 12 lead-in, a 40 search row, the grid, and the 48 category bar.
    // The poll page at a phone's sizes: 52 to the body, then the body itself
    // — a label, the 48 question, a label, THREE 54 option rows and the two
    // 52 switches, 393 measured — then the 44 footer over its 8 and the 20
    // margin. Three options is what a poll usually has; a fourth flicks.
    height: root.page == "poll" ? (root.phone ? 520px : 408px)
          : root.location-page ? 430px
          : root.page == "emoji" ? 400px
          : root.page == "stickers" ? 330px
          : root.page == "camera" ? 206px
          : root.phone ? 264px
          : 232px;

    public function reset() { root.page = "grid"; root.note = ""; }

    // Chrome: ONE translucent wash inset 10 all round, radius 18, over the
    // conversation ground (AttachMenu.qml:67-73). No opaque card, no border.
    // The phone's is a full-width sheet, 28 at the top corners only, straight
    // under the composer.
    chrome := Rectangle {
        x: root.phone ? 0px : 10px; y: root.phone ? 0px : 10px;
        width: root.phone ? root.width : root.width - 20px;
        height: root.phone ? root.height : root.height - 20px;
        border-top-left-radius: root.phone ? 28px : 18px;
        border-top-right-radius: root.phone ? 28px : 18px;
        border-bottom-left-radius: root.phone ? 0px : 18px;
        border-bottom-right-radius: root.phone ? 0px : 18px;
        background: root.sheet-c;
    }

    // Sub-page header — QML margins: 16 top, 18 sides; hidden on the grid and
    // on the location pages (:75-78). The emoji page has none either: its
    // back button rides in the picker's search row instead, where the
    // platform messenger puts the picker's own chrome.
    if root.page != "grid" && root.page != "emoji" && !root.location-page : header := Rectangle {
        x: 18px; y: 16px;
        width: root.width - 36px; height: 30px;
        back-disc := Rectangle {
            // at the left edge (AttachMenu.qml:80); unplaced, Slint centres it
            x: 0px; y: 0px;
            width: 30px; height: 30px; border-radius: 15px;
            background: hb-t.has-hover ? root.chip.brighter(0.2) : root.chip;
            IconLabel { text: Icons.back; color: root.fg; font-size: Theme.body; width: 100%; height: 100%; }
            hb-t := TouchArea { clicked => { root.reset(); } }
        }
        Text {
            text: root.page == "poll" ? "New poll"
                : root.page == "stickers" ? "Stickers"
                : root.page == "camera" ? "Camera"
                : root.page == "emoji" ? "Emoji" : "";
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.body;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%; height: 100%;
        }
    }

    // Grid: the 5-column block is centred while its rows still fill left to
    // right — row two is left-aligned under the block (QML Grid.centerIn).
    // On the phone the block is 16 in from each side and starts 16 down; a
    // cell is a fifth of it and rows run 116 with no gap between. The block
    // states its own height so the sheet's surplus (if the ladder above ever
    // grows one again) cannot centre the rows in it.
    //
    // Nine tiles, two rows of five minus one: ONE camera tile, which opens
    // the chooser below — Photo or Video is picked inside the capture flow,
    // the way the platform messenger does it, not as two tiles here.
    if root.page == "grid" : grid-box := Rectangle {
        width: 100%; height: 100%;
        property <length> cell: (grid-box.width - 32px) / 5;
        grid-block := VerticalLayout {
            x: root.phone ? 16px : (grid-box.width - 350px) / 2;
            y: root.phone ? 16px : (grid-box.height - self.preferred-height) / 2;
            width: root.phone ? grid-box.width - 32px : 350px;
            height: self.preferred-height;
            HorizontalLayout {
                alignment: start;
                spacing: root.phone ? 0px : 10px;
                AttachTile { icon: Icons.camera; label: "Camera"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.page = "camera"; } }
                AttachTile { icon: Icons.image; label: "Gallery"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.pick-gallery(); root.close-requested(); } }
                AttachTile { icon: Icons.attach; label: "Files"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.pick-files(); root.close-requested(); } }
                AttachTile { icon: Icons.emoji; label: "Emojis"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.load-emoji(); root.page = "emoji"; } }
                AttachTile { icon: Icons.sticker; label: "Stickers"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.load-stickers(); root.page = "stickers"; } }
            }
            Rectangle { height: root.phone ? 0px : 10px; }
            HorizontalLayout {
                alignment: start;
                spacing: root.phone ? 0px : 10px;
                AttachTile { icon: Icons.poll; label: "Poll"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.reset-poll(); root.page = "poll"; } }
                AttachTile { icon: Icons.myLocation; label: "Current\nLocation"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.open-location("current"); } }
                AttachTile { icon: Icons.liveLocation; label: "Live\nLocation"; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.open-location("live"); } }
                AttachTile { icon: Icons.pinDrop; label: "Drop a Pin"; icon-scale: 1.3; fg: root.fg; chip: root.tile-c; phone: root.phone; width: root.phone ? grid-box.cell : 62px; clicked => { root.open-location("pin"); } }
            }
        }
    }

    /// The capture chooser's mode, in the reference's own idiom: a shutter
    /// with Photo | Video under it, the chosen one in a filled stadium.
    in-out property <string> cam-mode: "photo";

    // The camera page. The reference is a live viewfinder with zoom chips and
    // a flip button; there is no camera surface in this app on Android, so
    // what stands here is the same choice in the same shape — pick Photo or
    // Video, press the shutter, and the SYSTEM camera opens for that capture.
    // Whatever it hands back lands on the staging page, captioned there.
    if root.page == "camera" : camera-box := Rectangle {
        width: 100%; height: 100%;
        // The shutter: the reference's 88 ring, at this sheet's scale.
        shutter := Rectangle {
            x: (camera-box.width - 72px) / 2; y: 46px;
            width: 72px; height: 72px; border-radius: 36px;
            background: transparent;
            border-width: 3px;
            border-color: root.fg;
            Rectangle {
                x: 6px; y: 6px;
                width: 60px; height: 60px; border-radius: 30px;
                background: sh-t.pressed ? root.fg.with-alpha(0.7) : root.fg;
                IconLabel {
                    text: root.cam-mode == "video" ? Icons.videoOn : Icons.camera;
                    color: root.sheet-c;
                    font-size: 26px;
                    width: 100%; height: 100%;
                }
            }
            sh-t := TouchArea {
                clicked => {
                    if (root.cam-mode == "video") { root.pick-video(); } else { root.pick-camera(); }
                    root.reset();
                    root.close-requested();
                }
            }
        }
        // Photo | Video, centred under the shutter.
        mode-row := HorizontalLayout {
            x: (camera-box.width - self.preferred-width) / 2;
            y: 142px;
            height: 40px;
            spacing: 4px;
            for m[i] in [{ v: "photo", t: "Photo" }, { v: "video", t: "Video" }] : Rectangle {
                property <bool> on: root.cam-mode == m.v;
                width: 96px; height: 40px; border-radius: 20px;
                background: self.on ? root.fg.with-alpha(0.9)
                    : mode-t.has-hover ? root.fg.with-alpha(0.10) : transparent;
                Text {
                    text: m.t;
                    color: parent.on ? root.sheet-c : root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    font-weight: parent.on ? 700 : 400;
                    width: 100%; height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                mode-t := TouchArea { clicked => { root.cam-mode = m.v; } }
            }
        }
    }

    // Note
    if root.page == "note" : Text {
        x: 40px;
        width: root.width - 80px; height: 100%;
        text: root.note;
        color: root.fg.with-alpha(0.75);
        font-family: Theme.font-ui;
        font-size: Theme.body;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    // Poll: question, then the options, then how the poll behaves — the order
    // the poll is thought of in. Up to 8 option slots (Slint models are not
    // mutable from the language, so the slots are explicit); `option-count`
    // is how many of them are open, and the list opens the next one itself as
    // soon as the last has words in it, so nothing has to be added by hand.
    in-out property <bool> poll-closed: false;
    /// Voters may pick more than one answer (engine: maxSelections).
    in-out property <bool> poll-multi: false;
    in-out property <int> option-count: 2;
    // The inputs live inside the poll page's `if`, so their ids are out of
    // scope here; the texts ride two-way component properties instead.
    in-out property <string> pq;
    in-out property <string> po1; in-out property <string> po2;
    in-out property <string> po3; in-out property <string> po4;
    in-out property <string> po5; in-out property <string> po6;
    in-out property <string> po7; in-out property <string> po8;
    // Whitespace-only entries count here — Slint has no trim, and the sheet
    // cannot ask the bridge for one (create-poll is the only seam it has).
    // The bridge trims the question and drops blank and whitespace-only
    // options before the poll is built (actions.rs create_poll), and says so
    // in a toast if that leaves fewer than two.
    property <bool> poll-valid: root.pq != ""
        && ((root.po1 != "" ? 1 : 0) + (root.po2 != "" ? 1 : 0) + (root.po3 != "" ? 1 : 0)
          + (root.po4 != "" ? 1 : 0) + (root.po5 != "" ? 1 : 0) + (root.po6 != "" ? 1 : 0)
          + (root.po7 != "" ? 1 : 0) + (root.po8 != "" ? 1 : 0)) >= 2;
    public function reset-poll() {
        root.poll-closed = false;
        root.poll-multi = false;
        root.option-count = 2;
        root.pq = ""; root.po1 = ""; root.po2 = ""; root.po3 = ""; root.po4 = "";
        root.po5 = ""; root.po6 = ""; root.po7 = ""; root.po8 = "";
    }
    // Typing into the last open slot opens the one under it (never the other
    // way round: a slot you have emptied stays, so the row you are working in
    // cannot vanish under the cursor). Blank ones cost nothing — the bridge
    // drops them when the poll is built.
    public function note-typed(i: int, t: string) {
        if (i == root.option-count && t != "" && root.option-count < 8) {
            root.option-count += 1;
        }
    }
    // Removing an option shifts the later slots up (QML pollOptions.remove);
    // any filled row can go once there are more than two.
    public function remove-option(i: int) {
        if (i <= 1) { root.po1 = root.po2; }
        if (i <= 2) { root.po2 = root.po3; }
        if (i <= 3) { root.po3 = root.po4; }
        if (i <= 4) { root.po4 = root.po5; }
        if (i <= 5) { root.po5 = root.po6; }
        if (i <= 6) { root.po6 = root.po7; }
        if (i <= 7) { root.po7 = root.po8; }
        root.po8 = "";
        root.option-count -= 1;
    }
    if root.page == "poll" : poll-box := Rectangle {
        x: 20px; y: 52px;
        // Margins 20, top 52; the footer is 34 (44 on the phone) with an 8px
        // gap above it (:180-186, :305-308).
        width: root.width - 40px;
        height: root.height - 52px - 20px - (root.phone ? 44px : 34px) - 8px;
        clip: true;
        property <length> label-gap: root.phone ? 6px : 4px;
        poll-flick := Flickable {
            width: 100%; height: 100%;
            viewport-height: poll-col.preferred-height;
            poll-col := VerticalLayout {
                width: poll-box.width;
                spacing: 6px;
                Text { text: "Question"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700; }
                q := PollField {
                    placeholder: "Ask something…";
                    text <=> root.pq;
                    height: root.phone ? 48px : 34px;
                    font-px: Theme.body; pad-right: 12px;
                    fg: root.fg; chip: root.well-c;
                }
                Rectangle { height: poll-box.label-gap; }
                Text { text: "Options"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700; }
                // Their own column at zero spacing: a closed slot has no
                // height, and a layout's spacing would still hold a gap open
                // for each of them. The gap rides inside the row instead.
                opts := VerticalLayout {
                    spacing: 0px;
                    PollOptionRow { placeholder: "Option 1"; text <=> root.po1; shown: true; removable: root.option-count > 2 && root.po1 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(1); } edited => { root.note-typed(1, root.po1); } }
                    PollOptionRow { placeholder: "Option 2"; text <=> root.po2; shown: true; removable: root.option-count > 2 && root.po2 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(2); } edited => { root.note-typed(2, root.po2); } }
                    PollOptionRow { placeholder: "Option 3"; text <=> root.po3; shown: root.option-count >= 3; removable: root.po3 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(3); } edited => { root.note-typed(3, root.po3); } }
                    PollOptionRow { placeholder: "Option 4"; text <=> root.po4; shown: root.option-count >= 4; removable: root.po4 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(4); } edited => { root.note-typed(4, root.po4); } }
                    PollOptionRow { placeholder: "Option 5"; text <=> root.po5; shown: root.option-count >= 5; removable: root.po5 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(5); } edited => { root.note-typed(5, root.po5); } }
                    PollOptionRow { placeholder: "Option 6"; text <=> root.po6; shown: root.option-count >= 6; removable: root.po6 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(6); } edited => { root.note-typed(6, root.po6); } }
                    PollOptionRow { placeholder: "Option 7"; text <=> root.po7; shown: root.option-count >= 7; removable: root.po7 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(7); } edited => { root.note-typed(7, root.po7); } }
                    PollOptionRow { placeholder: "Option 8"; text <=> root.po8; shown: root.option-count >= 8; removable: root.po8 != ""; fg: root.fg; chip: root.well-c; remove => { root.remove-option(8); } edited => { root.note-typed(8, root.po8); } }
                }
                // How the poll behaves, under what it asks: the QML's
                // Open/Closed segments as a switch, and multiple answers.
                PollToggleRow {
                    label: "Open poll";
                    sublabel: root.poll-closed ? "Results stay hidden until you close the poll"
                                               : "Voters see results as soon as they have voted";
                    on: !root.poll-closed;
                    fg: root.fg;
                    toggled => { root.poll-closed = !root.poll-closed; }
                }
                PollToggleRow {
                    label: "Multiple answers";
                    sublabel: root.poll-multi ? "Voters can pick as many options as they like"
                                              : "Voters pick one option";
                    on: root.poll-multi;
                    fg: root.fg;
                    toggled => { root.poll-multi = !root.poll-multi; }
                }
            }
        }
    }
    // The footer pills, at the QML's 30 on the desktop and a finger's 44 on
    // the phone (the sheet's own height counts on this: 54 / 64 to the edge).
    if root.page == "poll" : poll-footer := Rectangle {
        property <length> pill-h: root.phone ? 44px : 30px;
        x: 20px; y: root.height - self.pill-h - 20px;
        width: root.width - 40px; height: self.pill-h;
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            cancel-pill := Rectangle {
                width: root.phone ? 100px : 72px;
                height: poll-footer.pill-h; border-radius: self.height / 2;
                background: cp-t.pressed || cp-t.has-hover ? root.well-c.brighter(0.2) : root.well-c;
                Text { text: "Cancel"; color: root.fg; font-family: Theme.font-ui; font-size: root.phone ? Theme.body : Theme.body-small; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                cp-t := TouchArea { clicked => { root.reset(); } }
            }
            create-pill := Rectangle {
                width: root.phone ? 132px : 96px;
                height: poll-footer.pill-h; border-radius: self.height / 2;
                background: root.poll-valid ? root.accent : root.chip;
                opacity: root.poll-valid ? 1 : 0.7;
                Text {
                    text: "Create poll";
                    color: root.poll-valid ? Theme.background : root.fg.with-alpha(0.5);
                    font-family: Theme.font-ui; font-size: root.phone ? Theme.body : Theme.body-small;
                    font-weight: root.poll-valid ? 700 : 400;
                    width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        if (root.poll-valid) {
                            root.create-poll(root.pq,
                                [root.po1, root.po2, root.po3, root.po4, root.po5, root.po6, root.po7, root.po8],
                                root.poll-closed, root.poll-multi);
                        }
                    }
                }
            }
        }
    }

    // Location pages — one picker, three modes (AttachMenu.qml:350-376).
    // The `if` recreates it on entry, so the duration choice starts fresh
    // each time (locPicker.reset() at :53-55).
    if root.location-page : LocationPages {
        width: 100%; height: 100%;
        mode: root.page == "current" ? "current" : (root.page == "live" ? "live" : "pin");
        fg: root.fg;
        accent: root.accent;
        chip: root.chip;
        map-img: root.lp-map;
        map-unavailable: root.lp-unavailable;
        have-fix: root.lp-have-fix;
        fix-lat: root.lp-lat;
        fix-lon: root.lp-lon;
        position-error: root.lp-error;
        marked: root.lp-marked;
        mark-lat: root.lp-mark-lat;
        mark-lon: root.lp-mark-lon;
        my-avatar: root.my-avatar;
        back-requested => { root.page = "grid"; }
        map-tapped(x, y) => { root.loc-tap(x, y); }
        zoom-requested(d) => { root.loc-zoom(d); }
        recentre-requested => { root.loc-recentre(); }
        retry-position => { root.loc-retry(); }
        share-requested(la, lo, ms, mode) => { root.share-location(la, lo, ms, mode); }
    }

    // Stickers — margins 22, top 54 (:379-383).
    if root.page == "stickers" : stickers-box := Rectangle {
        x: 22px; y: 54px;
        width: root.width - 44px; height: root.height - 76px;
        clip: true;
        // A Flow: as many 56px cells as the width takes, packed left to right.
        property <int> cols: max(1, floor(self.width / 64px));
        // The port has no Element packs, so the copy names the folder instead
        // of AttachMenu.qml:390's im.ponies.user_emotes wording (recorded).
        if root.stickers.length == 0 : Text {
            text: "No sticker packs yet.\nPut a folder of images in " + (root.sticker-dir == "" ? "the stickers folder" : root.sticker-dir) + " and they show up here.";
            color: root.fg.with-alpha(0.6);
            font-family: Theme.font-ui;
            font-size: Theme.body-small;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%; height: 100%;
        }
        sticker-flick := Flickable {
            width: 100%; height: 100%;
            viewport-height: ((root.stickers.length + stickers-box.cols - 1) / stickers-box.cols) * 64px;
            for st[i] in root.stickers : st-box := Rectangle {
                x: mod(i, stickers-box.cols) * 64px;
                y: floor(i / stickers-box.cols) * 64px;
                width: 56px; height: 56px;
                Image { source: st.art; width: 100%; height: 100%; image-fit: contain; }
                Rectangle {
                    width: 100%; height: 100%; border-radius: 8px;
                    border-width: st-t.has-hover ? 2px : 0px;
                    border-color: root.accent.with-alpha(0.7);
                }
                st-t := TouchArea { clicked => { root.send-sticker(i); } }
            }
        }
    }

    // Emoji page body is the host's EmojiPicker mount. The picker carries its
    // own 8 side padding and its category bar sits on the sheet's bottom
    // edge, so the slot is the whole sheet less a 12 lead-in over the search
    // row. (@children cannot sit under a conditional, so visibility gates it.)
    //
    // The picker sets its OWN height at the mount (chat.slint), because the
    // sheet's frame is cut short when the keyboard leaves less room than the
    // sheet's natural height and only the host knows by how much; the slot is
    // the sheet's full body and does not clip, so a shorter picker simply
    // stops higher up. Nothing is lost: the frame cuts the chrome's bottom
    // corners, which are square on the phone.
    emoji-slot := Rectangle {
        visible: root.page == "emoji";
        x: 0px; y: 12px;
        width: root.width; height: root.height - 12px;
        @children
    }

    // The back button, in the picker's search row — the gap EmojiPicker's
    // `back-slot` leaves at the LEFT of the field, leading it, 8 in from the
    // sheet edge and 40 square, level with the 40 field. It lives here because
    // the picker arrives through @children, which can neither be given a
    // property nor have a callback connected.
    if root.page == "emoji" : emoji-back := Rectangle {
        x: 8px; y: 12px;
        width: 40px; height: 40px;
        border-radius: 20px;
        background: eb-t.pressed || eb-t.has-hover ? root.chip.brighter(0.2) : root.chip;
        IconLabel { text: Icons.back; color: root.fg; font-size: Theme.icon-size; width: 100%; height: 100%; }
        eb-t := TouchArea { clicked => { root.reset(); } }
    }
}
