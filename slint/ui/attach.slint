// Attachment sheet under the composer — mobile/AttachMenu.qml. Each category
// opens its own page inside the same panel, the three location pages
// included (LocationPicker.qml in three modes, over the engine's
// location.map crop). The emoji page body is whatever the host puts in
// @children (ChatPage mounts the shared EmojiPicker there).

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";
import { SelfPin } from "pages/map.slint";

export struct StickerItem { path: string, art: image, body: string, url: string, w: int, h: int }

// AttachMenu.qml's poll field: a 10px-radius chip well whose fill LIGHTENS on
// focus (no border), question at body size, options at body-small. Insets are
// 12 left and 10 right for options, 12/12 for the question (:264, :234).
component PollField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <length> font-px: Theme.body-small;
    in property <length> pad-right: 10px;
    in property <color> fg;
    in property <color> chip;
    height: 32px;
    border-radius: 10px;
    background: input.has-focus ? root.chip.brighter(0.15) : root.chip;
    HorizontalLayout {
        padding-left: 12px; padding-right: root.pad-right;
        Rectangle {
            clip: true;
            input := TextInput {
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: root.font-px;
                vertical-alignment: center;
                height: 100%; width: 100%;
                single-line: true;
            }
            if input.text == "" : Text {
                text: root.placeholder;
                color: root.fg.with-alpha(0.55);
                font-family: Theme.font-ui;
                font-size: root.font-px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}

// A poll option row: the field, and the "×" remove disc that every row shows
// once there are more than two options (AttachMenu.qml:259, :283). With the
// disc the field is `parent - 40` wide (34 + 6 spacing), and the disc's 28px
// end 6px short of the right edge — exactly the QML Row.
component PollOptionRow inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> removable;
    in property <color> fg;
    in property <color> chip;
    callback remove;
    height: 32px;
    field := PollField {
        x: 0; y: 0;
        width: root.removable ? root.width - 40px : root.width;
        placeholder: root.placeholder; text <=> root.text; fg: root.fg; chip: root.chip;
    }
    if root.removable : Rectangle {
        x: root.width - 40px + 6px; y: 2px;
        width: 28px; height: 28px; border-radius: 14px;
        background: rm-t.has-hover ? root.chip.brighter(0.2) : root.chip;
        // A literal multiplication sign in the UI face at body size (:283).
        Text { text: "\u{00d7}"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
        rm-t := TouchArea { clicked => { root.remove(); } }
    }
}

component AttachTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <float> icon-scale: 1.0;
    in property <color> fg;
    in property <color> chip;
    callback clicked;
    width: 62px; height: 72px;
    disc := Rectangle {
        // Top of the tile (QML anchors only horizontalCenter): a sized child
        // outside a layout is otherwise centred by default in Slint.
        x: (62px - self.width) / 2; y: 0;
        width: 58px; height: 40px;
        border-radius: 20px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: tile-t.has-hover ? 1.05 : 1.0;
        transform-scale-y: tile-t.has-hover ? 1.05 : 1.0;
        animate transform-scale-x, transform-scale-y { duration: 110ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        // Lightens on hover only (AttachMenu.qml:121); a press changes nothing.
        background: tile-t.has-hover ? root.chip.brighter(0.2) : root.chip;
        IconLabel {
            text: root.icon;
            color: root.fg;
            font-size: Theme.icon-size * root.icon-scale;
            width: 100%; height: 100%;
        }
    }
    Text {
        y: 45px;
        width: 62px;
        text: root.label;
        color: root.fg.with-alpha(0.75);
        font-family: Theme.font-ui;
        font-size: 10px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    tile-t := TouchArea { clicked => { root.clicked(); } }
}

// The attachment sheet's three location pages — LocationPicker.qml, one
// picker in three modes:
//   "current" — your position, avatar marker, share once
//   "live"    — your position plus how long to keep sharing it
//   "pin"     — tap the map to place a point, then share that
// The map is the engine's location.map crop, CENTRED on the pin (or the
// fix), so the marker always stands at the middle of the box; a tap goes up
// as box-local pixels and the bridge turns them into lat/lon and re-crops.
component LocationPages inherits Rectangle {
    in property <string> mode: "pin";          // current | live | pin
    in property <color> fg;
    in property <color> accent;
    in property <color> chip;
    /// The location.map composite at 2× the map box; empty while pending.
    in property <image> map-img;
    /// location.map answered "unavailable": no style on this server.
    in property <bool> map-unavailable;
    in property <bool> have-fix;
    in property <float> fix-lat;
    in property <float> fix-lon;
    in property <string> position-error;
    /// Pin mode: where the last tap landed (bridge-computed).
    in property <bool> marked;
    in property <float> mark-lat;
    in property <float> mark-lon;
    in property <image> my-avatar;
    callback back-requested;
    callback map-tapped(length, length);       // logical px inside the map box
    callback zoom-requested(int);              // +1 / −1; the bridge clamps 3..19
    callback recentre-requested;               // re-crop at the fix
    callback retry-position;                   // position.refresh
    callback share-requested(float, float, float, string); // lat, lon, durationMs, mode

    property <bool> pin-mode: root.mode == "pin";
    property <bool> live-mode: root.mode == "live";
    property <bool> can-share: root.pin-mode ? root.marked : root.have-fix;
    // stands in for QML's mapReady (LocationPicker.qml:32): the style exists
    // until the engine says otherwise.
    property <bool> map-ready: !root.map-unavailable;
    property <int> duration-index: 0;
    property <[string]> duration-labels: ["Share for 15m", "Share for 1h", "Share for 8h"];
    property <[float]> duration-ms: [900000, 3600000, 28800000];
    in-out property <bool> duration-open: false;
    // LocationPicker.qml:20-22 — the popup ground with its alpha forced to 1.
    property <color> menu-solid: Theme.popup-background.with-alpha(1.0);

    background: transparent;

    // LocationPicker.qml:86-103 — the map box: 16 in from the sides and top,
    // 14 above the bottom bar, radius 14, fg@0.10 ground. Its height is a
    // constant per mode (340px, 294px live) that src/actions.rs mirrors when
    // sizing the location.map request — keep them in step.
    map-box := Rectangle {
        x: 16px; y: 16px;
        width: root.width - 32px;
        height: bottom-bar.y - 14px - 16px;
        border-radius: 14px;
        background: root.fg.with-alpha(0.10);
        clip: true;

        if root.map-ready && root.map-img.width > 0 : Image {
            width: 100%; height: 100%;
            source: root.map-img;
            image-fit: cover;
        }

        // The tiles' tap handler (LocationPicker.qml:128-131 mapTapped):
        // pin mode only; chips are declared after so they stay on top.
        map-tap := TouchArea {
            enabled: root.pin-mode && root.map-ready;
            clicked => { root.map-tapped(self.pressed-x, self.pressed-y); }
        }

        // The marker MapView.qml would place (:117-127): the crop is centred
        // on the point, so its tip stands at the middle of the box. Your face
        // in the pin outside pin mode (:122-124); a plain pin once marked
        // (markerAvatar is "" in pin mode — SelfPin without a face is one).
        if root.map-ready && !root.pin-mode && root.have-fix : self-marker := SelfPin {
            x: map-box.width / 2 - 24px;
            y: map-box.height / 2 - 48px;
            pin-color: root.accent;
            avatar: root.my-avatar;
        }
        if root.map-ready && root.pin-mode && root.marked : pin-marker := SelfPin {
            x: map-box.width / 2 - 24px;
            y: map-box.height / 2 - 48px;
            pin-color: root.accent;
        }

        // LocationPicker.qml:135-150 — the no-map column, parent − 40 wide,
        // spacing 8; ours appears when the engine has no style configured.
        if !root.map-ready : VerticalLayout {
            x: 20px;
            width: map-box.width - 40px;
            y: (map-box.height - self.preferred-height) / 2;
            height: self.preferred-height;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                if !root.pin-mode && root.have-fix : SelfPin {
                    pin-color: root.accent;
                    avatar: root.my-avatar;
                }
                // :140-141 — the no-map glyph: filled `place`, 36px, accent@0.8.
                if root.pin-mode || !root.have-fix : IconLabel {
                    text: Icons.location;
                    filled: true;
                    color: root.accent.with-alpha(0.8);
                    font-size: 36px;
                    width: 36px; height: 36px;
                }
            }
            Text {
                text: "Maps are not set up on this server";
                color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // LocationPicker.qml:154-161 — back chip: a 30px disc at 8/8 in the
        // chip fill, the outlined `back` glyph at icon size.
        back-chip := Rectangle {
            x: 8px; y: 8px;
            width: 30px; height: 30px;
            border-radius: 15px;
            background: root.chip;
            IconLabel {
                text: Icons.back;
                color: root.fg;
                font-size: Theme.icon-size;
                width: 100%; height: 100%;
            }
            TouchArea { clicked => { root.back-requested(); } }
        }

        // :163-178 — recentre chip, top right: filled glyph, accent once
        // there is anything to centre on, fg@0.4 otherwise.
        recentre-chip := Rectangle {
            x: map-box.width - 30px - 8px; y: 8px;
            width: 30px; height: 30px;
            border-radius: 15px;
            background: root.chip;
            visible: root.map-ready;
            IconLabel {
                text: Icons.recentre;
                filled: true;
                color: root.have-fix || root.marked ? root.accent : root.fg.with-alpha(0.4);
                font-size: Theme.icon-size;
                width: 100%; height: 100%;
            }
            TouchArea { clicked => { root.recentre-requested(); } }
        }

        // :180-203 — zoom chips, bottom right, pin mode only: 28px squares,
        // radius 8, spacing 4.
        zoom-col := VerticalLayout {
            x: map-box.width - 28px - 8px;
            y: map-box.height - 28px * 2 - 4px - 8px;
            width: 28px;
            spacing: 4px;
            visible: root.pin-mode && root.map-ready;
            Rectangle {
                width: 28px; height: 28px; border-radius: 8px;
                background: root.chip;
                Text { text: "+"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.zoom-requested(1); } }
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: 8px;
                background: root.chip;
                Text { text: "−"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.zoom-requested(-1); } }
            }
        }

        // :205-228 — the hint pill, top centre at 8: 26 tall, text + 20 wide,
        // chip fill, caption. Tapping it retries a missing fix.
        hint-pill := Rectangle {
            x: (map-box.width - self.width) / 2;
            y: 8px;
            width: hint.preferred-width + 20px;
            height: 26px;
            border-radius: 13px;
            background: root.chip;
            visible: root.map-ready && (root.pin-mode || !root.have-fix);
            hint := Text {
                text: root.pin-mode
                    ? (root.marked ? "Click to move the pin" : "Click to drop a pin")
                    : (root.position-error != "" ? "Location unavailable — tap to retry" : "Finding your location…");
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
            TouchArea {
                enabled: !root.pin-mode && !root.have-fix;
                clicked => { root.retry-position(); }
            }
        }
    }

    // LocationPicker.qml:231-287 — the bottom bar: 16 in and 16 up, spacing 8
    // between the duration field and the share pill.
    bottom-bar := VerticalLayout {
        x: 16px;
        width: root.width - 32px;
        y: root.height - 16px - self.preferred-height;
        height: self.preferred-height;
        spacing: 8px;

        // :239-261 — how long to keep sharing, live mode only: a 38px field,
        // radius 11, popup ground; label bodySmall, chevron fg@0.7.
        if root.live-mode : duration-field := Rectangle {
            height: 38px;
            border-radius: 11px;
            background: root.menu-solid;
            Text {
                x: 14px; height: 100%;
                width: parent.width - 14px - 12px - 14px;
                text: root.duration-labels[root.duration-index];
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
                vertical-alignment: center;
                overflow: elide;
            }
            IconLabel {
                x: parent.width - 12px - 14px;
                width: 14px; height: 100%;
                text: root.duration-open ? Icons.chevronUp : Icons.chevronDown;
                color: root.fg.with-alpha(0.7);
                font-size: Theme.icon-size;
            }
            TouchArea { clicked => { root.duration-open = !root.duration-open; } }
        }

        // :263-286 — Share: the accent pill once there is something to share.
        share-btn := Rectangle {
            height: 44px;
            border-radius: 22px;
            background: root.can-share ? root.accent.with-alpha(0.92) : root.chip;
            opacity: root.can-share ? 1 : 0.6;
            Text {
                text: "Share location";
                color: root.can-share ? #141414 : root.fg.with-alpha(0.7);
                font-family: Theme.font-ui;
                font-size: Theme.body;
                font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
            TouchArea {
                enabled: root.can-share;
                clicked => {
                    root.share-requested(
                        root.pin-mode ? root.mark-lat : root.fix-lat,
                        root.pin-mode ? root.mark-lon : root.fix-lon,
                        root.live-mode ? root.duration-ms[root.duration-index] : 0,
                        root.mode);
                }
            }
        }
    }

    // LocationPicker.qml:289-324 — the duration card: the bar's width, its
    // bottom 56 above the bar's bottom, radius 12, popup ground, rows of 34
    // at radius 9 inside a 4px margin; selected accent@0.25, hover fg@0.08.
    if root.duration-open && root.live-mode : dur-card := Rectangle {
        x: 16px;
        width: root.width - 32px;
        height: dur-col.preferred-height + 8px;
        y: root.height - 16px - 56px - self.height;
        border-radius: 12px;
        background: root.menu-solid;
        dur-col := VerticalLayout {
            x: 4px; y: 4px;
            width: dur-card.width - 8px;
            height: self.preferred-height;
            for label[i] in root.duration-labels : dur-row := Rectangle {
                height: 34px;
                border-radius: 9px;
                background: i == root.duration-index ? root.accent.with-alpha(0.25)
                          : dur-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                Text {
                    x: 12px; height: 100%;
                    text: label;
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                }
                dur-t := TouchArea { clicked => { root.duration-index = i; root.duration-open = false; } }
            }
        }
    }
}

export component AttachMenu inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <color> surface: Theme.menu-text.with-alpha(0.07);
    // ChatPage.qml chipC (unthemed): alpha(darker(menu.background, 2.1), 0.96)
    // ≈ rgba(36,36,36,0.96). Slint's darker(f) divides V by 1+f, so 1.1.
    in property <color> chip: Theme.menu-background.darker(1.1).with-alpha(0.96);

    // grid | poll | stickers | emoji | note | pin | current | live — a
    // location tile emits open-location and the bridge answers by setting
    // `page` to the mode (AttachMenu.qml:53-55 does both at once; ours
    // resets the picker state on the Rust side first).
    in-out property <string> page: "grid";
    in-out property <string> note: "";
    in property <[StickerItem]> stickers;
    in property <bool> stickers-loaded: false;
    /// Where packs live on this device (stickers.list tells us).
    in property <string> sticker-dir;

    // The location pages' feed (see LocationPages above).
    in property <image> lp-map;
    in property <bool> lp-unavailable;
    in property <bool> lp-have-fix;
    in property <float> lp-lat;
    in property <float> lp-lon;
    in property <string> lp-error;
    in property <bool> lp-marked;
    in property <float> lp-mark-lat;
    in property <float> lp-mark-lon;
    in property <image> my-avatar;

    callback pick-files;
    callback open-location(string); // "pin" | "current" | "live"
    callback loc-tap(length, length);   // map tap, logical px in the map box
    callback loc-zoom(int);             // +1 / −1
    callback loc-recentre;
    callback loc-retry;                 // position.refresh
    callback share-location(float, float, float, string); // lat, lon, ms, mode
    callback insert-emoji(string);
    callback create-poll(string, [string], bool); // question, options, closed
    callback send-sticker(int);     // index into stickers
    callback load-stickers;
    callback load-emoji;
    callback close-requested;

    property <bool> location-page: root.page == "pin" || root.page == "current" || root.page == "live";
    height: root.page == "poll" ? 408px
          : root.location-page ? 430px
          : (root.page == "emoji" || root.page == "stickers") ? 330px
          : 232px;

    public function reset() { root.page = "grid"; root.note = ""; }

    // Chrome: ONE translucent wash inset 10 all round, radius 18, over the
    // conversation ground (AttachMenu.qml:67-73). No opaque card, no border.
    chrome := Rectangle {
        x: 10px; y: 10px;
        width: root.width - 20px; height: root.height - 20px;
        border-radius: 18px;
        background: root.surface;
    }

    // Sub-page header — QML margins: 16 top, 18 sides; hidden on the grid and
    // on the location pages (:75-78).
    if root.page != "grid" && !root.location-page : header := Rectangle {
        x: 18px; y: 16px;
        width: root.width - 36px; height: 30px;
        back-disc := Rectangle {
            // at the left edge (AttachMenu.qml:80); unplaced, Slint centres it
            x: 0px; y: 0px;
            width: 30px; height: 30px; border-radius: 15px;
            background: hb-t.has-hover ? root.chip.brighter(0.2) : root.chip;
            IconLabel { text: Icons.back; color: root.fg; font-size: Theme.body; width: 100%; height: 100%; }
            hb-t := TouchArea { clicked => { root.reset(); } }
        }
        Text {
            text: root.page == "poll" ? "New poll"
                : root.page == "stickers" ? "Stickers"
                : root.page == "emoji" ? "Emoji" : "";
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.body;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%; height: 100%;
        }
    }

    // Grid: the 5-column block is centred while its rows still fill left to
    // right — row two is left-aligned under the block (QML Grid.centerIn).
    if root.page == "grid" : grid-box := Rectangle {
        width: 100%; height: 100%;
        grid-block := VerticalLayout {
            x: (grid-box.width - 350px) / 2;
            y: (grid-box.height - self.preferred-height) / 2;
            width: 350px;
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                AttachTile { icon: Icons.attach; label: "Files"; fg: root.fg; chip: root.chip; clicked => { root.pick-files(); root.close-requested(); } }
                AttachTile { icon: Icons.emoji; label: "Emojis"; fg: root.fg; chip: root.chip; clicked => { root.load-emoji(); root.page = "emoji"; } }
                AttachTile { icon: Icons.sticker; label: "Stickers"; fg: root.fg; chip: root.chip; clicked => { root.load-stickers(); root.page = "stickers"; } }
                AttachTile { icon: Icons.poll; label: "Poll"; fg: root.fg; chip: root.chip; clicked => { root.reset-poll(); root.page = "poll"; } }
                AttachTile { icon: Icons.myLocation; label: "Current\nLocation"; fg: root.fg; chip: root.chip; clicked => { root.open-location("current"); } }
            }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                AttachTile { icon: Icons.liveLocation; label: "Live\nLocation"; fg: root.fg; chip: root.chip; clicked => { root.open-location("live"); } }
                AttachTile { icon: Icons.pinDrop; label: "Drop a Pin"; icon-scale: 1.3; fg: root.fg; chip: root.chip; clicked => { root.open-location("pin"); } }
            }
        }
    }

    // Note
    if root.page == "note" : Text {
        x: 40px;
        width: root.width - 80px; height: 100%;
        text: root.note;
        color: root.fg.with-alpha(0.75);
        font-family: Theme.font-ui;
        font-size: Theme.body;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    // Poll: question + up to 8 option slots (Slint models are not mutable
    // from the language, so the slots are explicit; count gates visibility).
    in-out property <bool> poll-closed: false;
    in-out property <int> option-count: 2;
    // The inputs live inside the poll page's `if`, so their ids are out of
    // scope here; the texts ride two-way component properties instead.
    in-out property <string> pq;
    in-out property <string> po1; in-out property <string> po2;
    in-out property <string> po3; in-out property <string> po4;
    in-out property <string> po5; in-out property <string> po6;
    in-out property <string> po7; in-out property <string> po8;
    // Whitespace-only entries count here; the QML trims (:170-175) — the
    // bridge trims before creating (chat-handoff.md B15).
    property <bool> poll-valid: root.pq != ""
        && ((root.po1 != "" ? 1 : 0) + (root.po2 != "" ? 1 : 0) + (root.po3 != "" ? 1 : 0)
          + (root.po4 != "" ? 1 : 0) + (root.po5 != "" ? 1 : 0) + (root.po6 != "" ? 1 : 0)
          + (root.po7 != "" ? 1 : 0) + (root.po8 != "" ? 1 : 0)) >= 2;
    public function reset-poll() {
        root.poll-closed = false;
        root.option-count = 2;
        root.pq = ""; root.po1 = ""; root.po2 = ""; root.po3 = ""; root.po4 = "";
        root.po5 = ""; root.po6 = ""; root.po7 = ""; root.po8 = "";
    }
    // Removing an option shifts the later slots up (QML pollOptions.remove);
    // any row can go once there are more than two.
    public function remove-option(i: int) {
        if (i <= 1) { root.po1 = root.po2; }
        if (i <= 2) { root.po2 = root.po3; }
        if (i <= 3) { root.po3 = root.po4; }
        if (i <= 4) { root.po4 = root.po5; }
        if (i <= 5) { root.po5 = root.po6; }
        if (i <= 6) { root.po6 = root.po7; }
        if (i <= 7) { root.po7 = root.po8; }
        root.po8 = "";
        root.option-count -= 1;
    }
    if root.page == "poll" : poll-box := Rectangle {
        x: 20px; y: 52px;
        // Margins 20, top 52; the footer is 34 with an 8px gap above it (:180-186, :305-308).
        width: root.width - 40px; height: root.height - 52px - 20px - 34px - 8px;
        clip: true;
        poll-flick := Flickable {
            width: 100%; height: 100%;
            viewport-height: poll-col.preferred-height;
            poll-col := VerticalLayout {
                width: poll-box.width;
                spacing: 6px;
                Text { text: "Poll type"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    open-seg := Rectangle {
                        width: 84px; height: 28px; border-radius: 14px;
                        background: !root.poll-closed ? root.accent : root.chip;
                        Text { text: "Open"; color: !root.poll-closed ? Theme.background : root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: !root.poll-closed ? 700 : 400; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.poll-closed = false; } }
                    }
                    closed-seg := Rectangle {
                        width: 84px; height: 28px; border-radius: 14px;
                        background: root.poll-closed ? root.accent : root.chip;
                        Text { text: "Closed"; color: root.poll-closed ? Theme.background : root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: root.poll-closed ? 700 : 400; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.poll-closed = true; } }
                    }
                }
                Text {
                    text: root.poll-closed ? "Results stay hidden until you close the poll"
                                           : "Voters see results as soon as they have voted";
                    color: root.fg.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Rectangle { height: 4px; }   // the description's bottomPadding (:222)
                Text { text: "Question"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700; }
                q := PollField { placeholder: "Ask something…"; text <=> root.pq; height: 34px; font-px: Theme.body; pad-right: 12px; fg: root.fg; chip: root.chip; }
                Rectangle { height: 4px; }
                Text { text: "Options"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700; }
                PollOptionRow { placeholder: "Option 1"; text <=> root.po1; removable: root.option-count > 2; fg: root.fg; chip: root.chip; remove => { root.remove-option(1); } }
                PollOptionRow { placeholder: "Option 2"; text <=> root.po2; removable: root.option-count > 2; fg: root.fg; chip: root.chip; remove => { root.remove-option(2); } }
                if root.option-count >= 3 : PollOptionRow { placeholder: "Option 3"; text <=> root.po3; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(3); } }
                if root.option-count >= 4 : PollOptionRow { placeholder: "Option 4"; text <=> root.po4; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(4); } }
                if root.option-count >= 5 : PollOptionRow { placeholder: "Option 5"; text <=> root.po5; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(5); } }
                if root.option-count >= 6 : PollOptionRow { placeholder: "Option 6"; text <=> root.po6; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(6); } }
                if root.option-count >= 7 : PollOptionRow { placeholder: "Option 7"; text <=> root.po7; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(7); } }
                if root.option-count >= 8 : PollOptionRow { placeholder: "Option 8"; text <=> root.po8; removable: true; fg: root.fg; chip: root.chip; remove => { root.remove-option(8); } }
                if root.option-count < 8 : add-row := Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        IconLabel { text: Icons.plus; color: root.accent; font-size: Theme.body-small; vertical-alignment: center; }
                        Rectangle {
                            width: add-label.preferred-width;
                            add-label := Text { text: "Add option"; color: root.accent; font-family: Theme.font-ui; font-size: Theme.body-small; vertical-alignment: center; height: 100%; }
                            // QML underlines the label on hover (:297); Slint Text has
                            // no underline, so a 1px rule stands in for it.
                            Rectangle {
                                y: (30px + add-label.preferred-height) / 2 - 1px;
                                width: 100%; height: 1px;
                                background: add-t.has-hover ? root.accent : transparent;
                            }
                        }
                    }
                    add-t := TouchArea { clicked => { root.option-count += 1; } }
                }
            }
        }
    }
    if root.page == "poll" : poll-footer := Rectangle {
        x: 20px; y: root.height - 54px;
        width: root.width - 40px; height: 34px;
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            cancel-pill := Rectangle {
                width: 72px; height: 30px; border-radius: 15px;
                background: cp-t.has-hover ? root.chip.brighter(0.2) : root.chip;
                Text { text: "Cancel"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body-small; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                cp-t := TouchArea { clicked => { root.reset(); } }
            }
            create-pill := Rectangle {
                width: 96px; height: 30px; border-radius: 15px;
                background: root.poll-valid ? root.accent : root.chip;
                opacity: root.poll-valid ? 1 : 0.7;
                Text {
                    text: "Create poll";
                    color: root.poll-valid ? Theme.background : root.fg.with-alpha(0.5);
                    font-family: Theme.font-ui; font-size: Theme.body-small;
                    font-weight: root.poll-valid ? 700 : 400;
                    width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        if (root.poll-valid) {
                            root.create-poll(root.pq, [root.po1, root.po2, root.po3, root.po4, root.po5, root.po6, root.po7, root.po8], root.poll-closed);
                        }
                    }
                }
            }
        }
    }

    // Location pages — one picker, three modes (AttachMenu.qml:350-376).
    // The `if` recreates it on entry, so the duration choice starts fresh
    // each time (locPicker.reset() at :53-55).
    if root.location-page : LocationPages {
        width: 100%; height: 100%;
        mode: root.page == "current" ? "current" : (root.page == "live" ? "live" : "pin");
        fg: root.fg;
        accent: root.accent;
        chip: root.chip;
        map-img: root.lp-map;
        map-unavailable: root.lp-unavailable;
        have-fix: root.lp-have-fix;
        fix-lat: root.lp-lat;
        fix-lon: root.lp-lon;
        position-error: root.lp-error;
        marked: root.lp-marked;
        mark-lat: root.lp-mark-lat;
        mark-lon: root.lp-mark-lon;
        my-avatar: root.my-avatar;
        back-requested => { root.page = "grid"; }
        map-tapped(x, y) => { root.loc-tap(x, y); }
        zoom-requested(d) => { root.loc-zoom(d); }
        recentre-requested => { root.loc-recentre(); }
        retry-position => { root.loc-retry(); }
        share-requested(la, lo, ms, mode) => { root.share-location(la, lo, ms, mode); }
    }

    // Stickers — margins 22, top 54 (:379-383).
    if root.page == "stickers" : stickers-box := Rectangle {
        x: 22px; y: 54px;
        width: root.width - 44px; height: root.height - 76px;
        clip: true;
        // A Flow: as many 56px cells as the width takes, packed left to right.
        property <int> cols: max(1, floor(self.width / 64px));
        // The port has no Element packs, so the copy names the folder instead
        // of AttachMenu.qml:390's im.ponies.user_emotes wording (recorded).
        if root.stickers.length == 0 : Text {
            text: "No sticker packs yet.\nPut a folder of images in " + (root.sticker-dir == "" ? "the stickers folder" : root.sticker-dir) + " and they show up here.";
            color: root.fg.with-alpha(0.6);
            font-family: Theme.font-ui;
            font-size: Theme.body-small;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%; height: 100%;
        }
        sticker-flick := Flickable {
            width: 100%; height: 100%;
            viewport-height: ((root.stickers.length + stickers-box.cols - 1) / stickers-box.cols) * 64px;
            for st[i] in root.stickers : st-box := Rectangle {
                x: mod(i, stickers-box.cols) * 64px;
                y: floor(i / stickers-box.cols) * 64px;
                width: 56px; height: 56px;
                Image { source: st.art; width: 100%; height: 100%; image-fit: contain; }
                Rectangle {
                    width: 100%; height: 100%; border-radius: 8px;
                    border-width: st-t.has-hover ? 2px : 0px;
                    border-color: root.accent.with-alpha(0.7);
                }
                st-t := TouchArea { clicked => { root.send-sticker(i); } }
            }
        }
    }

    // Emoji page body is the host's EmojiPicker mount; reserve the space
    // (margins 20, top 52 — :392-396). (@children cannot sit under a
    // conditional, so visibility gates it.)
    emoji-slot := Rectangle {
        visible: root.page == "emoji";
        x: 20px; y: 52px;
        width: root.width - 40px; height: root.height - 72px;
        @children
    }
}
