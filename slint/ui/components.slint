// Shared furniture, mirroring omarchy/components/: IconLabel, Avatar, the
// action button, and the search pill. Each exists so pages cannot drift.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";

// An icon by name (`Icons.*`), never a glyph in a Text: the codepoints are
// private-use, so the wrong family draws a different icon, not tofu.
// Defaults follow IconLabel.qml:15,17: 16px, outlined. Sites pass `filled: true`
// and a size only where their QML twin does.
export component IconLabel inherits Text {
    in property <bool> filled: false;
    font-family: self.filled ? Theme.font-icon-filled : Theme.font-icon;
    font-size: 16px;
    color: Theme.menu-text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// Bare size×size tap surface with a centred icon — PanelActionButton: 22×22
// with a 14px glyph (docs/ui-conventions.md:148-150, 170-173). Every QML site
// passes `fontFamily: Fonts.icon` (outlined) unless noted, so `filled` is off.
// Where a page needs a bigger finger target the QML enlarges only the
// MouseArea; do the same with a sibling TouchArea, not the button.
// Plain centring is correct for Material Symbols; do not ink-centre them
// (docs/ui-conventions.md, "Icons and centring").
export component ActionButton inherits Rectangle {
    in property <string> icon;
    in property <bool> filled: false;
    in property <color> foreground: Theme.menu-text;
    in property <length> icon-size: Theme.icon-size;
    callback clicked;
    width: 22px; height: 22px;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.menu-text.with-alpha(0.10)
              : touch.has-hover ? Theme.menu-text.with-alpha(0.06)
              : transparent;
    IconLabel {
        text: root.icon;
        filled: root.filled;
        color: root.foreground;
        font-size: root.icon-size;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Avatar: image when the engine cached one, initials over a hashed tint
// otherwise. The colour and initials are computed in Rust with the row.
export component Avatar inherits Rectangle {
    in property <length> size: 32px;   // Avatar.qml:62
    in property <image> source;
    in property <string> initials;
    in property <color> tint: Theme.accent;
    /// online | away | busy | offline | "" (unknown: no dot at all)
    in property <string> status;
    in property <color> status-backdrop: Theme.menu-background;
    width: self.size; height: self.size;
    border-radius: self.size / 2;
    background: root.source.width > 0 ? transparent : root.tint.with-alpha(0.55);
    // The clip lives on the image wrap, not the root: the presence dot rides
    // 2% outside the rim and must not be cut.
    if root.source.width > 0 : Rectangle {
        width: root.size; height: root.size;
        border-radius: root.size / 2;
        clip: true;
        Image {
            source: root.source;
            width: root.size; height: root.size;
            image-fit: cover;
        }
    }
    if root.source.width == 0 : Text {
        text: root.initials;
        color: Theme.foreground;
        font-family: Theme.font-ui;
        font-size: max(8px, root.size * 0.42);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%; height: 100%;
    }
    // Presence: a dot pinned to the lower-right rim, ring (outline) when
    // offline — Avatar.qml's status badge. The pad is transparent there
    // (statusBackdrop is declared but never applied) and rides 2% outside.
    if root.status != "" : status-pad := Rectangle {
        x: root.size - self.width + root.size * 0.02;
        y: root.size - self.height + root.size * 0.02;
        width: max(10px, root.size * 0.32);
        height: self.width;
        border-radius: self.width / 2;
        background: transparent;
        IconLabel {
            text: root.status == "offline" ? Icons.statusRing : Icons.statusDot;
            filled: true;   // Avatar.qml:88
            color: root.status == "online" ? #3fbf5f
                 : root.status == "busy" ? #e2564a
                 : root.status == "away" ? #eaa030
                 : Theme.menu-text;
            font-size: status-pad.width;
            width: 100%; height: 100%;
        }
    }
}

// Pill button — components/Button.qml. `bordered` is the primary face
// (LoginPage.qml:41,84; RecoveryPage.qml:59); plain is for secondaries such as
// Cancel, Back and "Skip for now" (LoginPage.qml:91-92; RecoveryPage.qml:60).
export component SButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> bordered: true;
    in property <color> foreground: Theme.menu-text;
    callback clicked;
    height: 36px;
    width: row.preferred-width + 28px;
    border-radius: self.height / 2;
    border-width: root.bordered ? 1px : 0px;
    border-color: root.foreground.with-alpha(0.25);
    background: !root.enabled ? transparent
              : touch.pressed ? root.foreground.with-alpha(0.12)
              : touch.has-hover ? root.foreground.with-alpha(0.07)
              : transparent;
    opacity: root.enabled ? 1.0 : 0.45;
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-top: 0; padding-bottom: 0;
        // outlined, as IconLabel.qml:17 defaults (Button.qml never sets `filled`)
        if root.icon != "" : IconLabel {
            text: root.icon;
            color: root.foreground;
            font-size: Theme.icon-size;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.foreground;
            font-family: Theme.font-ui;
            font-size: Theme.body;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// One-line text entry in a rounded well: the login and settings fields.
// LoginPage.qml:58-77 / RecoveryPage.qml:28-55: 36 high, radius
// Style.cornerRadius/2 (10), fill fg@0.06, a 1px border fg@0.12 at rest and
// accent@0.6 with focus, text inset 10 each side, placeholder fg@0.4.
export component TextWell inherits Rectangle {
    in property <string> placeholder;
    in property <string> leading-icon;
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    in property <bool> password: false;
    /// the in-field eye that flips `reveal` (RecoveryPage.qml:47-54); the
    /// page binds `password: !reveal` itself
    in property <bool> reveal-toggle: false;
    in-out property <bool> reveal: false;
    callback accepted;
    callback edited;
    height: 36px;
    border-radius: 10px;
    background: Theme.menu-text.with-alpha(0.06);
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.6) : Theme.menu-text.with-alpha(0.12);
    public function focus-input() { input.focus(); }
    HorizontalLayout {
        // LoginPage.qml:65 margins 10/10; RecoveryPage.qml:35 right 36 past the eye
        padding-left: 10px;
        padding-right: root.reveal-toggle ? 36px : 10px;
        spacing: 8px;
        if root.leading-icon != "" : IconLabel {
            text: root.leading-icon;
            color: Theme.menu-text.with-alpha(0.5);
            vertical-alignment: center;
        }
        // The editing menu of TextContextMenu.qml:19-26 (right-click, or a
        // long press on touch), in the shape Slint's own LineEdit uses.
        ContextMenuArea {
            enabled: root.enabled;
            Menu {
                MenuItem {
                    title: "Cut";
                    enabled: root.enabled && input.text != "";
                    activated => { input.cut(); }
                }
                MenuItem {
                    title: "Copy";
                    enabled: input.text != "";
                    activated => { input.copy(); }
                }
                MenuItem {
                    title: "Paste";
                    enabled: root.enabled;
                    activated => { input.paste(); }
                }
                MenuItem {
                    title: "Select all";
                    enabled: input.text != "";
                    activated => { input.select-all(); }
                }
            }
            Rectangle {
                clip: true;
                input := TextInput {
                    enabled: root.enabled;
                    color: Theme.menu-text;
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    height: 100%;
                    single-line: true;
                    input-type: root.password ? InputType.password : InputType.text;
                    accepted => { root.accepted(); }
                    edited => { root.edited(); }
                }
                if input.text == "" : Text {
                    text: root.placeholder;
                    color: Theme.menu-text.with-alpha(0.4);
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    height: 100%;
                }
            }
        }
    }
    // RecoveryPage.qml:47-54: a 22×22 PanelActionButton 6 in from the right,
    // eye when revealed, eyeOff when hidden, fg@0.7.
    if root.reveal-toggle : ActionButton {
        x: root.width - 6px - self.width;
        y: (root.height - self.height) / 2;
        width: 22px; height: 22px;
        icon: root.reveal ? Icons.eye : Icons.eyeOff;
        foreground: Theme.menu-text.with-alpha(0.7);
        clicked => { root.reveal = !root.reveal; }
    }
}


// A tap surface that also recognises a hold. Inner media areas use this so
// long-press opens the message menu from anywhere on a bubble, as in QML.
export component HoldArea inherits TouchArea {
    callback held;
    /// The press has outlasted a tap (160ms of the 500) and is probably a
    /// hold: whoever answers `held` can prepare for it now. Not on the down
    /// itself, so a plain tap costs nothing.
    callback hold-started;
    in-out property <bool> fired: false;
    hold-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.fired = true;
            root.held();
        }
    }
    warm-timer := Timer {
        interval: 160ms;
        running: false;
        triggered => { self.running = false; root.hold-started(); }
    }
    pointer-event(ev) => {
        if (ev.kind == PointerEventKind.down) {
            root.fired = false;
            hold-timer.running = true;
            warm-timer.running = true;
        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
            hold-timer.running = false;
            warm-timer.running = false;
        }
    }
    moved => {
        if (abs((self.mouse-x - self.pressed-x) / 1px) > 12 || abs((self.mouse-y - self.pressed-y) / 1px) > 12) {
            hold-timer.running = false;
            warm-timer.running = false;
        }
    }
}
