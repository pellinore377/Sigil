// The one emoji picker (components/EmojiPicker.qml): the reaction drawer and
// the attachment sheet both host this, so they cannot drift apart. The emoji
// data arrives pre-chunked into rows of 8 from the bridge (QML loads
// /usr/share/omarchy/shell/plugins/emojis/emojis.json — see WIRING-chat.md);
// a flat `for` over ~1800 glyphs would defeat ListView virtualisation.

import { TouchList } from "furniture.slint";
import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";
import { EmojiItem } from "model.slint";

export component EmojiPicker inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <color> chip: Theme.background.with-alpha(0.85);
    /// Rows of up to 8; filtered by the bridge when `search-edited` fires.
    in property <[[EmojiItem]]> rows;
    /// Category jump targets: the ROW index each category starts at.
    in property <[string]> cat-icons: ["😀", "👋", "🐵", "🍇", "🌍", "🎃", "👓", "🏧", "🏁"];
    in property <[int]> cat-rows;
    callback picked(string);
    callback search-edited(string);

    background: transparent;

    // EmojiPicker.qml:89-99 curCat: the row under the top edge (+10), and
    // the last category starting at or before it. -1 while searching; the
    // categories are ordered, so the index is a count of those passed.
    property <float> cur-row: floor((-grid.viewport-y + 10px) / 44px);
    property <bool> searching: search-input.text != "";
    property <int> cur-cat: root.searching || root.cat-rows.length == 0 ? -1
        : (root.cat-rows.length > 1 && root.cat-rows[1] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 2 && root.cat-rows[2] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 3 && root.cat-rows[3] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 4 && root.cat-rows[4] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 5 && root.cat-rows[5] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 6 && root.cat-rows[6] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 7 && root.cat-rows[7] <= root.cur-row ? 1 : 0)
        + (root.cat-rows.length > 8 && root.cat-rows[8] <= root.cur-row ? 1 : 0);

    /// EmojiPicker.qml:37 reset(): the attachment sheet clears the search on close.
    public function reset() {
        if (search-input.text != "") { search-input.text = ""; root.search-edited(""); }
    }

    // EmojiPicker.qml:45-48: a Column of search / grid / strip at spacing 8;
    // the grid is parent − 86 (:70), so 4px of slack sit under the strip.
    VerticalLayout {
        spacing: 8px;
        alignment: start;

        // Search well
        search-well := Rectangle {
            height: 34px;
            border-radius: 17px;
            background: root.chip;
            HorizontalLayout {
                padding-left: 12px; padding-right: 10px;
                spacing: 8px;
                IconLabel {
                    text: Icons.search;
                    color: root.fg.with-alpha(0.5);
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                }
                Rectangle {
                    clip: true;
                    horizontal-stretch: 1;
                    search-input := TextInput {
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        vertical-alignment: center;
                        height: 100%; width: 100%;
                        single-line: true;
                        edited => { root.search-edited(self.text); }
                    }
                    if search-input.text == "" : Text {
                        text: "Search emoji";
                        color: root.fg.with-alpha(0.45);
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }
            }
        }

        grid := TouchList {
            height: max(0px, root.height - 86px);
            for row in root.rows : erow := Rectangle {
                height: 44px;
                HorizontalLayout {
                    for em in row : cell := Rectangle {
                        width: grid.width / 8;
                        // EmojiPicker.qml:80: the highlight is inset 2 with
                        // radius 8 — 40×40 inside the 44 cell.
                        Rectangle {
                            x: 2px; y: 2px;
                            width: cell.width - 4px; height: cell.height - 4px;
                            border-radius: 8px;
                            background: cell-t.pressed || cell-t.has-hover
                                ? root.accent.with-alpha(0.3) : transparent;
                        }
                        if em.has-img : Image {
                            source: em.img;
                            x: (cell.width - 26px) / 2; y: 9px; width: 26px; height: 26px;
                            image-fit: contain;
                        }
                        if !em.has-img : Text {
                            text: em.glyph;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                        cell-t := TouchArea { clicked => { root.picked(em.glyph); } }
                    }
                }
            }
        }

        // Category strip: tapping jumps the grid to that section.
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            for icon[ci] in root.cat-icons : cat-cell := Rectangle {
                width: 32px; height: 32px;
                border-radius: 10px;
                // EmojiPicker.qml:106-108: the shown category sits on the
                // accent; hover is the softer tint.
                background: root.cur-cat == ci ? root.accent
                    : cat-t.pressed || cat-t.has-hover ? root.accent.with-alpha(0.35) : transparent;
                Text {
                    text: icon;
                    font-size: 15px;
                    opacity: 0.9;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                cat-t := TouchArea {
                    // EmojiPicker.qml:110: the search clears before the jump.
                    clicked => {
                        root.reset();
                        if (ci < root.cat-rows.length) {
                            grid.viewport-y = -44px * root.cat-rows[ci];
                        }
                    }
                }
            }
        }
    }
}
