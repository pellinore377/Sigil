// Home: header + search + segmented tabs (Chats | Requests) + room list —
// mobile/HomePage.qml. Filtering and ordering stay in Rust: the engine already
// sorts rooms (pinned, highlights, unread, recency), and re-sorting in the view
// is how the QML side ended up owning a copy of that rule.
//
// Not ported: the "Open as window" PanelActionButton (a desktop-panel
// affordance with no Android meaning).

import { TouchList } from "furniture.slint";
import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton, Avatar } from "components.slint";

import { RoomRow } from "model.slint";

// One conversation row in the platform messenger's shape (all dp): 78 tall,
// a 51 avatar at 16, the text column at 83, the time and mark right-aligned
// 24 in. Home and the phone's search share it; a request wears an outlined
// "Request" pill where the unread count would sit.
export component ChatRow inherits Rectangle {
    in property <string> name;
    in property <image> avatar;
    in property <string> initials;
    in property <color> tint;
    in property <string> preview;
    in property <string> preview-icon;
    in property <string> stamp;
    in property <string> badge;
    in property <bool> badge-urgent;
    in property <bool> unread;
    in property <bool> is-favourite;
    in property <bool> is-invite;
    in property <bool> is-typing;
    in property <bool> has-call;
    in property <string> draft;
    in property <color> accent-container;
    callback clicked;

    height: 78px;
    background: touch.pressed ? Theme.menu-text.with-alpha(0.08) : transparent;
    property <bool> loud: root.unread || (root.badge-urgent && !root.is-invite);
    property <bool> request: root.is-invite;
    property <string> line: root.draft != "" ? root.draft
        // rows.rs words a message-less request for the desktop card
        : root.request && root.preview == "Invitation — tap to respond" ? "Wants to chat"
        : root.preview;

    Avatar {
        x: 16px; y: (78px - self.size) / 2;
        size: 51px;
        source: root.avatar;
        initials: root.initials;
        tint: root.tint;
    }

    VerticalLayout {
        x: 83px;
        width: meta.x - 12px - 83px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.name;
            color: Theme.menu-text;
            font-family: Theme.font-ui;
            font-size: 16px;
            font-weight: root.loud ? 700 : 400;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            if root.draft != "" : Text {
                text: "Draft:";
                color: Theme.urgent;
                font-family: Theme.font-ui; font-size: 14px;
                font-italic: true;
            }
            if root.draft == "" && !root.request && root.preview-icon != "" : IconLabel {
                text: root.preview-icon;
                filled: true;
                font-size: 15px;
                color: root.has-call ? Theme.accent : root.loud ? Theme.menu-text : Theme.muted;
                vertical-alignment: center;
            }
            Text {
                text: root.line;
                color: root.request || root.is-typing || root.has-call ? Theme.accent
                     : root.loud ? Theme.menu-text : Theme.muted;
                font-family: Theme.font-ui;
                font-size: 14px;
                font-italic: root.draft != "";
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }

    // Time in the row's top third, the mark under it; the column is as wide
    // as its widest line and ends 24 before the row's edge.
    meta := Rectangle {
        x: root.width - 24px - self.width;
        width: max(stamp.preferred-width,
                   root.request ? pill.width : root.badge != "" ? badge.width
                   : root.is-favourite ? 14px : 0px);
        stamp := Text {
            x: meta.width - self.width;
            y: 19px; height: 16px;
            text: root.stamp;
            color: root.loud ? Theme.menu-text : Theme.muted;
            font-family: Theme.font-ui;
            font-size: 12px;
            vertical-alignment: center;
        }
        badge := Rectangle {
            visible: !root.request && root.badge != "";
            x: meta.width - self.width;
            y: 41px;
            width: max(20px, badge-text.preferred-width + 12px);
            height: 20px;
            border-radius: 10px;
            background: root.badge-urgent ? Theme.urgent : root.accent-container;
            badge-text := Text {
                text: root.badge;
                color: root.badge-urgent ? #ffffff : Theme.menu-text;
                font-family: Theme.font-ui;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
        IconLabel {
            visible: !root.request && root.badge == "" && root.is-favourite;
            x: meta.width - self.width;
            y: 41px; height: 20px;
            text: Icons.pin;
            filled: true;
            font-size: 14px;
            color: Theme.muted;
            vertical-alignment: center;
        }
        pill := Rectangle {
            visible: root.request;
            x: meta.width - self.width;
            y: 41px;
            width: pill-text.preferred-width + 12px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.popup-border;
            pill-text := Text {
                text: "Request";
                color: Theme.menu-text;
                font-family: Theme.font-ui;
                font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

export component HomePage inherits Rectangle {
    in property <[RoomRow]> rooms;
    in property <[RoomRow]> requests;
    // The phone's one list: chats and requests together, by time (bridge
    // rebuild_rooms); the desktop keeps its two tabs.
    in property <[RoomRow]> all-rooms;
    in property <string> my-initials;
    in property <image> my-avatar;
    in property <color> my-tint;
    in property <string> my-name;
    in property <string> my-user-id;
    in property <string> sync-line;   // non-empty: engine is catching up / erroring
    in property <bool> rooms-loaded;  // first rooms.list has arrived
    in-out property <int> tab: 0;     // 0 chats, 1 requests (desktop only)
    callback room-clicked(string);
    callback search-edited(string);
    callback open-search;             // the phone's search page
    callback new-chat;
    callback open-settings;
    callback sign-out;
    // Drawn in-page, not as a popup (HomePage.qml accountOpen).
    in-out property <bool> account-open: false;

    property <bool> chats-mode: root.tab == 0;
    // The phone is not the QML card: it is the platform's own conversation
    // list (flat bar, rounded sheet, extended FAB). The desktop tree below
    // stays as ported.
    property <bool> phone: Theme.mode != "desktop";

    background: root.phone ? Theme.background : Theme.card-ground;

    if !root.phone : desk := Rectangle {
    width: 100%; height: 100%;

    VerticalLayout {
        // Header
        header := Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 10px;
                Text {
                    text: "Sigil";
                    color: Theme.menu-text;
                    font-family: Theme.font-ui;
                    font-size: Theme.heading;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 36px;
                    // HomePage.qml:87-90: a 36×36 tap box with the avatar
                    // centred in it (anchors.centerIn).
                    Avatar {
                        x: (36px - self.size) / 2;
                        y: (parent.height - self.size) / 2;
                        size: 28px;
                        source: root.my-avatar;
                        initials: root.my-initials;
                        tint: root.my-tint;
                    }
                    TouchArea { clicked => { root.account-open = !root.account-open; } }
                }
            }
        }

        // Search pill
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                padding-top: 2px; padding-bottom: 8px;
                pill := Rectangle {
                    border-radius: self.height / 2;
                    background: Theme.menu-text.with-alpha(0.07);
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent.with-alpha(0.4) : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 12px;
                        spacing: 8px;
                        IconLabel {
                            text: Icons.search;
                            filled: true; font-size: Theme.icon-size;   // HomePage.qml:105
                            color: Theme.menu-text.with-alpha(0.5);
                            vertical-alignment: center;
                        }
                        input-holder := Rectangle {
                            clip: true;
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                color: Theme.menu-text;
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%; width: 100%;
                                single-line: true;
                                edited => { root.search-edited(self.text); }
                            }
                            if search-input.text == "" : Text {
                                text: root.tab == 0 ? "Search chats" : "Search requests";
                                color: Theme.menu-text.with-alpha(0.45);
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                    }
                }
            }
        }

        // Segmented tabs.
        Rectangle {
            height: 44px;
            seg := Rectangle {
                width: root.width - 28px;
                height: 34px;
                x: 14px;
                y: 5px;
                border-radius: self.height / 2;
                background: Theme.menu-text.with-alpha(0.06);
                thumb := Rectangle {
                    width: seg.width / 2 - 3px;
                    height: seg.height - 6px;
                    border-radius: self.height / 2;
                    x: 3px + (root.tab == 0 ? 0px : seg.width / 2);
                    y: 3px;
                    background: Theme.accent.with-alpha(0.22);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.35);
                    // OutCubic, from the engine's easing table
                    animate x { duration: 160ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                }
                HorizontalLayout {
                    tab0 := Rectangle {
                        Text {
                            text: "Chats";
                            color: root.tab == 0 ? Theme.menu-text : Theme.menu-text.with-alpha(0.55);
                            font-family: Theme.font-ui;
                            font-size: Theme.body;
                            font-weight: root.tab == 0 ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                        TouchArea { clicked => { root.tab = 0; } }
                    }
                    tab1 := Rectangle {
                        Text {
                            text: root.requests.length > 0 ? "Requests (\{root.requests.length})" : "Requests";
                            color: root.tab == 1 ? Theme.menu-text : Theme.menu-text.with-alpha(0.55);
                            font-family: Theme.font-ui;
                            font-size: Theme.body;
                            font-weight: root.tab == 1 ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                        TouchArea { clicked => { root.tab = 1; } }
                    }
                }
            }
        }

        // The sync strip is the card's, above every page (app.slint status-strip,
        // Panel.qml:491-501); `sync-line` stays bound for the bridge.

        // Empty states name their emptiness: "no rooms" is a fact about the
        // account, "looking" is a fact about us (ui-conventions.md).
        if (root.chats-mode ? root.rooms.length : root.requests.length) == 0 : Rectangle {
            vertical-stretch: 1;
            Text {
                text: !root.rooms-loaded ? "Looking for your chats…"
                    : root.chats-mode ? "No chats yet" : "No requests";
                color: Theme.menu-text.with-alpha(0.5);
                font-family: Theme.font-ui;
                font-size: Theme.body;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }

        // Room list; a request is a row like any other, its badge says "!"
        list := TouchList {
            vertical-stretch: 1;
            // HomePage.qml:174 onMovementStarted: any move the glide did not
            // write itself is the finger, and ends the glide.
            changed viewport-y => {
                if (desk.returning && self.viewport-y != desk.glide-wrote) { desk.returning = false; }
            }

            for room in (root.chats-mode ? root.rooms : root.requests) : rrow := Rectangle {
                height: 64px;
                Rectangle {
                    x: 8px; width: rrow.width - 16px;
                    y: 4px; height: rrow.height - 8px;
                    border-radius: 14px;
                    // HomePage.qml:199: hover only, fg@0.05; no pressed face.
                    background: row-touch.has-hover ? Theme.menu-text.with-alpha(0.05) : transparent;
                }

                HorizontalLayout {
                    // HomePage.qml:200-205,272: avatar at leftMargin 16, the
                    // text column 12 after it and ending 8 before the meta
                    // column, which sits at rightMargin 16. The two gaps
                    // differ, so they are paddings on the text column, not
                    // one layout spacing.
                    padding-left: 16px; padding-right: 16px;
                    spacing: 0;
                    Rectangle {
                        width: 44px;
                        Avatar {
                            // anchors.verticalCenter (HomePage.qml:200)
                            y: (rrow.height - self.height) / 2;
                            size: 44px;
                            source: room.avatar;
                            initials: room.initials;
                            tint: room.tint;
                        }
                    }
                    // name + flags | preview
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        padding-left: 12px; padding-right: 8px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 5px;
                            name-text := Text {
                                text: room.name;
                                color: Theme.menu-text;
                                font-family: Theme.font-ui;
                                font-size: Theme.subtitle;
                                // HomePage.qml:208: bold on unread OR
                                // highlights. The bridge folds only the unread
                                // counts into `unread`; an urgent badge on a
                                // non-invite row is exactly "highlights > 0".
                                font-weight: room.unread || (room.badge-urgent && !room.is-invite) ? 700 : 400;
                                overflow: elide;
                            }
                            if room.is-encrypted : IconLabel {
                                text: Icons.lock;
                                filled: true;   // HomePage.qml:209
                                font-size: Theme.caption;
                                color: Theme.menu-text.with-alpha(0.35);
                                vertical-alignment: center;
                            }
                            if room.has-call : IconLabel {
                                text: Icons.phone;
                                filled: true;   // HomePage.qml:210
                                font-size: Theme.caption;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        // Preview: an unsent message is marked with a red "Draft:".
                        preview-line := HorizontalLayout {
                            alignment: start;
                            spacing: 4px;   // HomePage.qml:213
                            if room.draft != "" : Text {
                                text: "Draft:";
                                color: Theme.urgent;
                                font-family: Theme.font-ui; font-size: Theme.body-small;
                                font-italic: true;
                            }
                            // HomePage.qml:245: the mark carries rightPadding 4
                            // on top of the row spacing, so mark→text is 8
                            // while Draft:→text stays 4.
                            if room.draft == "" && room.preview-icon != "" : HorizontalLayout {
                                padding-right: 4px;
                                IconLabel {
                                    text: room.preview-icon;
                                    filled: true;   // HomePage.qml:244 Fonts.iconFilled
                                    font-size: Theme.body-small;
                                    color: room.has-call ? Theme.accent
                                         : Theme.menu-text.with-alpha(room.unread ? 0.8 : 0.55);
                                    vertical-alignment: center;
                                }
                            }
                            preview-text := Text {
                                text: room.draft != "" ? room.draft : room.preview;
                                color: room.is-typing ? Theme.accent
                                     : room.has-call ? Theme.accent
                                     : Theme.menu-text.with-alpha(room.unread ? 0.8 : 0.55);
                                font-family: Theme.font-ui;
                                font-size: Theme.body-small;
                                font-italic: room.draft != "";
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    // stamp | badge + pin
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        if room.stamp != "" : Text {
                            text: room.stamp;
                            color: room.unread ? Theme.accent : Theme.menu-text.with-alpha(0.45);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            horizontal-alignment: right;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 5px;
                            if room.badge != "" : Rectangle {
                                width: max(19px, badge-text.preferred-width + 10px);
                                height: 19px;
                                border-radius: self.height / 2;
                                background: room.badge-urgent ? Theme.urgent : Theme.accent.with-alpha(0.9);
                                badge-text := Text {
                                    text: room.badge;
                                    color: Theme.background;
                                    font-family: Theme.font-ui;
                                    font-size: Theme.caption;
                                    font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            if room.is-favourite : IconLabel {
                                text: Icons.pin;
                                filled: true;   // HomePage.qml:302 Fonts.iconFilled
                                font-size: Theme.caption;
                                color: Theme.menu-text.with-alpha(0.55);
                            }
                        }
                    }
                }

                row-touch := TouchArea { clicked => { root.room-clicked(room.id); } }
            }
        }
    }

    // New-chat FAB (bottom-right).
    fab := Rectangle {
        x: root.width - self.width - 14px;
        y: root.height - self.height - 14px;
        width: 48px; height: 48px;
        border-radius: 16px;
        background: Theme.accent.with-alpha(0.9);   // HomePage.qml:186: constant, no pressed face
        IconLabel {
            text: Icons.plus;
            filled: true;   // HomePage.qml:187
            color: Theme.background;
            font-size: Theme.icon-large;
            width: 100%; height: 100%;
        }
        fab-touch := TouchArea { clicked => { root.new-chat(); } }
    }

    // The glide back to the top — HomePage.qml:444-453. The QML FrameAnimation
    // is a per-frame exponential decay (k = 1 - 0.0001^dt: 63% of the way in
    // ~0.11 s, 95% in ~0.33 s); ease-out-expo over 300ms traces that curve.
    // The viewport is driven from a helper because a binding on viewport-y
    // would be dropped by the first finger flick. `glide-t` is reset with a
    // 0ms duration (an instant set) before the 300ms run so every tap starts
    // from wherever the list is now.
    property <bool> returning: false;
    property <length> glide-from;
    property <length> glide-wrote;
    property <float> glide-t: 1.0;
    animate glide-t { duration: desk.returning ? 300ms : 0ms; easing: ease-out-expo; }
    changed glide-t => {
        if (desk.returning) {
            desk.glide-wrote = desk.glide-from * (1.0 - desk.glide-t);
            list.viewport-y = desk.glide-wrote;
            if (desk.glide-t >= 1.0) { desk.returning = false; }
        }
    }
    function return-to-top() {
        desk.returning = false;
        desk.glide-t = 0.0;
        desk.glide-from = list.viewport-y;
        desk.glide-wrote = list.viewport-y;
        desk.returning = true;
        desk.glide-t = 1.0;
    }

    // Scroll-to-top: bottom-centred once the list has run 3/4 of a screen
    // (HomePage.qml:455-472). Two curves, as in the QML: scale pops with
    // OutBack overshoot 2.2 over 220ms (:468), opacity fades linearly over
    // 140ms (:469); shown while scale > 0.01 (:459).
    top-layer := Rectangle {
        property <bool> shown: list.viewport-y < -(list.height * 0.75);
        property <float> pop: self.shown ? 1.0 : 0.0;
        property <float> fade: self.shown ? 1.0 : 0.0;
        // OutBack with overshoot 2.2, from the engine's easing table
        animate pop { duration: 220ms; easing: cubic-bezier(0.34, 1.8, 0.64, 1); }
        animate fade { duration: 140ms; }
        visible: self.pop > 0.01;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 18px;
        width: 38px; height: 38px; border-radius: 19px;
        opacity: self.fade;
        transform-scale-x: max(0.01, self.pop);
        transform-scale-y: max(0.01, self.pop);
        background: Theme.popup-background;
        IconLabel {
            text: Icons.arrowUp;
            filled: true; font-size: Theme.icon-size;   // HomePage.qml:470
            color: Theme.menu-text;
            width: 100%; height: 100%;
        }
        TouchArea { clicked => { desk.return-to-top(); } }
    }
    }   // desk

    if root.phone : phone-tree := Rectangle {
        width: 100%; height: 100%;
        // Material's tonal containers, from the accent: a dark, muted tone
        // under the night palette, a pale wash under the day one.
        property <color> accent-container: Theme.mode == "dark"
            ? Theme.accent.mix(Theme.background, 0.42)
            : Theme.accent.mix(Theme.background, 0.22);

        VerticalLayout {
            // App bar, flat on the window ground: 60 tall, the title at 16,
            // the search glyph's centre 88 and the avatar's 32 from the right.
            Rectangle {
                height: 60px;
                Text {
                    x: 16px;
                    height: 100%;
                    text: "Sigil";
                    color: Theme.menu-text;
                    font-family: Theme.font-ui;
                    font-size: 22px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: parent.width - 88px - 24px; y: 6px;
                    width: 48px; height: 48px;
                    border-radius: 24px;
                    background: search-btn.pressed ? Theme.menu-text.with-alpha(0.10)
                              : search-btn.has-hover ? Theme.menu-text.with-alpha(0.06) : transparent;
                    IconLabel {
                        text: Icons.search;
                        font-size: 24px;
                        color: Theme.menu-text;
                        width: 100%; height: 100%;
                    }
                    search-btn := TouchArea { clicked => { root.open-search(); } }
                }
                Rectangle {
                    x: parent.width - 32px - 24px; y: 6px;
                    width: 48px; height: 48px;
                    Avatar {
                        x: 8px; y: 8px;
                        size: 32px;
                        source: root.my-avatar;
                        initials: root.my-initials;
                        tint: root.my-tint;
                    }
                    TouchArea { clicked => { root.account-open = !root.account-open; } }
                }
            }

            // The sheet: one step lighter than the window, rounded at the top,
            // straight under the bar and down to the page bottom.
            sheet := Rectangle {
                vertical-stretch: 1;
                background: Theme.card-ground;
                border-top-left-radius: 28px;
                border-top-right-radius: 28px;
                clip: true;

                if root.all-rooms.length == 0 : Text {
                    text: !root.rooms-loaded ? "Looking for your chats…" : "No chats yet";
                    color: Theme.muted;
                    font-family: Theme.font-ui;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%; height: 100%;
                }

                phone-list := TouchList {
                    width: 100%; height: 100%;
                    Rectangle { height: 8px; }
                    for room in root.all-rooms : ChatRow {
                        name: room.name; avatar: room.avatar; initials: room.initials; tint: room.tint;
                        preview: room.preview; preview-icon: room.preview-icon; stamp: room.stamp;
                        badge: room.badge; badge-urgent: room.badge-urgent; unread: room.unread;
                        is-favourite: room.is-favourite; is-invite: room.is-invite;
                        is-typing: room.is-typing; has-call: room.has-call; draft: room.draft;
                        accent-container: phone-tree.accent-container;
                        clicked => { root.room-clicked(room.id); }
                    }
                    // room for the FAB past the last row
                    Rectangle { height: 96px; }
                }
            }
        }

        // Extended FAB: "Start chat".
        phone-fab := Rectangle {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 24px;
            width: fab-row.preferred-width;
            height: 56px;
            border-radius: 28px;
            background: phone-fab-touch.pressed ? phone-tree.accent-container.brighter(0.15)
                      : phone-tree.accent-container;
            drop-shadow-color: #00000055;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            fab-row := HorizontalLayout {
                padding-left: 16px; padding-right: 20px;
                spacing: 12px;
                IconLabel {
                    text: Icons.chat;
                    font-size: 24px;
                    color: Theme.menu-text;
                    vertical-alignment: center;
                }
                Text {
                    text: "Start chat";
                    color: Theme.menu-text;
                    font-family: Theme.font-ui;
                    font-size: 14px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            phone-fab-touch := TouchArea { clicked => { root.new-chat(); } }
        }
    }

    // Account menu: a page-level tap-away layer with NO scrim (HomePage.qml:
    // 396-401 is a bare MouseArea) and the card below the header. Two curves,
    // as in the QML: opacity fades over 120ms linear (:419); scale grows
    // 0.94→1 over 140ms OutCubic about the top-right corner (:408-409, :420).
    account-layer := Rectangle {
        property <float> show: root.account-open ? 1.0 : 0.0;
        property <float> grow: root.account-open ? 1.0 : 0.0;
        animate show { duration: 120ms; }
        // OutCubic, from the engine's easing table
        animate grow { duration: 140ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: root.account-open || self.show > 0.01;
        opacity: self.show;
        width: 100%; height: 100%;
        background: transparent;
        TouchArea { clicked => { root.account-open = false; } }
        menu-card := Rectangle {
            // under the bar's avatar on either layout
            x: root.width - self.width - (root.phone ? 16px : 12px);
            y: root.phone ? 52px : 48px;
            transform-origin: { x: self.width, y: 0px };
            transform-scale-x: 0.94 + 0.06 * account-layer.grow;
            transform-scale-y: 0.94 + 0.06 * account-layer.grow;
            width: 230px;
            height: card-col.preferred-height + 20px;
            border-radius: 14px;
            background: Theme.popup-background.with-alpha(0.98);
            card-col := VerticalLayout {
                x: 10px; y: 10px;
                width: menu-card.width - 20px;
                spacing: 4px;
                Text {
                    text: root.my-name;
                    color: Theme.popup-text;
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.my-user-id;
                    color: Theme.popup-text.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    overflow: elide;
                }
                Rectangle { height: 4px; }
                Rectangle { height: 1px; background: Theme.popup-text.with-alpha(0.1); }
                Rectangle { height: 4px; }
                // Settings live in the app here; on the desktop QML they were
                // the shell's. Same row shape as Sign out below.
                mi-settings := Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: mi-settings-t.pressed || mi-settings-t.has-hover ? Theme.popup-text.with-alpha(0.1) : transparent;
                    IconLabel {
                        x: 8px;
                        y: (30px - self.preferred-height) / 2;
                        text: Icons.settings;
                        filled: true; font-size: Theme.icon-size;   // no QML twin; same row as HomePage.qml:437
                        color: Theme.popup-text;
                        opacity: 0.85;
                    }
                    Text {
                        x: 34px;
                        text: "Settings";
                        color: Theme.popup-text;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    mi-settings-t := TouchArea { clicked => { root.account-open = false; root.open-settings(); } }
                }
                mi-out := Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: mi-out-t.pressed || mi-out-t.has-hover ? Theme.popup-text.with-alpha(0.1) : transparent;
                    IconLabel {
                        x: 8px;
                        y: (30px - self.preferred-height) / 2;
                        text: Icons.logout;
                        filled: true; font-size: Theme.icon-size;   // HomePage.qml:437
                        color: Theme.urgent;
                        opacity: 0.85;
                    }
                    Text {
                        x: 34px;
                        text: "Sign out";
                        color: Theme.urgent;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    mi-out-t := TouchArea { clicked => { root.account-open = false; root.sign-out(); } }
                }
            }
        }
    }
}
