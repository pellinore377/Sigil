// Voice recorder — VoiceRecorder.qml verbatim: an inline panel under the
// composer. Three states: idle (a large waveform + caption), recording
// (blinking dot + zero-padded timer over a live level band), ready (the clip's
// waveform + duration). Controls: three equal pills under the card.
// The root is transparent (VoiceRecorder.qml:7): the conversation ground
// stands behind the card and around the pills, and nothing is painted under
// the gesture bar — the page and the window own that strip.
//
// The phone's is the platform messenger's, measured off it at density 408
// (1dp = 2.537px):
//
//   card      inset 8 from the sides, 300 tall, radius 24, its own OPAQUE
//             ground a step LIGHTER than the page — an elevated surface,
//             not a window onto the chat. Its content (illustration over
//             caption) is centred: 52 clear above, 54 below.
//   gap       8 between the card and the pill row
//   pills     56 tall, fully rounded, THREE EQUAL widths (166 each on this
//             screen) with 8 between them and 8 to the sides. Cancel and
//             Attach are filled tonal pills on the page ground (measured
//             #2B2A28 against a #141311 page — filled, not outlined); the
//             mic is the accent container, the same width as the others.
//   below     44 clear under the pills, so the gesture bar has its own room.
//
// An earlier pass painted every surface here with the conversation's own
// colour at the composer band's alpha, which made the card vanish into the
// chat and left the pills as bare outlines. `ground` is the page ground the
// panel SITS ON now — opaque — and `panel-surface` is the step above it that
// the card and the side pills wear.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";

export component VoiceRecorder inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    // ChatPage.qml hands the recorder themedSend: accent@0.9 unthemed (:45, :1836).
    in property <color> accent: Theme.accent.with-alpha(0.9);
    in property <color> surface: Theme.menu-text.with-alpha(0.07);
    /// The conversation's own ground, OPAQUE: the page the panel sits on, and
    /// the base every surface here is derived from. It must carry no alpha —
    /// the card and the pills are lifts off it, and a translucent lift would
    /// let the timeline through the card again (ChatPage hands this down).
    in property <color> ground: Theme.menu-background.darker(0.35);
    // deepChipC ≈ rgba(36,36,36,0.96) (ChatPage.qml:56-59, :1839).
    in property <color> chip: Theme.menu-background.darker(1.1).with-alpha(0.96);
    /// The room wears a chat theme. The grounds no longer branch on it:
    /// `ground` already carries the room's tone, since the conversation ground
    /// it comes from is the themed one.
    in property <bool> themed: false;
    in property <string> state: "idle";      // idle | recording | ready
    in property <float> elapsed: 0;          // seconds, ticked by Rust
    in property <float> clip-duration: 0;
    in property <[float]> levels;            // rolling last 60 while recording
    in property <[float]> clip-waveform;     // from voice.stop's reply

    callback record;
    callback stop;
    callback restart;
    callback attach;
    callback cancelled;

    property <bool> phone: Theme.mode != "desktop";
    // The card ink: the QML flips to dark on light theme tints; Frosted Glass
    // stays dark, so fg stands in until chat themes reach the recorder.
    property <color> ink: root.fg;
    property <color> pill-c: root.chip;
    /// One step off the page ground, opaque: the card, and the two side pills.
    /// The reference lifts its dark page #141311 to #272623 for the card and
    /// #2B2A28 for the pills — a hair under 8% of the ink, and a difference of
    /// four counts between them, so one tone carries both here.
    ///
    /// Lifting toward the ink is what "elevated" means on a dark ground; on
    /// the light palette the conversation ground is already the *dimmer*
    /// surface (card-ground #f4f0f4 under a #fdf8fd window), so there the card
    /// rises toward white instead and lands clear of the page just the same.
    property <color> panel-surface: Theme.mode == "light"
        ? root.ground.with-alpha(1.0).mix(#ffffff, 0.25)
        : root.ground.with-alpha(1.0).mix(Theme.menu-text, 0.90);
    property <color> sheet-c: root.phone ? root.panel-surface : root.surface;
    // The phone's accent container: the room accent sunk into the ground.
    // The mic pill wears the platform messenger's accent tint: a light wash of
    // the accent over dark palettes, a sunk one over light.
    property <color> accent-container: Theme.mode == "light" ? root.accent.with-alpha(1.0).mix(Theme.background, 0.22) : root.accent.with-alpha(1.0).mix(#ffffff, 0.45);
    property <bool> recording: root.state == "recording";
    property <float> shown: root.recording ? root.elapsed : root.clip-duration;
    property <string> timer-text:
        (floor(root.shown / 60) < 10 ? "0" : "") + floor(root.shown / 60)
        + ":" + (mod(floor(root.shown), 60) < 10 ? "0" : "") + mod(floor(root.shown), 60);

    // The card's illustration: the app ships no picture, so the waveform the
    // recorder already draws stands in for one, at the size the reference
    // gives its drawing rather than at glyph size.
    /// The idle card's illustration. It is a PICTURE, not a reading, so it is
    /// the one thing here that scales with the card: under a short keyboard
    /// the card comes down and a 150 drawing over its caption would spill out
    /// of the card onto the pills. (The level band below does not scale — that
    /// one is a reading, and the reference keeps it.) 76 is the caption, the
    /// 20 above it and the air the card wants around the block.
    property <length> wave-h: root.phone ? clamp(root.card-h - 76px, 40px, 150px) : 46px;
    property <length> wave-w: root.phone ? 12px : 5px;
    property <length> band-h: root.phone ? 120px : 48px;
    property <length> dot: root.phone ? 12px : 9px;
    /// The gesture bar's height, handed in by the page: the pills stand
    /// 28 above it, and the panel's ground runs on under it.
    in property <length> bottom-inset: 0px;
    // 8 under the card, 28 under the pills, then the gesture bar's own room.
    property <length> pad-bottom: root.phone ? 28px + root.bottom-inset : 10px;
    /// The phone's three pills are EQUAL, so the width is arithmetic, not a
    /// stretch factor: a box layout hands each child its preferred width first
    /// and only then splits what is left by stretch, and "Cancel" and "Attach"
    /// prefer far more than a bare glyph does — which is how the mic ended up
    /// the narrowest of the three. 8 of padding a side, 8 in each of the two
    /// gaps, the rest in thirds. (166 on a 530-wide screen; the reference's is
    /// 166 too.)
    property <length> pill-w: (root.width - 16px - 16px) / 3;

    /// The height the page wants this panel to be: the remembered keyboard's,
    /// so switching between the keyboard and this panel never moves the
    /// composer above it (chat.slint's `kb-h`). Zero means "your natural size"
    /// — the desktop, and any host that does not measure a keyboard.
    in property <length> avail: 0px;
    /// What the card cannot go below: the recording state's own block, which
    /// is the tallest thing that has to fit in it — the 28pt timer's line
    /// (~36), the 22 under it and the 120 level band. The band and the pills
    /// keep their sizes whatever happens; the card is what gives, and this is
    /// where it stops giving.
    ///
    /// Exactly that block and not a pixel of spare air, because the spare air
    /// cost more than it bought: at 184 the panel's floor came to 308 on a
    /// phone whose keyboard is 306 over a 24 bar, so the recorder could not be
    /// the keyboard's height, the keyboard never covered it, and swapping back
    /// to the keyboard sat through the handover's give-up timer before the
    /// panel would go. 178 clears it.
    property <length> card-min: root.phone ? 178px : 90px;
    /// What the card actually gets: the panel less everything fixed above and
    /// below it. Taken from the panel's own height rather than from the card's
    /// laid-out height — a size read back out of the layout and fed to a child
    /// of that layout is a loop.
    property <length> card-h: max(0px, root.height - (root.phone
        ? 8px + 8px + 56px + root.pad-bottom
        : 10px + 10px + 46px + root.pad-bottom));
    /// The floor under what the page asks for: 8 above the card, a card that
    /// can still hold the take, 8, the 56 pill row, and the 28 plus the
    /// gesture bar under it. A keyboard shorter than this — no phone's is —
    /// simply leaves the panel standing a little taller than the keyboard.
    out property <length> min-h: root.phone
        ? 8px + root.card-min + 8px + 56px + root.pad-bottom
        // The desktop has no keyboard to match and nothing asks it to give.
        : root.natural-h;
    // The natural size, when nothing is asked for: 8 + 300 + 8 + 56 + 28 on
    // the phone, plus the gesture bar.
    property <length> natural-h: root.phone ? 400px + root.bottom-inset : 230px;
    // The card is the only thing in the column with a stretch, so shortening
    // the panel shortens the card and nothing else: the pills and the band
    // keep their sizes, as the reference's do.
    height: root.avail > 0px ? max(root.min-h, root.avail) : root.natural-h;
    background: transparent;

    VerticalLayout {
        padding-left: root.phone ? 8px : 10px;
        padding-right: root.phone ? 8px : 10px;
        // The reference leaves 16 between the composer's well and the card,
        // and the composer's own band already spends ~8 of that below the
        // well, so 8 here lands it. (Were ChatPage ever to hand the composer
        // a gesture inset — it binds none today — that band would grow and
        // this would want to shrink again.)
        padding-top: root.phone ? 8px : 10px;
        padding-bottom: root.pad-bottom;
        spacing: root.phone ? 8px : 10px;

        // The card: opaque, a step lighter than the page it sits on.
        stage := Rectangle {
            vertical-stretch: 1;
            border-radius: root.phone ? 24px : 18px;
            background: root.sheet-c;

            // idle: the standing waveform over the caption, as a block,
            // centred in the card.
            if root.state == "idle" : VerticalLayout {
                alignment: center;
                spacing: root.phone ? 20px : 10px;
                // Each bar is centred in its own column so the layout cannot
                // pin it to the top.
                idle-wave := HorizontalLayout {
                    alignment: center;
                    spacing: root.phone ? 11px : 4px;
                    height: root.wave-h;
                    for lvl in [0.35, 0.6, 0.85, 1.0, 0.8, 0.5, 0.3] : Rectangle {
                        width: root.wave-w; height: root.wave-h;
                        Rectangle {
                            x: 0; y: (root.wave-h - self.height) / 2;
                            width: root.wave-w;
                            height: max(root.wave-w, root.wave-h * lvl);
                            border-radius: root.wave-w / 2;
                            background: root.ink.with-alpha(root.phone ? 0.5 : 0.55);
                        }
                    }
                }
                Text {
                    text: "Tap to record your voice";
                    color: root.phone ? root.ink : root.ink.with-alpha(0.8);
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    horizontal-alignment: center;
                }
            }

            // recording / ready: dot + timer stacked above the level band,
            // in a column `parent - 28` wide (VoiceRecorder.qml:124) — the same
            // block, the same card, centred the same way.
            if root.state != "idle" : VerticalLayout {
                x: 14px;
                width: stage.width - 28px;
                alignment: center;
                spacing: root.phone ? 22px : 14px;
                HorizontalLayout {
                    alignment: center;
                    spacing: root.phone ? 10px : 7px;
                    if root.recording : Rectangle {
                        width: root.dot;
                        rec-dot := Rectangle {
                            x: 0; y: (parent.height - root.dot) / 2;
                            width: root.dot; height: root.dot;
                            border-radius: root.dot / 2;
                            background: #e88b90;
                            // Linear to 0.25 over 700ms, back to 1 over 700ms (:135).
                            property <float> t: (animation-tick() / 1400ms).mod(1.0);
                            opacity: self.t < 0.5 ? 1 - 0.75 * (self.t / 0.5)
                                                  : 0.25 + 0.75 * ((self.t - 0.5) / 0.5);
                        }
                    }
                    timer-line := Text {
                        text: root.timer-text;
                        color: root.ink;
                        font-family: Theme.font-ui;
                        font-size: root.phone ? Theme.display : Theme.title;
                        vertical-alignment: center;
                    }
                }
                band := Rectangle {
                    height: root.band-h;
                    bars := HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        for level in (root.recording ? root.levels : root.clip-waveform) : Rectangle {
                            width: 3px; height: root.band-h;
                            Rectangle {
                                x: 0; y: (root.band-h - self.height) / 2;
                                width: 3px;
                                height: max(3px, (root.band-h - 4px) * min(1.0, level));
                                border-radius: 1.5px;
                                background: root.ink.with-alpha(0.8);
                            }
                        }
                    }
                }
            }
        }

        // Controls: Restart/Cancel · record/stop · Attach. The phone pins all
        // three to `pill-w` so they come out equal whatever the words inside
        // them are; the desktop keeps its 120px centre pill between two
        // content-sized sides.
        controls := HorizontalLayout {
            height: root.phone ? 56px : 46px;
            spacing: 8px;
            cancel-b := Rectangle {
                min-width: root.phone ? root.pill-w : 0px;
                max-width: root.phone ? root.pill-w : 100000px;
                horizontal-stretch: 1;
                border-radius: root.phone ? 28px : 23px;
                // A filled tonal pill on the page ground, like the card: the
                // reference's side pills carry no outline at all.
                background: root.phone ? root.panel-surface : root.pill-c;
                HorizontalLayout {
                    alignment: center;
                    // QML's fitWidth icon boxes hug the glyph at spacing 6; a
                    // Slint glyph cell is wider, so 4 lands the same gap.
                    spacing: root.phone ? 8px : 4px;
                    IconLabel {
                        text: root.recording ? Icons.refresh : Icons.close;
                        font-size: root.phone ? 20px : Theme.icon-size;   // VoiceRecorder.qml:178
                        color: root.phone ? root.accent : root.fg; vertical-alignment: center;
                    }
                    Text {
                        text: root.recording ? "Restart" : "Cancel";
                        color: root.phone ? root.accent : root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }
                cancel-t := TouchArea { clicked => {
                    if (root.recording) { root.restart(); }
                    else { root.cancelled(); }
                } }
            }
            mic-b := Rectangle {
                // 120 on the desktop; the phone takes an equal third.
                min-width: root.phone ? root.pill-w : 120px;
                max-width: root.phone ? root.pill-w : 120px;
                horizontal-stretch: 1;
                border-radius: root.phone ? 28px : 23px;
                background: root.phone
                    ? (root.recording ? Theme.urgent : root.accent-container)
                    : root.recording ? Theme.urgent.brighter(0.25) : root.accent.brighter(0.3);
                IconLabel {
                    text: root.recording ? Icons.stop : Icons.record;
                    filled: true;   // VoiceRecorder.qml:194
                    color: root.phone ? (Theme.mode == "light" ? root.ink : #1b1b1f) : Theme.background;
                    font-size: root.phone ? 24px : 22px;
                    width: 100%; height: 100%;
                }
                mic-t := TouchArea { clicked => {
                    if (root.recording) { root.stop(); }
                    else if (root.state == "ready") { root.restart(); }
                    else { root.record(); }
                } }
            }
            attach-b := Rectangle {
                min-width: root.phone ? root.pill-w : 0px;
                max-width: root.phone ? root.pill-w : 100000px;
                horizontal-stretch: 1;
                border-radius: root.phone ? 28px : 23px;
                // Idle means nothing to attach yet. The reference dims only
                // the LABEL for that (#292826 against Cancel's #2B2A28 is all
                // its container gives up, while the check and the word drop to
                // about 0.45); dimming the whole pill sank it back into the
                // page, which is the opposite of what the row is for.
                opacity: root.phone ? 1.0 : root.state == "idle" ? 0.6 : 1;
                background: root.phone ? root.panel-surface
                          : root.state == "idle" ? root.pill-c : root.accent.brighter(0.3);
                HorizontalLayout {
                    alignment: center;
                    opacity: root.phone && root.state == "idle" ? 0.45 : 1.0;
                    spacing: root.phone ? 8px : 4px;
                    IconLabel {
                        text: Icons.check; font-size: root.phone ? 20px : Theme.icon-size;   // VoiceRecorder.qml:214
                        color: root.phone ? root.accent : root.state == "idle" ? root.fg : #1a1a1a;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Attach";
                        color: root.phone ? root.accent : root.state == "idle" ? root.fg : #1a1a1a;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }
                attach-t := TouchArea {
                    enabled: root.state != "idle";
                    // Attaching mid-recording stops the take first (QML attach()).
                    clicked => {
                        if (root.recording) { root.stop(); }
                        else { root.attach(); }
                    }
                }
            }
        }
    }
}
