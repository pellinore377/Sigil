// Voice recorder — the QML voice panel: a compact drawer that rises above
// the composer, not a full-screen page. Three states: idle (tap to record),
// recording (live level bars + elapsed), ready (clip waveform + duration).

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";

export component VoiceRecorder inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <string> state: "idle";      // idle | recording | ready
    in property <float> elapsed: 0;          // seconds, ticked by Rust
    in property <float> clip-duration: 0;
    in property <[float]> levels;            // rolling last 60 while recording
    in property <[float]> clip-waveform;     // from voice.stop's reply

    callback record;
    callback stop;
    callback restart;
    callback attach;
    callback cancelled;

    // Scrim: tap-away cancels, like every sheet.
    background: Theme.background.with-alpha(0.35);
    TouchArea { clicked => { root.cancelled(); } }

    drawer := Rectangle {
        x: 10px;
        width: root.width - 20px;
        y: root.height - self.height - 76px;   // riding above the composer
        height: 220px;
        border-radius: 22px;
        background: Theme.popup-background;
        border-width: 1px;
        border-color: Theme.popup-border;
        TouchArea { }  // the drawer itself swallows taps

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Stage
            stage := Rectangle {
                vertical-stretch: 1;
                border-radius: 14px;
                background: root.fg.with-alpha(0.05);

                if root.state == "idle" : VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    IconLabel {
                        text: Icons.voiceMemo;
                        filled: false;
                        color: root.fg.with-alpha(0.8);
                        font-size: 30px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Tap to record your voice";
                        color: root.fg.with-alpha(0.65);
                        font-family: Theme.font-ui;
                        font-size: Theme.body-small;
                        horizontal-alignment: center;
                    }
                }

                if root.state == "recording" : HorizontalLayout {
                    padding-left: 16px; padding-right: 16px;
                    spacing: 12px;
                    rec-dot := Rectangle {
                        y: (stage.height - 12px) / 2;
                        width: 12px; height: 12px; border-radius: 6px;
                        background: Theme.urgent;
                        opacity: 0.35 + 0.65 * abs(sin(360deg * (animation-tick() / 1.2s)));
                    }
                    bars := Rectangle {
                        horizontal-stretch: 1;
                        for level[i] in root.levels : Rectangle {
                            property <length> slot: bars.width / 60;
                            x: i * self.slot;
                            width: max(2px, self.slot - 2px);
                            height: max(3px, min(1.0, level) * (stage.height - 24px));
                            y: (stage.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: root.fg.with-alpha(0.9);
                        }
                    }
                    Text {
                        text: floor(root.elapsed / 60) + ":" + (mod(floor(root.elapsed), 60) < 10 ? "0" : "") + mod(floor(root.elapsed), 60);
                        color: root.fg.with-alpha(0.8);
                        font-family: Theme.font-mono;
                        font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }

                if root.state == "ready" : HorizontalLayout {
                    padding-left: 16px; padding-right: 16px;
                    spacing: 12px;
                    wave := Rectangle {
                        horizontal-stretch: 1;
                        for level[i] in root.clip-waveform : Rectangle {
                            property <length> slot: wave.width / 60;
                            x: i * self.slot;
                            width: max(2px, self.slot - 2px);
                            height: max(3px, min(1.0, level) * (stage.height - 24px));
                            y: (stage.height - self.height) / 2;
                            border-radius: 1.5px;
                            background: root.accent;
                        }
                    }
                    Text {
                        text: floor(root.clip-duration / 60) + ":" + (mod(floor(root.clip-duration), 60) < 10 ? "0" : "") + mod(floor(root.clip-duration), 60);
                        color: root.fg.with-alpha(0.8);
                        font-family: Theme.font-mono;
                        font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }
            }

            // Cancel · record/stop · Attach
            HorizontalLayout {
                spacing: 10px;
                cancel-b := Rectangle {
                    horizontal-stretch: 1;
                    height: 46px;
                    border-radius: 23px;
                    background: cancel-t.pressed ? root.fg.with-alpha(0.12) : root.fg.with-alpha(0.06);
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        IconLabel { text: Icons.close; color: root.fg; font-size: Theme.body; vertical-alignment: center; }
                        Text { text: root.state == "ready" ? "Restart" : "Cancel"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
                    }
                    cancel-t := TouchArea { clicked => {
                        if (root.state == "ready") { root.restart(); } else { root.cancelled(); }
                    } }
                }
                mic-b := Rectangle {
                    width: 84px;
                    height: 46px;
                    border-radius: 23px;
                    background: root.state == "recording" ? Theme.urgent
                              : mic-t.pressed ? root.fg.with-alpha(0.35) : root.fg.with-alpha(0.22);
                    IconLabel {
                        text: root.state == "recording" ? Icons.stop : Icons.micOn;
                        color: root.state == "recording" ? Theme.background : root.fg;
                        width: 100%; height: 100%;
                    }
                    mic-t := TouchArea { clicked => {
                        if (root.state == "recording") { root.stop(); }
                        else if (root.state == "idle") { root.record(); }
                    } }
                }
                attach-b := Rectangle {
                    horizontal-stretch: 1;
                    height: 46px;
                    border-radius: 23px;
                    opacity: root.state == "ready" ? 1.0 : 0.4;
                    background: attach-t.pressed && root.state == "ready" ? root.accent.with-alpha(0.5) : root.accent.with-alpha(0.3);
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        IconLabel { text: Icons.check; color: root.fg; font-size: Theme.body; vertical-alignment: center; }
                        Text { text: "Attach"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
                    }
                    attach-t := TouchArea {
                        enabled: root.state == "ready";
                        clicked => { root.attach(); }
                    }
                }
            }
        }
    }
}
