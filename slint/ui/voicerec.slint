// Voice recorder — VoiceRecorder.qml verbatim: an inline 230px panel under
// the composer. Three states: idle (static 7-bar wave + caption), recording
// (blinking dot + zero-padded timer over a live 48px level band), ready (the
// clip's waveform + duration). Controls: side pills + a 120px centre pill.
// The root is transparent (VoiceRecorder.qml:7): the conversation ground
// shows through around the stage card and the pills.
//
// The phone's is the platform messenger's: a 300dp sheet on the card ground
// (radius 28, 16 from the sides, 12 under the composer) and, outside it, a
// 56dp row of three pills — outlined Cancel and Attach, the mic on an accent
// container between them, split 1 : 1.1 : 1.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";

export component VoiceRecorder inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    // ChatPage.qml hands the recorder themedSend: accent@0.9 unthemed (:45, :1836).
    in property <color> accent: Theme.accent.with-alpha(0.9);
    in property <color> surface: Theme.menu-text.with-alpha(0.07);
    // deepChipC ≈ rgba(36,36,36,0.96) (ChatPage.qml:56-59, :1839).
    in property <color> chip: Theme.menu-background.darker(1.1).with-alpha(0.96);
    /// The room wears a chat theme: the phone's sheet takes `surface` then.
    in property <bool> themed: false;
    in property <string> state: "idle";      // idle | recording | ready
    in property <float> elapsed: 0;          // seconds, ticked by Rust
    in property <float> clip-duration: 0;
    in property <[float]> levels;            // rolling last 60 while recording
    in property <[float]> clip-waveform;     // from voice.stop's reply

    callback record;
    callback stop;
    callback restart;
    callback attach;
    callback cancelled;

    property <bool> phone: Theme.mode != "desktop";
    // The card ink: the QML flips to dark on light theme tints; Frosted Glass
    // stays dark, so fg stands in until chat themes reach the recorder.
    property <color> ink: root.fg;
    property <color> pill-c: root.chip;
    // The phone's sheet: the room's own surface when themed, else the card ground.
    property <color> sheet-c: root.phone && !root.themed ? Theme.card-ground : root.surface;
    // The phone's accent container: the room accent sunk into the ground.
    // The mic pill wears the platform messenger's accent tint: a light wash of
    // the accent over dark palettes, a sunk one over light.
    property <color> accent-container: Theme.mode == "light" ? root.accent.with-alpha(1.0).mix(Theme.background, 0.22) : root.accent.with-alpha(1.0).mix(#ffffff, 0.45);
    property <bool> recording: root.state == "recording";
    property <float> shown: root.recording ? root.elapsed : root.clip-duration;
    property <string> timer-text:
        (floor(root.shown / 60) < 10 ? "0" : "") + floor(root.shown / 60)
        + ":" + (mod(floor(root.shown), 60) < 10 ? "0" : "") + mod(floor(root.shown), 60);

    // 12 + 300 + 12 + 56 + 16 on the phone.
    height: root.phone ? 396px : 230px;
    background: transparent;

    VerticalLayout {
        padding-left: root.phone ? 8px : 10px;
        padding-right: root.phone ? 8px : 10px;
        padding-top: root.phone ? 12px : 10px;
        padding-bottom: root.phone ? 16px : 10px;
        spacing: root.phone ? 12px : 10px;

        // Stage card
        stage := Rectangle {
            vertical-stretch: 1;
            border-radius: root.phone ? 28px : 18px;
            background: root.sheet-c;

            // idle: static waveform glyph + caption
            if root.state == "idle" : VerticalLayout {
                alignment: center;
                spacing: root.phone ? 16px : 10px;
                // A 46px band; each bar is centred in its own column so the
                // layout cannot pin it to the top.
                idle-wave := HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    height: 46px;
                    for lvl in [0.35, 0.6, 0.85, 1.0, 0.8, 0.5, 0.3] : Rectangle {
                        width: 5px; height: 46px;
                        Rectangle {
                            x: 0; y: (46px - self.height) / 2;
                            width: 5px;
                            height: round(46 * lvl) * 1px;
                            border-radius: 2.5px;
                            background: root.ink.with-alpha(0.55);
                        }
                    }
                }
                Text {
                    text: "Tap to record your voice";
                    color: root.phone ? root.ink : root.ink.with-alpha(0.8);
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    horizontal-alignment: center;
                }
            }

            // recording / ready: dot + timer stacked above the level band,
            // in a column `parent - 28` wide (VoiceRecorder.qml:124).
            if root.state != "idle" : VerticalLayout {
                x: 14px;
                width: stage.width - 28px;
                alignment: center;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    if root.recording : Rectangle {
                        width: 9px;
                        rec-dot := Rectangle {
                            x: 0; y: (parent.height - 9px) / 2;
                            width: 9px; height: 9px; border-radius: 4.5px;
                            background: #e88b90;
                            // Linear to 0.25 over 700ms, back to 1 over 700ms (:135).
                            property <float> t: (animation-tick() / 1400ms).mod(1.0);
                            opacity: self.t < 0.5 ? 1 - 0.75 * (self.t / 0.5)
                                                  : 0.25 + 0.75 * ((self.t - 0.5) / 0.5);
                        }
                    }
                    timer-line := Text {
                        text: root.timer-text;
                        color: root.ink;
                        font-family: Theme.font-ui;
                        font-size: Theme.title;
                        vertical-alignment: center;
                    }
                }
                band := Rectangle {
                    height: 48px;
                    bars := HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        for level in (root.recording ? root.levels : root.clip-waveform) : Rectangle {
                            width: 3px; height: 48px;
                            Rectangle {
                                x: 0; y: (48px - self.height) / 2;
                                width: 3px;
                                height: max(3px, 44px * min(1.0, level));
                                border-radius: 1.5px;
                                background: root.ink.with-alpha(0.8);
                            }
                        }
                    }
                }
            }
        }

        // Controls: Restart/Cancel · record/stop · Attach — sides (W-136)/2.
        controls := HorizontalLayout {
            height: root.phone ? 56px : 46px;
            spacing: root.phone ? 12px : 8px;
            cancel-b := Rectangle {
                horizontal-stretch: 1;
                border-radius: root.phone ? 28px : 23px;
                background: root.phone ? Theme.bubble-other : root.pill-c;
                // The phone's side pills are filled surface containers, accent ink.
                border-width: 0px;
                border-color: root.accent;
                HorizontalLayout {
                    alignment: center;
                    // QML's fitWidth icon boxes hug the glyph at spacing 6; a
                    // Slint glyph cell is wider, so 4 lands the same gap.
                    spacing: root.phone ? 8px : 4px;
                    IconLabel {
                        text: root.recording ? Icons.refresh : Icons.close;
                        font-size: root.phone ? 20px : Theme.icon-size;   // VoiceRecorder.qml:178
                        color: root.phone ? root.accent : root.fg; vertical-alignment: center;
                    }
                    Text {
                        text: root.recording ? "Restart" : "Cancel";
                        color: root.phone ? root.accent : root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }
                cancel-t := TouchArea { clicked => {
                    if (root.recording) { root.restart(); }
                    else { root.cancelled(); }
                } }
            }
            mic-b := Rectangle {
                // 120 on the desktop; the phone's takes 1.1 of the split.
                min-width: root.phone ? 0px : 120px;
                max-width: root.phone ? 10000px : 120px;
                horizontal-stretch: root.phone ? 1.1 : 0;
                border-radius: root.phone ? 28px : 23px;
                background: root.phone
                    ? (root.recording ? Theme.urgent : root.accent-container)
                    : root.recording ? Theme.urgent.brighter(0.25) : root.accent.brighter(0.3);
                IconLabel {
                    text: root.recording ? Icons.stop : Icons.record;
                    filled: true;   // VoiceRecorder.qml:194
                    color: root.phone ? (Theme.mode == "light" ? root.ink : #1b1b1f) : Theme.background;
                    font-size: root.phone ? 24px : 22px;
                    width: 100%; height: 100%;
                }
                mic-t := TouchArea { clicked => {
                    if (root.recording) { root.stop(); }
                    else if (root.state == "ready") { root.restart(); }
                    else { root.record(); }
                } }
            }
            attach-b := Rectangle {
                horizontal-stretch: 1;
                border-radius: root.phone ? 28px : 23px;
                opacity: root.state == "idle" ? (root.phone ? 0.45 : 0.6) : 1;
                background: root.phone ? Theme.bubble-other
                          : root.state == "idle" ? root.pill-c : root.accent.brighter(0.3);
                border-width: 0px;
                border-color: root.accent;
                HorizontalLayout {
                    alignment: center;
                    spacing: root.phone ? 8px : 4px;
                    IconLabel {
                        text: Icons.check; font-size: root.phone ? 20px : Theme.icon-size;   // VoiceRecorder.qml:214
                        color: root.phone ? root.accent : root.state == "idle" ? root.fg : #1a1a1a;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Attach";
                        color: root.phone ? root.accent : root.state == "idle" ? root.fg : #1a1a1a;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                    }
                }
                attach-t := TouchArea {
                    enabled: root.state != "idle";
                    // Attaching mid-recording stops the take first (QML attach()).
                    clicked => {
                        if (root.recording) { root.stop(); }
                        else { root.attach(); }
                    }
                }
            }
        }
    }
}
