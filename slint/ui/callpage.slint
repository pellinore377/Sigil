// The in-panel call experience — CallPage.qml + omarchy/calls/* as one file:
// voice = big avatar card with speaking rings; video = remote fills the page
// with a draggable self-view; a screen share takes the spotlight layout.
//
// The page renders; the BRIDGE decides. Slint expressions cannot scan arrays,
// so everything the QML computed by iterating (featured track, group mode,
// tile list with self last, status/duration text) arrives as `in` properties.
// Frames arrive as `frame` images on each participant — the bridge reads the
// engine's shm files in-process and repaints them; the page just draws.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, Avatar } from "components.slint";
import { CallParticipant, DeviceRow } from "model.slint";

/// One in-call reaction floating up the page (LiveKit data channel, ephemeral).
export struct Floater {
    fid: int,
    emoji: string,
    who: string,
}

// Rings expanding out of a call avatar while that participant talks
// (calls/SpeakingRipple.qml). The amplitude follows the engine's audio
// level through `smooth`; the bridge does not report `level` yet, so the
// rings sit at the 0.18 floor while speaking (see calls-handoff.md).
export component SpeakingRipple inherits Rectangle {
    in property <color> accent: Theme.accent;
    in property <bool> speaking: false;
    /// 0..1 from the engine (SpeakingRipple.qml:11).
    in property <float> level: 0;
    in property <length> size: 110px;
    width: root.size * 2.1;
    height: root.size * 2.1;
    background: transparent;
    // SpeakingRipple.qml:17-21: smooth eases toward max(0.18, min(1, level*3.2))
    // while speaking and decays to 0 afterwards (frameTime*9 ≈ a 110ms time
    // constant, ~90 % settled at 250ms) — the rings never snap off.
    property <float> target: root.speaking ? max(0.18, min(1.0, root.level * 3.2)) : 0.0;
    property <float> smooth: root.target;
    animate smooth { duration: 250ms; easing: ease-out; }
    // SpeakingRipple.qml:41: visible while smooth > 0.01.
    property <bool> alive: root.smooth > 0.01;
    // SpeakingRipple.qml:198-203: free-running 1600ms phase.
    property <float> phase: mod(animation-tick() / 1600ms, 1.0);
    // SpeakingRipple.qml:33-39: diameter, border and alpha all scale with smooth.
    ring0 := Rectangle {
        visible: root.alive;
        property <float> p: root.phase;
        width: root.size * (1 + self.p * 1.05 * (0.35 + root.smooth));
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: transparent;
        border-width: max(1px, 2px * (0.4 + root.smooth));
        border-color: root.accent.with-alpha((1 - self.p) * 0.55 * min(1.0, root.smooth * 1.6));
    }
    ring1 := Rectangle {
        visible: root.alive;
        property <float> p: mod(root.phase + 0.5, 1.0);
        width: root.size * (1 + self.p * 1.05 * (0.35 + root.smooth));
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: transparent;
        border-width: max(1px, 2px * (0.4 + root.smooth));
        border-color: root.accent.with-alpha((1 - self.p) * 0.55 * min(1.0, root.smooth * 1.6));
    }
}

// One call tile (calls/ParticipantTile.qml): video frame or avatar fallback,
// name strip, mute glyph, speaking border. The bridge only sets has-frame for
// a LIVE track (a muted camera stays published in LiveKit but must not freeze
// on its last frame).
export component CallTile inherits Rectangle {
    in property <CallParticipant> participant;
    in property <bool> is-local: false;
    in property <bool> fit-video: false;
    in property <length> tile-radius: 12px;
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    /// "good" | "poor" | "lost" (ParticipantTile.qml:144). CallParticipant
    /// carries no quality yet; the bridge fills it (calls-handoff.md).
    in property <string> quality: "good";

    border-radius: root.tile-radius;
    background: Theme.background.with-alpha(0.55);
    border-width: root.participant.speaking ? 2px : 1px;
    border-color: root.participant.speaking ? root.accent : root.fg.with-alpha(0.12);
    clip: true;

    // ParticipantTile.qml:87-106: the frame is inset by the border width
    // (speaking ? 2 : 1) and masked at max(1, tileRadius - 1).
    property <length> inset: root.participant.speaking ? 2px : 1px;
    if root.participant.has-frame : Rectangle {
        x: root.inset; y: root.inset;
        width: root.width - root.inset * 2;
        height: root.height - root.inset * 2;
        border-radius: max(1px, root.tile-radius - 1px);
        clip: true;
        Image {
            width: 100%; height: 100%;
            source: root.participant.frame;
            image-fit: root.fit-video || root.participant.screen-sharing ? contain : cover;
            // ParticipantTile.qml:93: your own camera preview is mirrored; a
            // shared screen is not.
            transform-scale-x: root.is-local && !root.participant.screen-sharing ? -1 : 1;
        }
    }
    if !root.participant.has-frame : SpeakingRipple {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        size: min(root.width, root.height) * 0.32;
        accent: root.accent;
        speaking: root.participant.speaking;
    }
    if !root.participant.has-frame : Avatar {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        size: min(root.width, root.height) * 0.32;
        source: root.participant.avatar;
        initials: root.participant.initials;
        tint: root.participant.tint;
    }
    // Name pill, bounded by the tile with a real ellipsis.
    name-pill := Rectangle {
        x: 8px;
        y: root.height - self.height - 8px;
        width: min(name-row.preferred-width + 14px, root.width - 16px);
        height: 22px;
        border-radius: 11px;
        background: Theme.background.with-alpha(0.6);
        name-row := HorizontalLayout {
            padding-left: 7px; padding-right: 7px;
            spacing: 5px;
            if root.participant.mic-muted : IconLabel {
                text: Icons.micOff;
                filled: true;   // ParticipantTile.qml:83
                color: Theme.urgent;
                font-size: Theme.body-small;
                vertical-alignment: center;
            }
            Text {
                // ParticipantTile.qml:135: the suffix keys off the tile's track
                // being a screen track (the bridge picks screen > camera, so a
                // sharing participant's tile IS the screen), not off a live frame.
                text: (root.is-local ? "You" : root.participant.display-name)
                    + (root.participant.screen-sharing ? " (screen)" : "");
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    // ParticipantTile.qml:144-146: poor / lost connection glyph, top right.
    if root.quality == "poor" || root.quality == "lost" : IconLabel {
        x: root.width - self.width - 8px;
        y: 8px;
        text: Icons.signalOff;
        filled: true;   // ParticipantTile.qml:96
        color: Theme.urgent;
        font-size: Theme.icon-size;
    }
}

// Group-call layout for the narrow panel (mobile/CallGrid.qml): portrait
// cells, a screen share on top with the people in a thumb strip below.
component CallGrid inherits Rectangle {
    in property <[CallParticipant]> tiles;      // self LAST (bridge order)
    in property <int> spotlight-idx: -1;        // index into tiles, -1 = none
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    background: transparent;

    property <length> gap: 8px;
    property <bool> sharing: root.spotlight-idx >= 0;
    // CallGrid.qml:28-32: everyone but the share is a "person".
    property <int> n: root.tiles.length - (root.sharing ? 1 : 0);
    // CallGrid.qml:65-66: two columns; three across leaves faces too small.
    property <int> cols: root.n <= 2 ? 1 : 2;
    property <int> rows: max(1, ceil(root.n / root.cols));
    // CallGrid.qml:69-70: with a share on top, people become one 96-high strip.
    property <length> strip-h: root.sharing && root.n > 0 ? 96px : 0px;
    property <length> share-h: root.sharing ? root.height - root.strip-h - root.gap : 0px;
    // CallGrid.qml:137-140: portrait cells, clamped to 1.4 × width.
    property <length> cell-w: max(0px, (root.width - root.gap * (root.cols + 1)) / root.cols);
    property <length> cell-h: max(0px, min((root.height - root.gap * (root.rows + 1)) / root.rows,
                                          root.cell-w * 1.4));
    // CallGrid.qml:98-106: the thumb row's width, centred when it fits.
    property <length> strip-w: root.n * 96px + (root.n + 1) * root.gap;
    property <length> strip-x: max(0px, (root.width - root.strip-w) / 2);

    // Spotlight (CallGrid.qml:73-85): full width, radius 20, never cropped.
    if root.sharing : CallTile {
        x: root.gap; y: root.gap;
        width: root.width - root.gap * 2;
        height: max(0px, root.share-h - root.gap);
        tile-radius: 20px;
        fit-video: true;
        participant: root.tiles[root.spotlight-idx];
        is-local: root.spotlight-idx == root.tiles.length - 1;
        fg: root.fg; accent: root.accent;
    }
    // Thumb strip (CallGrid.qml:88-122): 96-wide tiles, radius 12, scrolls
    // sideways when the row outgrows the page.
    if root.sharing : Flickable {
        x: 0; y: root.share-h + root.gap;
        width: root.width;
        height: max(0px, root.strip-h - root.gap);
        viewport-width: max(root.width, root.strip-w);
        viewport-height: self.height;
        for tile[i] in root.tiles : CallTile {
            property <int> slot: i > root.spotlight-idx ? i - 1 : i;
            visible: i != root.spotlight-idx;
            x: root.strip-x + root.gap + self.slot * (96px + root.gap);
            y: 0;
            width: 96px; height: parent.height;
            participant: tile;
            is-local: i == root.tiles.length - 1;
            fg: root.fg; accent: root.accent;
        }
    }
    // Grid (CallGrid.qml:125-151): last row centred when short, block
    // centred vertically once the cells are clamped.
    for tile[i] in root.tiles : holder := Rectangle {
        property <int> slot: root.sharing && i > root.spotlight-idx ? i - 1 : i;
        property <int> c: mod(self.slot, root.cols);
        property <int> r: floor(self.slot / root.cols);
        property <int> in-row: min(root.cols, root.n - self.r * root.cols);
        property <length> row-w: self.in-row * root.cell-w + (self.in-row - 1) * root.gap;
        visible: !root.sharing;
        x: (root.width - self.row-w) / 2 + self.c * (root.cell-w + root.gap);
        y: root.gap + max(0px, (root.height - root.gap * (root.rows + 1) - root.rows * root.cell-h) / 2)
           + self.r * (root.cell-h + root.gap);
        width: root.cell-w; height: root.cell-h;
        background: transparent;
        CallTile {
            width: 100%; height: 100%;
            tile-radius: 16px;
            participant: tile;
            is-local: i == root.tiles.length - 1;
            fg: root.fg; accent: root.accent;
        }
    }
    // CallGrid.qml:153-160: `tiles` always contains you, so this is "nobody else".
    if !root.sharing && root.n == 0 : Text {
        text: "Waiting for others to join…";
        color: root.fg.with-alpha(0.5);
        font-family: Theme.font-ui;
        font-size: Theme.body;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
    }
}

export component CallPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;   // the room's chat theme colour

    // ---- call.state, digested by the bridge ----
    in property <string> state: "idle";     // idle joining connected reconnecting leaving
    in property <string> status-text;       // "Calling…" / "Ringing…" / running duration
    in property <string> error;
    in property <bool> encrypted;
    in property <bool> mic-muted;
    in property <bool> camera-on;
    in property <bool> screen-sharing;
    /// Everyone with their best live frame (screen > camera), self LAST.
    in property <[CallParticipant]> tiles;
    in property <int> spotlight-idx: -1;
    /// 1:1 video layout: the one remote worth featuring.
    in property <CallParticipant> featured;
    in property <bool> has-featured;
    /// Self camera for the draggable PiP (1:1 mode only).
    in property <CallParticipant> local-cam;
    in property <bool> has-local-cam;
    in property <bool> group-mode;
    in property <bool> video-mode;
    /// Voice layout fallback identity (first remote, else the room).
    in property <string> peer-name;
    in property <image> peer-avatar;
    in property <string> peer-initials;
    in property <color> peer-tint: Theme.accent;
    in property <bool> peer-speaking;
    /// Whether the host shows the page (CallPage.qml:25 `visible`): the tray
    /// and the sheet close when it hides.
    in property <bool> shown: true;
    // ---- devices (call.devices) ----
    in property <[DeviceRow]> mics;
    in property <[DeviceRow]> speakers;
    // ---- reactions ----
    in property <[Floater]> floaters;

    in-out property <bool> react-open: false;
    in-out property <bool> settings-open: false;

    callback set-mic(bool);
    callback set-camera(bool);
    callback set-screenshare(bool);
    callback hang-up;
    callback select-device(string, string);   // kind, id
    callback react(string);
    callback minimize;

    property <[string]> react-emoji: ["👍", "❤️", "😂", "😮", "😢", "😡"];

    // CallPage.qml:25: leaving the page drops the tray (floaters are the
    // bridge's list; the host stops feeding them while hidden).
    changed shown => {
        if (!root.shown) { root.react-open = false; root.settings-open = false; }
    }

    clip: true;
    border-radius: 22px;
    background: Theme.background.with-alpha(0.35);

    // ---- stage (everything above the control bar) ----
    stage := Rectangle {
        width: 100%;
        height: root.height - controls.height;
        background: transparent;

        if root.video-mode && !root.group-mode : CallTile {
            x: 10px; y: 10px;
            width: stage.width - 20px; height: stage.height - 20px;
            tile-radius: 20px;
            participant: root.featured;
            fit-video: root.has-featured && root.featured.screen-sharing;
            fg: root.fg; accent: root.accent;
        }
        if root.group-mode : CallGrid {
            x: 2px; y: 2px;
            width: stage.width - 4px; height: stage.height - 4px;
            tiles: root.tiles;
            spotlight-idx: root.spotlight-idx;
            fg: root.fg; accent: root.accent;
        }
        // Voice-call / waiting layout.
        // CallPage.qml:185-210: a Column centred in the stage at its own
        // height (unsized, the layout would stretch the status row down).
        if !root.video-mode && !root.group-mode : voice-col := VerticalLayout {
            y: (stage.height - self.preferred-height) / 2;
            width: 100%;
            height: self.preferred-height;
            spacing: 14px;
            Rectangle {
                height: 110px;
                SpeakingRipple {
                    x: (stage.width - self.width) / 2;
                    y: (110px - self.height) / 2;
                    size: 110px;
                    accent: root.accent;
                    speaking: root.peer-speaking;
                }
                Avatar {
                    x: (stage.width - self.width) / 2;
                    y: 0;
                    size: 110px;
                    source: root.peer-avatar;
                    initials: root.peer-initials;
                    tint: root.peer-tint;
                }
            }
            Text {
                text: root.peer-name;
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.heading;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: root.status-text;
                    color: root.fg.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                }
                if root.encrypted : IconLabel {
                    text: Icons.lock;
                    filled: true;   // CallPage.qml:209
                    color: root.fg.with-alpha(0.5);
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                }
            }
        }

        // Self-view PiP (CallPage.qml:215-300): draggable; the release velocity
        // (low-passed per move, v = v*0.55 + (dx/dt)*0.45) aims at the corner
        // the throw is heading for (pos + v*0.14) and a back-out curve stands
        // in for the k=120 c=15 spring. The corner is kept, not a position, so
        // a resize re-parks it (Panel's park()).
        pip := Rectangle {
            visible: root.has-local-cam && !root.group-mode;
            width: 110px; height: 150px;
            property <length> edge: 16px;
            property <bool> dragging: false;
            property <bool> flying: false;
            property <int> cx: 1;   // 0 = left edge, 1 = right edge (starts top right)
            property <int> cy: 0;   // 0 = top edge, 1 = bottom edge
            property <length> dx;   // position while dragging
            property <length> dy;
            property <float> vx;    // px/s
            property <float> vy;
            property <duration> last-t;
            property <length> last-x;
            property <length> last-y;
            x: self.dragging ? self.dx : (self.cx == 0 ? self.edge : stage.width - self.width - self.edge);
            y: self.dragging ? self.dy : (self.cy == 0 ? self.edge : stage.height - self.height - self.edge);
            animate x, y { duration: pip.flying ? 380ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            settle := Timer {
                interval: 400ms;
                running: pip.flying;
                triggered => { pip.flying = false; }
            }
            CallTile {
                width: 100%; height: 100%;
                tile-radius: 16px;
                participant: root.local-cam;
                is-local: true;
                fg: root.fg; accent: root.accent;
            }
            pip-drag := TouchArea {
                // CallPage.qml:281: open hand, closed while held.
                mouse-cursor: self.pressed ? grabbing : grab;
                moved => {
                    if (pip.dragging || abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
                        pip.dragging = true;
                        // CallPage.qml:283-285: drag bounds 6 in from every edge.
                        pip.dx = min(max(pip.dx + self.mouse-x - self.pressed-x, 6px), stage.width - pip.width - 6px);
                        pip.dy = min(max(pip.dy + self.mouse-y - self.pressed-y, 6px), stage.height - pip.height - 6px);
                        // CallPage.qml:236-249: low-passed velocity, sampled per frame.
                        if ((animation-tick() - pip.last-t) / 1s > 0.001) {
                            pip.vx = pip.vx * 0.55 + ((pip.dx - pip.last-x) / 1px / ((animation-tick() - pip.last-t) / 1s)) * 0.45;
                            pip.vy = pip.vy * 0.55 + ((pip.dy - pip.last-y) / 1px / ((animation-tick() - pip.last-t) / 1s)) * 0.45;
                            pip.last-x = pip.dx; pip.last-y = pip.dy; pip.last-t = animation-tick();
                        }
                    }
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        pip.flying = false;
                        pip.vx = 0; pip.vy = 0;
                        pip.dx = pip.x; pip.dy = pip.y;
                        pip.last-x = pip.x; pip.last-y = pip.y; pip.last-t = animation-tick();
                    } else if (ev.kind == PointerEventKind.up && pip.dragging) {
                        // CallPage.qml:290-296: aim at where the throw is heading.
                        pip.cx = pip.dx + pip.vx * 0.14 * 1px + pip.width / 2 < stage.width / 2 ? 0 : 1;
                        pip.cy = pip.dy + pip.vy * 0.14 * 1px + pip.height / 2 < stage.height / 2 ? 0 : 1;
                        pip.flying = true;
                        pip.dragging = false;
                    } else if (ev.kind == PointerEventKind.cancel) {
                        pip.dragging = false;
                    }
                }
            }
        }

        // Running-duration chip over video layouts.
        if (root.video-mode || root.group-mode) && root.state == "connected" : time-chip := Rectangle {
            x: (stage.width - self.width) / 2;
            y: 16px;
            width: time-text.preferred-width + 18px;
            height: 24px;
            border-radius: 12px;
            background: Theme.background.with-alpha(0.55);
            time-text := Text {
                text: root.status-text;
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }

        // Reactions float up the page — page-owned, the sender may have no tile.
        // Each delegate drives itself off animation-tick from its birth tick;
        // the bridge prunes floaters after ~2.6 s.
        for fl in root.floaters : floater := Rectangle {
            property <duration> t0;
            init => { self.t0 = animation-tick(); }
            // Milliseconds alive, 0..2600 (CallPage.qml:359-370's clock).
            property <float> ms: min(2600.0, (animation-tick() - self.t0) / 1ms);
            property <length> lane: stage.width * (0.22 + mod(fl.fid * 37, 100) / 100.0 * 0.56) - 26px;
            // CallPage.qml:325, 331-332: a 52×52 box with the content centred.
            width: 52px; height: 52px;
            // CallPage.qml:367-370: sway lane→+16 over 900ms then →-12 over 1000ms,
            // both InOutSine, then hold.
            x: self.ms < 900 ? self.lane + 16px * (0.5 - 0.5 * cos(180deg * (self.ms / 900)))
                             : self.lane + 16px - 28px * (0.5 - 0.5 * cos(180deg * min(1.0, (self.ms - 900) / 1000)));
            // CallPage.qml:329, 361: from H-62 up to 0.22·H over 2600ms OutCubic.
            y: (stage.height - 62px) + (stage.height * 0.22 - (stage.height - 62px))
               * (1 - (1 - self.ms / 2600) * (1 - self.ms / 2600) * (1 - self.ms / 2600));
            // CallPage.qml:362-366: 220ms in, 1600ms hold, 780ms out.
            opacity: self.ms < 220 ? self.ms / 220 : (self.ms > 1820 ? max(0.0, 1 - (self.ms - 1820) / 780) : 1.0);
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    // No font-family override: the colour-emoji font must resolve.
                    text: fl.emoji;
                    font-size: 30px;
                    horizontal-alignment: center;
                }
                if fl.who != "" : HorizontalLayout {
                    alignment: center;
                    who-chip := Rectangle {
                        width: min(who-text.preferred-width + 12px, 110px);
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.background.with-alpha(0.6);
                        who-text := Text {
                            x: (who-chip.width - self.width) / 2;
                            width: min(self.preferred-width, who-chip.width - 10px);
                            height: 100%;
                            text: fl.who;
                            color: #ececec;
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            horizontal-alignment: center; vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // Minimise to the app-wide PiP; sits where a back arrow would be
    // (CallPage.qml:147-155: a constant background@0.55, no press tint).
    min-btn := Rectangle {
        x: 14px; y: 14px;
        width: 34px; height: 34px;
        border-radius: 17px;
        background: Theme.background.with-alpha(0.55);
        IconLabel {
            text: Icons.pip;
            filled: true; font-size: Theme.icon-size;   // CallPage.qml:152
            color: root.fg;
            width: 100%; height: 100%;
        }
        min-touch := TouchArea { mouse-cursor: pointer; clicked => { root.minimize(); } }
    }

    if root.error != "" : Text {
        x: 30px;
        y: root.height - controls.height - self.preferred-height - 10px;
        width: root.width - 60px;
        text: root.error;
        color: Theme.urgent;
        font-family: Theme.font-ui;
        font-size: Theme.caption;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // Tap-away for the reaction tray — page level, or every control needs two taps.
    if root.react-open : TouchArea {
        clicked => { root.react-open = false; }
    }

    // ---- controls: dark circles, inverted when off, red hangup pill ----
    controls := Rectangle {
        y: root.height - self.height;
        width: 100%;
        height: 84px;
        background: transparent;

        // Emoji tray above the controls: a short row, not the full picker.
        // CallPage.qml:407-419: opacity 140ms, scale 0.9→1 180ms OutBack,
        // alive while opacity > 0.01.
        tray := Rectangle {
            x: (root.width - self.width) / 2;
            y: -self.height - 8px;   // floats above the bar
            width: tray-row.preferred-width + 20px;
            height: 48px;
            border-radius: 24px;
            background: #292b2e.with-alpha(0.92);
            visible: self.opacity > 0.01;
            opacity: root.react-open ? 1 : 0;
            animate opacity { duration: 140ms; }
            transform-scale: root.react-open ? 1 : 0.9;
            animate transform-scale { duration: 180ms; easing: ease-out-back; }
            TouchArea { } // swallow taps on the pill's own padding
            tray-row := HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                spacing: 6px;
                for emoji in root.react-emoji : e-btn := Rectangle {
                    width: 36px; height: 36px;
                    border-radius: 18px;
                    background: e-touch.pressed || e-touch.has-hover ? root.accent.with-alpha(0.32) : transparent;
                    // CallPage.qml:432-434: 1.08 on hover, 110ms OutCubic.
                    transform-scale: e-touch.pressed || e-touch.has-hover ? 1.08 : 1;
                    animate transform-scale { duration: 110ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    Text {
                        text: emoji;
                        font-size: 19px;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    e-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.react(emoji); root.react-open = false; }
                    }
                }
            }
        }

        bar := HorizontalLayout {
            alignment: center;
            spacing: 12px;
            y: (controls.height - 46px) / 2;
            height: 46px;
            mic-btn := Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: root.mic-muted ? #e8e8e8 : #292b2e.with-alpha(0.92);
                IconLabel {
                    text: root.mic-muted ? Icons.micOff : Icons.micOn;
                    filled: true;   // CallPage.qml:474
                    color: root.mic-muted ? #202124 : #ececec;
                    font-size: 19px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.set-mic(root.mic-muted); } }
            }
            cam-btn := Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: !root.camera-on ? #e8e8e8 : #292b2e.with-alpha(0.92);
                IconLabel {
                    text: root.camera-on ? Icons.videoOn : Icons.videoOff;
                    filled: true;   // CallPage.qml:474
                    color: !root.camera-on ? #202124 : #ececec;
                    font-size: 19px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.set-camera(!root.camera-on); } }
            }
            share-btn := Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: root.screen-sharing ? Theme.accent.with-alpha(0.85) : #292b2e.with-alpha(0.92);
                IconLabel {
                    text: Icons.screenShareAlt;
                    filled: true;   // CallPage.qml:474
                    color: #ececec;
                    font-size: 19px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.set-screenshare(!root.screen-sharing); } }
            }
            react-btn := Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: root.react-open ? Theme.accent.with-alpha(0.85) : #292b2e.with-alpha(0.92);
                IconLabel {
                    text: Icons.emoji;
                    filled: true;   // CallPage.qml:474
                    color: #ececec;
                    font-size: 19px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.react-open = !root.react-open; } }
            }
            settings-btn := Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: #292b2e.with-alpha(0.92);
                IconLabel {
                    text: Icons.settings;
                    filled: true;   // CallPage.qml:474
                    color: #ececec;
                    font-size: 19px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.settings-open = true; } }
            }
            hangup-btn := Rectangle {
                width: 64px; height: 46px; border-radius: 23px;
                background: Theme.urgent.with-alpha(0.95);
                IconLabel {
                    text: Icons.phone;
                    filled: true;
                    transform-rotation: 135deg;
                    color: #ffffff;
                    font-size: 20px;
                    width: 100%; height: 100%;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.hang-up(); } }
            }
        }
    }

    // ---- settings sheet: input/output devices, slides in from the bottom ----
    // CallPage.qml:501-507: the scrim fades 0↔0.35 over 180ms and only
    // takes taps while the sheet is open.
    scrim := Rectangle {
        width: 100%; height: 100%;
        border-radius: 22px;
        background: #000000;
        opacity: root.settings-open ? 0.35 : 0;
        animate opacity { duration: 180ms; }
        visible: self.opacity > 0;
        TouchArea { enabled: root.settings-open; clicked => { root.settings-open = false; } }
    }
    sheet := Rectangle {
        y: root.settings-open ? root.height - self.height : root.height + 6px;
        animate y { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        // Parked below the page it must not show in the gesture zone (the
        // phone's window does not clip the page).
        visible: self.y < root.height - 0.5px;
        width: 100%;
        height: sheet-col.preferred-height + 34px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        background: Theme.popup-background.with-alpha(0.97);
        border-width: 1px;
        border-color: Theme.popup-text.with-alpha(0.08);
        sheet-col := VerticalLayout {
            x: 16px; y: 10px;
            width: root.width - 32px;
            spacing: 2px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px; height: 4px; border-radius: 2px;
                    background: Theme.popup-text.with-alpha(0.25);
                }
            }
            // CallPage.qml:523: title padded 6 above, 4 below.
            Rectangle {
                height: sheet-title.preferred-height + 10px;
                sheet-title := Text {
                    y: 6px;
                    text: "Call settings";
                    color: Theme.popup-text;
                    font-family: Theme.font-ui;
                    font-size: Theme.subtitle;
                    font-weight: 700;
                }
            }
            // CallPage.qml:533: section labels padded 8 above, 2 below.
            Rectangle {
                height: mic-label.preferred-height + 10px;
                mic-label := Text {
                    y: 8px;
                    text: "Microphone";
                    color: Theme.popup-text.with-alpha(0.55);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    font-weight: 700;
                }
            }
            for dev in root.mics : mic-row := Rectangle {
                height: 32px;
                border-radius: 8px;
                background: mic-row-t.pressed || mic-row-t.has-hover ? Theme.popup-text.with-alpha(0.08) : transparent;
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 8px;
                    IconLabel {
                        text: dev.selected ? Icons.check : " ";
                        filled: true;   // CallPage.qml:542 Fonts.iconFilled
                        color: Theme.accent;
                        font-size: Theme.body;
                        width: 16px;
                        vertical-alignment: center;
                    }
                    Text {
                        // CallPage.qml:543: the name runs to sheet.width - 70.
                        width: root.width - 70px;
                        text: dev.label;
                        color: Theme.popup-text;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                mic-row-t := TouchArea { clicked => { root.select-device("mic", dev.id); } }
            }
            if root.mics.length == 0 : Text {
                text: "No devices found";
                color: Theme.popup-text.with-alpha(0.5);
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
            }
            Rectangle {
                height: spk-label.preferred-height + 10px;
                spk-label := Text {
                    y: 8px;
                    text: "Speaker";
                    color: Theme.popup-text.with-alpha(0.55);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    font-weight: 700;
                }
            }
            for dev in root.speakers : spk-row := Rectangle {
                height: 32px;
                border-radius: 8px;
                background: spk-row-t.pressed || spk-row-t.has-hover ? Theme.popup-text.with-alpha(0.08) : transparent;
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 8px;
                    IconLabel {
                        text: dev.selected ? Icons.check : " ";
                        filled: true;   // CallPage.qml:542 Fonts.iconFilled
                        color: Theme.accent;
                        font-size: Theme.body;
                        width: 16px;
                        vertical-alignment: center;
                    }
                    Text {
                        // CallPage.qml:543: the name runs to sheet.width - 70.
                        width: root.width - 70px;
                        text: dev.label;
                        color: Theme.popup-text;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                spk-row-t := TouchArea { clicked => { root.select-device("speaker", dev.id); } }
            }
            if root.speakers.length == 0 : Text {
                text: "No devices found";
                color: Theme.popup-text.with-alpha(0.5);
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
            }
        }
    }
}
