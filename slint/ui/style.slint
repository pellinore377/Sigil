// The design-token contract from docs/portability.md, as a Slint global.
// The QML frontend gets these from the Omarchy host (qs.Commons / qs.Ui);
// here they are Sigil's own. Same names, same roles: a component asks for a
// token, never a literal.
//
// `Style.space(n)` does not exist here on purpose: Slint's `px` is already a
// logical pixel scaled by the platform's device pixel ratio, which is the whole
// job Style.space did on Quickshell. A design px in QML is a `px` here, 1:1.

// The bundled fonts, embedded at compile time. Nothing asks the system for a font.
import "../../shared/fonts/Roboto-Regular.ttf";
import "../../shared/fonts/Roboto-Medium.ttf";
import "../../shared/fonts/Roboto-Bold.ttf";
import "../../shared/fonts/RobotoMono-Regular.ttf";
import "../../shared/fonts/MaterialSymbolsRounded.ttf";
import "../../shared/fonts/MaterialSymbolsRounded-Filled.ttf";

export global Theme {
    // Three palettes behind one set of tokens.
    //
    // "desktop" is the Frosted Glass theme, verbatim from the desktop's
    // active Omarchy theme (colors.toml + shell.menu/popups.toml) —
    // deliberately monochrome, composited over the wallpaper, exactly what
    // 1:1 with the QML panel looks like on that machine.
    //
    // "dark" and "light" are the phone: a phone has no wallpaper behind the
    // app, and a messenger there should ground itself the way the platform's
    // own one does — a near-black (or paper-white) neutral, the colour spent
    // only on your own bubbles and small accents, sized and lit by the
    // system. The bridge picks the mode from the device and feeds the
    // system's Material accent.
    in-out property <string> mode: "desktop";
    in-out property <color> system-accent: #a8a8a8;
    property <bool> dark: mode == "dark";
    property <bool> light: mode == "light";

    out property <color> accent: dark || light ? system-accent : #a8a8a8;
    out property <color> background: dark ? #101014 : light ? #fdf8fd : #4b4b4b;
    out property <color> foreground: dark ? #e5e1e6 : light ? #1b1b1f : #c6c6c6;
    out property <color> muted: dark ? #96939b : light ? #757379 : #8a8a8a;
    out property <color> urgent: dark || light ? #de5b4f : #a55555;

    out property <color> menu-text: dark ? #e5e1e6 : light ? #1b1b1f : #c6c6c6;
    out property <color> menu-background: dark ? #101014 : light ? #fdf8fd : #4b4b4b;
    out property <color> menu-border: transparent;
    /// The card, and every page ground: lighter(menu.background, 1.35)
    /// (Panel.qml:33, 35). Qt's lighter(1.35) is Slint's brighter(0.35).
    /// The phone's ground barely lifts off the window, like the platform's
    /// own elevated surfaces.
    out property <color> card-ground: dark ? #17171b : light ? #f4f0f4 : #4b4b4b.brighter(0.35);

    /// A stranger's bubble: QML mixes 22% of the foreground into the popup
    /// ground, which reads right over the desktop's grey but washes out on
    /// the phone's near-black; there the platform's own neutral container
    /// stands in.
    out property <color> bubble-other: dark ? #2b2d31 : light ? #e9e7ec
        : #c6c6c6.mix(#4b4b4b, 0.22);
    out property <color> popup-text: dark ? #e5e1e6 : light ? #1b1b1f : #c6c6c6;
    out property <color> popup-background: dark ? #232227 : light ? #ffffff : #4b4b4b;
    out property <color> popup-border: dark ? #38363d : light ? #dcd9de : #5c5c5c;

    // Fonts, by the family names the bundled files declare.
    out property <string> font-ui: "Roboto";
    out property <string> font-mono: "Roboto Mono";
    out property <string> font-icon: "Material Symbols Rounded";
    out property <string> font-icon-filled: "Material Symbols Rounded Filled";

    // Type scale — Style.font.* in QML, VERBATIM. (An early "one step up
    // for phones" deviation lived here and made everything read oversized.)
    // On the phone the window is 1:1 with the platform's dp, so these are
    // the platform messenger's sp values (body 16, list title 16, page
    // title 22) rather than the desktop card's.
    property <bool> phone: mode != "desktop";
    out property <length> caption: phone ? 12px : 10px;
    out property <length> body-small: phone ? 14px : 11px;
    out property <length> body: phone ? 16px : 12px;
    out property <length> subtitle: phone ? 16px : 13px;
    out property <length> title: phone ? 17px : 14px;
    out property <length> heading: phone ? 22px : 16px;
    out property <length> display: phone ? 28px : 24px;
    out property <length> icon-size: phone ? 20px : 14px;
    out property <length> icon-large: phone ? 24px : 18px;

    // Spacing steps — Style.spacing.* in QML.
    out property <length> sp-sm: 6px;
    out property <length> sp-md: 10px;
    out property <length> sp-lg: 14px;
    out property <length> sp-xl: 20px;
}
