// ThreadsPage — every thread in a room, most recently active first (server
// order). Opening one is not a special view: the engine builds a
// thread-focused timeline and the ordinary chat page renders it
// (ThreadsPage.qml). Chat-theme tones arrive pre-mixed via `accent`;
// the full ChatPage derivation is noted in WIRING-spaces.md.
//
// On the phone the browser arrives out of the conversation in the same three
// beats the conversation itself arrives in (chat.slint:90-109, map.slint
// :153-190): the header's furniture lets go and the word "Threads" comes in
// from the right (head-t), then the list's ground rises from the page bottom
// (list-t), and only once those have landed do the rows follow it up
// (foot-t) — the beat the conversation spends on its composer. Leaving plays
// the three in reverse; the holder in app.slint waits for it (`hold`).

import { TouchList, Beats } from "../furniture.slint";
import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { ThreadRow } from "../model.slint";

export component ThreadsPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <string> room-name;
    in property <[ThreadRow]> threads;
    in property <bool> loading;
    in property <bool> loaded;
    /// A chat theme accent is set for this room (ThreadsPage.qml:21).
    in property <bool> themed: false;

    // The conversation's own bar, so the phone's header can start as an exact
    // copy of it and morph out of it (map.slint:132-146).
    in property <string> room-subtitle;
    in property <image> room-avatar;
    in property <string> room-initials;
    in property <color> room-tint: Theme.accent;
    /// The tone the conversation's header settled on (chat.slint's `top-rest`),
    /// so the bar this page morphs is the very same colour.
    in property <color> header-c: Theme.card-ground;

    callback closed;
    callback thread-picked(string);

    // ThreadsPage.qml:20-32, exactly as ChatPage mixes them: surfaceC is
    // lighter(menu.bg, 1.35) with 35 % accent when themed; chromeC is that
    // surface, else lighter(menu.bg, 1.35); convoC is darker(menu.bg, 1.35)
    // with 18 % accent only when themed.
    property <color> surface-c: root.themed
        ? Theme.menu-background.brighter(0.35).mix(root.accent, 0.65)
        : Theme.popup-background;
    property <color> chrome-c: root.themed ? root.surface-c : Theme.menu-background.brighter(0.35);
    // The conversation's ground, chat.slint:372-375 verbatim: the phone's light
    // palette is near white and darkening it reads as grey, so there the sheet
    // sits on the card ground instead.
    property <color> convo-base: root.phone && Theme.mode == "light"
        ? Theme.card-ground : Theme.menu-background.darker(0.35);
    property <color> convo-c: root.themed
        ? root.convo-base.mix(root.accent, 0.82)
        : root.convo-base;

    /// The page is the one on the stack (app.slint's threads holder).
    ///
    /// The clocks come from the shared `Beats` (furniture.slint), which also
    /// carries the reason they are elapsed time rather than a `states`
    /// transition: a transition can only play a change the state machine
    /// saw, and nothing draws this page while it is put away, so it used to
    /// wake already at rest on any arrival no departure had been drawn for.
    in property <bool> phone: Theme.mode != "desktop";
    in property <bool> opened: true;
    beats := Beats { opened: root.opened; phone: root.phone; }
    property <float> head-t: beats.head-t;
    property <float> list-t: beats.body-t;
    property <float> foot-t: beats.foot-t;
    property <float> list-e: beats.body-e;
    property <float> foot-e: beats.foot-e;
    // The conversation's furniture lets go over the first 45% of the header
    // beat; the word arrives over the last 65%, so the bar is bare in between.
    property <float> shed: max(0.0, 1 - root.head-t / 0.45);
    property <float> word-t: clamp((root.head-t - 0.35) / 0.65, 0.0, 1.0);
    property <float> word-e: 1 - (1 - root.word-t) * (1 - root.word-t) * (1 - root.word-t);
    property <length> header-h: root.phone ? 60px : 56px;
    /// What sits under the status bar: the header's own ground, so the inset
    /// reads as part of the page (chat.slint's `top-ground`).
    out property <color> top-ground: root.phone ? root.header-c : root.chrome-c;

    background: root.phone ? root.header-c : root.chrome-c;

    // Absolute rather than stacked: on the phone the ground rises from the
    // page bottom while the header stays put, so the two move independently.
    Rectangle {
        width: 100%; height: 100%;

        header := Rectangle {
            x: 0; y: 0; width: parent.width; height: root.header-h;
            background: transparent;
            clip: true;
            // ThreadsPage.qml:80-91: PanelActionButton (22×22) at 6, the title
            // column 6 past it (x 34) and 14 short of the right edge.
            if !root.phone : HorizontalLayout {
                padding-left: 6px; padding-right: 14px;
                spacing: 6px;
                Rectangle {
                    width: 22px;
                    ActionButton {
                        y: (56px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Threads";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.heading;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.count-line;
                        color: root.fg.with-alpha(0.55);
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        overflow: elide;
                    }
                }
            }
            // The phone's bar, in chat.slint's own geometry (:586-592): a 24px
            // back glyph in a 48 target at 4, the 40 avatar at 56, the title at
            // 108, three 48 targets from the right 8 apart and 8 in.
            if root.phone : phone-bar := Rectangle {
                width: 100%; height: 100%;
                // The back arrow is the one thing that stays: it is already
                // under the finger that opened the page, and it does not move.
                back-target := Rectangle {
                    x: 4px; y: 6px; width: 48px; height: 48px; border-radius: 24px;
                    background: back-t.pressed ? root.fg.with-alpha(0.10)
                              : back-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.back; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    back-t := TouchArea { clicked => { root.closed(); } }
                }
                // Everything the conversation had, fading out where it stood:
                // the room's face, its name and subtitle, and the trailing
                // glyphs. They belong to the page underneath, so they are a
                // picture of it — nothing here is tappable.
                if root.shed > 0 : Rectangle {
                    width: 100%; height: 100%;
                    opacity: root.shed;
                    Avatar {
                        x: 56px; y: 10px; size: 40px;
                        source: root.room-avatar;
                        initials: root.room-initials;
                        tint: root.room-tint;
                        status-backdrop: root.header-c;
                    }
                    VerticalLayout {
                        x: 108px; y: 0; height: 100%;
                        width: max(0px, phone-bar.width - 176px - 108px);
                        alignment: center;
                        Text {
                            text: root.room-name;
                            color: root.fg;
                            font-family: Theme.font-ui; font-size: 17px; font-weight: 500;
                            overflow: elide;
                        }
                        if root.room-subtitle != "" : Text {
                            text: root.room-subtitle;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui; font-size: 13px;
                            overflow: elide;
                        }
                    }
                    for g[i] in [Icons.phone, Icons.videoOn, Icons.moreVertical] : Rectangle {
                        x: phone-bar.width - 168px + i * 56px; y: 6px;
                        width: 48px; height: 48px;
                        IconLabel { text: g; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    }
                }
                // … and then the word, in from the right edge onto the spot
                // the conversation's own title held, with the count under it.
                VerticalLayout {
                    x: 56px + (phone-bar.width - 56px) * (1 - root.word-e);
                    y: 0; height: 100%;
                    width: max(0px, phone-bar.width - 72px);
                    alignment: center;
                    opacity: root.word-t;
                    Text {
                        text: "Threads";
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: 19px; font-weight: 500;
                        overflow: elide;
                    }
                    Text {
                        text: root.count-line;
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: 13px;
                        overflow: elide;
                    }
                }
            }
        }

        // Until the ground arrives the conversation's own sheet stands under
        // the header — the page opens over the chat, so what it stands on is
        // the chat's ground, in the tone chat.slint paints it (`convo-paint`,
        // :386-387): the same colour this page's own ground is about to be, so
        // the arrival changes the rows and nothing else.
        if root.phone && root.list-t < 1 : Rectangle {
            x: 0; y: root.header-h; width: 100%;
            height: parent.height - root.header-h;
            background: root.convo-c.mix(root.header-c, 0.94);
            border-top-left-radius: 28px; border-top-right-radius: 28px;
        }

        // The second beat: once the header has settled, the ground rises from
        // the page's bottom edge on an OutCubic, exactly as the conversation's
        // sheet does (chat.slint:733-750).
        ground := Rectangle {
            x: 0; width: parent.width;
            height: parent.height - root.header-h;
            y: root.header-h + (parent.height - root.header-h) * (1 - root.list-e);
            background: root.convo-c;
            border-top-left-radius: root.phone ? 28px : 24px;
            border-top-right-radius: root.phone ? 28px : 24px;
            clip: true;

            // 46px highlight across the rounded top (ChatPage.qml:966).
            if root.phone : Rectangle {
                x: 0; y: 0; width: 100%; height: 46px;
                background: @linear-gradient(180deg,
                    Theme.menu-background.brighter(0.35).with-alpha(0.3) 0%,
                    transparent 100%);
            }

            // The third beat: the rows follow the ground up, the room the
            // conversation gives its composer. Everything inside the ground
            // rides one lift, so an empty page arrives the same way a full
            // one does.
            // The `if` is thrift, and nothing more. It was once load-bearing —
            // an attempt to keep the third beat honest by having a condition,
            // evaluated with the item tree, read the clock that an off-screen
            // opacity would not. Measured, it does not work: with the page
            // never drawn while it is put away, the arrival still woke at
            // rest. The clocks come off elapsed time now (furniture.slint's
            // `Beats`), so the gate carries no weight and is safe to keep.
            if root.foot-t > 0 : body := Rectangle {
                x: 0; width: 100%; height: 100%;
                y: 24px * (1 - root.foot-e);
                opacity: root.foot-t;

                // Empty and loading say different things.
                if root.threads.length == 0 : VerticalLayout {
                    alignment: center;
                    padding-left: 30px; padding-right: 30px;
                    spacing: 10px;
                    IconLabel {
                        text: Icons.thread;
                        color: root.accent.with-alpha(0.8);
                        font-size: 44px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.loading || !root.loaded ? "Looking for threads…" : "No threads yet";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    if root.loaded && !root.loading : Text {
                        text: "Swipe a message toward its own edge, or use its menu, to start one.";
                        color: root.fg.with-alpha(0.6);
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.threads.length > 0 : TouchList {
                    y: 6px;
                    width: 100%; height: ground.height - 6px;
                    for thread in root.threads : trow := Rectangle {
                        height: 64px;
                        Rectangle {
                            x: 8px; width: trow.width - 16px;
                            y: 4px; height: trow.height - 8px;
                            border-radius: 14px;
                            background: trow-t.pressed || trow-t.has-hover
                                ? root.fg.with-alpha(0.05) : transparent;
                        }
                        // ThreadsPage.qml:176-229: avatar 44 at 16, centred; text
                        // 12 past it and 10 short of the stamp, which sits 16
                        // from the right.
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            spacing: 0px;
                            Rectangle {
                                width: 44px;
                                Avatar {
                                    y: (trow.height - self.height) / 2;
                                    size: 44px;
                                    source: thread.avatar;
                                    initials: thread.initials;
                                    tint: thread.tint;
                                }
                            }
                            Rectangle { width: 12px; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: thread.sender-name;
                                    color: root.fg;
                                    font-family: Theme.font-ui;
                                    font-size: Theme.subtitle;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    if thread.reply-count > 0 : Text {
                                        text: thread.reply-count == 1 ? "1 reply" : "\{thread.reply-count} replies";
                                        color: root.accent.with-alpha(0.9);
                                        font-family: Theme.font-ui;
                                        font-size: Theme.body-small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: thread.body != "" ? thread.body : "Thread";
                                        color: root.fg.with-alpha(0.55);
                                        font-family: Theme.font-ui;
                                        font-size: Theme.body-small;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            Rectangle { width: 10px; }
                            Text {
                                text: thread.last-ts-label;
                                color: root.fg.with-alpha(0.45);
                                font-family: Theme.font-ui;
                                font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                        }
                        trow-t := TouchArea { clicked => { root.thread-picked(thread.root-id); } }
                    }
                }
            }
        }
    }

    // A subtitle that appears only once the count lands makes the title jump
    // on load, so it is unconditional.
    property <string> count-line: root.threads.length == 0 ? root.room-name
        : root.threads.length == 1 ? "\{root.room-name} · 1 thread"
        : "\{root.room-name} · \{root.threads.length} threads";
}
