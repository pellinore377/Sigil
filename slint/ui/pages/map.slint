// Full-page view of a shared location — MapPage.qml. Slint has no map
// widget (QML gets MapLibre through QtLocation), so the engine rasterises
// the tiles and this page is the map: a grid of single rendered tiles
// (map.tile) the bridge places for a centre and a zoom it keeps, so the
// page drags with the finger and steps in and out about what was tapped.
// A server that renders composites but not single tiles keeps the old
// still picture centred on the point; with neither, the pin card remains
// and says so. The phone opens the page the way it opens a conversation.
// The attachment sheet's LocationPicker lives in attach.slint now, on the
// same imagery; it borrows SelfPin from here.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { Beats } from "../furniture.slint";

// MapView.qml:172-274 — your own position: the filled `place` glyph (48px) in
// the pin colour with the face masked into its head (the hole centres at
// 0.4896 across, 0.4062 down, radius 0.26 of the box), and while a live share
// runs, two staggered broadcast arcs radiating from the face. No avatar
// leaves the plain pin (:156-169).
export component SelfPin inherits Rectangle {
    in property <color> pin-color: Theme.accent;
    in property <image> avatar;
    in property <bool> ripple: false;
    /// The location category's own glyph (Icons.myLocation / liveLocation /
    /// pinDrop), worn as a small disc on the pin's shoulder so the marker
    /// carries the same icon the attach sheet's tile for that category does.
    /// Empty (the picker's use) leaves the plain pin.
    in property <string> badge;
    width: 48px; height: 48px;
    background: transparent;
    property <length> head-cx: 48px * 0.4896;
    property <length> head-cy: 48px * 0.4062;
    property <length> head-r: 48px * 0.26;

    // MapView.qml:193-236 — each ring is two 68° arcs (−34°…34° and
    // 146°…214°) of radius 1.7×headR, stroke 2, about the face; index i
    // pauses i×850ms then fades 0.8→0 and grows 0.8→2.2 over 1700ms OutCubic,
    // looping (the pause is inside the loop, as in the SequentialAnimation),
    // scaled about the box centre (:200 transformOrigin: Item.Center). The
    // arcs are exactly the part of the full ring inside a band of half-height
    // r·sin 34° about the face, so they are drawn as a bordered ring clipped
    // to that band, with the scale applied to the geometry itself: that draws
    // in every renderer (the software renderer has neither Path nor scale).
    for i in (root.ripple ? 2 : 0) : wave := Rectangle {
        property <float> cycle: i * 850 + 1700;
        property <float> u: mod(animation-tick() / 1ms, self.cycle);
        property <float> p: self.u < i * 850 ? -1.0 : (self.u - i * 850) / 1700;
        property <float> e: 1 - pow(1 - self.p, 3.0);
        property <float> s: self.p < 0 ? 0.8 : 0.8 + 1.4 * self.e;
        property <length> r: root.head-r * 1.7 * self.s;
        property <length> cx: 24px + (root.head-cx - 24px) * self.s;
        property <length> cy: 24px + (root.head-cy - 24px) * self.s;
        property <length> hh: root.head-r * 1.7 * 0.5592 * self.s;   // r·sin 34°
        x: self.cx - self.r - 2px; y: self.cy - self.hh;
        width: self.r * 2 + 4px; height: self.hh * 2;
        clip: true;
        background: transparent;
        opacity: self.p < 0 ? 0 : 0.8 * (1 - self.e);
        Rectangle {
            x: 2px; y: wave.hh - wave.r;
            width: wave.r * 2; height: wave.r * 2;
            border-radius: wave.r;
            border-width: 2px * wave.s;
            border-color: root.pin-color;
            background: transparent;
        }
    }
    IconLabel {
        text: Icons.location;
        filled: true;
        color: root.pin-color;
        font-size: 48px;
        width: 48px; height: 48px;
    }
    if root.avatar.width > 0 : face := Rectangle {
        x: root.head-cx - root.head-r; y: root.head-cy - root.head-r;
        width: root.head-r * 2; height: root.head-r * 2;
        border-radius: root.head-r;
        clip: true;
        Image { source: root.avatar; width: 100%; height: 100%; image-fit: cover; }
    }
    // The category's glyph on the pin's shoulder, in the attach tile's own
    // arrangement: the icon centred on a filled disc. The disc is the dark
    // one, not the pin's colour — on the pin's own colour it would read as a
    // hole punched in the head rather than as a badge worn on it.
    if root.badge != "" : Rectangle {
        x: 30px; y: 0;
        width: 18px; height: 18px;
        border-radius: 9px;
        background: #141414;
        IconLabel {
            text: root.badge;
            filled: true;
            color: root.pin-color;
            font-size: 12px;
            width: 100%; height: 100%;
        }
    }
}

/// One rendered tile, placed by the bridge: the map is a grid of these, not
/// a single picture, so it can be dragged and zoomed. `x`/`y` are its top-left
/// inside the map area and `w`/`h` its drawn size, all in logical pixels.
///
/// The size is per tile and per axis rather than one side for the whole grid
/// because of the seams: at a fractional magnification a tile's edges fall
/// between device pixels, a renderer rounds the position and the side apart,
/// and the pixel they disagree over shows the ground through the join. The
/// bridge rounds both of a tile's edges onto whole device pixels and hands the
/// difference over as the size — plus one pixel of overlap, so a renderer that
/// truncates has no crack to show either. See `mapview::MapView::place`.
/// `sx`/`sy`/`sw`/`sh` are the part of `img` to draw, in the picture's OWN
/// pixels. For a tile that has arrived it is the whole picture; where one has
/// not, the bridge stands its parent in and crops that parent to the quarter
/// (or sixteenth, two levels up) this tile's ground occupies inside it, so a
/// hole in the grid is covered by blurred imagery instead of being a hole.
/// See `mapview::MapView::layout`.
export struct MapTileView {
    x: length, y: length, w: length, h: length,
    sx: int, sy: int, sw: int, sh: int,
    img: image,
}

export component MapPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    callback closed;
    callback open-osm(string);   // platform::open_url with the map link
    callback stop-live;          // location.stopLive

    // The message being viewed, digested by the bridge (MapPage.qml's locals).
    in property <string> who;              // "You" or the sender
    in property <bool> own;
    in property <bool> live;               // running live share
    in property <bool> ended;              // live share whose window passed
    in property <bool> stoppable;          // ours AND still publishing
    in property <bool> openable;
    in property <string> status-text;      // "Sharing until 3:00 PM" / "Shared 2:41 PM"
    in property <string> remaining-label;  // "1h 05m" / "3:41", ticked by the bridge
    in property <float> lat;
    in property <float> lon;
    in property <string> description;      // unused: MapPage.qml never shows loc.description
    in property <bool> self-marker;        // m.self / live: face, not a pin
    in property <image> sender-avatar;
    /// An image that is never set, so it is empty: what the marker wears in
    /// its head for a dropped point, which is nothing (MapPage.qml:48).
    property <image> no-face;
    in property <string> sender-initials;
    in property <color> sender-tint: Theme.accent;
    in-out property <string> toast;
    // The room the point was shared in, so the phone's header can start as
    // the conversation's own and morph out of it.
    in property <string> room-name;
    in property <string> room-subtitle;
    in property <image> room-avatar;
    in property <string> room-initials;
    in property <color> room-tint: Theme.accent;
    /// The room carries a chat theme: the header band and the footer sheet
    /// take the conversation's tones instead of the plain chrome.
    in property <bool> themed;
    /// The conversation header's ground (chat.slint's `top-ground`), so the
    /// bar the page morphs out of is the very same colour.
    in property <color> header-c: Theme.card-ground;
    /// The themed chrome surface (chat.slint's `surface-c`) the footer sheet
    /// sits on.
    in property <color> surface-c: Theme.popup-background;
    /// The gesture inset below the page. The window paints nothing there for
    /// this page (`bottom-ground` is transparent), so the map and the footer
    /// run on down through it and the bar shows the page, not a strip.
    in property <length> bleed-bottom: 0px;
    out property <color> bottom-ground: Colors.transparent;

    /// The phone opens this page out of the conversation, in three beats:
    /// the header's furniture lets go and "Location" arrives from the right
    /// (head-t), then the map rises from the bottom (map-t), and only once
    /// those have landed does the footer follow it up (foot-t). Closing plays
    /// the three in reverse — the holder in app.slint waits for it (`hold`).
    ///
    /// The clocks come from the shared `Beats` (furniture.slint), which also
    /// carries the reason they are elapsed time rather than a `states`
    /// transition: a transition can only play a change the state machine
    /// saw, and nothing draws this page while it is put away, so it used to
    /// wake already at rest on any arrival no departure had been drawn for.
    in property <bool> phone: Theme.mode != "desktop";
    in property <bool> opened: true;
    beats := Beats { opened: root.opened; phone: root.phone; }
    property <float> head-t: beats.head-t;
    property <float> map-e: beats.body-e;
    property <float> foot-e: beats.foot-e;
    // The conversation's furniture lets go over the first 45% of the header
    // beat; the word arrives over the last 65%, so the bar is bare in between.
    property <float> shed: max(0.0, 1 - root.head-t / 0.45);
    property <float> word-t: clamp((root.head-t - 0.35) / 0.65, 0.0, 1.0);
    property <float> word-e: 1 - (1 - root.word-t) * (1 - root.word-t) * (1 - root.word-t);
    property <length> header-h: root.phone ? 60px : 52px;

    /// Which of the attachment sheet's three location tiles this point came
    /// from, so every glyph on the page is that category's own: a running or
    /// finished share is Live Location, your own fix is Current Location,
    /// anything else is a dropped pin (attach.slint:554-561).
    property <string> category: root.live || root.ended ? "live"
        : root.self-marker ? "current" : "pin";
    property <string> cat-icon: root.category == "live" ? Icons.liveLocation
        : root.category == "current" ? Icons.myLocation : Icons.pinDrop;
    // The engine's composite, centred on the point; empty until location.map
    // lands. It is the still fallback: with a tile server the page draws the
    // grid below instead, which drags and zooms.
    in property <image> map-image;
    callback zoom-requested(int);          // +1 / −1; the bridge clamps 3..19
    property <bool> has-map: root.map-image.width > 0;

    /// The visible tiles, placed by the bridge for the current centre and
    /// zoom (map.tile, one rendered tile each).
    in property <[MapTileView]> tiles;
    /// The shared point inside the map area, so the marker travels with the
    /// map as it is dragged.
    in property <length> pin-x: -1000px;
    in property <length> pin-y: -1000px;
    property <bool> tiled: root.tiles.length > 0;
    /// The map area's size, so the bridge knows how much grid to place.
    callback viewport(length, length);
    /// Dragged by this much, in logical pixels.
    callback panned(length, length);
    /// A step in or out about a point in the map area (a double tap).
    callback zoom-at(int, length, length);
    /// Two fingers went down: the bridge remembers where the view was, so
    /// every step of the pinch is measured from there.
    callback pinch-begin();
    /// The fingers have spread by this much since they went down, with their
    /// midpoint here in the map area: the view magnifies about it.
    callback pinched(float, length, length);
    /// The fingers lifted: the level the tiles come from settles, the zoom
    /// stays exactly where they left it.
    callback pinch-end();
    /// Two fingers are on the map: the drag area holds its peace (see below).
    property <bool> pinch-live: false;

    property <color> chip: Theme.background.with-alpha(0.85);
    // MapPage.qml:44, 47 — openable = pin || (liveKind && live && !own), where
    // pin = !selfMarker && haveFix. The app's `openable` ANDs in (it is `true`
    // today; the bridge may compute it instead — handoff).
    property <bool> can-open: root.openable
        && ((!root.self-marker && (root.lat != 0 || root.lon != 0)) || (root.live && !root.own));

    background: transparent;

    // MapPage.qml:152-154 — note() holds a toast for 2200ms.
    toast-clear := Timer {
        interval: 2200ms;
        running: root.toast != "";
        triggered => { root.toast = ""; self.running = false; }
    }

    // Absolute rather than stacked: on the phone the map rises from the page
    // bottom while the header stays put, so the two move independently.
    Rectangle {
        width: 100%; height: 100%;
        // Header (MapPage.qml:158-178 — its own, not the settings header).
        // The phone's is the conversation's bar carried across and morphed:
        // it starts as an exact copy of chat.slint's phone-bar at rest, so
        // nothing appears to move when the page arrives, and then everything
        // but the back arrow lets go and the word "Location" comes in from
        // the right. Its ground is the conversation's own (`header-c`).
        header := Rectangle {
            x: 0; y: 0; width: parent.width; height: root.header-h;
            background: root.phone ? root.header-c : Colors.transparent;
            clip: true;
            if !root.phone : Rectangle {
                width: 100%; height: 100%;
                // :162-169 — 22px PanelActionButton at leftMargin 6.
                back-btn := ActionButton {
                    x: 6px; y: (52px - 22px) / 2;
                    width: 22px; height: 22px;
                    icon: Icons.back;
                    foreground: root.fg;
                    clicked => { root.closed(); }
                }
                // :170-177 — title at backBtn.right + 8 = 36, rightMargin 12.
                Text {
                    x: 36px; width: header.width - 36px - 12px; height: 100%;
                    text: "Location";
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.subtitle;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // The phone's bar, in chat.slint's own geometry (:568-571): a 24px
            // back glyph in a 48 target at 4, the 40 avatar at 56, the title at
            // 108, three 48 targets from the right 8 apart and 8 in.
            if root.phone : phone-bar := Rectangle {
                width: 100%; height: 100%;
                // The back arrow is the one thing that stays: it is already
                // under the finger that opened the page, and it does not move.
                back-target := Rectangle {
                    x: 4px; y: 6px; width: 48px; height: 48px; border-radius: 24px;
                    background: back-t.pressed ? root.fg.with-alpha(0.10)
                              : back-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.back; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    back-t := TouchArea { clicked => { root.closed(); } }
                }
                // Everything the conversation had, fading out where it stood:
                // the room's face, its name and subtitle, and the trailing
                // glyphs. They belong to the page underneath, so they are a
                // picture of it — nothing here is tappable.
                if root.shed > 0 : Rectangle {
                    width: 100%; height: 100%;
                    opacity: root.shed;
                    Avatar {
                        x: 56px; y: 10px; size: 40px;
                        source: root.room-avatar;
                        initials: root.room-initials;
                        tint: root.room-tint;
                        status-backdrop: root.header-c;
                    }
                    VerticalLayout {
                        x: 108px; y: 0; height: 100%;
                        width: max(0px, phone-bar.width - 176px - 108px);
                        alignment: center;
                        Text {
                            text: root.room-name;
                            color: root.fg;
                            font-family: Theme.font-ui; font-size: 17px; font-weight: 500;
                            overflow: elide;
                        }
                        if root.room-subtitle != "" : Text {
                            text: root.room-subtitle;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui; font-size: 13px;
                            overflow: elide;
                        }
                    }
                    for g[i] in [Icons.phone, Icons.videoOn, Icons.moreVertical] : Rectangle {
                        x: phone-bar.width - 168px + i * 56px; y: 6px;
                        width: 48px; height: 48px;
                        IconLabel { text: g; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    }
                }
                // … and then the word, in from the right edge onto the spot
                // the conversation's own title held.
                Text {
                    x: 56px + (phone-bar.width - 56px) * (1 - root.word-e);
                    y: 0; height: 100%;
                    width: max(0px, phone-bar.width - 72px);
                    text: "Location";
                    color: root.fg;
                    font-family: Theme.font-ui; font-size: 19px; font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    opacity: root.word-t;
                }
            }
        }

        // The "map" area: rounded top, fg@0.08 ground (MapPage.qml:216), the
        // marker and one caption as a card.
        map-area := Rectangle {
            x: 0;
            width: parent.width;
            // The page ALREADY runs on down through the gesture inset: with
            // this page up the window is `to-the-edge` (app.slint:57), so
            // `content` is the whole height and this box's own bottom edge is
            // the screen's. Adding `bleed-bottom` here as well counted the
            // inset twice — it pushed the map area, and the sheet anchored to
            // its foot, that far past the bottom of the screen, which is why
            // the person's row came out under the gesture bar. The inset is
            // reserved once, inside the sheet, the way chat.slint's composer
            // reserves `bottom-inset` in its own height.
            height: parent.height - root.header-h;
            // The second beat: once the header has settled, the map rises
            // from the page's bottom edge on an OutCubic (chat.slint:719).
            y: root.header-h + (parent.height - root.header-h) * (1 - root.map-e);
            background: root.fg.with-alpha(0.08);
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            clip: true;
            // The bridge places the grid for this box, so it has to know it.
            changed width => { root.viewport(self.width, self.height); }
            changed height => { root.viewport(self.width, self.height); }
            init => { root.viewport(self.width, self.height); }

            // The rendered composite; its centre is the shared point. It
            // stands in until the grid has tiles, and stays for a server that
            // serves composites but no single tiles.
            if root.has-map && !root.tiled : Image {
                width: 100%; height: 100%;
                source: root.map-image;
                image-fit: cover;
            }

            // The live map: a grid the bridge places for the current centre
            // and zoom. Dragging moves the centre and the grid follows in the
            // same frame, so the map tracks the finger.
            if root.tiled : Rectangle {
                width: 100%; height: 100%;
                // The rows come back to front: the bridge puts every borrowed
                // tile first and the real ones over them, so imagery arriving
                // covers the stand-in it replaces.
                for t in root.tiles : Image {
                    x: t.x; y: t.y;
                    width: t.w; height: t.h;
                    source: t.img;
                    // Which part of the picture: the whole of it for a tile of
                    // its own, one quarter of a parent standing in for a tile
                    // that has not landed yet.
                    source-clip-x: t.sx;
                    source-clip-y: t.sy;
                    source-clip-width: t.sw;
                    source-clip-height: t.sh;
                    image-fit: fill;
                }
            }
            // Two fingers. Slint's TouchArea is single-pointer, but the
            // runtime recognises a pinch from the raw touch points and hands
            // it over whole: `scale` is the spread since the fingers went
            // down and `center` their midpoint, so the map magnifies smoothly
            // about the spot between them and settles on a whole zoom when
            // they lift (viewer.slint:336-348 does the same for a picture).
            // It is declared before the drag area, exactly as there: while a
            // pinch runs it intercepts, so the two never fight.
            if root.tiled : ScaleRotateGestureHandler {
                width: 100%; height: 100%;
                // The drag area below is still holding the first finger when
                // the second lands. Left to itself it pans by that finger's
                // travel while the pinch pans by the midpoint's, so the map
                // moves twice for one gesture — a good part of what made a
                // pinch feel finicky. `pinch-live` says a two-finger touch has
                // stopped being a drag; the drag area keeps its anchor fresh
                // meanwhile, so when a finger lifts and the other slides on,
                // panning resumes from where that finger is rather than
                // jumping by everything the pinch covered.
                started => { root.pinch-live = true; root.pinch-begin(); }
                updated => { root.pinched(self.scale, self.center.x, self.center.y); }
                ended => { root.pinch-live = false; root.pinch-end(); }
                cancelled => { root.pinch-live = false; root.pinch-end(); }
            }
            // Declared before the marker, the chips and the sheet, so all of
            // those still take their own taps.
            if root.tiled : drag := TouchArea {
                width: 100%; height: 100%;
                property <length> last-x;
                property <length> last-y;
                property <bool> dragging: false;
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                        self.dragging = true;
                    }
                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        self.dragging = false;
                    }
                }
                moved => {
                    // Under a pinch the anchor is kept up to date but nothing
                    // is panned: the pinch is already moving the map by its
                    // midpoint. Keeping it fresh is the point — when one
                    // finger lifts and the other slides on, the pan carries on
                    // from where that finger is instead of lurching by
                    // everything the two of them covered.
                    if (root.pinch-live) {
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                    } else if (self.dragging) {
                        root.panned(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                    }
                }
                // A double tap zooms in on what was tapped, as every map does.
                double-clicked => { root.zoom-at(1, self.mouse-x, self.mouse-y); }
                // …and the desktop's own gesture, the wheel, about the pointer.
                // With this the page needs no +/− chips over the live map, and
                // the QML has none (MapPage.qml has only the recentre disc).
                scroll-event(e) => {
                    if (e.delta-y != 0) {
                        root.zoom-at(e.delta-y > 0 ? 1 : -1, self.mouse-x, self.mouse-y);
                        return accept;
                    }
                    reject
                }
            }

            // The marker, MapPage.qml:46-48 and MapView.qml:172-274: one pin,
            // wearing the sender's face in its head where the point is a
            // person's own position or a live share (`markerAvatar`), and the
            // same pin bare where it is a dropped point. It carries no badge —
            // the category's glyph on its shoulder is a dark disc, and against
            // pale imagery that disc is the only part of the marker with any
            // contrast, so the whole thing reads as a black target rather than
            // as a pin. The glyph still names the category down in the sheet,
            // where it has a dark ground to sit on.
            //
            // On the grid the marker stands on its own point and travels with
            // the map; its tip is the bottom of its box.
            if root.tiled : SelfPin {
                x: root.pin-x - 24px; y: root.pin-y - 48px;
                pin-color: root.accent;
                avatar: root.self-marker ? root.sender-avatar : root.no-face;
                ripple: root.live;
            }

            if !root.tiled : place-col := VerticalLayout {
                x: 24px;
                width: map-area.width - 48px;
                y: root.has-map
                    ? map-area.height / 2 - self.preferred-height
                    : (map-area.height - sheet.height - self.preferred-height) / 2;
                height: self.preferred-height;
                spacing: 10px;
                // MapPage.qml:274-280 — the same one marker as on the grid, so
                // a point looks like itself whether or not there are tiles
                // under it: the face in the pin for a person's own position,
                // the bare pin for a dropped one.
                HorizontalLayout {
                    alignment: center;
                    SelfPin {
                        pin-color: root.accent;
                        avatar: root.self-marker ? root.sender-avatar : root.no-face;
                        ripple: root.live;
                    }
                }
                // :281-291 — one caption, fg@0.6, wrapped and centred.
                if !root.has-map : Text {
                    text: "No map server is set for this account — open the point in your browser.";
                    color: root.fg.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Time remaining, top left: the same chip the bubble carries
            // (MapPage.qml:297-349). Width is the row + 22 with the row
            // centred — no inner padding.
            if root.live || root.ended : countdown := Rectangle {
                x: 12px; y: 12px;
                width: chip-row.preferred-width + 22px;
                height: 28px;
                border-radius: 14px;
                background: root.chip;
                chip-row := HorizontalLayout {
                    x: (countdown.width - self.preferred-width) / 2;
                    width: self.preferred-width;
                    height: 100%;
                    spacing: 6px;
                    Rectangle {
                        y: (28px - 7px) / 2;
                        width: 7px; height: 7px; border-radius: 3.5px;
                        background: root.live ? #e8646a : #ececec.with-alpha(0.5);
                        // :325-330 — live: a linear ramp 1→0.3→1, 800ms each way.
                        property <float> ph: mod(animation-tick() / 1600ms, 1.0);
                        opacity: root.live
                            ? (self.ph < 0.5 ? 1 - 1.4 * self.ph : 0.3 + 1.4 * (self.ph - 0.5))
                            : 1.0;
                    }
                    Text {
                        text: root.live ? root.remaining-label : "Live location ended";
                        color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // The recentre disc, top right: MapPage.qml:351-366 — a 38px disc
            // of the same chip tone at margin 12, the `my_location` glyph in
            // the accent, and it puts the view back on the shared point.
            // There is no callback of its own for that, so it goes out as a
            // zoom step of nothing about the point, which the bridge reads as
            // "recentre" (actions.rs, on_map_zoom_at).
            if root.tiled : recentre := Rectangle {
                x: map-area.width - 38px - 12px;
                y: 12px;
                width: 38px; height: 38px; border-radius: 19px;
                background: root.chip;
                IconLabel {
                    text: Icons.recentre;
                    filled: true;
                    color: root.accent;
                    font-size: Theme.icon-size;
                    width: 100%; height: 100%;
                }
                TouchArea { clicked => { root.zoom-at(0, root.pin-x, root.pin-y); } }
            }

            // Zoom the still composite in or out; the bridge re-requests at
            // ±1. Only the composite: it is one picture with no gesture on it,
            // so the chips are the only way to zoom it at all. The live grid
            // pinches, double-taps and takes the wheel, and the QML carries no
            // chips over a map, so it has none here either.
            if root.has-map && !root.tiled : zoom-chips := VerticalLayout {
                x: map-area.width - 34px - 12px;
                y: 12px;
                width: 34px;
                spacing: 8px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: root.chip;
                    Text {
                        text: "+"; color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.zoom-requested(1); } }
                }
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: root.chip;
                    Text {
                        text: "−"; color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.zoom-requested(-1); } }
                }
            }

            // Bottom sheet: who is on the map and the one action (MapPage.qml:371-487).
            // The last beat — it follows the map up, once the map has landed —
            // on the conversation's own chrome surface, and its ground runs on
            // through the gesture inset so the bar is the sheet, not a strip.
            sheet := Rectangle {
                y: map-area.height - self.height * (root.phone ? root.foot-e : 1.0);
                width: 100%;
                // 14 above the column and 18 below it — and then the gesture
                // inset on top of that 18, reserved the once. The sheet's foot
                // is the screen's bottom edge, so its ground fills the inset
                // and the bar shows the sheet; what stands off by the inset is
                // the content inside it. chat.slint's composer is built the
                // same way: `composer-h = well-h + 16px + bottom-inset`, and
                // the send disc sits at `composer.height - disc - 8px -
                // bottom-inset` (chat.slint:507, 1445).
                height: sheet-col.preferred-height + 32px + root.bleed-bottom;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                background: root.themed ? root.surface-c : Theme.popup-background;
                TouchArea { }   // the sheet floats over the card; swallow taps (:382)
                // MapPage.qml:384-389 — anchored to the sheet's top, so it is
                // exactly as tall as its contents. Saying so is not optional:
                // a layout given a position but no height fills its parent
                // instead, and the sheet's height is *derived* from this one's
                // preferred height, so the column ended up 14px + whatever the
                // gesture inset added taller than the room it was measuring.
                // Everything under the title was pushed past the map area's
                // clip and off the page — which is where the person's row went.
                sheet-col := VerticalLayout {
                    x: 14px; y: 14px;
                    width: sheet.width - 28px;
                    height: self.preferred-height;
                    spacing: 10px;
                    Text {
                        text: "On the map";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        font-weight: 700;
                    }
                    person-row := Rectangle {
                        height: 60px;
                        border-radius: 18px;
                        background: root.fg.with-alpha(0.10);
                        // :405-416 — the face at 11, draining to 0.55 over 300ms once the share ends.
                        face := Avatar {
                            x: 11px; y: (60px - self.height) / 2;
                            size: 38px;
                            source: root.sender-avatar;
                            initials: root.sender-initials;
                            tint: root.sender-tint;
                            opacity: root.ended ? 0.55 : 1.0;
                            animate opacity { duration: 300ms; }
                        }
                        // :418-448 — labels from face.right + 11 to action.left − 10.
                        labels := VerticalLayout {
                            x: 60px;
                            width: action.x - 10px - 60px;
                            y: (60px - self.preferred-height) / 2;
                            height: self.preferred-height;
                            spacing: 2px;
                            Text {
                                text: root.who;
                                color: root.fg;
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                font-weight: 700;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                // The category's own glyph, as the attach
                                // sheet's tile for it carries (:554-561).
                                IconLabel {
                                    text: root.cat-icon;
                                    filled: true;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: Theme.caption;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.status-text;
                                    color: root.fg.with-alpha(0.6);
                                    font-family: Theme.font-ui;
                                    font-size: Theme.caption;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        // :450-484 — one action: Stop while broadcasting, Open
                        // for a destination; collapsed to nothing otherwise.
                        action := Rectangle {
                            visible: root.stoppable || root.can-open;
                            x: person-row.width - self.width - (self.visible ? 10px : 0px);
                            y: (60px - 34px) / 2;
                            width: self.visible ? action-label.preferred-width + 26px : 0px;
                            height: 34px;
                            border-radius: 17px;
                            background: root.stoppable ? root.fg.with-alpha(0.90) : root.accent.with-alpha(0.90);
                            action-label := Text {
                                text: root.stoppable ? "Stop" : "Open";
                                color: #141414;
                                font-family: Theme.font-ui;
                                font-size: Theme.body-small;
                                font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.stoppable) {
                                        root.stop-live();
                                        root.toast = "Stopped sharing";
                                    } else {
                                        // :478-481 — `geo:` has no desktop handler; the https map link.
                                        root.open-osm("https://www.google.com/maps/search/?api=1&query="
                                            + root.lat + "%2C" + root.lon);
                                        root.toast = "Opened in your browser";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.toast != "" : toast-chip := Rectangle {
                x: (map-area.width - self.width) / 2;
                y: sheet.y - 28px - 12px;
                width: toast-text.preferred-width + 22px;
                height: 28px;
                border-radius: 14px;
                background: Theme.background.with-alpha(0.85);
                toast-text := Text {
                    text: root.toast;
                    color: #ececec;
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
        }
    }
}

