// Full-page view of a shared location — MapPage.qml. Slint has no map
// widget (QML gets MapLibre through QtLocation), so the engine rasterises
// the tiles instead: MapPage shows a location.map composite centred on the
// point, with the marker drawn on top and +/- chips that re-request at
// zoom ±1. Without a configured style the pin card remains, and says so.
// The attachment sheet's LocationPicker lives in attach.slint now, on the
// same imagery; it borrows SelfPin from here.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";

// MapView.qml:172-274 — your own position: the filled `place` glyph (48px) in
// the pin colour with the face masked into its head (the hole centres at
// 0.4896 across, 0.4062 down, radius 0.26 of the box), and while a live share
// runs, two staggered broadcast arcs radiating from the face. No avatar
// leaves the plain pin (:156-169).
export component SelfPin inherits Rectangle {
    in property <color> pin-color: Theme.accent;
    in property <image> avatar;
    in property <bool> ripple: false;
    width: 48px; height: 48px;
    background: transparent;
    property <length> head-cx: 48px * 0.4896;
    property <length> head-cy: 48px * 0.4062;
    property <length> head-r: 48px * 0.26;

    // MapView.qml:193-236 — each ring is two 68° arcs (−34°…34° and
    // 146°…214°) of radius 1.7×headR, stroke 2, about the face; index i
    // pauses i×850ms then fades 0.8→0 and grows 0.8→2.2 over 1700ms OutCubic,
    // looping (the pause is inside the loop, as in the SequentialAnimation),
    // scaled about the box centre (:200 transformOrigin: Item.Center). The
    // arcs are exactly the part of the full ring inside a band of half-height
    // r·sin 34° about the face, so they are drawn as a bordered ring clipped
    // to that band, with the scale applied to the geometry itself: that draws
    // in every renderer (the software renderer has neither Path nor scale).
    for i in (root.ripple ? 2 : 0) : wave := Rectangle {
        property <float> cycle: i * 850 + 1700;
        property <float> u: mod(animation-tick() / 1ms, self.cycle);
        property <float> p: self.u < i * 850 ? -1.0 : (self.u - i * 850) / 1700;
        property <float> e: 1 - pow(1 - self.p, 3.0);
        property <float> s: self.p < 0 ? 0.8 : 0.8 + 1.4 * self.e;
        property <length> r: root.head-r * 1.7 * self.s;
        property <length> cx: 24px + (root.head-cx - 24px) * self.s;
        property <length> cy: 24px + (root.head-cy - 24px) * self.s;
        property <length> hh: root.head-r * 1.7 * 0.5592 * self.s;   // r·sin 34°
        x: self.cx - self.r - 2px; y: self.cy - self.hh;
        width: self.r * 2 + 4px; height: self.hh * 2;
        clip: true;
        background: transparent;
        opacity: self.p < 0 ? 0 : 0.8 * (1 - self.e);
        Rectangle {
            x: 2px; y: wave.hh - wave.r;
            width: wave.r * 2; height: wave.r * 2;
            border-radius: wave.r;
            border-width: 2px * wave.s;
            border-color: root.pin-color;
            background: transparent;
        }
    }
    IconLabel {
        text: Icons.location;
        filled: true;
        color: root.pin-color;
        font-size: 48px;
        width: 48px; height: 48px;
    }
    if root.avatar.width > 0 : face := Rectangle {
        x: root.head-cx - root.head-r; y: root.head-cy - root.head-r;
        width: root.head-r * 2; height: root.head-r * 2;
        border-radius: root.head-r;
        clip: true;
        Image { source: root.avatar; width: 100%; height: 100%; image-fit: cover; }
    }
}

export component MapPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    callback closed;
    callback open-osm(string);   // platform::open_url with the map link
    callback stop-live;          // location.stopLive

    // The message being viewed, digested by the bridge (MapPage.qml's locals).
    in property <string> who;              // "You" or the sender
    in property <bool> own;
    in property <bool> live;               // running live share
    in property <bool> ended;              // live share whose window passed
    in property <bool> stoppable;          // ours AND still publishing
    in property <bool> openable;
    in property <string> status-text;      // "Sharing until 3:00 PM" / "Shared 2:41 PM"
    in property <string> remaining-label;  // "1h 05m" / "3:41", ticked by the bridge
    in property <float> lat;
    in property <float> lon;
    in property <string> description;      // unused: MapPage.qml never shows loc.description
    in property <bool> self-marker;        // m.self / live: face, not a pin
    in property <image> sender-avatar;
    in property <string> sender-initials;
    in property <color> sender-tint: Theme.accent;
    in-out property <string> toast;
    // The engine's composite, centred on the point; empty until location.map lands.
    in property <image> map-image;
    callback zoom-requested(int);          // +1 / −1; the bridge clamps 3..19
    property <bool> has-map: root.map-image.width > 0;

    property <color> chip: Theme.background.with-alpha(0.85);
    // MapPage.qml:44, 47 — openable = pin || (liveKind && live && !own), where
    // pin = !selfMarker && haveFix. The app's `openable` ANDs in (it is `true`
    // today; the bridge may compute it instead — handoff).
    property <bool> can-open: root.openable
        && ((!root.self-marker && (root.lat != 0 || root.lon != 0)) || (root.live && !root.own));

    background: transparent;

    // MapPage.qml:152-154 — note() holds a toast for 2200ms.
    toast-clear := Timer {
        interval: 2200ms;
        running: root.toast != "";
        triggered => { root.toast = ""; self.running = false; }
    }

    VerticalLayout {
        // Header (52px, MapPage.qml:158-178 — its own, not the settings header).
        header := Rectangle {
            height: 52px;
            // :162-169 — 22px PanelActionButton at leftMargin 6.
            back-btn := ActionButton {
                x: 6px; y: (52px - 22px) / 2;
                width: 22px; height: 22px;
                icon: Icons.back;
                foreground: root.fg;
                clicked => { root.closed(); }
            }
            // :170-177 — title at backBtn.right + 8 = 36, rightMargin 12.
            Text {
                x: 36px; width: header.width - 36px - 12px; height: 100%;
                text: "Location";
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.subtitle;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // The "map" area: rounded top, fg@0.08 ground (MapPage.qml:216), the
        // marker and one caption as a card.
        map-area := Rectangle {
            vertical-stretch: 1;
            background: root.fg.with-alpha(0.08);
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            clip: true;

            // The rendered composite; its centre is the shared point.
            if root.has-map : Image {
                width: 100%; height: 100%;
                source: root.map-image;
                image-fit: cover;
            }

            // MapPage.qml:268-292 — the no-map column: parent − 48 wide,
            // spacing 10, centred in the room above the sheet. The marker is
            // MapView.qml's, since the card stands in for the tiles. With a
            // map the caption goes and the marker's tip sits on the point.
            place-col := VerticalLayout {
                x: 24px;
                width: map-area.width - 48px;
                y: root.has-map
                    ? map-area.height / 2 - self.preferred-height
                    : (map-area.height - sheet.height - self.preferred-height) / 2;
                height: self.preferred-height;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    if root.self-marker : SelfPin {
                        pin-color: root.accent;
                        avatar: root.sender-avatar;
                        ripple: root.live;
                    }
                    // MapPage.qml:274-280 — a dropped pin: filled `place`, 46px, accent@0.85.
                    if !root.self-marker : IconLabel {
                        text: Icons.location;
                        filled: true;
                        color: root.accent.with-alpha(0.85);
                        font-size: 46px;
                        width: 46px; height: 46px;
                    }
                }
                // :281-291 — one caption, fg@0.6, wrapped and centred.
                if !root.has-map : Text {
                    text: "Sigil on Slint cannot draw maps yet — open the point in your browser.";
                    color: root.fg.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Time remaining, top left: the same chip the bubble carries
            // (MapPage.qml:297-349). Width is the row + 22 with the row
            // centred — no inner padding.
            if root.live || root.ended : countdown := Rectangle {
                x: 12px; y: 12px;
                width: chip-row.preferred-width + 22px;
                height: 28px;
                border-radius: 14px;
                background: root.chip;
                chip-row := HorizontalLayout {
                    x: (countdown.width - self.preferred-width) / 2;
                    width: self.preferred-width;
                    height: 100%;
                    spacing: 6px;
                    Rectangle {
                        y: (28px - 7px) / 2;
                        width: 7px; height: 7px; border-radius: 3.5px;
                        background: root.live ? #e8646a : #ececec.with-alpha(0.5);
                        // :325-330 — live: a linear ramp 1→0.3→1, 800ms each way.
                        property <float> ph: mod(animation-tick() / 1600ms, 1.0);
                        opacity: root.live
                            ? (self.ph < 0.5 ? 1 - 1.4 * self.ph : 0.3 + 1.4 * (self.ph - 0.5))
                            : 1.0;
                    }
                    Text {
                        text: root.live ? root.remaining-label : "Live location ended";
                        color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Zoom the composite in or out; the bridge re-requests at ±1.
            if root.has-map : zoom-chips := VerticalLayout {
                x: map-area.width - 34px - 12px;
                y: 12px;
                width: 34px;
                spacing: 8px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: root.chip;
                    Text {
                        text: "+"; color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.zoom-requested(1); } }
                }
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: root.chip;
                    Text {
                        text: "−"; color: #ececec;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.zoom-requested(-1); } }
                }
            }

            // Bottom sheet: who is on the map and the one action (MapPage.qml:371-487).
            sheet := Rectangle {
                y: map-area.height - self.height;
                width: 100%;
                height: sheet-col.preferred-height + 32px;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                background: Theme.popup-background;
                TouchArea { }   // the sheet floats over the card; swallow taps (:382)
                sheet-col := VerticalLayout {
                    x: 14px; y: 14px;
                    width: sheet.width - 28px;
                    spacing: 10px;
                    Text {
                        text: "On the map";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        font-weight: 700;
                    }
                    person-row := Rectangle {
                        height: 60px;
                        border-radius: 18px;
                        background: root.fg.with-alpha(0.10);
                        // :405-416 — the face at 11, draining to 0.55 over 300ms once the share ends.
                        face := Avatar {
                            x: 11px; y: (60px - self.height) / 2;
                            size: 38px;
                            source: root.sender-avatar;
                            initials: root.sender-initials;
                            tint: root.sender-tint;
                            opacity: root.ended ? 0.55 : 1.0;
                            animate opacity { duration: 300ms; }
                        }
                        // :418-448 — labels from face.right + 11 to action.left − 10.
                        labels := VerticalLayout {
                            x: 60px;
                            width: action.x - 10px - 60px;
                            y: (60px - self.preferred-height) / 2;
                            height: self.preferred-height;
                            spacing: 2px;
                            Text {
                                text: root.who;
                                color: root.fg;
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                font-weight: 700;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                IconLabel {
                                    text: Icons.recentre;
                                    filled: true;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: Theme.caption;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.status-text;
                                    color: root.fg.with-alpha(0.6);
                                    font-family: Theme.font-ui;
                                    font-size: Theme.caption;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        // :450-484 — one action: Stop while broadcasting, Open
                        // for a destination; collapsed to nothing otherwise.
                        action := Rectangle {
                            visible: root.stoppable || root.can-open;
                            x: person-row.width - self.width - (self.visible ? 10px : 0px);
                            y: (60px - 34px) / 2;
                            width: self.visible ? action-label.preferred-width + 26px : 0px;
                            height: 34px;
                            border-radius: 17px;
                            background: root.stoppable ? root.fg.with-alpha(0.90) : root.accent.with-alpha(0.90);
                            action-label := Text {
                                text: root.stoppable ? "Stop" : "Open";
                                color: #141414;
                                font-family: Theme.font-ui;
                                font-size: Theme.body-small;
                                font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.stoppable) {
                                        root.stop-live();
                                        root.toast = "Stopped sharing";
                                    } else {
                                        // :478-481 — `geo:` has no desktop handler; the https map link.
                                        root.open-osm("https://www.google.com/maps/search/?api=1&query="
                                            + root.lat + "%2C" + root.lon);
                                        root.toast = "Opened in your browser";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.toast != "" : toast-chip := Rectangle {
                x: (map-area.width - self.width) / 2;
                y: sheet.y - 28px - 12px;
                width: toast-text.preferred-width + 22px;
                height: 28px;
                border-radius: 14px;
                background: Theme.background.with-alpha(0.85);
                toast-text := Text {
                    text: root.toast;
                    color: #ececec;
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
        }
    }
}

