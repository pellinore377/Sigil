// AudioPage — mobile/AudioPage.qml. Flat header, full-bleed tinted stage with
// cover art, a rounded shelf carrying the transport. No skip controls: one
// track, nowhere to skip to.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton } from "../components.slint";

export component AudioPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    callback closed;

    in property <string> title;
    in property <string> size-label;
    in property <string> status: "";      // "" | "loading" | "error"
    in property <image> art;
    in property <bool> have-art: false;
    in property <color> tone: Theme.accent;   // audio.info's accent, or fallback
    in property <float> duration: 0;          // seconds
    in property <bool> playing: false;
    in property <float> position: 0;          // seconds, panel playback clock
    in property <string> toast: "";
    in property <bool> can-download: true;

    callback toggle-requested;
    callback seek-requested(float);
    callback download-requested;

    property <float> frac: root.duration > 0 ? max(0, min(1, root.position / root.duration)) : 0;

    function clock(t: float) -> string {
        return floor(t / 60) + ":" + (mod(floor(t), 60) < 10 ? "0" : "") + mod(floor(t), 60);
    }

    background: transparent;

    // AudioPage.qml:48-49 — note() holds a toast for 2600ms. `toast` is bound
    // by the app, so the page hides it rather than clearing it (an assignment
    // would drop the binding); the bridge blanks it first to repeat the same text.
    property <bool> toast-live: root.toast != "";
    changed toast => {
        root.toast-live = root.toast != "";
        if (root.toast-live) { toast-clock.restart(); }
    }
    toast-clock := Timer {
        interval: 2600ms;
        running: false;
        triggered => { root.toast-live = false; self.stop(); }
    }

    header := Rectangle {
        x: 0; y: 0;       // a sized element with no position centres itself in Slint
        height: 52px;
        width: 100%;
        // AudioPage.qml:72-79 — 22px PanelActionButton at leftMargin 6.
        back-btn := ActionButton {
            x: 6px; y: (52px - 22px) / 2;
            width: 22px; height: 22px;
            icon: Icons.back;
            filled: false;
            foreground: root.fg;
            clicked => { root.closed(); }
        }
        // :80-87 — title at backBtn.right + 8 = 36, rightMargin 12.
        Text {
            x: 36px; width: header.width - 36px - 12px; height: 100%;
            text: "Audio";
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.subtitle;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Stage: tinted gradient behind the art, cut at the header with round corners.
    stage := Rectangle {
        y: 52px;
        width: 100%;
        height: root.height - 52px;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        clip: true;
        background: @linear-gradient(180deg, root.tone.darker(1.1) 0%, root.tone.darker(2.0) 100%);

        cover-stack := Rectangle {
            property <length> box: min(stage.width - 56px, 300px);
            // AudioPage.qml:166-167 — playing breathes the art by SCALE,
            // 1.0 / 0.97 over 400ms OutCubic about its centre; drawn as the
            // box's size, since a rounded clip does not survive a transform in
            // every renderer. The art only: the no-art placeholder (:170-191)
            // does not breathe.
            property <length> drawn: self.box * (root.playing || !root.have-art ? 1.0 : 0.97);
            animate drawn { duration: 400ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            x: (stage.width - self.drawn) / 2;
            y: max(10px, (stage.height - shelf.height - self.box) / 2) + (self.box - self.drawn) / 2;
            width: self.drawn; height: self.drawn;
            border-radius: 18px;
            clip: true;
            background: root.have-art ? transparent : #ffffff.with-alpha(0.07);
            if root.have-art : Image {
                source: root.art;
                width: 100%; height: 100%;
                image-fit: cover;
            }
            if !root.have-art && root.status != "loading" : IconLabel {
                text: Icons.music;
                filled: false;
                color: #ffffff.with-alpha(0.5);
                font-size: 72px;
                width: 100%; height: 100%;
            }
            if !root.have-art && root.status == "loading" : Text {
                text: "Reading the track…";
                color: #ffffff.with-alpha(0.5);
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }

        dl-disc := Rectangle {
            x: stage.width - self.width - 12px; y: 12px;
            width: 38px; height: 38px; border-radius: 19px;
            // AudioPage.qml:199 — #000@0.42, no pressed state.
            background: #000000.with-alpha(0.42);
            IconLabel { text: Icons.download; filled: false; color: #ffffff; width: 100%; height: 100%; }
            dl-t := TouchArea {
                enabled: root.can-download;
                clicked => { root.download-requested(); }
            }
        }

        // Shelf
        shelf := Rectangle {
            y: stage.height - self.height;
            width: 100%;
            height: shelf-col.preferred-height + 32px;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            background: Theme.popup-background;
            TouchArea { }
            shelf-col := VerticalLayout {
                x: 16px; y: 14px;
                width: shelf.width - 32px;
                spacing: 10px;
                // AudioPage.qml:235 elides in the middle; the bridge hands a
                // pre-elided title (handoff), this only clips the tail.
                Text {
                    text: root.title;
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    font-weight: 700;
                    overflow: elide;
                }
                // Scrubber (AudioPage.qml:242-284)
                scrub-box := Rectangle {
                    height: 16px;
                    track := Rectangle {
                        y: (16px - 4px) / 2;
                        width: 100%; height: 4px; border-radius: 2px;
                        background: root.fg.with-alpha(0.18);
                        Rectangle {
                            width: track.width * root.frac;
                            height: 100%; border-radius: 2px;
                            background: root.accent;
                        }
                    }
                    knob := Rectangle {
                        x: max(0px, min(track.width - self.width, track.width * root.frac - self.width / 2));
                        y: (16px - self.height) / 2;
                        width: 13px; height: 13px;
                        border-radius: 6.5px;
                        background: root.accent;
                        // :266-267 — grows 1.3× about its centre while pressed, 100ms.
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: scrub-t.pressed ? 1.3 : 1.0;
                        transform-scale-y: scrub-t.pressed ? 1.3 : 1.0;
                        animate transform-scale-x, transform-scale-y { duration: 100ms; }
                    }
                    // :269-283 — the hit target is the row grown 6 on every
                    // side (28 tall); the fraction is measured on the track.
                    scrub-t := TouchArea {
                        x: -6px; y: -6px;
                        width: scrub-box.width + 12px; height: 16px + 12px;
                        enabled: root.duration > 0;
                        clicked => {
                            root.seek-requested((max(0px, min(track.width, self.mouse-x + self.x)) / track.width) * root.duration);
                        }
                        moved => {
                            if (self.pressed) {
                                root.seek-requested((max(0px, min(track.width, self.mouse-x + self.x)) / track.width) * root.duration);
                            }
                        }
                    }
                }
                // Transport + times
                transport := Rectangle {
                    height: 48px;
                    Text {
                        text: root.clock(root.position);
                        color: root.fg.with-alpha(0.6);
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    play-disc := Rectangle {
                        x: (transport.width - self.width) / 2;
                        y: (48px - self.height) / 2;
                        width: 48px; height: 48px; border-radius: 24px;
                        background: root.accent;
                        // AudioPage.qml:303-304 — pressed shrinks to 0.93 over 90ms.
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: play-t.pressed ? 0.93 : 1.0;
                        transform-scale-y: play-t.pressed ? 0.93 : 1.0;
                        animate transform-scale-x, transform-scale-y { duration: 90ms; }
                        IconLabel {
                            text: root.playing ? Icons.pause : Icons.play;
                            color: #141414;
                            font-size: 22px;
                            width: 100%; height: 100%;
                        }
                        play-t := TouchArea { clicked => { root.toggle-requested(); } }
                    }
                    Text {
                        x: transport.width - self.preferred-width;
                        text: root.duration > 0 ? root.clock(root.duration) : root.size-label;
                        color: root.fg.with-alpha(0.6);
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }
            }
        }

        // AudioPage.qml:327-341 — the toast pill, 12 above the shelf, text +
        // 22 wide and never wider than the page − 38.
        if root.toast != "" && root.toast-live : toast-pill := Rectangle {
            x: (stage.width - self.width) / 2;
            y: shelf.y - 40px;
            width: min(toast-text.preferred-width + 22px, stage.width - 38px);
            height: 28px; border-radius: 14px;
            background: Theme.background.with-alpha(0.85);
            toast-text := Text {
                text: root.toast;
                color: #ececec;
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 11px; width: parent.width - 22px; height: 100%;
            }
        }
    }
}
