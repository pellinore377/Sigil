// AddPeoplePage — mobile/AddPeoplePage.qml. Invite people to the current room
// (start-chat style user search). The homeserver's directory only knows local
// users and remote users who share a room here, so empty results are normal.

import { TouchList } from "../furniture.slint";
import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { UserRow } from "../model.slint";

export component AddPeoplePage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <[UserRow]> results;
    in-out property <string> note;
    callback closed;
    /// Fired debounced; "" clears results.
    callback search(string);
    callback invite-user(string);

    background: transparent;
    public function focus-search() { search-input.focus(); }
    public function reset() { search-input.text = ""; root.note = ""; }

    debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.search(search-input.text);
        }
    }

    VerticalLayout {
        // AddPeoplePage.qml:26-28: a 54 band, PanelActionButton (22×22) at 6,
        // the title 6 past it — x 34. The tap surface spans the band.
        header := Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 6px;
                spacing: 6px;
                Rectangle {
                    width: 22px;
                    ActionButton {
                        y: (54px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                Text {
                    text: "Add people";
                    color: root.fg;
                    font-family: Theme.font-ui; font-size: Theme.heading;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; padding-bottom: 8px;
                pill := Rectangle {
                    border-radius: self.height / 2;
                    background: root.fg.with-alpha(0.07);
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent.with-alpha(0.4) : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 12px;
                        spacing: 8px;
                        IconLabel {
                            text: Icons.search;
                            font-size: Theme.icon-size;   // AddPeoplePage.qml:36 (outlined, size: Style.font.icon)
                            color: root.fg.with-alpha(0.5);
                            vertical-alignment: center;
                        }
                        Rectangle {
                            clip: true;
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                color: root.fg;
                                font-family: Theme.font-ui; font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%; width: 100%;
                                single-line: true;
                                // AddPeoplePage.qml:20,46: the query is trimmed
                                // before the two-character test and the search.
                                // Slint has no trim, so the length test here is
                                // on the raw text and the bridge trims the query
                                // it receives (a whitespace-padded short text
                                // clears results one debounce later than the
                                // QML; see settings-handoff.md).
                                edited => {
                                    root.note = "";
                                    if (self.text.character-count >= 2) {
                                        debounce.running = false;
                                        debounce.running = true;
                                    } else {
                                        debounce.running = false;
                                        root.search("");
                                    }
                                }
                                // AddPeoplePage.qml:47: Escape closes the page.
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.closed();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            if search-input.text == "" : Text {
                                text: "Search for someone";
                                color: root.fg.with-alpha(0.45);
                                font-family: Theme.font-ui; font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                    }
                }
            }
        }

        if root.note != "" : Rectangle {
            height: note-text.preferred-height + 4px;
            note-text := Text {
                y: 4px;   // QML: topPadding 4, nothing below
                text: root.note;
                color: Theme.accent;
                font-family: Theme.font-ui; font-size: Theme.caption;
                horizontal-alignment: center;
                width: 100%;
            }
        }

        people := TouchList {
            vertical-stretch: 1;
            for user in root.results : prow := Rectangle {
                height: 56px;
                Rectangle {
                    x: 10px; width: prow.width - 20px;
                    y: 4px; height: prow.height - 8px;
                    border-radius: 12px;
                    background: prow-touch.pressed || prow-touch.has-hover
                        ? root.fg.with-alpha(0.05) : transparent;
                }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 12px;
                    spacing: 12px;
                    Rectangle {
                        width: 38px;
                        // AddPeoplePage.qml:64: the avatar is vertically centred.
                        Avatar {
                            y: (prow.height - self.height) / 2;
                            size: 38px;
                            source: user.avatar;
                            initials: user.initials;
                            tint: user.tint;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: user.display-name != "" ? user.display-name : user.user-id;
                            color: root.fg;
                            font-family: Theme.font-ui; font-size: Theme.body;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: user.user-id;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui; font-size: Theme.caption;
                            overflow: elide;
                        }
                    }
                }
                prow-touch := TouchArea {
                    clicked => { root.invite-user(user.user-id); }
                }
            }
        }
    }
}
