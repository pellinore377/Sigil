// StartPage — start chat: look someone up by username, or make a group;
// suggestions from existing DMs (StartChatPage.qml, minus what only Matrix
// had: spaces and joining by address).

import { TouchList } from "../furniture.slint";
import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar, SButton } from "../components.slint";
import { UserRow } from "../model.slint";

export component StartPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    /// Directory results while the query is ≥ 2 chars, else DM suggestions.
    in property <[UserRow]> people;
    in property <bool> busy;
    in property <string> error;

    callback closed;
    /// Debounced by the bridge; fired on every edit.
    callback search-edited(string);
    callback start-dm(string);
    /// (mode, value) — mode: create.
    callback submit-extra(string, string);

    in-out property <string> mode: "";   // "" | create

    public function reset() {
        root.mode = "";
        search-input.text = "";
        // extra-input clears itself: it lives under `if mode != ""` and is
        // recreated when the mode reopens.
    }

    background: Theme.menu-background.brighter(0.35);

    VerticalLayout {
        // Header
        header := Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 6px;
                spacing: 6px;
                Rectangle {
                    // PanelActionButton is 22×22 at leftMargin 6, vertically
                    // centred (StartChatPage.qml:61); the title then lands at
                    // x 34 (:62). The tap surface spans the header height for
                    // fingers, as SettingsHeader does.
                    width: 22px;
                    ActionButton {
                        y: (54px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.close;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                Text {
                    text: "Start chat";
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.heading;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // Search pill
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; padding-bottom: 8px;
                pill := Rectangle {
                    border-radius: self.height / 2;
                    background: root.fg.with-alpha(0.07);
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent.with-alpha(0.4) : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 12px;
                        spacing: 8px;
                        IconLabel {
                            text: Icons.search;
                            font-size: Theme.icon-size;   // StartChatPage.qml:70
                            color: root.fg.with-alpha(0.5);
                            vertical-alignment: center;
                        }
                        Rectangle {
                            clip: true;
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                color: root.fg;
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%; width: 100%;
                                single-line: true;
                                edited => { root.search-edited(self.text); }
                            }
                            if search-input.text == "" : Text {
                                text: "Search by username";
                                color: root.fg.with-alpha(0.45);
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                    }
                }
            }
        }

        // Quick actions, only while not searching.
        if search-input.text == "" : VerticalLayout {
            qa1 := Rectangle {
                height: 48px;
                Rectangle {
                    x: 10px; width: qa1.width - 20px;
                    y: 4px; height: qa1.height - 8px;
                    border-radius: 12px;
                    background: qa1-t.pressed || qa1-t.has-hover ? root.fg.with-alpha(0.05) : transparent;
                }
                IconLabel { x: 22px; height: 100%; text: Icons.plus; font-size: Theme.icon-size; color: root.fg.with-alpha(0.7); }
                Text {
                    x: 56px; height: 100%;
                    text: "New group";
                    color: root.fg;
                    font-family: Theme.font-ui; font-size: Theme.body;
                    vertical-alignment: center;
                }
                qa1-t := TouchArea { clicked => { root.mode = root.mode == "create" ? "" : "create"; } }
            }
            if root.mode != "" : Rectangle {
                height: 52px;
                // Qt.callLater(extra.forceActiveFocus): focus rides instantiation.
                init => { extra-input.focus(); }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px;
                    padding-top: 4px; padding-bottom: 8px;
                    extra-well := Rectangle {
                        border-radius: 12px;
                        background: root.fg.with-alpha(0.06);
                        border-width: 1px;
                        border-color: extra-input.has-focus ? Theme.accent.with-alpha(0.4) : root.fg.with-alpha(0.1);
                        // StartChatPage.qml:110: the field runs from 10 to an
                        // 80px right gutter; the button sits in that gutter at
                        // rightMargin 6, vertically centred (:121).
                        Rectangle {
                            x: 10px;
                            width: extra-well.width - 90px;
                            height: 100%;
                            clip: true;
                            extra-input := TextInput {
                                color: root.fg;
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%; width: 100%;
                                single-line: true;
                                accepted => {
                                    if (!root.busy) { root.submit-extra(root.mode, self.text); }
                                }
                            }
                            if extra-input.text == "" : Text {
                                text: "Group name";
                                color: root.fg.with-alpha(0.4);
                                font-family: Theme.font-ui;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                        SButton {
                            x: extra-well.width - self.width - 6px;
                            y: (extra-well.height - self.height) / 2;
                            text: "Create";
                            enabled: !root.busy;
                            clicked => { root.submit-extra(root.mode, extra-input.text); }
                        }
                    }
                }
            }
        }

        if root.error != "" : Rectangle { height: 4px; }
        if root.error != "" : Text {
            text: root.error;
            color: Theme.urgent;
            font-family: Theme.font-ui;
            font-size: Theme.caption;
            horizontal-alignment: center;
        }

        Rectangle { height: 10px; }
        Text {
            // The caption flips at two characters, with the list (QML trims;
            // Slint has no trim, so whitespace-only text still flips it).
            text: search-input.text.character-count >= 2 ? "Results" : "Suggestions";
            color: root.fg.with-alpha(0.55);
            font-family: Theme.font-ui;
            font-size: Theme.caption;
            font-weight: 700;
            x: 18px;
        }
        Rectangle { height: 4px; }

        people-list := TouchList {
            vertical-stretch: 1;
            for person in root.people : prow := Rectangle {
                height: 56px;
                Rectangle {
                    x: 10px; width: prow.width - 20px;
                    y: 4px; height: prow.height - 8px;
                    border-radius: 12px;
                    // StartChatPage.qml:138: hover only, no pressed face.
                    background: prow-t.has-hover ? root.fg.with-alpha(0.05) : transparent;
                }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 12px;
                    spacing: 12px;
                    Rectangle {
                        width: 38px;
                        Avatar {
                            y: (prow.height - self.height) / 2;
                            size: 38px;
                            source: person.avatar;
                            initials: person.initials;
                            tint: person.tint;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: person.display-name != "" ? person.display-name : person.user-id;
                            color: root.fg;
                            font-family: Theme.font-ui;
                            font-size: Theme.body;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: person.user-id;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            overflow: elide;
                        }
                    }
                }
                prow-t := TouchArea { clicked => { root.start-dm(person.user-id); } }
            }
        }
    }
}
