// PinsPage — a room's pinned messages as a timeline. Pinned events are
// fetched by id (`pins.items`); TimelineFocus::PinnedEvents is not usable
// here (PinsPage.qml). Rows arrive as TimelineRow with the pins stamp format
// ("Today · 1:58 PM") in `stamp` and the kind chip words in `media-filename`.

import { TouchList } from "../furniture.slint";
import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { TimelineRow } from "../model.slint";

export component PinsPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <string> room-name;
    in property <bool> room-is-dm;
    in property <[TimelineRow]> items;
    in property <bool> loading;
    in property <bool> loaded;
    /// A chat theme accent is set for this room (PinsPage.qml:20).
    in property <bool> themed: false;

    callback closed;
    callback jump-requested(string);
    callback unpin(string);

    // PinsPage.qml:19-31, exactly as ChatPage mixes them: surfaceC is
    // lighter(menu.bg, 1.35) with 35 % accent when themed; chromeC is that
    // surface, else lighter(menu.bg, 1.35); convoC is darker(menu.bg, 1.35)
    // with 18 % accent only when themed.
    property <color> surface-c: root.themed
        ? Theme.menu-background.brighter(0.35).mix(root.accent, 0.65)
        : Theme.popup-background;
    property <color> chrome-c: root.themed ? root.surface-c : Theme.menu-background.brighter(0.35);
    property <color> convo-c: root.themed
        ? Theme.menu-background.darker(0.35).mix(root.accent, 0.82)
        : Theme.menu-background.darker(0.35);

    background: root.chrome-c;

    // PinsPage.qml:33-41: the exact fill BubbleDelegate uses; an
    // approximation does not match the room. Others' bubbles take the themed
    // surface when there is one.
    pure function bubble-fill(own: bool) -> color {
        return own ? root.accent.mix(Theme.popup-background, 0.42)
             : root.themed ? root.surface-c
             : Theme.bubble-other;
    }

    VerticalLayout {
        // PinsPage.qml:104-133: PanelActionButton (22×22) at 6, the title
        // column 6 past it (x 34) and 14 short of the right edge.
        header := Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 6px; padding-right: 14px;
                spacing: 6px;
                Rectangle {
                    width: 22px;
                    ActionButton {
                        y: (56px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Pinned";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.heading;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.items.length > 0
                            ? "\{root.room-name} · \{root.items.length} pinned"
                            : root.room-name;
                        color: root.fg.with-alpha(0.55);
                        font-family: Theme.font-ui;
                        font-size: Theme.caption;
                        overflow: elide;
                    }
                }
            }
        }

        ground := Rectangle {
            vertical-stretch: 1;
            background: root.convo-c;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            clip: true;

            if root.items.length == 0 : VerticalLayout {
                alignment: center;
                padding-left: 30px; padding-right: 30px;
                spacing: 10px;
                IconLabel {
                    text: Icons.pin;
                    color: root.accent.with-alpha(0.8);
                    font-size: 44px;
                    horizontal-alignment: center;
                    transform-rotation: 35deg;
                }
                Text {
                    text: root.loading || !root.loaded ? "Loading pinned messages…" : "Nothing pinned yet";
                    color: root.fg;
                    font-family: Theme.font-ui;
                    font-size: Theme.body;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                if root.loaded && !root.loading : Text {
                    text: "Pin a message from its menu to keep it here.";
                    color: root.fg.with-alpha(0.6);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.items.length > 0 : TouchList {
                y: 10px;
                width: 100%; height: ground.height - 10px;
                for item[i] in root.items : prow := Rectangle {
                    height: p-inner.preferred-height;
                    // PinsPage.qml:184-240: stamp, 4, the 24-high sender row
                    // (absent for own rows and DMs), own ? 2 : 8, the card,
                    // then 8 of slack; the list puts 4 between rows.
                    p-inner := VerticalLayout {
                        width: prow.width;
                        spacing: 0px;
                        // Centred stamp above each pinned card.
                        Text {
                            text: item.stamp;
                            color: root.fg.with-alpha(0.55);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: 4px; }
                        // Sender row — a DM shows no sender header in the room,
                        // so none here either.
                        if !item.is-own && !root.room-is-dm : HorizontalLayout {
                            height: 24px;
                            padding-left: 14px;
                            spacing: 7px;
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                Avatar {
                                    y: 2px;
                                    size: 20px;
                                    source: item.avatar;
                                    initials: item.initials;
                                    tint: item.tint;
                                }
                            }
                            Text {
                                text: item.sender-name;
                                color: root.fg.with-alpha(0.6);
                                font-family: Theme.font-ui;
                                font-size: Theme.caption;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { height: item.is-own ? 2px : 8px; }
                        // Card + trailing unpin, aligned per ownership.
                        HorizontalLayout {
                            alignment: item.is-own ? end : start;
                            padding-left: 14px; padding-right: 14px;
                            spacing: 4px;
                            // PinsPage.qml:310-319: the unpin is a 22×22
                            // PanelActionButton 4 off the card, centred on it.
                            if item.is-own : Rectangle {
                                width: 22px;
                                ActionButton {
                                    y: (parent.height - self.height) / 2;
                                    width: 22px; height: 22px;
                                    icon: Icons.close;
                                    foreground: root.fg;
                                    clicked => { root.unpin(item.event-id); }
                                }
                            }
                            card := Rectangle {
                                // PinsPage.qml:237-240: the widest natural line
                                // + 22, at least 40, at most 78 % of the list.
                                width: max(40px, min(prow.width * 0.78, card-inner.preferred-width + 22px));
                                height: card-inner.preferred-height + 20px;
                                border-radius: 16px;
                                background: root.bubble-fill(item.is-own);
                                // PinsPage.qml:244-265: the pin badge overhangs
                                // the top corner, rimmed 1.5 in popups.background.
                                pin-badge := Rectangle {
                                    x: item.is-own ? card.width - 15px : -5px;
                                    y: -5px;
                                    width: 20px; height: 20px;
                                    border-radius: 10px;
                                    background: root.accent;
                                    border-width: max(1px, 1.5px);
                                    border-color: Theme.popup-background;
                                    Text {
                                        text: Icons.pin;
                                        color: Theme.background;
                                        font-family: Theme.font-icon;
                                        font-size: Theme.caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%; height: 100%;
                                        transform-rotation: item.is-own ? 35deg : -35deg;
                                    }
                                }
                                // PinsPage.qml:267-272: inset 10 on every side.
                                card-inner := VerticalLayout {
                                    x: 10px; y: 10px;
                                    width: card.width - 20px;
                                    spacing: 3px;
                                    // a top-anchored Column: the card's 20 of
                                    // padding must not stretch the kind chip
                                    alignment: start;
                                    // Icon and words are separate elements: one
                                    // family per element (kind chip).
                                    if item.media-filename != "" : HorizontalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        IconLabel {
                                            text: item.media-icon;
                                            color: root.fg.with-alpha(0.6);
                                            font-size: Theme.caption;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: item.media-filename;
                                            color: root.fg.with-alpha(0.6);
                                            font-family: Theme.font-ui;
                                            font-size: Theme.caption;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // PinsPage.qml clamps the body at six lines;
                                    // no maximumLineCount in Slint, so clip there.
                                    Rectangle {
                                        clip: true;
                                        height: min(body-text.preferred-height, 6 * Theme.body * 1.35);
                                        body-text := Text {
                                            width: 100%;
                                            text: item.body;
                                            color: root.fg;
                                            font-family: Theme.font-ui;
                                            font-size: Theme.body;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                TouchArea { clicked => { root.jump-requested(item.event-id); } }
                            }
                            if !item.is-own : Rectangle {
                                width: 22px;
                                ActionButton {
                                    y: (parent.height - self.height) / 2;
                                    width: 22px; height: 22px;
                                    icon: Icons.close;
                                    foreground: root.fg;
                                    clicked => { root.unpin(item.event-id); }
                                }
                            }
                        }
                        // 8 of slack (PinsPage.qml:191), plus the list's 4
                        // between rows (:184).
                        Rectangle { height: i == root.items.length - 1 ? 8px : 12px; }
                    }
                }
            }
        }
    }
}
