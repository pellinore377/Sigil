// SearchPage — conversation search: text results while typing; media and
// links when idle (SearchPage.qml). The collect() pass over the open timeline
// runs in the bridge; rows arrive as TimelineRow projections — text results
// carry sender-name + body, images carry thumb, links carry the url in body.
//
// On the phone it is the platform messenger's search instead: one pill at
// the top, a grid of filter chips while the query is empty, then rows across
// every room (engine search.global) — or one room when opened from a chat.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { TouchList } from "../furniture.slint";
import { ChatRow } from "../home.slint";
import { TimelineRow, RoomRow, SearchHit } from "../model.slint";

export component SearchPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <[TimelineRow]> results;    // text matches for the query
    in property <[TimelineRow]> images;     // newest images, idle view
    in property <[TimelineRow]> links;      // newest links, idle view
    in property <bool> searching;           // query ≥ 2 chars
    // the phone's page
    in property <[RoomRow]> rooms;          // room hits
    in property <[SearchHit]> hits;         // message hits
    in-out property <string> kind;          // the chip filter, "" for none
    in property <bool> global;              // opened from home: every room
    in property <bool> shown;               // the current page: the field takes focus
    in-out property <string> query;

    callback closed;
    callback search-edited(string);
    callback jump-to(string);
    callback open-image(string);            // eventId
    callback open-link(string);             // url (in body)
    callback kind-picked(string);           // a chip, or "" when cleared
    callback open-room(string);             // a room hit
    callback open-hit(string, string);      // roomId, eventId

    public function reset() { root.query = ""; root.kind = ""; }

    property <bool> phone: Theme.mode != "desktop";
    background: root.phone ? Theme.background : Theme.menu-background.brighter(0.35);

    if !root.phone : Rectangle {
    width: 100%; height: 100%;
    VerticalLayout {
        // Header: back + search pill filling the rest.
        header := Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 6px; padding-right: 14px;
                spacing: 4px;
                Rectangle {
                    // PanelActionButton is 22×22 at leftMargin 6, vertically
                    // centred (SearchPage.qml:205). The tap surface spans the
                    // header height for fingers, as SettingsHeader does.
                    width: 22px;
                    ActionButton {
                        y: (54px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                // SearchPage.qml:206-208: the pill runs from 4 after the button
                // (x 32) to rightMargin 14, 36 high, radius 18, centred in 54.
                Rectangle {
                    horizontal-stretch: 1;
                    pill := Rectangle {
                        y: (54px - self.height) / 2;
                        width: 100%;
                        height: 36px;
                        border-radius: 18px;
                        background: root.fg.with-alpha(0.07);
                        border-width: 1px;
                        border-color: search-input.has-focus ? Theme.accent.with-alpha(0.4) : transparent;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 12px;
                            Rectangle {
                                clip: true;
                                search-input := TextInput {
                                    text <=> root.query;
                                    color: root.fg;
                                    font-family: Theme.font-ui;
                                    font-size: Theme.body;
                                    vertical-alignment: center;
                                    height: 100%; width: 100%;
                                    single-line: true;
                                    edited => { root.search-edited(self.text); }
                                }
                                if search-input.text == "" : Text {
                                    text: "Search conversation";
                                    color: root.fg.with-alpha(0.45);
                                    font-family: Theme.font-ui;
                                    font-size: Theme.body;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }
        }

        content := Flickable {
            vertical-stretch: 1;
            viewport-height: content-l.preferred-height + 20px;
            content-l := VerticalLayout {
                width: content.width;
                spacing: 4px;

                // Text results while typing.
                for r in (root.searching ? root.results : []) : rrow := Rectangle {
                    height: 52px;
                    Rectangle {
                        x: 10px; width: rrow.width - 20px;
                        y: 4px; height: rrow.height - 8px;
                        border-radius: 12px;
                        // SearchPage.qml:240: hover only, no pressed face.
                        background: rrow-t.has-hover ? root.fg.with-alpha(0.05) : transparent;
                    }
                    VerticalLayout {
                        x: 18px;
                        width: rrow.width - 36px;
                        alignment: center;
                        Text {
                            text: r.is-own ? "You" : r.sender-name;
                            color: root.fg.with-alpha(0.6);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: r.body;
                            color: root.fg;
                            font-family: Theme.font-ui;
                            font-size: Theme.body-small;
                            overflow: elide;
                        }
                    }
                    rrow-t := TouchArea { clicked => { root.jump-to(r.event-id); } }
                }
                // SearchPage.qml:249: topPadding 20 over a natural-height
                // line, centred across the page.
                if root.searching && root.results.length == 0 : VerticalLayout {
                    padding-top: 20px;
                    Text {
                        text: "No matches";
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        horizontal-alignment: center;
                    }
                }

                // Idle: images grid (a Flow of fixed cells).
                // SearchPage.qml:251: leftPadding 16, topPadding 8, natural height.
                if !root.searching && root.images.length > 0 : VerticalLayout {
                    padding-left: 16px; padding-top: 8px;
                    Text {
                        text: "Images";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle;
                        font-weight: 700;
                    }
                }
                if !root.searching : img-flow := Rectangle {
                    // SearchPage.qml:252-261: a Flow 28 narrower than the page,
                    // horizontally centred (so at x 14), 84px cells with 6px
                    // spacing laid from its left edge: cols = floor((w-28+6)/90),
                    // rows*90 - 6 high (no spacing after the last row).
                    property <int> cols: max(1, floor((self.width - 28px + 6px) / 90px));
                    property <int> rows: root.images.length == 0 ? 0
                        : floor((root.images.length - 1) / self.cols) + 1;
                    height: self.rows == 0 ? 0px : self.rows * 90px - 6px;
                    for img[i] in root.images : cell := Rectangle {
                        x: 14px + mod(i, img-flow.cols) * 90px;
                        y: floor(i / img-flow.cols) * 90px;
                        width: 84px; height: 84px;
                        border-radius: 10px;
                        clip: true;
                        background: root.fg.with-alpha(0.08);
                        if img.thumb.width > 0 : Image {
                            source: img.thumb;
                            image-fit: cover;
                            width: 100%; height: 100%;
                        }
                        TouchArea { clicked => { root.open-image(img.event-id); } }
                    }
                }

                // Idle: links.
                // SearchPage.qml:270: leftPadding 16, topPadding 10, natural height.
                if !root.searching && root.links.length > 0 : VerticalLayout {
                    padding-left: 16px; padding-top: 10px;
                    Text {
                        text: "Links";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle;
                        font-weight: 700;
                    }
                }
                for l in (root.searching ? [] : root.links) : lrow := Rectangle {
                    height: 56px;
                    Rectangle {
                        x: 14px; width: lrow.width - 28px;
                        y: 4px; height: lrow.height - 8px;
                        border-radius: 14px;
                        background: root.fg.with-alpha(0.06);
                    }
                    VerticalLayout {
                        x: 24px;
                        width: lrow.width - 48px;
                        alignment: center;
                        Text {
                            // SearchPage.qml:279 elides the url in the MIDDLE;
                            // Slint only elides the end, so the bridge pre-
                            // truncates `body` (project.rs collect_search:
                            // 30 + … + 19 past 52 chars); link-url is the full url.
                            text: l.body;   // the url
                            color: root.fg;
                            font-family: Theme.font-ui;
                            font-size: Theme.body-small;
                            overflow: elide;
                        }
                        Text {
                            text: l.is-own ? "You" : l.sender-name;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            overflow: elide;
                        }
                    }
                    // The body may be middle-elided; the tap uses the full url.
                    TouchArea { clicked => { root.open-link(l.link-url != "" ? l.link-url : l.body); } }
                }
            }
        }
    }
    }   // desktop

    pure function kind-label(k: string) -> string {
        if (k == "unread") { return "Unread"; }
        if (k == "known") { return "Known"; }
        if (k == "unknown") { return "Unknown"; }
        if (k == "starred") { return "Starred"; }
        if (k == "images") { return "Images"; }
        if (k == "videos") { return "Videos"; }
        if (k == "places") { return "Places"; }
        if (k == "links") { return "Links"; }
        return "";
    }

    if root.phone : phone-tree := Rectangle {
        width: 100%; height: 100%;
        property <color> accent-container: Theme.mode == "dark"
            ? Theme.accent.mix(Theme.background, 0.42)
            : Theme.accent.mix(Theme.background, 0.22);
        property <bool> idle: root.query == "" && root.kind == "";
        property <bool> on: root.shown;
        changed on => { if (self.on) { phone-input.focus(); } }

        VerticalLayout {
            // The pill: 16 in, 8 down, 52 tall; the back arrow's 24 glyph at
            // x 24 inside it, the field from 64.
            Rectangle {
                height: 60px;
                ppill := Rectangle {
                    x: 16px; y: 8px;
                    width: parent.width - 32px; height: 52px;
                    border-radius: 26px;
                    background: Theme.bubble-other;
                    Rectangle {
                        x: 12px; y: 2px; width: 48px; height: 48px;
                        border-radius: 24px;
                        background: back-t.pressed ? Theme.menu-text.with-alpha(0.10) : transparent;
                        IconLabel {
                            text: Icons.back;
                            font-size: 24px;
                            color: Theme.menu-text;
                            width: 100%; height: 100%;
                        }
                        // With a chip in force the arrow first returns to the grid.
                        back-t := TouchArea {
                            clicked => {
                                if (root.kind != "") { root.kind = ""; root.kind-picked(""); }
                                else { root.closed(); }
                            }
                        }
                    }
                    Rectangle {
                        x: 64px; width: ppill.width - 64px - (root.query != "" ? 60px : 16px);
                        height: 100%;
                        clip: true;
                        phone-input := TextInput {
                            text <=> root.query;
                            color: Theme.menu-text;
                            font-family: Theme.font-ui;
                            font-size: 16px;
                            vertical-alignment: center;
                            height: 100%; width: 100%;
                            single-line: true;
                            edited => { root.search-edited(self.text); }
                        }
                        if root.query == "" : Text {
                            text: root.kind != "" ? root.kind-label(root.kind)
                                : root.global ? "Search messages" : "Search conversation";
                            color: Theme.muted;
                            font-family: Theme.font-ui;
                            font-size: 16px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                    if root.query != "" : Rectangle {
                        x: ppill.width - 12px - 48px; y: 2px; width: 48px; height: 48px;
                        border-radius: 24px;
                        background: clear-t.pressed ? Theme.menu-text.with-alpha(0.10) : transparent;
                        IconLabel {
                            text: Icons.close;
                            font-size: 24px;
                            color: Theme.menu-text;
                            width: 100%; height: 100%;
                        }
                        clear-t := TouchArea {
                            clicked => { root.query = ""; root.search-edited(""); phone-input.focus(); }
                        }
                    }
                }
            }

            // Filter chips, two to a row: 16 margins, 8 gaps, 60 tall.
            if phone-tree.idle : grid := Rectangle {
                height: 16px + 4 * 60px + 3 * 8px;
                property <length> cw: (self.width - 32px - 8px) / 2;
                for chip[i] in [
                    { label: "Unread",  kind: "unread",  icon: Icons.email },
                    { label: "Known",   kind: "known",   icon: Icons.person },
                    { label: "Unknown", kind: "unknown", icon: Icons.personAdd },
                    { label: "Starred", kind: "starred", icon: Icons.star },
                    { label: "Images",  kind: "images",  icon: Icons.image },
                    { label: "Videos",  kind: "videos",  icon: Icons.videoOn },
                    { label: "Places",  kind: "places",  icon: Icons.location },
                    { label: "Links",   kind: "links",   icon: Icons.link },
                ] : Rectangle {
                    x: 16px + mod(i, 2) * (grid.cw + 8px);
                    y: 16px + floor(i / 2) * 68px;
                    width: grid.cw; height: 60px;
                    border-radius: 16px;
                    background: chip-t.pressed ? Theme.bubble-other.brighter(0.15) : Theme.bubble-other;
                    IconLabel {
                        x: 24px;
                        text: chip.icon;
                        font-size: 24px;
                        color: Theme.menu-text;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    Text {
                        x: 72px;
                        text: chip.label;
                        color: Theme.menu-text;
                        font-family: Theme.font-ui;
                        font-size: 16px;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    chip-t := TouchArea { clicked => { root.kind = chip.kind; root.kind-picked(chip.kind); } }
                }
            }
            if phone-tree.idle : Rectangle { }

            // Hits: rooms, then messages, in the home row's shape.
            if !phone-tree.idle : TouchList {
                vertical-stretch: 1;
                if root.rooms.length > 0 : Text {
                    text: "Chats";
                    color: Theme.muted;
                    font-family: Theme.font-ui;
                    font-size: 14px;
                    font-weight: 500;
                    x: 16px; height: 36px;
                    vertical-alignment: center;
                }
                for r in root.rooms : ChatRow {
                    name: r.name; avatar: r.avatar; initials: r.initials; tint: r.tint;
                    preview: r.preview; preview-icon: r.preview-icon; stamp: r.stamp;
                    badge: r.badge; badge-urgent: r.badge-urgent; unread: r.unread;
                    is-favourite: r.is-favourite; is-invite: r.is-invite;
                    is-typing: r.is-typing; has-call: r.has-call; draft: r.draft;
                    accent-container: phone-tree.accent-container;
                    clicked => { root.open-room(r.id); }
                }
                if root.hits.length > 0 : Text {
                    text: "Messages";
                    color: Theme.muted;
                    font-family: Theme.font-ui;
                    font-size: 14px;
                    font-weight: 500;
                    x: 16px; height: 36px;
                    vertical-alignment: center;
                }
                for h in root.hits : ChatRow {
                    name: h.room-name; avatar: h.avatar; initials: h.initials; tint: h.tint;
                    preview: h.body; preview-icon: h.icon; stamp: h.stamp;
                    accent-container: phone-tree.accent-container;
                    clicked => { root.open-hit(h.room-id, h.event-id); }
                }
                if root.rooms.length == 0 && root.hits.length == 0 : Text {
                    text: "No matches";
                    color: Theme.muted;
                    font-family: Theme.font-ui;
                    font-size: 16px;
                    horizontal-alignment: center;
                    height: 72px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
