// SearchPage — conversation search: text results while typing; media and
// links when idle (SearchPage.qml). The collect() pass over the open timeline
// runs in the bridge; rows arrive as TimelineRow projections — text results
// carry sender-name + body, images carry thumb, links carry the url in body.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, ActionButton, Avatar } from "../components.slint";
import { TimelineRow } from "../model.slint";

export component SearchPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <[TimelineRow]> results;    // text matches for the query
    in property <[TimelineRow]> images;     // newest images, idle view
    in property <[TimelineRow]> links;      // newest links, idle view
    in property <bool> searching;           // query ≥ 2 chars

    callback closed;
    callback search-edited(string);
    callback jump-to(string);
    callback open-image(string);            // eventId
    callback open-link(string);             // url (in body)

    public function reset() { search-input.text = ""; }

    background: Theme.menu-background.brighter(0.35);

    VerticalLayout {
        // Header: back + search pill filling the rest.
        header := Rectangle {
            height: 54px;
            HorizontalLayout {
                padding-left: 6px; padding-right: 14px;
                spacing: 4px;
                Rectangle {
                    // PanelActionButton is 22×22 at leftMargin 6, vertically
                    // centred (SearchPage.qml:205). The tap surface spans the
                    // header height for fingers, as SettingsHeader does.
                    width: 22px;
                    ActionButton {
                        y: (54px - self.height) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back; filled: false;
                        foreground: root.fg;
                        clicked => { root.closed(); }
                    }
                    TouchArea { clicked => { root.closed(); } }
                }
                // SearchPage.qml:206-208: the pill runs from 4 after the button
                // (x 32) to rightMargin 14, 36 high, radius 18, centred in 54.
                Rectangle {
                    horizontal-stretch: 1;
                    pill := Rectangle {
                        y: (54px - self.height) / 2;
                        width: 100%;
                        height: 36px;
                        border-radius: 18px;
                        background: root.fg.with-alpha(0.07);
                        border-width: 1px;
                        border-color: search-input.has-focus ? Theme.accent.with-alpha(0.4) : transparent;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 12px;
                            Rectangle {
                                clip: true;
                                search-input := TextInput {
                                    color: root.fg;
                                    font-family: Theme.font-ui;
                                    font-size: Theme.body;
                                    vertical-alignment: center;
                                    height: 100%; width: 100%;
                                    single-line: true;
                                    edited => { root.search-edited(self.text); }
                                }
                                if search-input.text == "" : Text {
                                    text: "Search conversation";
                                    color: root.fg.with-alpha(0.45);
                                    font-family: Theme.font-ui;
                                    font-size: Theme.body;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }
        }

        content := Flickable {
            vertical-stretch: 1;
            viewport-height: content-l.preferred-height + 20px;
            content-l := VerticalLayout {
                width: content.width;
                spacing: 4px;

                // Text results while typing.
                for r in (root.searching ? root.results : []) : rrow := Rectangle {
                    height: 52px;
                    Rectangle {
                        x: 10px; width: rrow.width - 20px;
                        y: 4px; height: rrow.height - 8px;
                        border-radius: 12px;
                        // SearchPage.qml:240: hover only, no pressed face.
                        background: rrow-t.has-hover ? root.fg.with-alpha(0.05) : transparent;
                    }
                    VerticalLayout {
                        x: 18px;
                        width: rrow.width - 36px;
                        alignment: center;
                        Text {
                            text: r.is-own ? "You" : r.sender-name;
                            color: root.fg.with-alpha(0.6);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: r.body;
                            color: root.fg;
                            font-family: Theme.font-ui;
                            font-size: Theme.body-small;
                            overflow: elide;
                        }
                    }
                    rrow-t := TouchArea { clicked => { root.jump-to(r.event-id); } }
                }
                // SearchPage.qml:249: topPadding 20 over a natural-height
                // line, centred across the page.
                if root.searching && root.results.length == 0 : VerticalLayout {
                    padding-top: 20px;
                    Text {
                        text: "No matches";
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        horizontal-alignment: center;
                    }
                }

                // Idle: images grid (a Flow of fixed cells).
                // SearchPage.qml:251: leftPadding 16, topPadding 8, natural height.
                if !root.searching && root.images.length > 0 : VerticalLayout {
                    padding-left: 16px; padding-top: 8px;
                    Text {
                        text: "Images";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle;
                        font-weight: 700;
                    }
                }
                if !root.searching : img-flow := Rectangle {
                    // SearchPage.qml:252-261: a Flow 28 narrower than the page,
                    // horizontally centred (so at x 14), 84px cells with 6px
                    // spacing laid from its left edge: cols = floor((w-28+6)/90),
                    // rows*90 - 6 high (no spacing after the last row).
                    property <int> cols: max(1, floor((self.width - 28px + 6px) / 90px));
                    property <int> rows: root.images.length == 0 ? 0
                        : floor((root.images.length - 1) / self.cols) + 1;
                    height: self.rows == 0 ? 0px : self.rows * 90px - 6px;
                    for img[i] in root.images : cell := Rectangle {
                        x: 14px + mod(i, img-flow.cols) * 90px;
                        y: floor(i / img-flow.cols) * 90px;
                        width: 84px; height: 84px;
                        border-radius: 10px;
                        clip: true;
                        background: root.fg.with-alpha(0.08);
                        if img.thumb.width > 0 : Image {
                            source: img.thumb;
                            image-fit: cover;
                            width: 100%; height: 100%;
                        }
                        TouchArea { clicked => { root.open-image(img.event-id); } }
                    }
                }

                // Idle: links.
                // SearchPage.qml:270: leftPadding 16, topPadding 10, natural height.
                if !root.searching && root.links.length > 0 : VerticalLayout {
                    padding-left: 16px; padding-top: 10px;
                    Text {
                        text: "Links";
                        color: root.fg;
                        font-family: Theme.font-ui;
                        font-size: Theme.subtitle;
                        font-weight: 700;
                    }
                }
                for l in (root.searching ? [] : root.links) : lrow := Rectangle {
                    height: 56px;
                    Rectangle {
                        x: 14px; width: lrow.width - 28px;
                        y: 4px; height: lrow.height - 8px;
                        border-radius: 14px;
                        background: root.fg.with-alpha(0.06);
                    }
                    VerticalLayout {
                        x: 24px;
                        width: lrow.width - 48px;
                        alignment: center;
                        Text {
                            // SearchPage.qml:279 elides the url in the MIDDLE;
                            // Slint only elides the end, so the bridge pre-
                            // truncates `body` (project.rs collect_search:
                            // 30 + … + 19 past 52 chars); link-url is the full url.
                            text: l.body;   // the url
                            color: root.fg;
                            font-family: Theme.font-ui;
                            font-size: Theme.body-small;
                            overflow: elide;
                        }
                        Text {
                            text: l.is-own ? "You" : l.sender-name;
                            color: root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui;
                            font-size: Theme.caption;
                            overflow: elide;
                        }
                    }
                    // The body may be middle-elided; the tap uses the full url.
                    TouchArea { clicked => { root.open-link(l.link-url != "" ? l.link-url : l.body); } }
                }
            }
        }
    }
}
