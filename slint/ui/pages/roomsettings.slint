// RoomSettingsPage — mobile/RoomSettingsPage.qml. Room settings: identity,
// quick toggles, add people, members, and leave.

import { Theme } from "../style.slint";
import { Icons } from "../icons.slint";
import { IconLabel, Avatar, TextWell, SButton, ActionButton } from "../components.slint";
import { SettingsHeader, SettingsGroup, SettingsRow, NotePill } from "../furniture.slint";
import { RoomSettingsModel, MemberRow } from "../model.slint";

export component RoomSettingsPage inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <RoomSettingsModel> model;
    /// Everyone in the room. Group rooms only — a DM has two people, one is you.
    in property <[MemberRow]> members;
    /// How many rooms are already pinned, for the five-pin cap.
    in property <int> pinned-count;
    in property <string> dm-user-id;
    callback closed;
    callback add-people;
    callback open-notifications;
    callback open-admins;
    callback open-privacy;
    callback rename(string);
    callback set-favourite(bool);
    callback set-low-priority(bool);
    callback leave;

    property <string> note;
    property <bool> confirm-leave;
    in-out property <bool> renaming: false;
    property <bool> is-group: !root.model.is-dm;
    // RoomSettingsPage.qml:70: the subtitle Text exists only while it says something.
    property <string> sub-text: root.model.is-dm ? root.dm-user-id : root.model.member-count + " members";
    background: transparent;

    // One line of bodySmall, measured, so the topic clamp below is exact.
    line-probe := Text {
        visible: false;
        text: "X";
        font-family: Theme.font-ui; font-size: Theme.body-small;
    }

    fl := Flickable {
        width: 100%; height: 100%;
        viewport-height: content.preferred-height + 20px;
        content := VerticalLayout {
            width: fl.width;
            alignment: start;

            // RoomSettingsPage.qml:62-64: a 54 band, PanelActionButton (22×22)
            // at 6, the title 6 past it — x 34. The tap surface spans the band.
            header := Rectangle {
                height: 54px;
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 6px;
                    Rectangle {
                        width: 22px;
                        ActionButton {
                            y: (54px - self.height) / 2;
                            width: 22px; height: 22px;
                            icon: Icons.back; filled: false;
                            foreground: root.fg;
                            clicked => { root.closed(); }
                        }
                        TouchArea { clicked => { root.closed(); } }
                    }
                    Text {
                        text: "Settings";
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.heading; font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            Rectangle { height: 16px; }
            face-holder := Rectangle {
                height: 72px;
                Avatar {
                    x: (face-holder.width - self.width) / 2;
                    size: 72px;
                    source: root.model.avatar;
                    initials: root.model.initials;
                    tint: root.model.tint;
                }
            }
            Rectangle { height: 8px; }
            Rectangle {
                height: name-line.preferred-height;
                name-line := Text {
                    width: 100%;
                    text: root.model.name != "" ? root.model.name : root.model.room-id;
                    color: root.fg;
                    font-family: Theme.font-ui; font-size: Theme.title; font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            // RoomSettingsPage.qml:70: caption @0.55, topPadding 2, only when non-empty.
            if root.sub-text != "" : Rectangle {
                height: sub-line.preferred-height + 2px;
                sub-line := Text {
                    y: 2px; width: 100%;
                    text: root.sub-text;
                    color: root.fg.with-alpha(0.55);
                    font-family: Theme.font-ui; font-size: Theme.caption;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            // RoomSettingsPage.qml:71: width-60, centred, wrapped, at most
            // three lines then elided, topPadding 6. Slint has no
            // maximumLineCount, so the box is three measured lines high and
            // the text elides inside it.
            if root.model.topic != "" : Rectangle {
                height: topic-clip.height + 6px;
                topic-clip := Rectangle {
                    x: 30px; y: 6px; width: fl.width - 60px;
                    clip: true;
                    height: min(topic-line.preferred-height, 3 * line-probe.preferred-height);
                    topic-line := Text {
                        width: 100%; height: 100%;
                        text: root.model.topic;
                        color: root.fg.with-alpha(0.6);
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
            Rectangle { height: 18px; }

            // Quick rows: add people, pin, low priority.
            SettingsRow {
                fg: root.fg;
                icon: Icons.plus; label: "Add people";
                clicked => { root.add-people(); }
            }
            SettingsRow {
                fg: root.fg;
                icon: Icons.pin; label: "Pin";
                trailing: "toggle"; on: root.model.is-favourite;
                clicked => {
                    // Five pins max: refuse the sixth rather than silently dropping one.
                    if (!root.model.is-favourite && root.pinned-count >= 5) {
                        root.note = "Five conversations are already pinned";
                    } else {
                        root.set-favourite(!root.model.is-favourite);
                    }
                }
            }
            SettingsRow {
                fg: root.fg;
                icon: Icons.lowPriority; label: "Low priority";
                trailing: "toggle"; on: root.model.is-low-priority;
                clicked => { root.set-low-priority(!root.model.is-low-priority); }
            }

            // Members preview.
            if root.is-group : Rectangle { height: 16px; }
            if root.is-group : Rectangle {
                height: members-title.preferred-height;
                members-title := Text {
                    x: 22px;
                    text: root.members.length > 0
                        ? root.members.length + (root.members.length == 1 ? " member" : " members")
                        : "Members";
                    color: root.fg.with-alpha(0.55);
                    font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700;
                }
            }
            if root.is-group : Rectangle { height: 6px; }
            if root.is-group : VerticalLayout {
                for member in root.members : member-row := Rectangle {
                    height: 52px;
                    // RoomSettingsPage.qml:125-163: avatar 34 at 24, centred;
                    // text 12 past it and 10 short of the power tag, which sits
                    // 24 from the right. The tag's Text keeps its width even
                    // when hidden (its text is set regardless of `visible`),
                    // so the column always stops short of it.
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 24px;
                        spacing: 0px;
                        Rectangle {
                            width: 34px;
                            Avatar {
                                y: (member-row.height - self.height) / 2;
                                size: 34px;
                                source: member.avatar;
                                initials: member.initials;
                                tint: member.tint;
                            }
                        }
                        Rectangle { width: 12px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: member.display-name != "" ? member.display-name : member.user-id;
                                color: root.fg;
                                font-family: Theme.font-ui; font-size: Theme.body;
                                overflow: elide;
                            }
                            if member.user-id != "" && member.display-name != member.user-id : Text {
                                text: member.user-id;
                                color: root.fg.with-alpha(0.5);
                                font-family: Theme.font-ui; font-size: Theme.caption;
                                overflow: elide;
                            }
                        }
                        Rectangle { width: 10px; }
                        power-tag := Text {
                            visible: member.power-level >= 50;
                            width: self.preferred-width;
                            text: member.power-level >= 100 ? "Admin" : "Mod";
                            color: root.fg.with-alpha(0.55);
                            font-family: Theme.font-ui; font-size: Theme.caption;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Notifications (local to this device), privacy, admins, and a rename for admins.
            Rectangle { height: 10px; }
            SettingsGroup {
                fg: root.fg;
                SettingsRow {
                    fg: root.fg;
                    icon: Icons.bell; label: "Notifications";
                    trailing: "value";
                    // Blank until the read lands: a default caption asserts facts it lacks.
                    value: root.model.room-id == "" ? ""
                         : root.model.notification-mode == "all" ? "All messages"
                         : root.model.notification-mode == "mentions" ? "Mentions only"
                         : root.model.notification-mode == "mute" ? "Muted" : "Default";
                    clicked => { root.open-notifications(); }
                }
                SettingsRow {
                    fg: root.fg;
                    icon: Icons.lock; label: "Privacy";
                    trailing: "value";
                    value: root.model.room-id == "" ? "" : "Encrypted";
                    clicked => { root.open-privacy(); }
                }
                if root.is-group : SettingsRow {
                    fg: root.fg;
                    icon: Icons.shield; label: "Admins";
                    trailing: "chevron";
                    clicked => { root.open-admins(); }
                }
                if root.is-group && root.model.can-edit-info : SettingsRow {
                    fg: root.fg;
                    icon: Icons.edit; label: "Rename";
                    trailing: root.renaming ? "none" : "chevron";
                    clicked => { root.renaming = !root.renaming; }
                }
                // The editor takes its own height: 4 + the 36 well + 8.
                if root.is-group && root.model.can-edit-info && root.renaming : Rectangle {
                    HorizontalLayout {
                        padding-left: 22px; padding-right: 22px; padding-top: 4px; padding-bottom: 8px;
                        spacing: 8px;
                        rename-well := TextWell { placeholder: root.model.name; horizontal-stretch: 1;
                            accepted => { if (self.text != "") { root.rename(self.text); root.renaming = false; } } }
                        SButton { text: "Save"; enabled: rename-well.text != ""; clicked => { root.rename(rename-well.text); root.renaming = false; } }
                    }
                }
            }

            // RoomSettingsPage.qml:200: 14 between the group and the leave button.
            Rectangle { height: 14px; }
            leave-btn := Rectangle {
                x: 20px; width: fl.width - 40px; height: 44px;
                border-radius: 14px;
                background: root.confirm-leave ? Theme.urgent.with-alpha(0.85) : Theme.urgent.with-alpha(0.16);
                Text {
                    text: root.confirm-leave ? "Tap again to confirm"
                        : (root.model.is-dm ? "Leave chat" : "Leave room");
                    color: root.confirm-leave ? Theme.background : Theme.urgent;
                    font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                TouchArea {
                    clicked => {
                        if (!root.confirm-leave) {
                            root.confirm-leave = true;
                        } else {
                            root.confirm-leave = false;
                            root.leave();
                        }
                    }
                }
            }
        }
    }

    confirm-timer := Timer {
        interval: 4000ms;
        running: root.confirm-leave;
        triggered => { root.confirm-leave = false; }
    }

    // Transient notice (pin cap, mostly) — RoomSettingsPage.qml:291-304, the
    // rimmed caption variant, 2600ms (:20).
    NotePill {
        width: 100%; height: 100%;
        text: root.note; fg: root.fg;
        variant: "settings";
        expired => { root.note = ""; }
    }
}
