// Message action sheet — MessageSheet.qml. The page frosts behind a blurred
// snapshot the bridge takes the instant before the sheet opens (frost.rs),
// under 55 % black like the QML; the pressed bubble lifts as a crop of the
// same picture to a computed resting place, the quick-reaction pill above
// it and the action menu below, with a delete-confirm bottom sheet and the
// emoji drawer sharing the same host. Without a snapshot (a renderer that
// cannot take one) the scrim is a deeper dim and the copy is redrawn.
//
// Motion, as MessageSheet.qml plays it: the copy is placed on the bubble and
// lifts to its resting place (220ms OutBack), the pill and menu scale in
// over 160ms while fading in linearly over 130ms, the frost fades in over
// 200ms. Closing is two phases (:48-56, :135-143): the copy flies home over
// 200ms with a harder overshoot while the pill, menu and frost fade, and
// only then does the sheet clear.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";
import { MenuEntry } from "furniture.slint";
import { TimelineRow, EmojiItem } from "model.slint";
import { EmojiPicker } from "emoji.slint";

export component MessageSheet inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    // Panel.qml:1370-1372 hands in the chat's themed surface, chip and deep chip.
    in property <color> surface: Theme.popup-background.with-alpha(0.98);
    /// MessageSheet.qml:19 — the emoji drawer's search well.
    in property <color> chip: Theme.background.with-alpha(0.85);
    /// MessageSheet.qml:18 — the delete-confirm's Cancel button.
    in property <color> deep-chip: Theme.background;
    /// MessageSheet.qml:21 cardRadius: the frost mask and the sheets' bottom corners.
    in property <length> card-radius: 22px;
    in property <TimelineRow> item;
    in-out property <bool> open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> confirm-open: false;
    in property <[[EmojiItem]]> emoji-rows;
    in property <[int]> emoji-cat-rows;
    /// The quick reactions with their pictures; the bare glyphs stand in until they arrive.
    in property <[EmojiItem]> quick-emoji;
    property <[EmojiItem]> quick: root.quick-emoji.length == 6 ? root.quick-emoji : [
        { glyph: "👍" }, { glyph: "❤️" }, { glyph: "😂" }, { glyph: "😮" }, { glyph: "😢" }, { glyph: "😡" }];
    /// The page as it was, blurred; empty when the renderer could not snapshot.
    in property <image> backdrop;
    /// The pressed bubble as it was drawn.
    in property <image> copy-image;
    property <bool> frosted: root.backdrop.width > 0;

    // Where the bubble was pressed, in window coordinates (menu-requested args).
    in-out property <length> hole-x;
    in-out property <length> hole-y;
    in-out property <length> hole-w;
    in-out property <length> hole-h;
    /// MessageSheet.qml:57-59: the list viewport in the sheet's coordinates —
    /// the spotlight is clipped to it (Panel.qml:1014-1015 pass the list's
    /// top and bottom). The defaults clip nothing.
    in property <length> vp-top: 0px;
    in property <length> vp-bottom: 100000px;

    callback act(string /*action*/, string /*event-id*/);
    callback react(string /*event-id*/, string /*key*/);
    callback emoji-search(string);
    /// MessageSheet.loadEmojis: the drawer picker fills itself when opened.
    callback load-emoji;

    public function open-for(x: length, y: length, w: length, h: length) {
        root.hole-x = x; root.hole-y = y; root.hole-w = w; root.hole-h = h;
        root.drawer-open = false;
        root.confirm-open = false;
        root.begin-open();
        root.open = true;
    }

    // openFor's analytic layout: pill above, copy, menu below, clamped to the page.
    property <length> pill-h: 48px;
    property <length> gap: 10px;
    /// Built by the bridge when the sheet opens — MessageSheet.actionsFor ported
    /// to Rust, one place instead of two (slint/src/…, see WIRING-chat.md).
    in property <[MenuEntry]> actions;
    property <int> action-count: root.actions.length;
    property <length> menu-h: root.action-count * 38px + 16px;
    property <length> content-h: root.pill-h + root.gap + root.hole-h + root.gap + root.menu-h;
    property <length> dest-y: max(12px + root.pill-h + root.gap,
        min(root.hole-y, root.height - root.content-h - 12px + root.pill-h + root.gap));
    property <length> card-x: max(12px, min(
        item.is-own ? root.hole-x + root.hole-w - 220px : root.hole-x,
        root.width - 220px - 12px));
    // The pill clamps with its OWN width, not the menu's (MessageSheet.qml:234).
    property <length> pill-w: pill-row-probe;
    property <length> pill-x: max(12px, min(
        item.is-own ? root.hole-x + root.hole-w - root.pill-w : root.hole-x,
        root.width - root.pill-w - 12px));
    // 7 cells at 36 + 6×6 spacing + 20 = 292px, static so the clamp needs no id.
    property <length> pill-row-probe: 7 * 36px + 6 * 6px + 20px;

    // ---- Phases: shown (item !== null) and closing (MessageSheet.qml:44-56).
    property <bool> shown: false;
    property <bool> closing: false;
    // `up` is the QML's `item !== null && !closing`: pill, menu and frost in.
    property <bool> up: root.shown && !root.closing;
    // The copy: at the hole, then at dest-y once `lifted` (MessageSheet.qml:44,
    // 119-133). `animate-copy` is the QML's animateCopy gate — off while the
    // copy is placed on the bubble so it never slides in from the last spot.
    property <bool> lifted: false;
    property <bool> animate-copy: false;
    property <length> copy-y: root.lifted ? root.dest-y : root.hole-y;
    // Lift: 220ms OutBack overshoot 1.1 (:196). Fly home: 200ms OutBack
    // overshoot 1.25 (:53). Placement: instant.
    animate copy-y {
        duration: !root.animate-copy ? 0ms : root.closing ? 200ms : 220ms;
        easing: root.closing ? cubic-bezier(0.34, 1.56, 0.64, 1) : cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    // Reads that force a first evaluation: a Slint animation starts from the
    // value last evaluated, so the copy is read while parked on the bubble
    // and the fades are read at rest before the flip that animates them.
    property <length> copy-rest;
    property <float> motion-rest;
    // Pill and menu: scale 0.4→1 over 160ms OutCubic (:229-233, :276-280),
    // opacity LINEAR over 130ms (:228, :275).
    property <float> pop: root.up ? 1.0 : 0.0;
    animate pop { duration: 160ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    property <float> fade: root.up ? 1.0 : 0.0;
    animate fade { duration: 130ms; }
    // Frost: 200ms OutCubic both ways (:158-159).
    property <float> frost-a: root.up ? 1.0 : 0.0;
    animate frost-a { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    function begin-open() {
        // MessageSheet.qml:110: a re-open interrupts the fly-home.
        close-timer.running = false;
        root.closing = false;
        // :117-120 — parked on the bubble, no animation …
        root.animate-copy = false;
        root.lifted = false;
        root.copy-rest = root.copy-y;
        root.motion-rest = root.pop + root.fade + root.frost-a;
        // … :121-133 — then lifted to where it will rest.
        root.animate-copy = true;
        root.lifted = true;
        root.shown = true;
    }
    function begin-close() {
        // MessageSheet.qml:135-143 close(): fly home behind the frost, then clear.
        root.closing = true;
        root.drawer-open = false;
        root.confirm-open = false;
        root.animate-copy = true;
        root.lifted = false;
        close-timer.running = true;
    }
    // `open` is the public switch; the phases hang off it.
    changed open => {
        if (!root.open && root.shown && !root.closing) { root.begin-close(); }
        else if (root.open && !root.shown) { root.begin-open(); }
    }
    // closeAnim's ScriptAction (:55): the same-frame clear once the copy is home.
    close-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => { self.running = false; root.shown = false; root.closing = false; }
    }

    visible: root.shown;
    background: transparent;

    // The frost: the blurred snapshot under 55 % black (MessageSheet.qml:155-169),
    // or a deeper dim when there is no snapshot; masked to the card's radius
    // (:162-177) and faded as one (:158-159).
    frost := Rectangle {
        width: 100%; height: 100%;
        border-radius: root.card-radius;
        clip: true;
        opacity: root.frost-a;
        if root.frosted : Image {
            source: root.backdrop;
            width: 100%; height: 100%;
            image-fit: fill;
            image-rendering: smooth;
        }
        Rectangle {
            width: 100%; height: 100%;
            background: #000000.with-alpha(root.frosted ? 0.55 : 0.62);
        }
    }
    // MessageSheet.qml:178-182: the tap-away sits under everything.
    TouchArea {
        clicked => {
            if (root.drawer-open) { root.drawer-open = false; }
            else if (root.confirm-open) { root.confirm-open = false; }
            else { root.open = false; }
        }
    }

    // Spotlight copy of the message, clipped to the list viewport (:184-189).
    copy-clip := Rectangle {
        x: 0px;
        y: root.vp-top;
        width: 100%;
        height: max(0px, min(root.vp-bottom, root.height) - root.vp-top);
        clip: true;
        copy-card := Rectangle {
            x: root.hole-x;
            y: root.copy-y - root.vp-top;
            width: root.hole-w;
            height: root.hole-h;
            border-radius: 16px;
            background: root.copy-image.width > 0 ? transparent : root.surface.with-alpha(0.97);
            clip: true;
            if root.copy-image.width > 0 : Image {
                source: root.copy-image;
                width: 100%; height: 100%;
                image-fit: fill;
            }
            if root.copy-image.width == 0 : Text {
                x: 10px; y: 10px;
                width: copy-card.width - 20px;
                height: copy-card.height - 20px;
                text: item.kind == "poll" ? item.poll-question
                    : item.kind == "location" ? (item.location-label != "" ? item.location-label : "Location")
                    : item.body;
                color: root.fg;
                font-family: Theme.font-ui; font-size: Theme.body;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // Quick reactions pill. The QML reacts with "❤️" (U+2764 U+FE0F) — the key
    // must match the desktop's; femtovg draws the VS16 pair as tofu, so the
    // pill DISPLAYS the bare heart while SENDING the emoji-presentation key.
    if !root.drawer-open : pill := Rectangle {
        x: root.pill-x;
        y: root.dest-y - root.gap - self.height;
        // MessageSheet.qml:227-233: linear fade, X scale from 0.4 about the centre.
        opacity: root.fade;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: 0.4 + 0.6 * root.pop;
        width: root.pill-w;
        height: root.pill-h;
        border-radius: root.pill-h / 2;
        background: root.surface;
        // MessageSheet.qml:239-242: the Row is centred in the pill — 36 cells
        // in 48 leave 6 above and below, and the +20 width is 10 a side.
        pill-row := HorizontalLayout {
            padding-left: 10px; padding-right: 10px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 6px;
            for e in root.quick : q-cell := Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: q-t.pressed || q-t.has-hover ? root.accent.with-alpha(0.32) : transparent;
                if e.has-img : Image {
                    source: e.img;
                    x: 7px; y: 7px; width: 22px; height: 22px;
                    image-fit: contain;
                }
                if !e.has-img : Text {
                    text: e.glyph == "❤️" ? "❤" : e.glyph;
                    font-size: 19px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                q-t := TouchArea {
                    clicked => { root.react(item.event-id, e.glyph); root.open = false; }
                }
            }
            more-cell := Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: more-t.pressed || more-t.has-hover ? root.accent.with-alpha(0.32) : transparent;
                IconLabel {
                    text: Icons.emojiMore;
                    color: root.fg; font-size: 19px;
                    width: 100%; height: 100%;
                }
                more-t := TouchArea { clicked => { root.load-emoji(); root.drawer-open = true; } }
            }
        }
    }

    // Action menu. Rows come from the same rules as MessageSheet.actionsFor.
    // Stays visible behind the delete-confirm (only the emoji drawer hides it).
    if !root.drawer-open : menu-box := Rectangle {
        x: root.card-x;
        y: min(root.dest-y + root.hole-h + root.gap, root.height - self.height - 12px);
        // MessageSheet.qml:274-280: linear fade, Y scale from 0.4 about the top edge.
        opacity: root.fade;
        transform-origin: { x: self.width / 2, y: 0px };
        transform-scale-y: 0.4 + 0.6 * root.pop;
        width: 220px;
        // preferred-height already contains the 8px paddings (= QML's +16).
        height: menu-col.preferred-height;
        border-radius: 16px;
        background: root.surface;
        menu-col := VerticalLayout {
            padding: 8px;
            for entry in root.actions : a-row := Rectangle {
                height: 38px;
                border-radius: 10px;
                background: a-t.pressed || a-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                // MessageSheet.qml:301-315: leftMargin 10, a 20×20 icon box,
                // spacing 12 — the label lands at x 42 and is 150 wide.
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 12px;
                    if entry.icon != "" : IconLabel {
                        text: entry.icon; font-size: Theme.icon-size;   // MessageSheet.qml:311
                        color: entry.danger ? Theme.urgent : root.fg.with-alpha(0.75);
                        width: 20px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.t;
                        color: entry.danger ? Theme.urgent : root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 150px;
                    }
                }
                a-t := TouchArea {
                    clicked => {
                        if (entry.a == "redact") { root.confirm-open = true; }
                        else { root.open = false; root.act(entry.a, item.event-id); }
                    }
                }
            }
        }
    }

    // The confirm draws its own dim over the sheet: #000000 to 0.5 over
    // 180ms, masked to the card radius (MessageSheet.qml:335-341).
    property <float> confirm-dim: root.confirm-open ? 0.5 : 0.0;
    animate confirm-dim { duration: 180ms; }
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.card-radius;
        background: #000000.with-alpha(root.confirm-dim);
        visible: root.confirm-dim > 0.005;
        TouchArea { enabled: root.confirm-open; clicked => { root.confirm-open = false; } }
    }

    // Delete confirm: redactions are permanent, so it slides up and asks.
    // Always built, so it slides 220ms OutCubic both ways from 6 below the
    // edge (MessageSheet.qml:342-350) and keeps its state between opens.
    confirm-sheet := Rectangle {
        y: root.confirm-open ? root.height - self.height : root.height + 6px;
        animate y { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.y < root.height - 0.5px;
        width: 100%;
        // preferred-height already carries the 10/16 paddings (= QML's +26).
        height: conf-col.preferred-height;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: root.card-radius;
        border-bottom-right-radius: root.card-radius;
        background: root.surface;
        // MessageSheet.qml:351: taps on the sheet go nowhere.
        TouchArea { }
        conf-col := VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 10px;
            Rectangle {
                height: 4px;
                grab := Rectangle {
                    x: (confirm-sheet.width - 32px - 36px) / 2;
                    width: 36px; height: 4px; border-radius: 2px;
                    background: root.fg.with-alpha(0.25);
                }
            }
            Text {
                text: "Delete message?";
                color: root.fg;
                font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "This can't be undone — the message is removed for everyone.";
                color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui; font-size: Theme.caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // MessageSheet.qml:360: 2px more before the buttons.
            Rectangle { height: 2px; }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                cancel-btn := Rectangle {
                    width: 110px; height: 40px; border-radius: 20px;
                    // MessageSheet.qml:367: the deep chip.
                    background: root.deep-chip;
                    Text {
                        text: "Cancel"; color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.confirm-open = false; } }
                }
                delete-btn := Rectangle {
                    width: 110px; height: 40px; border-radius: 20px;
                    background: Theme.urgent;
                    Text {
                        text: "Delete"; color: Theme.background;
                        font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => {
                            root.confirm-open = false;
                            root.open = false;
                            root.act("redact", item.event-id);
                        }
                    }
                }
            }
        }
    }

    // Emoji drawer — the same EmojiPicker the attachment sheet uses. Always
    // built and slid 220ms OutCubic from 6 below the edge (MessageSheet.qml:
    // 389-399), so the search and scroll survive a close.
    drawer := Rectangle {
        y: root.drawer-open ? root.height - self.height : root.height + 6px;
        animate y { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.y < root.height - 0.5px;
        width: 100%;
        height: 360px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: root.card-radius;
        border-bottom-right-radius: root.card-radius;
        background: root.surface;
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            padding-bottom: 8px;
            spacing: 8px;
            alignment: start;
            Rectangle {
                height: 4px;
                Rectangle {
                    x: (drawer.width - 24px - 36px) / 2;
                    width: 36px; height: 4px; border-radius: 2px;
                    background: root.fg.with-alpha(0.25);
                }
            }
            EmojiPicker {
                // MessageSheet.qml:405-408: the column's height (360 − 12 − 8) less 16.
                height: (drawer.height - 20px) - 16px;
                fg: root.fg;
                accent: root.accent;
                chip: root.chip;
                rows: root.emoji-rows;
                cat-rows: root.emoji-cat-rows;
                picked(e) => {
                    root.react(item.event-id, e);
                    root.drawer-open = false;
                    root.open = false;
                }
                search-edited(q) => { root.emoji-search(q); }
            }
        }
    }
}
