// Message action sheet — the long-press menu, as Google Messages does it.
//
// Nothing is copied and nothing is snapshotted. The pressed bubble is the
// real row in the real list: the host scrolls the conversation so the
// bubble comes to the resting place this sheet computes (pill above, menu
// below, all of it on screen and clear of the gesture bar), and this sheet
// dims everything else with a scrim that has a hole cut exactly at the
// bubble's rectangle. The host hands in `shift` — how far the list has
// scrolled since the press — so the hole, the pill and the menu ride with
// the bubble as it glides. Earlier versions blurred a snapshot of the window
// and flew a second copy of the bubble over it; the snapshot cost a frame,
// the copy could never be clipped like the row it stood in for, and both
// were the wrong shape for the problem.
//
// The sheet is the page's size but its scrim, tap-away and bottom sheets
// bleed past it by `bleed-top` / `bleed-bottom` — the phone's status-bar
// and gesture-bar zones the window paints around the page — so the dim
// covers the entire screen.
//
// Motion: the list glides 220ms on an overshoot curve (the host's), the pill
// and menu scale in over 160ms while fading in linearly over 130ms, the
// scrim fades in over 200ms. Closing: the list glides home over 200ms while
// the pill, menu and scrim fade, and only then does the sheet clear.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel } from "components.slint";
import { MenuEntry } from "furniture.slint";
import { TimelineRow, EmojiItem, SheetRect } from "model.slint";
import { EmojiPicker } from "emoji.slint";

export component MessageSheet inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    // Panel.qml:1370-1372 hands in the chat's themed surface, chip and deep chip.
    in property <color> surface: Theme.popup-background.with-alpha(0.98);
    /// MessageSheet.qml:19 — the emoji drawer's search well.
    in property <color> chip: Theme.background.with-alpha(0.85);
    /// MessageSheet.qml:18 — the delete-confirm's Cancel button.
    in property <color> deep-chip: Theme.background;
    /// MessageSheet.qml:21 cardRadius: the frost mask and the sheets' bottom corners.
    in property <length> card-radius: 22px;
    /// How far the frost and the bottom sheets reach past the sheet's own
    /// rect: the window's zones above (status bar, sync strip) and below
    /// (gesture bar or keyboard) the page. Zero on the desktop.
    in property <length> bleed-top: 0px;
    in property <length> bleed-bottom: 0px;
    /// The zone at the bottom of the WINDOW that the page keeps clear — the
    /// gesture bar, or the keyboard while it is up (app.slint hands the page
    /// max() of the two). The conversation runs edge to edge under the gesture
    /// bar, so `bleed-bottom` is zero there and this is the only channel the
    /// emoji drawer has: without it its category bar sits under the gesture
    /// bar, and its search field puts it under the keyboard.
    in property <length> bottom-inset: 0px;
    /// The conversation band, in the sheet's coordinates: the header's bottom
    /// edge and the composer's top edge. The flying copy is clipped to it.
    in property <length> band-top: 0px;
    in property <length> band-bottom: root.height;
    // The two cases pull opposite ways, so split the one number back apart
    // (chat.slint's att-frame does the same, for the same reason): nothing
    // pinned to a screen edge is near 96 tall and no keyboard is near that
    // short. While the keyboard is up the gesture bar is behind it, so the
    // gesture share falls to zero rather than staying.
    property <length> gesture-inset: root.bottom-inset > 96px ? 0px : root.bottom-inset;
    property <length> kb-inset: root.bottom-inset > 96px ? root.bottom-inset : 0px;
    in property <TimelineRow> item;
    in-out property <bool> open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> confirm-open: false;
    in property <[[EmojiItem]]> emoji-rows;
    in property <[int]> emoji-cat-rows;
    /// The quick reactions with their pictures; the bare glyphs stand in until they arrive.
    in property <[EmojiItem]> quick-emoji;
    property <[EmojiItem]> quick: root.quick-emoji.length == 6 ? root.quick-emoji : [
        { glyph: "👍" }, { glyph: "❤️" }, { glyph: "😂" }, { glyph: "😮" }, { glyph: "😢" }, { glyph: "😡" }];
    // Where the bubble was pressed, in the SHEET's coordinates: open-for
    // converts from the window's.
    in-out property <length> hole-x;
    in-out property <length> hole-y;
    in-out property <length> hole-w;
    in-out property <length> hole-h;
    /// The bubble's own corners, each its own radius: the scrim's hole
    /// follows them.
    in-out property <length> hole-r-tl;
    in-out property <length> hole-r-tr;
    in-out property <length> hole-r-bl;
    in-out property <length> hole-r-br;
    /// The held ROW's top in the sheet's coordinates: the host's live copy
    /// of the row (this sheet's child) stands there and lifts with the hole.
    in property <length> row-top: 0px;
    /// How far the BUBBLE has lifted from where it was pressed: zero at the
    /// press, `dest-y - hole-y` at rest, and back to zero as the sheet goes.
    /// The host moves the real row's bubble by exactly this (the list does
    /// not move), and the hole, the pill and the menu are laid out around
    /// `bubble-y`, so all four travel as one. Lift: 220ms on an overshoot
    /// curve; home: 200ms on a harder one.
    out property <length> lift: root.up ? root.dest-y - root.hole-y : 0px;
    animate lift {
        duration: root.closing ? 200ms : 220ms;
        easing: root.closing ? cubic-bezier(0.34, 1.42, 0.64, 1) : cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    /// Where the bubble IS, this frame.
    property <length> bubble-y: root.hole-y + root.lift;

    callback act(string /*action*/, string /*event-id*/);
    callback react(string /*event-id*/, string /*key*/);
    callback emoji-search(string);
    /// MessageSheet.loadEmojis: the drawer picker fills itself when opened.
    callback load-emoji;

    /// Open over the bubble drawn at `r` — the bubble's `absolute-position`,
    /// size and corners, i.e. logical lengths from the window's origin. The
    /// sheet's own `absolute-position` is measured the same way (safe-area
    /// inset, status strip, page holder and all), so the difference is
    /// exactly where the bubble sits inside the sheet, whatever the scale
    /// factor: no physical pixels enter the placement.
    public function open-for(r: SheetRect) {
        root.hole-x = r.x - root.absolute-position.x;
        root.hole-y = r.y - root.absolute-position.y;
        root.hole-w = r.w; root.hole-h = r.h;
        root.hole-r-tl = r.r-tl; root.hole-r-tr = r.r-tr;
        root.hole-r-bl = r.r-bl; root.hole-r-br = r.r-br;
        root.drawer-open = false;
        root.confirm-open = false;
        root.begin-open();
        root.open = true;
    }

    // openFor's analytic layout: pill above, copy, menu below, clamped to the page.
    property <length> pill-h: 48px;
    property <length> gap: 10px;
    /// Built by the bridge when the sheet opens — MessageSheet.actionsFor ported
    /// to Rust, one place instead of two (slint/src/…, see WIRING-chat.md).
    in property <[MenuEntry]> actions;
    property <int> action-count: root.actions.length;
    property <length> menu-h: root.action-count * 38px + 16px;
    property <length> content-h: root.pill-h + root.gap + root.hole-h + root.gap + root.menu-h;
    // The menu stands clear of the gesture bar (or the keyboard, which the
    // hold now dismisses): the clamp keeps the whole column above the inset.
    out property <length> dest-y: max(12px + root.pill-h + root.gap,
        min(root.hole-y, root.height - root.bottom-inset - root.content-h - 12px + root.pill-h + root.gap));
    property <length> card-x: max(12px, min(
        item.is-own ? root.hole-x + root.hole-w - 220px : root.hole-x,
        root.width - 220px - 12px));
    // The pill clamps with its OWN width, not the menu's (MessageSheet.qml:234).
    property <length> pill-w: pill-row-probe;
    property <length> pill-x: max(12px, min(
        item.is-own ? root.hole-x + root.hole-w - root.pill-w : root.hole-x,
        root.width - root.pill-w - 12px));
    // 7 cells at 36 + 6×6 spacing + 20 = 292px, static so the clamp needs no id.
    property <length> pill-row-probe: 7 * 36px + 6 * 6px + 20px;

    // ---- Phases: shown, and closing.
    out property <bool> shown: false;
    /// The fly-home is under way: the host glides the list back on this.
    out property <bool> closing: false;
    // Pill, menu and scrim in: shown and not closing.
    property <bool> up: root.shown && !root.closing;
    // A read that forces a first evaluation: a Slint animation starts from
    // the value last evaluated, so the fades are read at rest before the
    // flip that animates them.
    property <float> motion-rest;
    property <length> lift-rest;
    // Pill and menu: scale 0.9→1 over 160ms OutCubic, opacity LINEAR over 130ms.
    property <float> pop: root.up ? 1.0 : 0.0;
    animate pop { duration: 160ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    property <float> fade: root.up ? 1.0 : 0.0;
    animate fade { duration: 130ms; }
    // The scrim: 200ms OutCubic both ways. Out, so the host can dim what
    // the scrim cannot reach (the pressed bubble's own rounded corners).
    out property <float> dim-a: root.up ? 1.0 : 0.0;
    animate dim-a { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    function begin-open() {
        // a re-open interrupts the fly-home
        close-timer.running = false;
        root.closing = false;
        root.motion-rest = root.pop + root.fade + root.dim-a;
        // the lift too: read at zero, so the flip below animates from zero
        root.lift-rest = root.lift;
        root.shown = true;
    }
    function begin-close() {
        // fly home as the scrim lifts, then clear
        root.closing = true;
        root.drawer-open = false;
        root.confirm-open = false;
        close-timer.running = true;
    }
    // `open` is the public switch; the phases hang off it.
    changed open => {
        if (!root.open && root.shown && !root.closing) { root.begin-close(); }
        else if (root.open && !root.shown) { root.begin-open(); }
    }
    // closeAnim's ScriptAction (:55): the same-frame clear once the copy is home.
    close-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.shown = false;
            root.closing = false;
        }
    }

    visible: root.shown;
    background: transparent;

    // The whole window's extent, in the sheet's coordinates.
    property <length> screen-y: -root.bleed-top;
    property <length> screen-h: root.height + root.bleed-top + root.bleed-bottom;

    // The scrim: 55 % black over the whole screen, with a hole cut in the
    // bubble's exact outline so the real bubble shows through undimmed. A
    // rectangle cannot have a hole, but a BORDER can: one rectangle, the
    // bubble's rect grown by `reach` on every side, painted as nothing but
    // a border `reach` thick in the scrim colour. Its outer edge lies past
    // the screen; its inner edge is the hole. The renderer draws a border's
    // inner corner at the outer radius less the border width, so each
    // corner is given the bubble's own radius plus `reach` — the inner
    // edge then follows the bubble's corners exactly, whatever they are
    // (16 on a group's outer corners, 5 on its inner ones, 14 on a link
    // card), and it rides `bubble-y` through the glide.
    property <color> scrim: #000000.with-alpha(0.55 * root.dim-a);
    property <length> reach: max(root.width, root.screen-h) + 64px;
    Rectangle {
        x: root.hole-x - root.reach;
        y: root.bubble-y - root.reach;
        width: root.hole-w + 2 * root.reach;
        height: root.hole-h + 2 * root.reach;
        background: transparent;
        border-width: root.reach;
        border-color: root.scrim;
        border-top-left-radius: root.hole-r-tl + root.reach;
        border-top-right-radius: root.hole-r-tr + root.reach;
        border-bottom-left-radius: root.hole-r-bl + root.reach;
        border-bottom-right-radius: root.hole-r-br + root.reach;
    }
    // The tap-away sits under everything else: a tap anywhere, the bubble
    // included, puts the sheet away.
    TouchArea {
        y: root.screen-y; height: root.screen-h;
        clicked => {
            if (root.drawer-open) { root.drawer-open = false; }
            else if (root.confirm-open) { root.confirm-open = false; }
            else { root.open = false; }
        }
    }

    // The lifted row: the host's live copy of the held row (its child),
    // standing on the row's own top and carried by `lift` with the hole,
    // the pill and the menu. Over the scrim, under the pill and menu.
    // Tapping it dismisses, as tapping away does.
    copy-row := Rectangle {
        x: root.hole-x;
        y: root.bubble-y;
        width: root.hole-w;
        height: root.hole-h;
        @children
        TouchArea { clicked => { root.open = false; } }
    }

    // Quick reactions pill. The QML reacts with "❤️" (U+2764 U+FE0F) — the key
    // must match the desktop's; femtovg draws the VS16 pair as tofu, so the
    // pill DISPLAYS the bare heart while SENDING the emoji-presentation key.
    if !root.drawer-open : pill := Rectangle {
        x: root.pill-x;
        y: root.bubble-y - root.gap - self.height;
        // MessageSheet.qml:227-233: linear fade, X scale from 0.9 about the centre.
        opacity: root.fade;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: 0.9 + 0.1 * root.pop;
        width: root.pill-w;
        height: root.pill-h;
        border-radius: root.pill-h / 2;
        background: root.surface;
        // MessageSheet.qml:239-242: the Row is centred in the pill — 36 cells
        // in 48 leave 6 above and below, and the +20 width is 10 a side.
        pill-row := HorizontalLayout {
            padding-left: 10px; padding-right: 10px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 6px;
            for e in root.quick : q-cell := Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: q-t.pressed || q-t.has-hover ? root.accent.with-alpha(0.32) : transparent;
                if e.has-img : Image {
                    source: e.img;
                    x: 7px; y: 7px; width: 22px; height: 22px;
                    image-fit: contain;
                }
                if !e.has-img : Text {
                    text: e.glyph == "❤️" ? "❤" : e.glyph;
                    font-size: 19px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
                q-t := TouchArea {
                    clicked => { root.react(item.event-id, e.glyph); root.open = false; }
                }
            }
            more-cell := Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: more-t.pressed || more-t.has-hover ? root.accent.with-alpha(0.32) : transparent;
                IconLabel {
                    text: Icons.emojiMore;
                    color: root.fg; font-size: 19px;
                    width: 100%; height: 100%;
                }
                more-t := TouchArea { clicked => { root.load-emoji(); root.drawer-open = true; } }
            }
        }
    }

    // Action menu. Rows come from the same rules as MessageSheet.actionsFor.
    // Stays visible behind the delete-confirm (only the emoji drawer hides it).
    if !root.drawer-open : menu-box := Rectangle {
        x: root.card-x;
        y: min(root.bubble-y + root.hole-h + root.gap, root.height - self.height - 12px);
        // MessageSheet.qml:274-280: linear fade, Y scale from 0.9 about the top edge.
        opacity: root.fade;
        transform-origin: { x: self.width / 2, y: 0px };
        transform-scale-y: 0.9 + 0.1 * root.pop;
        width: 220px;
        // preferred-height already contains the 8px paddings (= QML's +16).
        height: menu-col.preferred-height;
        border-radius: 16px;
        background: root.surface;
        menu-col := VerticalLayout {
            padding: 8px;
            for entry in root.actions : a-row := Rectangle {
                height: 38px;
                border-radius: 10px;
                background: a-t.pressed || a-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                // MessageSheet.qml:301-315: leftMargin 10, a 20×20 icon box,
                // spacing 12 — the label lands at x 42 and is 150 wide.
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 12px;
                    if entry.icon != "" : IconLabel {
                        text: entry.icon; font-size: Theme.icon-size;   // MessageSheet.qml:311
                        color: entry.danger ? Theme.urgent : root.fg.with-alpha(0.75);
                        width: 20px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.t;
                        color: entry.danger ? Theme.urgent : root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 150px;
                    }
                }
                a-t := TouchArea {
                    clicked => {
                        if (entry.a == "redact") { root.confirm-open = true; }
                        else { root.open = false; root.act(entry.a, item.event-id); }
                    }
                }
            }
        }
    }

    // The confirm draws its own dim over the sheet: #000000 to 0.5 over
    // 180ms, masked to the card radius (MessageSheet.qml:335-341).
    property <float> confirm-dim: root.confirm-open ? 0.5 : 0.0;
    animate confirm-dim { duration: 180ms; }
    Rectangle {
        y: root.screen-y;
        width: 100%; height: root.screen-h;
        border-radius: root.card-radius;
        background: #000000.with-alpha(root.confirm-dim);
        visible: root.confirm-dim > 0.005;
        TouchArea { enabled: root.confirm-open; clicked => { root.confirm-open = false; } }
    }

    // The bottom sheets rest on the screen's bottom edge, past the page's
    // when the gesture zone lies below it, and pad their content above it.
    property <length> screen-bottom: root.height + root.bleed-bottom;

    // Delete confirm: redactions are permanent, so it slides up and asks.
    // Always built, so it slides 220ms OutCubic both ways from 6 below the
    // edge (MessageSheet.qml:342-350) and keeps its state between opens.
    confirm-sheet := Rectangle {
        y: root.confirm-open ? root.screen-bottom - self.height : root.screen-bottom + 6px;
        animate y { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.y < root.screen-bottom - 0.5px;
        width: 100%;
        // preferred-height already carries the 10/16 paddings (= QML's +26).
        height: conf-col.preferred-height;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: root.card-radius;
        border-bottom-right-radius: root.card-radius;
        background: root.surface;
        // MessageSheet.qml:351: taps on the sheet go nowhere.
        TouchArea { }
        conf-col := VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            // The same standing-off the drawer does: on the conversation the
            // page runs to the screen edge itself, so the gesture bar arrives
            // as `bottom-inset` and `bleed-bottom` is zero.
            padding-bottom: 16px + max(root.bleed-bottom, root.gesture-inset);
            spacing: 10px;
            Rectangle {
                height: 4px;
                grab := Rectangle {
                    x: (confirm-sheet.width - 32px - 36px) / 2;
                    width: 36px; height: 4px; border-radius: 2px;
                    background: root.fg.with-alpha(0.25);
                }
            }
            Text {
                text: "Delete message?";
                color: root.fg;
                font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "This can't be undone — the message is removed for everyone.";
                color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui; font-size: Theme.caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // MessageSheet.qml:360: 2px more before the buttons.
            Rectangle { height: 2px; }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                cancel-btn := Rectangle {
                    width: 110px; height: 40px; border-radius: 20px;
                    // MessageSheet.qml:367: the deep chip.
                    background: root.deep-chip;
                    Text {
                        text: "Cancel"; color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea { clicked => { root.confirm-open = false; } }
                }
                delete-btn := Rectangle {
                    width: 110px; height: 40px; border-radius: 20px;
                    background: Theme.urgent;
                    Text {
                        text: "Delete"; color: Theme.background;
                        font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => {
                            root.confirm-open = false;
                            root.open = false;
                            root.act("redact", item.event-id);
                        }
                    }
                }
            }
        }
    }

    // Emoji drawer — the same EmojiPicker the attachment sheet uses. Always
    // built and slid 220ms OutCubic from 6 below the edge (MessageSheet.qml:
    // 389-399), so the search and scroll survive a close.
    drawer := Rectangle {
        /// How far the handle has dragged the drawer below its resting place.
        /// Never negative: the drawer does not rubber-band upward.
        property <length> drag: 0px;
        /// Past a quarter of its own height it is a dismissal, not a fidget.
        property <length> dismiss-at: self.height / 4;
        /// Cleared before `drag` is, so the settle always gets its animation
        /// (TouchArea.pressed is still set while the release is delivered).
        property <bool> dragging: false;
        /// Where the drawer's foot comes to rest. The screen's own bottom
        /// edge — its ground runs on under the gesture bar, and the picker
        /// stands off that from the inside — except while the keyboard is up,
        /// when the foot is the keyboard's top edge instead.
        property <length> rest: root.screen-bottom - root.kb-inset;
        y: (root.drawer-open ? self.rest - self.height : self.rest + 6px) + self.drag;
        // The finger moves it 1:1; letting go settles with the same 220ms
        // OutCubic the drawer opens on.
        animate y {
            duration: self.dragging ? 0ms : 220ms;
            easing: cubic-bezier(0.33, 1, 0.68, 1);
        }
        visible: self.y < self.rest - 0.5px;
        width: 100%;
        /// 400 of body, plus the gesture strip its ground paints on down
        /// through — unless the keyboard leaves less than 400 above it, and
        /// then as much of the body as fits, floored at the search row, one
        /// grid row and the category bar. The 24 keeps the sheet's own card
        /// showing above the drawer instead of the drawer covering the screen.
        height: min(400px, max(184px, root.height - root.kb-inset - 24px))
            + root.gesture-inset;
        // Deliberately NOT animated: `y` already is, and it is bound to this,
        // so easing both would let the foot lag the head and the drawer would
        // stretch and squash its way through a keyboard instead of moving.
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: root.card-radius;
        border-bottom-right-radius: root.card-radius;
        background: root.surface;
        TouchArea { }
        VerticalLayout {
            padding-top: 8px;
            alignment: start;
            // Drag handle: a 24 grab strip with the 36x4 pill centred in it.
            // It DRAGS — the drawer follows the finger down and either
            // settles back or dismisses (MessageSheet.qml:389-399 only ever
            // animated, so this was decoration until now).
            Rectangle {
                height: 24px;
                Rectangle {
                    width: 36px; height: 4px; border-radius: 2px;
                    background: root.fg.with-alpha(handle-t.pressed ? 0.45 : 0.25);
                }
                handle-t := TouchArea {
                    moved => {
                        drawer.dragging = true;
                        // The handle travels WITH the drawer, so `mouse-y` is
                        // already measured against the moved edge: what is
                        // left over is the step, not the whole gesture. Adding
                        // it keeps the pill under the finger (taking the
                        // difference outright tracks at half speed).
                        drawer.drag = max(0px, drawer.drag + self.mouse-y - self.pressed-y);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            drawer.dragging = false;
                            if (drawer.drag > drawer.dismiss-at) { root.drawer-open = false; }
                            drawer.drag = 0px;
                        }
                    }
                }
            }
            EmojiPicker {
                // The rest of the drawer: whatever it came out at, less the 8
                // above the handle and the 24 handle strip. The gesture strip
                // is inside this, reserved by the picker itself, so the
                // drawer's surface still paints down to the screen edge.
                height: max(0px, drawer.height - 32px);
                bottom-inset: root.gesture-inset;
                fg: root.fg;
                accent: root.accent;
                chip: root.chip;
                back-slot: false;
                rows: root.emoji-rows;
                cat-rows: root.emoji-cat-rows;
                picked(e) => {
                    root.react(item.event-id, e);
                    root.drawer-open = false;
                    root.open = false;
                }
                search-edited(q) => { root.emoji-search(q); }
            }
        }
    }
}
