// The shared page furniture, ported from omarchy/components/. Each exists so
// pages cannot drift: the header inset, the 22/56/20 settings-row columns and
// the menu/sheet shapes live here once.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton, Avatar } from "components.slint";

export struct MenuEntry { t: string, a: string, icon: string, danger: bool }
export struct ChoiceEntry { t: string, v: string, sub: string }

/// The three-beat arrival every page that opens out of the conversation
/// plays: the header first, then the window, then the footer — and the same
/// three in reverse on the way out. Drop one in the page, bind `opened` to
/// the holder's `active`, and take the six clocks off it:
///
///     beats := Beats { opened: root.opened; }
///     // motion off *-e, fades and sub-windows off *-t
///     y: root.header-h + (root.height - root.header-h) * (1 - beats.body-e);
///
/// The holder must let the page play its own arrival and wait for the
/// reverse: `slides: Theme.mode == "desktop"` and `hold: 660ms` on it.
///
/// WHY THIS IS A CLOCK AND NOT A `states` TRANSITION
///
/// A transition can only play a change the state machine actually SAW, and
/// it sees a change only when the property is evaluated — which, for clocks
/// read solely by things that get drawn, means only when the page is drawn.
/// These pages are never drawn while they are put away: PageHolder carries
/// `visible: root.x < root.width - 0.5px`. So the machine never witnesses
/// the page close, and when the holder goes active there is no change left
/// to play: the page wakes already at rest. Leaving looks right only
/// because the page stays visible through the whole of it — which is also
/// why a shots run that steps the departure first appears to pass.
///
/// Every "make something read the clocks eagerly" cure fails, and not for
/// the reason it looks like. Measured, in the running app: a Timer tick
/// inside the put-away page DOES fire, and DOES record the closed state
/// (the clocks read 0 with the page shut) — and the very next render still
/// came up at rest. One lazy read is not the same as having been drawn.
/// `init` cannot stand in either: at construction the bridge has not set
/// `Theme.mode`, so `phone` is still false and the closed state is not even
/// reachable. Nor can an `if` condition or a zero-size sentinel — the whole
/// subtree is what goes unevaluated.
///
/// So the beats run off the one thing that is true whether or not anything
/// looked: elapsed time since `opened` last moved. `changed` fires off the
/// event loop, so the start instant is always captured, and every clock is
/// then a pure function of it — the arrival is identical whether the page
/// was watched, drawn, or ignored.
export component Beats inherits Rectangle {
    /// The page is the one on the stack. Bind to the holder's `active`.
    in property <bool> opened: true;
    /// Only the phone plays the beats; the desktop card keeps the holder's
    /// own slide, so there the page simply sits at rest.
    in property <bool> phone: Theme.mode != "desktop";

    // Arrival:   header 0–220, window 200–460, footer 440–660.
    // Departure: footer 0–150, window 110–310, header 250–440.
    /// Linear clocks, in beat order. Fades and sub-windows take these.
    out property <float> head-t: !root.phone ? 1.0
        : root.opened ? root.ramp(root.el, 0ms, 220ms)
                      : 1.0 - root.ramp(root.el, 250ms, 190ms);
    out property <float> body-t: !root.phone ? 1.0
        : root.opened ? root.ramp(root.el, 200ms, 260ms)
                      : 1.0 - root.ramp(root.el, 110ms, 200ms);
    out property <float> foot-t: !root.phone ? 1.0
        : root.opened ? root.ramp(root.el, 440ms, 220ms)
                      : 1.0 - root.ramp(root.el, 0ms, 150ms);
    /// The same three on an OutCubic. Motion takes these.
    out property <float> head-e: 1 - (1 - root.head-t) * (1 - root.head-t) * (1 - root.head-t);
    out property <float> body-e: 1 - (1 - root.body-t) * (1 - root.body-t) * (1 - root.body-t);
    out property <float> foot-e: 1 - (1 - root.foot-t) * (1 - root.foot-t) * (1 - root.foot-t);

    property <duration> since: -10s;
    property <bool> playing: false;
    changed opened => {
        root.since = animation-tick();
        root.playing = root.phone;
        settle-clock.restart();
    }
    /// While a beat runs, `el` reads the animation tick, and THAT is what
    /// keeps the frames coming. Once the last beat has landed the timer
    /// drops `playing`, `el` stops reading the tick, and the page goes still
    /// instead of repainting for ever. Both directions saturate every ramp
    /// well before the timer fires, so nothing jumps when it does.
    property <duration> el: root.playing ? animation-tick() - root.since : 10s;
    settle-clock := Timer {
        interval: 760ms;   // the longer of the two directions, plus slack
        running: root.playing;
        triggered => { root.playing = false; }
    }
    /// 0 → 1 over `dur`, starting `from` into the beat; saturated either side.
    pure function ramp(t: duration, from: duration, dur: duration) -> float {
        return clamp((t / 1ms - from / 1ms) / (dur / 1ms), 0.0, 1.0);
    }

    // It draws nothing; it is here only to be evaluated and to hold a timer.
    width: 0px; height: 0px;
    background: transparent;
}

// Back, title, at most one trailing text action. 56 high; back at 6.
export component SettingsHeader inherits Rectangle {
    in property <string> title;
    in property <string> action;
    in property <bool> action-enabled: true;
    in property <color> fg: Theme.menu-text;
    callback back;
    callback actioned;
    height: 56px;
    HorizontalLayout {
        padding-left: 6px; padding-right: 18px;
        spacing: 6px;
        Rectangle {
            // PanelActionButton is 22×22 (Style.qml:36), putting the title at
            // x≈34. The tap surface spans the header height for fingers.
            width: 22px;
            back-btn := ActionButton {
                y: (56px - self.height) / 2;
                width: 22px; height: 22px;
                icon: Icons.back;
                foreground: root.fg;
                clicked => { root.back(); }
            }
            TouchArea { clicked => { root.back(); } }
        }
        Text {
            text: root.title;
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.heading;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // SettingsHeader.qml:33-42: the action text ends 18 from the right
        // and the title stops 10 before it — the layout's 6 plus 4 here. The
        // slot stays reserved when the action is empty (the QML anchors the
        // title to an invisible, zero-wide Text), so the title always ends at
        // width-28. The tap surface grows 8 past the text on every side (:44).
        Rectangle {
            width: (root.action != "" ? action-text.preferred-width : 0px) + 4px;
            action-text := Text {
                visible: root.action != "";
                text: root.action;
                color: root.action-enabled ? Theme.accent : root.fg.with-alpha(0.35);
                font-family: Theme.font-ui;
                font-size: Theme.body;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 100%; height: 100%;
            }
            TouchArea {
                x: -8px; y: -8px;
                width: parent.width + 16px; height: parent.height + 16px;
                enabled: root.action-enabled && root.action != "";
                clicked => { root.actioned(); }
            }
        }
    }
}

// A titled band of settings rows: divider, caption title at the 22px content edge.
export component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <bool> divided: true;
    in property <color> fg: Theme.menu-text;
    if root.divided : Rectangle { height: 1px; background: root.fg.with-alpha(0.08); }
    Rectangle { height: root.title != "" ? 14px : 6px; }
    if root.title != "" : Rectangle {
        height: title-text.preferred-height;
        title-text := Text {
            x: 22px;
            text: root.title;
            color: root.fg.with-alpha(0.55);
            font-family: Theme.font-ui;
            font-size: Theme.caption;
            font-weight: 700;
        }
    }
    if root.title != "" : Rectangle { height: 6px; }
    VerticalLayout { @children }
    Rectangle { height: 6px; }
}

// One settings line: icon column 22, text 56, trailing inset 20.
// trailing: none | chevron | value | toggle | radio | count | check
export component SettingsRow inherits Rectangle {
    in property <string> icon;
    in property <bool> filled: false;
    in property <string> label;
    in property <string> sublabel;
    in property <string> trailing: "none";
    in property <string> value;
    in property <bool> on: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <color> fg: Theme.menu-text;
    callback clicked;

    property <color> ink: root.danger ? Theme.urgent
                        : root.enabled ? root.fg : root.fg.with-alpha(0.38);
    height: root.sublabel != "" ? 60px : 48px;

    Rectangle {
        x: 10px; width: root.width - 20px;
        y: 4px; height: root.height - 8px;
        border-radius: 12px;
        background: (touch.pressed || touch.has-hover) && root.enabled
            ? root.fg.with-alpha(0.05) : transparent;
    }
    if root.icon != "" : IconLabel {
        x: 22px;
        y: (root.height - self.preferred-height) / 2;
        text: root.icon;
        filled: root.filled;
        color: root.danger ? Theme.urgent : root.ink.with-alpha(0.75);
        font-size: Theme.icon-size;   // SettingsRow.qml:46 size: Style.font.icon
    }
    labels := VerticalLayout {
        x: root.icon != "" ? 56px : 22px;
        width: root.width - self.x - 20px - tail.width - 10px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.ink;
            font-family: Theme.font-ui;
            font-size: Theme.body;
            overflow: elide;
        }
        // SettingsRow.qml caps the sublabel at two lines; Slint has no
        // maximumLineCount, so clip at two line-heights instead.
        if root.sublabel != "" : Rectangle {
            clip: true;
            height: min(sub-text.preferred-height, 2 * Theme.caption * 1.35);
            sub-text := Text {
                width: 100%;
                text: root.sublabel;
                color: root.ink.with-alpha(0.55);
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
    tail := Rectangle {
        x: root.width - self.width - 20px;
        // The chevron column is the icon size, 14 (SettingsRow.qml:255).
        width: root.trailing == "toggle" ? 38px
             : root.trailing == "radio" || root.trailing == "check" ? 20px
             : root.trailing == "chevron" ? Theme.icon-size
             : root.trailing == "value" || root.trailing == "count" ? tail-value.preferred-width
             : 0px;
        height: root.height;
        if root.trailing == "toggle" : Rectangle {
            y: (root.height - 22px) / 2;
            width: 38px; height: 22px;
            border-radius: 11px;
            background: root.on ? Theme.accent.with-alpha(0.8) : root.fg.with-alpha(0.15);
            opacity: root.enabled ? 1 : 0.45;
            knob := Rectangle {
                width: 16px; height: 16px; border-radius: 8px;
                y: 3px;
                x: root.on ? 38px - 16px - 3px : 3px;
                background: root.fg;
                animate x { duration: 120ms; }
            }
        }
        if root.trailing == "radio" : Rectangle {
            y: (root.height - 20px) / 2;
            width: 20px; height: 20px; border-radius: 10px;
            border-width: 2px;
            border-color: root.on ? Theme.accent : root.fg.with-alpha(0.35);
            opacity: root.enabled ? 1 : 0.45;
            if root.on : Rectangle {
                x: 5px; y: 5px; width: 10px; height: 10px; border-radius: 5px;
                background: Theme.accent;
            }
        }
        if root.trailing == "check" : Rectangle {
            y: (root.height - 20px) / 2;
            width: 20px; height: 20px; border-radius: 4px;
            background: root.on ? Theme.accent : transparent;
            border-width: 2px;
            border-color: root.on ? Theme.accent : root.fg.with-alpha(0.35);
            if root.on : IconLabel {
                text: Icons.check;
                filled: true;
                color: Theme.background;
                font-size: Theme.caption;
                width: 100%; height: 100%;
            }
        }
        // SettingsRow.qml:253-260: a filled chevron in a 14-wide column.
        if root.trailing == "chevron" : IconLabel {
            text: Icons.chevronRight;
            filled: true;
            color: root.ink.with-alpha(0.4);
            font-size: Theme.icon-size;
            width: Theme.icon-size;
            height: root.height;
        }
        tail-value := Text {
            visible: root.trailing == "value" || root.trailing == "count";
            text: root.value;
            color: root.ink.with-alpha(0.5);
            font-family: Theme.font-ui;
            font-size: Theme.body;
            vertical-alignment: center;
            height: root.height;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The ⋮ menu dropping from a header's top-right; owns its scrim.
export component OverflowMenu inherits Rectangle {
    in property <[MenuEntry]> model;
    in-out property <bool> open: false;
    /// Inset from the top-right corner (OverflowMenu.qml:86). ChatPage.qml:867
    /// passes 50 for its inline copy.
    in property <length> top-inset: 48px;
    in property <color> fg: Theme.menu-text;
    /// OverflowMenu.qml:83; ChatPage.qml:871 passes its themed surface.
    in property <color> surface: Theme.popup-background.with-alpha(0.98);
    /// OverflowMenu.qml:105 is 210 wide; ChatPage.qml:868's inline copy is 170.
    in property <length> card-width: 210px;
    callback picked(string);
    // OverflowMenu.qml:109-113: the card fades LINEARLY over 120ms while it
    // scales 0.92→1 from the top-right on OutCubic, also 120ms.
    property <float> fade: root.open ? 1.0 : 0.0;
    animate fade { duration: 120ms; }
    property <float> pop: root.open ? 1.0 : 0.0;
    animate pop { duration: 120ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    // `open ||` matters: a hidden element never starts its fade-in (:91).
    visible: root.open || self.fade > 0.01;
    TouchArea { enabled: root.open; clicked => { root.open = false; } }
    // OverflowMenu.qml:101-108: card 10 from the right, rows 34/r9, radius 14.
    card := Rectangle {
        x: root.width - self.width - 10px;
        y: root.top-inset;
        opacity: root.fade;
        transform-origin: { x: self.width, y: 0px };
        transform-scale-x: 0.92 + 0.08 * root.pop;
        transform-scale-y: 0.92 + 0.08 * root.pop;
        width: root.card-width;
        height: col.preferred-height + 12px;
        border-radius: 14px;
        background: root.surface;
        col := VerticalLayout {
            padding: 6px;
            for entry in root.model : mrow := Rectangle {
                height: 34px;
                border-radius: 9px;
                background: mrow-t.pressed || mrow-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                property <color> ink: entry.danger ? Theme.urgent : root.fg;
                // OverflowMenu.qml:126-137: a filled 14px icon at x 12, the
                // label pinned at x 38 and 8 short of the right edge.
                HorizontalLayout {
                    // The icon box carries 3px of slack on each side, taken
                    // back off the lead-in and the gap, so the glyph's centre
                    // and the label's edge both stay exactly where the QML put
                    // them (icon at 12, label at 12 + icon + 12). A Slint Text
                    // clips to its own width, and a box exactly one em wide
                    // shaves the outer antialiasing off a Material Symbol.
                    padding-left: 9px; padding-right: 8px;
                    spacing: 9px;
                    IconLabel {
                        text: entry.icon;
                        filled: true;
                        color: mrow.ink;
                        opacity: 0.85;
                        font-size: Theme.icon-size;
                        width: Theme.icon-size + 6px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.t;
                        color: mrow.ink;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                mrow-t := TouchArea {
                    clicked => { root.open = false; root.picked(entry.a); }
                }
            }
        }
    }
}

// Bottom sheet: one question, a handful of answers.
export component ChoiceSheet inherits Rectangle {
    in property <[ChoiceEntry]> model;
    in property <string> value;
    in property <string> title;
    in-out property <bool> open: false;
    in property <color> fg: Theme.menu-text;
    callback chose(string);
    // ChoiceSheet.qml:20: stays visible while the slide-out plays.
    visible: root.open || sheet.y < root.height - 0.5px;
    // The first layout (and any resize while closed) parks the sheet below
    // the edge instantly; only `open` slides it (the QML's Behavior never
    // sees a size change because its anchors resolve before the first frame).
    property <bool> settled: false;
    property <length> rest;
    changed height => {
        if (!root.open) { root.settled = false; root.rest = sheet.y; }
        root.settled = true;
    }
    scrim := Rectangle {
        width: 100%; height: 100%;
        background: #000000.with-alpha(root.open ? 0.5 : 0.0);
        animate background { duration: 140ms; }
        TouchArea { enabled: root.open; clicked => { root.open = false; } }
    }
    sheet := Rectangle {
        y: root.open ? root.height - self.height : root.height;
        animate y { duration: root.settled ? 180ms : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        width: 100%;
        height: sheet-col.preferred-height + 28px;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: Theme.popup-background;
        Rectangle {
            x: (root.width - 34px) / 2; y: 8px;
            width: 34px; height: 4px; border-radius: 2px;
            background: root.fg.with-alpha(0.25);
        }
        sheet-col := VerticalLayout {
            y: 22px;
            width: 100%;
            if root.title != "" : Rectangle {
                height: sheet-title.preferred-height + 6px;
                sheet-title := Text {
                    x: 22px;
                    text: root.title;
                    color: root.fg.with-alpha(0.55);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    font-weight: 700;
                }
            }
            for entry in root.model : SettingsRow {
                fg: root.fg;
                label: entry.t;
                sublabel: entry.sub;
                trailing: "radio";
                on: root.value == entry.v;
                clicked => { root.open = false; root.chose(entry.v); }
            }
        }
    }
}

// The floating notice a settings page shows for a moment, bottom-centred
// over the page: fill the page with it and set `text`; it hides itself when
// the text is empty and asks to be cleared after `hold`.
// variant "settings": RoomSettingsPage.qml:291-304 — text+26 wide, 34 high,
//   popups.background @0.98 with a 1px fg@0.12 rim, caption, 140ms, 22 up.
// variant "roles": RolesPage.qml:253-264 / PermissionsPage.qml:147-158 —
//   text+28 wide, opaque popups.background, no rim, bodySmall, 150ms, 20 up.
export component NotePill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.menu-text;
    in property <string> variant: "settings";
    /// noteTimer's 2600ms (RoomSettingsPage.qml:20); `expired` asks the host to clear.
    in property <duration> hold: 2600ms;
    callback expired;
    property <bool> settings-look: root.variant == "settings";
    background: transparent;
    pill := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.settings-look ? 22px : 20px);
        width: note-text.preferred-width + (root.settings-look ? 26px : 28px);
        height: 34px;
        border-radius: 17px;
        background: root.settings-look ? Theme.popup-background.with-alpha(0.98) : Theme.popup-background;
        border-width: root.settings-look ? 1px : 0px;
        border-color: root.fg.with-alpha(0.12);
        opacity: root.text != "" ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: root.settings-look ? 140ms : 150ms; }
        note-text := Text {
            text: root.text; color: root.fg;
            font-family: Theme.font-ui;
            font-size: root.settings-look ? Theme.caption : Theme.body-small;
            horizontal-alignment: center; vertical-alignment: center;
            width: 100%; height: 100%;
        }
    }
    note-timer := Timer {
        interval: root.hold;
        running: root.text != "";
        triggered => { self.running = false; root.expired(); }
    }
}

// The two-button question a settings page asks before something one-way
// (RolesPage.qml:132-185, both dialogs share the shape): fill the page with
// it and set `open`. Scrim rgba(0,0,0,0.5) closes on tap; the card is
// min(width-60, 320) wide, col+32 high, r18, popups.background; the column
// is inset 18 with 10 spacing; title subtitle-bold, body bodySmall@0.6;
// buttons 34 high with r=h/2, Cancel fg@0.07 (0.12 hovered), the confirm
// urgent (lighter 1.1 hovered) with bold background-coloured text.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text: "Change";
    in property <color> fg: Theme.menu-text;
    in-out property <bool> open: false;
    callback confirmed;
    background: transparent;
    visible: root.open;
    scrim := Rectangle {
        width: 100%; height: 100%;
        background: #000000.with-alpha(0.5);
        TouchArea { clicked => { root.open = false; } }
    }
    card := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 60px, 320px);
        height: col.preferred-height + 32px;
        border-radius: 18px;
        background: Theme.popup-background;
        TouchArea { }
        col := VerticalLayout {
            x: 18px; y: 16px;
            width: card.width - 36px;
            spacing: 10px;
            Text {
                text: root.title; color: root.fg;
                font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.body; color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui; font-size: Theme.body-small;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                cancel := Rectangle {
                    width: cancel-text.preferred-width + 26px; height: 34px;
                    border-radius: 17px;
                    background: root.fg.with-alpha(cancel-t.has-hover || cancel-t.pressed ? 0.12 : 0.07);
                    cancel-text := Text {
                        text: "Cancel"; color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    cancel-t := TouchArea { clicked => { root.open = false; } }
                }
                ok := Rectangle {
                    width: ok-text.preferred-width + 26px; height: 34px;
                    border-radius: 17px;
                    background: ok-t.has-hover || ok-t.pressed ? Theme.urgent.brighter(0.1) : Theme.urgent;
                    ok-text := Text {
                        text: root.confirm-text; color: Theme.background;
                        font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    ok-t := TouchArea { clicked => { root.open = false; root.confirmed(); } }
                }
            }
        }
    }
}

// The spinner glyph, turning.
export component Spinner inherits Rectangle {
    in property <length> size: Theme.icon-size;
    in property <color> spin-color: Theme.foreground;
    width: root.size; height: root.size;
    background: transparent;
    Text {
        text: Icons.spinner;
        color: root.spin-color;
        font-family: Theme.font-icon;
        font-size: root.size;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
        transform-rotation: 360deg * (animation-tick() / 900ms);
    }
}

// A slide-in page layer: slide from the right, opaque ground, event sink.
export component PageHolder inherits Rectangle {
    in property <bool> active: false;
    in property <color> ground: Theme.menu-background;
    /// A page with its own arrival (the phone's chat): `slides` false snaps
    /// x into place, and on the way out holds it for `hold` so the page's
    /// reverse choreography can play before it goes.
    in property <bool> slides: true;
    in property <duration> hold: 0ms;
    // PageHolder.qml:201-202: the first layout and any resize while inactive
    // park the holder at `width` at once; only `active` slides it. The gate
    // drops to 0ms, x is read to snap, and the gate comes back — all before
    // the frame that would have animated it.
    property <bool> settled: false;
    property <length> rest;
    x: root.active ? 0px : root.width;
    // PageHolder.qml:26-37 steps d×0.26 per frame with a floor: ≈200ms, a
    // hard early decelerate and a near-linear tail.
    animate x {
        duration: root.slides && root.settled ? 200ms : 0ms;
        delay: !root.slides && !root.active && root.settled ? root.hold : 0ms;
        easing: cubic-bezier(0.25, 1, 0.35, 1);
    }
    changed width => {
        if (!root.active) { root.settled = false; root.rest = root.x; }
        root.settled = true;
    }
    visible: root.x < root.width - 0.5px;
    Rectangle {
        width: 100%; height: 100%;
        background: root.ground;
        // The sink sits behind the page content, swallowing stray taps.
        TouchArea { }
    }
    Rectangle {
        width: 100%; height: 100%;
        @children
    }
}

// ScrollBarStyle.qml as an overlay for any Flickable: a 7-wide gutter at the
// right edge holding a 4-wide rounded handle, kept 14 clear of the top and
// bottom and 3 from the edge, never shorter than 14 % of the track. It shows
// only while the content moves or the gutter is hovered/pressed, fading over
// 220ms, and not at all when everything fits (size ≥ 0.995).
export component ScrollBarStyle inherits Rectangle {
    /// The visible height of the list.
    in property <length> view-h;
    /// The list's viewport-height.
    in property <length> content-h;
    /// Two-way with the list's viewport-y: dragging the handle scrolls it.
    in-out property <length> viewport-y;
    /// ScrollBarStyle.qml:156: shown while something else scrolls the list.
    in property <bool> force-active: false;
    width: 7px;
    height: root.view-h;
    background: transparent;
    property <float> size: root.content-h > 0px ? min(1.0, root.view-h / root.content-h) : 1.0;
    // ScrollBarStyle.qml:166
    visible: root.size > 0 && root.size < 0.995;
    // 14 top + 14 bottom padding (:159-160)
    property <length> span: max(0px, root.height - 28px);
    // minimumSize 0.14 (:162)
    property <length> handle-h: max(0.14 * root.span, root.size * root.span);
    property <length> travel: max(0px, root.content-h - root.view-h);
    property <float> position: root.travel > 0px ? clamp(-root.viewport-y / root.travel, 0.0, 1.0) : 0.0;
    // `active` in QQC terms: the list moved within the last moment.
    property <bool> scrolling: false;
    changed viewport-y => { root.scrolling = true; still.running = true; still.restart(); }
    still := Timer {
        interval: 150ms;
        running: false;
        triggered => { self.running = false; root.scrolling = false; }
    }
    property <length> drag-from;
    handle := Rectangle {
        x: 0px;
        y: 14px + root.position * (root.span - root.handle-h);
        width: 4px;
        height: root.handle-h;
        // Behavior on height 240ms OutCubic (:175)
        animate height { duration: 240ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        border-radius: 2px;
        // menu.text @0.45 pressed / 0.35 hovered / 0.2 (:170)
        background: Theme.menu-text.with-alpha(track.pressed ? 0.45 : track.has-hover ? 0.35 : 0.2);
        opacity: root.scrolling || track.has-hover || track.pressed || root.force-active ? 1 : 0;
        animate opacity { duration: 220ms; }
    }
    track := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.drag-from = root.viewport-y; }
        }
        moved => {
            if (self.pressed && root.span > root.handle-h) {
                root.viewport-y = clamp(
                    root.drag-from - (self.mouse-y - self.pressed-y) * (root.travel / (root.span - root.handle-h)),
                    -root.travel, 0px);
            }
        }
    }
}


// The touch list. std-widgets' ListView rides ScrollView, which pans with a
// wheel and a scrollbar but NOT with a finger (proven on device — a bare
// Flickable pans, a bare ListView does not). Every scrolling surface uses
// this instead. It trades ListView's lazy instantiation away; the QML side
// already ran with delegate reuse off, so the parity cost is bounded.
export component TouchList inherits Flickable {
    // ChatPage.qml's ListView is BottomToTop: content shorter than the view
    // hangs from the composer, not the header. `end` reproduces that.
    in property <LayoutAlignment> content-alignment: start;
    /// ScrollBarStyle.qml:156 — set while something scrolls the list
    /// without a flick (the chat's stepped wheel).
    in property <bool> bar-force-active: false;
    // Vertical-only: content width is the visible width, which also stops
    // row widths feeding back into the viewport (binding loop).
    viewport-width: self.width;
    VerticalLayout {
        alignment: root.content-alignment;
        @children
    }
    // The bar rides the viewport, so it is pinned back to the visible frame.
    // Only layout children size the viewport (the compiler's Flickable
    // pass), so this overlay does not stretch the content.
    bar := ScrollBarStyle {
        x: root.width - self.width;
        y: -root.viewport-y;
        view-h: root.height;
        content-h: root.viewport-height;
        viewport-y <=> root.viewport-y;
        force-active: root.bar-force-active;
    }
}
