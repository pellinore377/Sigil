// The shared page furniture, ported from omarchy/components/. Each exists so
// pages cannot drift: the header inset, the 22/56/20 settings-row columns and
// the menu/sheet shapes live here once.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton, Avatar } from "components.slint";

export struct MenuEntry { t: string, a: string, icon: string, danger: bool }
export struct ChoiceEntry { t: string, v: string, sub: string }

// Back, title, at most one trailing text action. 56 high; back at 6.
export component SettingsHeader inherits Rectangle {
    in property <string> title;
    in property <string> action;
    in property <bool> action-enabled: true;
    in property <color> fg: Theme.menu-text;
    callback back;
    callback actioned;
    height: 56px;
    HorizontalLayout {
        padding-left: 6px; padding-right: 18px;
        spacing: 6px;
        Rectangle {
            // PanelActionButton is 22×22 (Style.qml:36), putting the title at
            // x≈34. The tap surface spans the header height for fingers.
            width: 22px;
            back-btn := ActionButton {
                y: (56px - self.height) / 2;
                width: 22px; height: 22px;
                icon: Icons.back;
                filled: false;
                foreground: root.fg;
                clicked => { root.back(); }
            }
            TouchArea { clicked => { root.back(); } }
        }
        Text {
            text: root.title;
            color: root.fg;
            font-family: Theme.font-ui;
            font-size: Theme.heading;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.action != "" : Rectangle {
            width: action-text.preferred-width + 16px;
            action-text := Text {
                text: root.action;
                color: root.action-enabled ? Theme.accent : root.fg.with-alpha(0.35);
                font-family: Theme.font-ui;
                font-size: Theme.body;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 100%; height: 100%;
            }
            TouchArea {
                enabled: root.action-enabled;
                clicked => { root.actioned(); }
            }
        }
    }
}

// A titled band of settings rows: divider, caption title at the 22px content edge.
export component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <bool> divided: true;
    in property <color> fg: Theme.menu-text;
    if root.divided : Rectangle { height: 1px; background: root.fg.with-alpha(0.08); }
    Rectangle { height: root.title != "" ? 14px : 6px; }
    if root.title != "" : Rectangle {
        height: title-text.preferred-height;
        title-text := Text {
            x: 22px;
            text: root.title;
            color: root.fg.with-alpha(0.55);
            font-family: Theme.font-ui;
            font-size: Theme.caption;
            font-weight: 700;
        }
    }
    if root.title != "" : Rectangle { height: 6px; }
    VerticalLayout { @children }
    Rectangle { height: 6px; }
}

// One settings line: icon column 22, text 56, trailing inset 20.
// trailing: none | chevron | value | toggle | radio | count | check
export component SettingsRow inherits Rectangle {
    in property <string> icon;
    in property <bool> filled: false;
    in property <string> label;
    in property <string> sublabel;
    in property <string> trailing: "none";
    in property <string> value;
    in property <bool> on: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <color> fg: Theme.menu-text;
    callback clicked;

    property <color> ink: root.danger ? Theme.urgent
                        : root.enabled ? root.fg : root.fg.with-alpha(0.38);
    height: root.sublabel != "" ? 60px : 48px;

    Rectangle {
        x: 10px; width: root.width - 20px;
        y: 4px; height: root.height - 8px;
        border-radius: 12px;
        background: (touch.pressed || touch.has-hover) && root.enabled
            ? root.fg.with-alpha(0.05) : transparent;
    }
    if root.icon != "" : IconLabel {
        x: 22px;
        y: (root.height - self.preferred-height) / 2;
        text: root.icon;
        filled: root.filled;
        color: root.danger ? Theme.urgent : root.ink.with-alpha(0.75);
    }
    labels := VerticalLayout {
        x: root.icon != "" ? 56px : 22px;
        width: root.width - self.x - 20px - tail.width - 10px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.ink;
            font-family: Theme.font-ui;
            font-size: Theme.body;
            overflow: elide;
        }
        // SettingsRow.qml caps the sublabel at two lines; Slint has no
        // maximumLineCount, so clip at two line-heights instead.
        if root.sublabel != "" : Rectangle {
            clip: true;
            height: min(sub-text.preferred-height, 2 * Theme.caption * 1.35);
            sub-text := Text {
                width: 100%;
                text: root.sublabel;
                color: root.ink.with-alpha(0.55);
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
    tail := Rectangle {
        x: root.width - self.width - 20px;
        width: root.trailing == "toggle" ? 38px
             : root.trailing == "radio" || root.trailing == "check" ? 20px
             : root.trailing == "chevron" ? 18px
             : root.trailing == "value" || root.trailing == "count" ? tail-value.preferred-width
             : 0px;
        height: root.height;
        if root.trailing == "toggle" : Rectangle {
            y: (root.height - 22px) / 2;
            width: 38px; height: 22px;
            border-radius: 11px;
            background: root.on ? Theme.accent.with-alpha(0.8) : root.fg.with-alpha(0.15);
            opacity: root.enabled ? 1 : 0.45;
            knob := Rectangle {
                width: 16px; height: 16px; border-radius: 8px;
                y: 3px;
                x: root.on ? 38px - 16px - 3px : 3px;
                background: root.fg;
                animate x { duration: 120ms; }
            }
        }
        if root.trailing == "radio" : Rectangle {
            y: (root.height - 20px) / 2;
            width: 20px; height: 20px; border-radius: 10px;
            border-width: 2px;
            border-color: root.on ? Theme.accent : root.fg.with-alpha(0.35);
            opacity: root.enabled ? 1 : 0.45;
            if root.on : Rectangle {
                x: 5px; y: 5px; width: 10px; height: 10px; border-radius: 5px;
                background: Theme.accent;
            }
        }
        if root.trailing == "check" : Rectangle {
            y: (root.height - 20px) / 2;
            width: 20px; height: 20px; border-radius: 4px;
            background: root.on ? Theme.accent : transparent;
            border-width: 2px;
            border-color: root.on ? Theme.accent : root.fg.with-alpha(0.35);
            if root.on : IconLabel {
                text: Icons.check;
                color: Theme.background;
                font-size: Theme.caption;
                width: 100%; height: 100%;
            }
        }
        if root.trailing == "chevron" : IconLabel {
            text: Icons.chevronRight;
            color: root.ink.with-alpha(0.4);
            font-size: Theme.icon-size;
            height: root.height;
        }
        tail-value := Text {
            visible: root.trailing == "value" || root.trailing == "count";
            text: root.value;
            color: root.ink.with-alpha(0.5);
            font-family: Theme.font-ui;
            font-size: Theme.body;
            vertical-alignment: center;
            height: root.height;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The ⋮ menu dropping from a header's top-right; owns its scrim.
export component OverflowMenu inherits Rectangle {
    in property <[MenuEntry]> model;
    in-out property <bool> open: false;
    in property <length> top-inset: 50px;
    in property <color> fg: Theme.menu-text;
    callback picked(string);
    // 120ms fade + scale-in from the top-right corner, the QML's motion.
    property <float> show: root.open ? 1.0 : 0.0;
    animate show { duration: 120ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    // `open ||` matters: a hidden element never starts its fade-in.
    visible: root.open || self.show > 0.01;
    opacity: self.show;
    TouchArea { clicked => { root.open = false; } }
    // ChatPage.qml menu card: 170 wide at y 50, rows 34/r9, popups @0.98, no border.
    card := Rectangle {
        x: root.width - self.width - 10px;
        y: root.top-inset;
        transform-origin: { x: self.width, y: 0px };
        transform-scale-x: 0.92 + 0.08 * root.show;
        transform-scale-y: 0.92 + 0.08 * root.show;
        width: 170px;
        height: col.preferred-height + 12px;
        border-radius: 14px;
        background: Theme.popup-background.with-alpha(0.98);
        col := VerticalLayout {
            padding: 6px;
            for entry in root.model : mrow := Rectangle {
                height: 34px;
                border-radius: 9px;
                background: mrow-t.pressed || mrow-t.has-hover ? root.fg.with-alpha(0.08) : transparent;
                property <color> ink: entry.danger ? Theme.urgent : root.fg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 8px;
                    spacing: 10px;
                    IconLabel {
                        text: entry.icon;
                        color: mrow.ink;
                        opacity: 0.85;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.t;
                        color: mrow.ink;
                        font-family: Theme.font-ui;
                        font-size: Theme.body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                mrow-t := TouchArea {
                    clicked => { root.open = false; root.picked(entry.a); }
                }
            }
        }
    }
}

// Bottom sheet: one question, a handful of answers.
export component ChoiceSheet inherits Rectangle {
    in property <[ChoiceEntry]> model;
    in property <string> value;
    in property <string> title;
    in-out property <bool> open: false;
    in property <color> fg: Theme.menu-text;
    callback chose(string);
    visible: root.open;
    scrim := Rectangle {
        width: 100%; height: 100%;
        background: #000000.with-alpha(root.open ? 0.5 : 0.0);
        animate background { duration: 140ms; }
        TouchArea { clicked => { root.open = false; } }
    }
    sheet := Rectangle {
        y: root.open ? root.height - self.height : root.height;
        animate y { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        width: 100%;
        height: sheet-col.preferred-height + 28px;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: Theme.popup-background;
        Rectangle {
            x: (root.width - 34px) / 2; y: 8px;
            width: 34px; height: 4px; border-radius: 2px;
            background: root.fg.with-alpha(0.25);
        }
        sheet-col := VerticalLayout {
            y: 22px;
            width: 100%;
            if root.title != "" : Rectangle {
                height: sheet-title.preferred-height + 6px;
                sheet-title := Text {
                    x: 22px;
                    text: root.title;
                    color: root.fg.with-alpha(0.55);
                    font-family: Theme.font-ui;
                    font-size: Theme.caption;
                    font-weight: 700;
                }
            }
            for entry in root.model : SettingsRow {
                fg: root.fg;
                label: entry.t;
                sublabel: entry.sub;
                trailing: "radio";
                on: root.value == entry.v;
                clicked => { root.open = false; root.chose(entry.v); }
            }
        }
    }
}

// The spinner glyph, turning.
export component Spinner inherits Rectangle {
    in property <length> size: Theme.icon-size;
    in property <color> spin-color: Theme.foreground;
    width: root.size; height: root.size;
    background: transparent;
    Text {
        text: Icons.spinner;
        color: root.spin-color;
        font-family: Theme.font-icon;
        font-size: root.size;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
        transform-rotation: 360deg * (animation-tick() / 900ms);
    }
}

// A slide-in page layer: slide from the right, opaque ground, event sink.
export component PageHolder inherits Rectangle {
    in property <bool> active: false;
    in property <color> ground: Theme.menu-background;
    x: root.active ? 0px : root.width;
    animate x { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    visible: root.x < root.width - 0.5px;
    Rectangle {
        width: 100%; height: 100%;
        background: root.ground;
        // The sink sits behind the page content, swallowing stray taps.
        TouchArea { }
    }
    Rectangle {
        width: 100%; height: 100%;
        @children
    }
}


// The touch list. std-widgets' ListView rides ScrollView, which pans with a
// wheel and a scrollbar but NOT with a finger (proven on device — a bare
// Flickable pans, a bare ListView does not). Every scrolling surface uses
// this instead. It trades ListView's lazy instantiation away; the QML side
// already ran with delegate reuse off, so the parity cost is bounded.
export component TouchList inherits Flickable {
    // ChatPage.qml's ListView is BottomToTop: content shorter than the view
    // hangs from the composer, not the header. `end` reproduces that.
    in property <LayoutAlignment> content-alignment: start;
    // Vertical-only: content width is the visible width, which also stops
    // row widths feeding back into the viewport (binding loop).
    viewport-width: self.width;
    VerticalLayout {
        alignment: root.content-alignment;
        @children
    }
}
