// Every struct that crosses the Rust↔Slint boundary, in one place so pages
// and the bridge cannot disagree. Field meanings follow the engine item
// schema (core/docs/protocol.md) via Service.qml's decorate().

export struct ReactionChip {
    key: string,
    count: int,
    mine: bool,
    senders-text: string,
}

export struct ReplyRef {
    event-id: string,
    sender-name: string,
    kind: string,
    body: string,
    tint: color,
}

export struct PollOption {
    id: string,
    text: string,
    votes: int,
    mine: bool,
    winner: bool,
}

export struct TimelineRow {
    id: string,
    event-id: string,
    kind: string,        // text notice emote image video audio voice file sticker
                         // poll location contact redacted utd state dayDivider unsupported
    body: string,
    html-ish: bool,      // body carries formatting the effects pass renders
    sender: string,
    sender-name: string,
    initials: string,
    tint: color,
    avatar: image,
    show-header: bool,   // sender name row (group start, not own, not dm)
    show-avatar: bool,
    is-own: bool,
    group-start: bool,
    group-end: bool,
    stamp: string,
    day-label: string,   // non-empty: draw a session divider above this row
    edited: bool,
    highlighted: bool,
    send-state: string,  // sent | sending | failed
    send-error: string,
    read-count: int,
    media-icon: string,
    // media bodies
    thumb: image,
    thumb-w: length,
    thumb-h: length,
    media-filename: string,
    media-size: string,
    duration: string,
    reply: ReplyRef,
    has-reply: bool,
    reactions: [ReactionChip],
    thread-root: string,
    thread-count: int,
    can-edit: bool,
    can-reply: bool,
    can-redact: bool,
    can-react: bool,
    utd: bool,
    // voice / audio
    waveform: [float],
    voice-playing: bool,
    voice-frac: float,     // playback progress 0..1
    // poll (MSC3381)
    poll-question: string,
    poll-options: [PollOption],
    poll-total: int,
    poll-ended: bool,
    poll-multi: bool,
    // contact card
    contact-name: string,
    contact-id: string,
    // location
    location-label: string,
    location-live: bool,
    location-ended: bool,
    // read marker / receipts
    doc-lines: [string],
    doc-chip: string,        // TEXT / PDF / …; non-empty draws the page card
    doc-thumb: image,        // rendered page (pdf) when the engine returns one
    has-doc-image: bool,
    is-read-marker: bool,
    owns-receipt: bool,    // this own message wears the sent/read mark
    receipt-count: int,
    pinned: bool,
}

export struct RoomRow {
    id: string,
    name: string,
    initials: string,
    avatar: image,
    tint: color,
    preview: string,
    preview-icon: string,
    stamp: string,
    badge: string,
    badge-urgent: bool,
    unread: bool,
    is-favourite: bool,
    is-low-priority: bool,
    is-encrypted: bool,
    has-call: bool,
    is-invite: bool,
    is-typing: bool,
    presence: string,
    is-dm: bool,
    is-space: bool,
    topic: string,
    member-count: int,
}

export struct MemberRow {
    user-id: string,
    display-name: string,
    initials: string,
    avatar: image,
    tint: color,
    power-level: int,
    role: string,        // Admin | Moderator | ""
    membership: string,  // join | invite | ban | leave
    presence: string,    // online | away | busy | offline | ""
}

export struct SpaceRow {
    id: string,
    name: string,
    initials: string,
    avatar: image,
    tint: color,
    level: int,
    room-count: int,
}

// space.hierarchy rows: children this account may not have joined.
export struct HierarchyRow {
    id: string,
    name: string,
    topic: string,
    initials: string,
    avatar: image,
    tint: color,
    member-count: int,
    is-space: bool,
    joined: bool,
    encrypted: bool,
    in-space: bool,      // already m.space.child of the space being managed
}

export struct ThreadRow {
    root-id: string,
    sender-name: string,
    initials: string,
    tint: color,
    avatar: image,
    body: string,
    reply-count: int,
    last-ts-label: string,
}

export struct UserRow {
    user-id: string,
    display-name: string,
    initials: string,
    avatar: image,
    tint: color,
    saved: bool,
}

// room.settings in one struct: everything the settings pages read.
export struct RoomSettingsModel {
    room-id: string,
    name: string,
    topic: string,
    canonical-alias: string,
    initials: string,
    avatar: image,
    tint: color,
    is-space: bool,
    is-dm: bool,
    join-rule: string,          // public | invite | knock | restricted
    history-visibility: string, // world_readable | shared | invited | joined
    encrypted: bool,
    notification-mode: string,  // "" = account default | all | mentions | mute
    my-power-level: int,
    member-count: int,
    can-edit-info: bool,
    can-edit-permissions: bool,
    can-invite: bool,
    can-kick: bool,
    can-ban: bool,
    is-favourite: bool,
    is-low-priority: bool,
}

export struct PowerRow {
    key: string,       // invite kick ban redact eventsDefault stateDefault ...
    label: string,
    level: int,
}

export struct DeviceRow {
    id: string,
    label: string,
    selected: bool,
}

export struct CallParticipant {
    identity: string,
    display-name: string,
    initials: string,
    tint: color,
    avatar: image,
    speaking: bool,
    mic-muted: bool,
    camera-on: bool,
    screen-sharing: bool,
    frame: image,        // live video frame, refreshed by the bridge
    has-frame: bool,
}

export struct EmojiItem {
    glyph: string,
    name: string,
}
