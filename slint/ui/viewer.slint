// ImageViewer — components/ImageViewer.qml. Top bar, a swipeable pager over
// every image in the room, zoom, video playback, quick reactions.
//
// Gesture notes for the integrator (also in WIRING-media.md):
// - Pinch zoom rides ScaleRotateGestureHandler (two-finger); double-tap and
//   ctrl+wheel / wheel-when-zoomed are the fallbacks, exactly the QML set
//   (ImageViewer.qml:432-450, 484-495). There are no on-screen zoom discs.
// - Pan-while-zoomed uses moved-deltas — inherently passive, per portability.
// - The QML backdrop is a blurred page snapshot under a black veil
//   (ImageViewer.qml:70-86). Slint has no backdrop shader, so the picture is
//   taken in Rust the way the long-press sheet's is (frost.rs, one snapshot
//   of the window blurred) and handed down Theme.viewer-frost. With no
//   picture the ground under the same veil stands in, as it always did.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton } from "components.slint";
import { Spinner } from "furniture.slint";
import { EmojiPicker } from "emoji.slint";
import { EmojiItem } from "model.slint";

export struct ViewerItem {
    event-id: string,
    kind: string,        // image | video
    sender-name: string,
    is-own: bool,
    ts-label: string,    // formatted Rust-side (fmtTs)
    img: image,          // full image, poster frame for videos
    have-img: bool,
    w: int,
    h: int,
    can-redact: bool,
    gif-frames: [image], // >1: animate (frames from media.gifFrames)
    gif-delays: [int],
}

export component ImageViewer inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <[ViewerItem]> items;
    in-out property <int> cur: -1;
    in property <[string]> forward-names;   // first rooms, for the forward card
    in property <string> toast;
    // Video playback (engine decodes; Rust hands frames + clock)
    in property <string> playing-event: "";
    in property <image> video-frame;
    in property <float> play-pos: 0;
    in property <float> play-duration: 0;
    in property <bool> scrubbing: false;

    // ImageViewer.qml:32 — `shown`. The app binds it to viewer-open once the
    // viewer stays mounted (handoff); the default keeps an `if`-mounted viewer
    // working, since it then opens on mount.
    in property <bool> shown: true;
    // ImageViewer.qml:132-136 — the tapped thumbnail, in viewer coordinates.
    // A zero width means "no thumbnail": opened without the morph (:140-143).
    in property <length> from-x: 0;
    in property <length> from-y: 0;
    in property <length> from-w: 0;
    in property <length> from-h: 0;
    // ImageViewer.qml:17, 66-69 — the card's radius, so the corners sit flush.
    in property <length> scrim-radius: 0;

    callback closed;
    callback page-changed(int);      // fetch full image for index
    callback download-requested;
    callback delete-requested;
    callback share-requested;
    callback forward-to(int);
    callback react(string);
    callback toggle-playback;
    callback seek-requested(float);
    callback scrub-state(bool, float);

    // ImageViewer.qml:64-69, 83 — solid ground under the veil, the card's
    // radius, clipped. Nothing else paints it: the frost lies on top.
    background: Theme.menu-background;
    border-radius: root.scrim-radius;
    clip: true;

    /// Whether Rust managed to take the picture (a renderer that cannot
    /// snapshot hands back nothing, as it does for the sheet).
    property <bool> frosted: Theme.viewer-frost.width > 0;
    property <float> frost-aspect: root.frosted
        ? (Theme.viewer-frost.height * 1.0) / Theme.viewer-frost.width : 1.0;
    // ImageViewer.qml:70-86 — the blurred page under the veil, masked to the
    // card's shape by the root's own radius and clip.
    frost := Rectangle {
        width: 100%; height: 100%;
        if root.frosted : Image {
            // The picture is of the whole window, and the viewer is mounted
            // inside the page area — below the safe-area inset and the status
            // strip (app.slint) — so it is laid out in window coordinates and
            // the root's clip cuts it back to the card. QML had the same
            // problem and sourced the pages item (:84); here the snapshot is
            // of everything, so the picture moves instead. Its height comes
            // from its own aspect: nothing here knows the window's.
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: root.width + 2 * root.absolute-position.x;
            height: self.width * root.frost-aspect;
            source: Theme.viewer-frost;
            image-fit: fill;
            image-rendering: smooth;
        }
        // The veil. ImageViewer.qml:85 says 0.82, written against the
        // desktop's grey ground; over the phone's near-black page that buries
        // the frost entirely — which is what "flat black" looked like — so a
        // real picture wears the long-press sheet's own veil instead
        // (MessageSheet.qml:155-169, sheet.slint), and only the no-picture
        // fallback keeps the deeper QML number over the bare ground.
        Rectangle {
            width: 100%; height: 100%;
            background: #000000.with-alpha(root.frosted ? 0.55 : 0.82);
        }
    }
    // ImageViewer.qml:286-290 — the whole viewer is a tap-away, under
    // everything: the letterbox, the bands above and below the pager, the
    // margins beside the top bar. The pager's own surface and every control
    // are declared after it, so they take their taps first.
    close-sink := TouchArea {
        width: 100%; height: 100%;
        enabled: root.shown && !root.closing;
        clicked => { if (!root.zoomed) { root.close(); } }
        scroll-event(e) => { root.wheel-nav(e.delta-y / 1px); accept }
    }

    // ---- open / close motion (ImageViewer.qml:38-53, 132-152) ----
    // `released` rises one frame after `shown`, as viewerGrow (:49) does: the
    // first frame holds the snapped thumbnail-size scale at opacity 0, then
    // opacity fades in over 190ms (:40) while the scale flies to 1 over 270ms
    // (:46-47). Closing (:147-152) fades at full size and reports `closed`
    // after 200ms, so an `if`-mounted viewer still gets its fade.
    property <bool> released: false;
    property <bool> closing: false;
    property <bool> morphing: root.shown && !root.released && root.from-w > 1px;
    property <length> m-ox: root.from-x + root.from-w / 2;
    property <length> m-oy: root.from-y + root.from-h / 2;
    property <float> m-scale: max(0.04, root.from-w / max(1px, root.width));
    opacity: root.shown && root.released && !root.closing ? 1 : 0;
    animate opacity { duration: 190ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    transform-origin: { x: root.m-ox, y: root.m-oy };
    transform-scale-x: root.morphing ? root.m-scale : 1.0;
    transform-scale-y: root.morphing ? root.m-scale : 1.0;
    animate transform-scale-x, transform-scale-y { duration: root.released ? 270ms : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    // :38 — visible while there is something to show and the fade is not done.
    // Visible from the first (transparent) frame too: focus needs a visible item.
    visible: root.cur >= 0 && root.items.length > 0
        && ((root.shown && !root.closing) || root.opacity > 0.01);
    grow := Timer {
        interval: 16ms;
        running: root.shown && !root.released;
        triggered => { root.released = true; keys.focus(); }
    }
    changed shown => {
        if (!root.shown) {
            root.released = false; root.closing = false;
            // QML throws the pager's delegates away with the viewer, so the
            // next picture always arrives at fit, unturned, with no menu up.
            // Nothing here is thrown away, so it is unwound by hand.
            root.reset-zoom();
            root.drag-dx = 0; root.turning = false; root.turn-dir = 0;
            root.more-open = false; root.fwd-open = false;
            root.picker-open = false;
        }
    }
    fade := Timer {
        interval: 200ms;
        running: root.closing;
        triggered => { root.closing = false; root.closed(); }
    }
    function close() {
        if (root.closing || !root.shown) { return; }
        root.released = true;       // :149 no reverse flight: fade at full size
        root.closing = true;
    }

    // ImageViewer.qml:55-63 — own the keyboard while open; Escape unwinds the
    // more menu, then the forward menu, then the viewer. Not shown: let the
    // key travel on to the app's back scope.
    keys := FocusScope {
        width: 100%; height: 100%;
        init => { if (root.shown) { self.focus(); } }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.shown && !root.closing) {
                if (root.picker-open) { root.picker-open = false; }
                else if (root.more-open) { root.more-open = false; }
                else if (root.fwd-open) { root.fwd-open = false; }
                else { root.close(); }
                return accept;
            }
            reject
        }
    }

    property <ViewerItem> it: root.items[max(0, root.cur)];
    property <bool> is-video: root.it.kind == "video";
    property <bool> playing: root.playing-event != "" && root.playing-event == root.it.event-id;

    // ---- zoom (current page only; resets on page change) ----
    property <float> zoom: 1;
    property <length> ox: 0;
    property <length> oy: 0;
    property <bool> zoomed: root.zoom > 1.01;
    in-out property <length> drag-dx: 0;
    // Measured off the platform messenger's own viewer (docs: the reference
    // shot is 1344×2992 at 2.55 px/dp, so every number below is that shot's
    // pixels divided by 2.55). The stage runs from the header's bottom edge
    // (64) to 132 above the viewer's foot — the picture there fills that band
    // exactly, 899 tall, which is what fixes both numbers. The side inset
    // stays 28 a side: the reference's picture is a tall one and never
    // reaches the width, so only the height band is measurable.
    property <length> page-w: root.width - 56px;
    property <length> page-h: root.height - 64px - 132px;
    // ImageViewer.qml:319-321, 328-329 — 800×600 when the media carries no
    // size; fit = round(i × min(W/iw, H/ih)), never under 1.
    property <float> iw: root.it.w > 0 ? root.it.w : 800;
    property <float> ih: root.it.h > 0 ? root.it.h : 600;
    property <float> fs: min(root.page-w / 1px / root.iw, root.page-h / 1px / root.ih);
    property <length> fit-w: max(1px, round(root.iw * root.fs) * 1px);
    property <length> fit-h: max(1px, round(root.ih * root.fs) * 1px);
    // One page pitch. The reference puts the neighbour's inner edge 16 inside
    // the frame whatever the picture's shape (measured: a 404-wide picture in
    // a 527 frame, the sliver 16 wide), so the pitch is read off that edge —
    // half the picture plus half the gutter, less the sliver — rather than
    // off a fixed page width. A flat page-width pitch only showed the sliver
    // for a picture that filled the width; a tall one hid it off-screen.
    property <length> pitch: (root.width + root.fit-w) / 2 - 16px;

    function clamp-offsets() {
        root.ox = max(-max(0px, (root.fit-w * root.zoom - root.page-w) / 2),
                  min(max(0px, (root.fit-w * root.zoom - root.page-w) / 2), root.ox));
        root.oy = max(-max(0px, (root.fit-h * root.zoom - root.page-h) / 2),
                  min(max(0px, (root.fit-h * root.zoom - root.page-h) / 2), root.oy));
    }
    // Zoom about a point (fx/fy relative to the page centre): holding f fixed
    // across a zoom gives o1 = f - (f - o0) * z1/z0 — the QML maths verbatim.
    public function zoom-about(z: float, fx: length, fy: length) {
        if (abs(min(6.0, max(1.0, z)) - root.zoom) < 0.0001) { return; }
        root.ox = fx - (fx - root.ox) * (min(6.0, max(1.0, z)) / root.zoom);
        root.oy = fy - (fy - root.oy) * (min(6.0, max(1.0, z)) / root.zoom);
        root.zoom = min(6.0, max(1.0, z));
        root.clamp-offsets();
    }
    public function reset-zoom() { root.zoom = 1; root.ox = 0; root.oy = 0; }
    function go(idx: int) {
        if (idx < 0 || idx >= root.items.length || idx == root.cur) { return; }
        root.reset-zoom();
        root.cur = idx;
        root.page-changed(idx);
    }

    // ---- page turn (ImageViewer.qml:301-308) ----
    // SnapOneItem with highlightMoveDuration 200: a release past the threshold
    // slides one pitch and commits; short of it, the page settles back. `shift`
    // is what the stage draws — the live drag, or the 200ms settle.
    property <bool> turning: false;
    property <int> turn-dir: 0;
    property <length> turn-target: 0;
    property <length> shift: root.turning ? root.turn-target : root.drag-dx;
    animate shift { duration: root.turning ? 200ms : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    turn-clock := Timer {
        interval: 200ms;
        running: root.turning;
        triggered => {
            root.turning = false;
            root.drag-dx = 0;
            if (root.turn-dir != 0) { root.go(root.cur + root.turn-dir); }
            root.turn-dir = 0;
        }
    }
    function turn(dir: int) {
        if (root.turning) { return; }
        root.turn-dir = (dir != 0 && root.cur + dir >= 0 && root.cur + dir < root.items.length) ? dir : 0;
        root.turn-target = -root.turn-dir * root.pitch;
        root.turning = true;
    }

    // ImageViewer.qml:273-285 — wheelNav: accumulate to a notch (120), then one
    // page per notch with a 160ms lockout. Slint hands a notch as 60 logical
    // px (winit LineDelta × 60), so the delta is doubled to Qt's angleDelta.
    property <float> wheel-acc: 0;
    property <int> wheel-dir: 0;
    property <bool> wheel-locked: false;
    wheel-lock := Timer {
        interval: 160ms;
        running: root.wheel-locked;
        triggered => { root.wheel-locked = false; }
    }
    function wheel-nav(dy: float) {
        root.wheel-acc += dy * 2;
        if (abs(root.wheel-acc) < 120) { return; }
        root.wheel-dir = root.wheel-acc < 0 ? 1 : -1;
        root.wheel-acc = 0;
        if (root.wheel-locked) { return; }
        root.wheel-locked = true;
        root.turn(root.wheel-dir);
    }

    // Where the current picture actually is, in the viewer's own coordinates,
    // after the fit, the zoom, the pan and a page-turn's slide. Android has no
    // decoder on this side and lays the platform's own player over the Slint
    // surface, so it needs this box and needs it to follow every gesture —
    // hence bindings onto what the stage already draws, not a second sum.
    out property <length> pic-x: stage.x + media.x;
    out property <length> pic-y: stage.y + media.y;
    out property <length> pic-w: media.width;
    out property <length> pic-h: media.height;

    // ---- stage ----
    stage := Rectangle {
        y: 64px;
        width: 100%;
        height: root.page-h;
        clip: true;

        // Filmstrip: the neighbouring pictures, one pitch apart, each with its
        // own spinner and no slab behind it (ImageViewer.qml:292-316, :475).
        // They are there at rest, not only under a drag: `pitch` is set so the
        // neighbour's edge stands 16 inside the frame the whole time — that
        // sliver is what says there is another picture to swipe to, and the
        // port was hiding it for anything but a width-filling picture.
        if root.cur > 0 && !root.zoomed : prev-peek := Rectangle {
            property <ViewerItem> pit: root.items[root.cur - 1];
            property <float> piw: self.pit.w > 0 ? self.pit.w : 800;
            property <float> pih: self.pit.h > 0 ? self.pit.h : 600;
            property <float> ps: min(root.page-w / 1px / self.piw, root.page-h / 1px / self.pih);
            property <length> pfw: max(1px, round(self.piw * self.ps) * 1px);
            property <length> pfh: max(1px, round(self.pih * self.ps) * 1px);
            x: (stage.width - self.pfw) / 2 - root.pitch + root.shift;
            y: (stage.height - self.pfh) / 2;
            width: self.pfw; height: self.pfh;
            border-radius: 20px;   // measured: 51px at 2.55 px/dp
            clip: true;
            background: transparent;
            if self.pit.have-img : Image {
                source: prev-peek.pit.img;
                width: 100%; height: 100%;
            }
            if !self.pit.have-img && self.pit.kind != "video" : Spinner {
                x: (prev-peek.width - self.width) / 2; y: (prev-peek.height - self.height) / 2;
                spin-color: root.fg.with-alpha(0.5);
            }
        }
        if root.cur < root.items.length - 1 && !root.zoomed : next-peek := Rectangle {
            property <ViewerItem> nit: root.items[root.cur + 1];
            property <float> niw: self.nit.w > 0 ? self.nit.w : 800;
            property <float> nih: self.nit.h > 0 ? self.nit.h : 600;
            property <float> ns: min(root.page-w / 1px / self.niw, root.page-h / 1px / self.nih);
            property <length> nfw: max(1px, round(self.niw * self.ns) * 1px);
            property <length> nfh: max(1px, round(self.nih * self.ns) * 1px);
            x: (stage.width - self.nfw) / 2 + root.pitch + root.shift;
            y: (stage.height - self.nfh) / 2;
            width: self.nfw; height: self.nfh;
            border-radius: 20px;   // measured: 51px at 2.55 px/dp
            clip: true;
            background: transparent;
            if self.nit.have-img : Image {
                source: next-peek.nit.img;
                width: 100%; height: 100%;
            }
            if !self.nit.have-img && self.nit.kind != "video" : Spinner {
                x: (next-peek.width - self.width) / 2; y: (next-peek.height - self.height) / 2;
                spin-color: root.fg.with-alpha(0.5);
            }
        }

        media := Rectangle {
            property <int> gif-frame: 0;
            x: (stage.width - root.fit-w * root.zoom) / 2 + root.ox + root.shift;
            y: (stage.height - root.fit-h * root.zoom) / 2 + root.oy;
            width: root.fit-w * root.zoom;
            height: root.fit-h * root.zoom;
            border-radius: 20px;   // measured: 51px at 2.55 px/dp
            clip: true;
            // The still: the picture, or a video's poster. It stays up through
            // the second or so a decoder takes to hand over its first frame,
            // which used to be a black page (ImageViewer.qml kept the poster
            // under the video surface for the same reason).
            if root.it.have-img && root.it.gif-frames.length <= 1
                && (!root.playing || root.video-frame.width == 0) : Image {
                source: root.it.img;
                width: 100%; height: 100%;
                image-fit: fill;
            }
            // Animated GIF: the same engine frame strip the bubble cycles.
            if root.it.gif-frames.length > 1 && !root.playing : Image {
                source: root.it.gif-frames[min(media.gif-frame, root.it.gif-frames.length - 1)];
                width: 100%; height: 100%;
                image-fit: fill;
            }
            gif-clock := Timer {
                interval: root.it.gif-frames.length > 1
                    ? max(20, root.it.gif-delays[min(media.gif-frame, root.it.gif-delays.length - 1)]) * 1ms
                    : 1000ms;
                running: root.it.gif-frames.length > 1 && !root.playing;
                triggered => {
                    media.gif-frame = mod(media.gif-frame + 1, root.it.gif-frames.length);
                }
            }
            if root.playing : Image {
                source: root.video-frame;
                width: 100%; height: 100%;
                image-fit: contain;
            }
            if root.is-video && !root.playing : play-disc := Rectangle {
                x: (media.width - 60px) / 2; y: (media.height - 60px) / 2;
                width: 60px; height: 60px; border-radius: 30px;
                background: #000000.with-alpha(0.55);
                IconLabel { text: Icons.play; color: #ffffff; font-size: 26px; width: 100%; height: 100%; }
            }
        }
        // ImageViewer.qml:475 — the spinner in fg@0.5 while the full image loads.
        if !root.it.have-img && !root.is-video : Spinner {
            x: (stage.width - self.width) / 2; y: (stage.height - self.height) / 2;
            spin-color: root.fg.with-alpha(0.5);
        }

        // Swipe / pan / tap / double-tap / wheel — one surface, mode by state.
        property <length> last-x: 0;
        property <length> last-y: 0;
        // A press that travelled is a swipe or a pan, never a tap (Slint fires
        // `clicked` on every release; QML's MouseArea would not see a flick).
        property <bool> dragged: false;
        // Pinch zoom — ScaleRotateGestureHandler (two-finger; single-finger
        // input still lands on the TouchArea below). Same zoom-about maths.
        // ImageViewer.qml:434 — not for a video.
        pinch := ScaleRotateGestureHandler {
            width: 100%; height: 100%;
            enabled: !root.is-video;
            property <float> start-zoom: 1.0;
            started => { self.start-zoom = root.zoom; }
            updated => {
                root.zoom-about(self.start-zoom * self.scale,
                    self.center.x - stage.width / 2,
                    self.center.y - stage.height / 2);
            }
        }
        gesture := TouchArea {
            enabled: !root.turning;
            clicked => {
                if (stage.dragged) { return; }
                // ImageViewer.qml:429 — on the media itself a tap toggles a
                // video and does nothing for a picture …
                if (self.mouse-x >= media.x && self.mouse-x < media.x + media.width
                    && self.mouse-y >= media.y && self.mouse-y < media.y + media.height) {
                    if (root.is-video) { root.toggle-playback(); }
                    return;
                }
                // … and anywhere else (the letterbox too) closes (:286-290).
                if (!root.zoomed) { root.close(); }
            }
            double-clicked => {
                if (root.is-video) { return; }
                if (root.zoomed) { root.reset-zoom(); }
                else {
                    root.zoom-about(2.5, self.mouse-x - stage.width / 2, self.mouse-y - stage.height / 2);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    stage.last-x = self.mouse-x;
                    stage.last-y = self.mouse-y;
                    stage.dragged = false;
                    root.drag-dx = 0;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (!root.zoomed) {
                        // ImageViewer.qml:301 — past a quarter page turns, else settle back.
                        if (abs(root.drag-dx / 1px) > stage.width / 4px) {
                            root.turn(root.drag-dx < 0 ? 1 : -1);
                        } else if (root.drag-dx != 0) {
                            root.turn(0);
                        }
                    }
                }
            }
            moved => {
                if (abs((self.mouse-x - self.pressed-x) / 1px) > 6 || abs((self.mouse-y - self.pressed-y) / 1px) > 6) {
                    stage.dragged = true;
                }
                if (root.zoomed) {
                    root.ox += self.mouse-x - stage.last-x;
                    root.oy += self.mouse-y - stage.last-y;
                    root.clamp-offsets();
                } else {
                    root.drag-dx = self.mouse-x - self.pressed-x;
                }
                stage.last-x = self.mouse-x;
                stage.last-y = self.mouse-y;
            }
            // ImageViewer.qml:484-495 — ctrl+wheel zooms, a plain wheel zooms
            // too once magnified, otherwise it pages through wheelNav.
            scroll-event(e) => {
                if (e.modifiers.control || root.zoomed) {
                    root.zoom-about(root.zoom * (e.delta-y > 0 ? 1.25 : 0.8),
                                    self.mouse-x - stage.width / 2,
                                    self.mouse-y - stage.height / 2);
                    return accept;
                }
                root.wheel-nav(e.delta-y / 1px);
                return accept;
            }
        }
    }

    // ---- top bar ----
    // Measured off the reference (px @ 2.55 px/dp → dp): the row is 64 tall
    // with nothing painted behind it, every glyph 24 in a 48 tap target, the
    // close cross centred 28 from the left and the three right glyphs on a
    // 48 pitch ending 28 from the right. The two title lines are ink-centred
    // on the same axis as the glyphs (measured centre 32 from the row's top),
    // the name 16 and the time 14, both in the same ink — the reference does
    // not dim the time, and the port's 0.55 was the visible difference.
    property <length> bar-h: 64px;
    property <length> tap: 48px;      // the tap target
    property <length> glyph: 24px;    // the drawn glyph inside it
    property <length> edge: 4px;      // (28 − 48/2): what centres the glyph at 28
    top-bar := Rectangle {
        // pinned to the top: an element with no geometry centres itself in Slint
        x: 0px; y: 0px; width: 100%;
        height: root.bar-h;
        close-btn := ActionButton {
            x: root.edge; y: (root.bar-h - root.tap) / 2;
            width: root.tap; height: root.tap;
            icon: Icons.close;
            icon-size: root.glyph;
            foreground: root.fg;
            clicked => { root.close(); }
        }
        // Measured: the name's ink starts 56 from the left — the tap target's
        // right edge (52) plus 4.
        title-col := VerticalLayout {
            x: 56px;
            // The reference's two baselines stand 21 apart and its ink is
            // symmetric in the 64 row (measured 15.7 above, 15.4 below); two
            // stacked Slint line boxes sit 17 apart and ride high by their
            // unused descender, so the row is opened by 4 and dropped by 2.
            y: (root.bar-h - self.preferred-height) / 2 + 2px;
            width: max(0px, dl-btn.x - 56px - 8px);
            height: self.preferred-height;
            spacing: 4px;
            Text {
                text: root.it.is-own ? "You" : root.it.sender-name;
                color: root.fg;
                font-family: Theme.font-ui;
                // Measured stroke 0.11em: the medium face, not the bold one.
                font-size: Theme.subtitle; font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.it.ts-label;
                color: root.fg;
                font-family: Theme.font-ui;
                font-size: Theme.body-small;
                overflow: elide;
            }
        }
        // The right group is placed by hand, on the reference's 48 pitch off
        // the right edge, rather than laid out: the set changes with the page
        // — a picture of your own carries the bin, one of theirs does not —
        // and a layout would pop the bin in and out and jump the download
        // sideways. Held still, the bin cross-fades in its own slot (200ms)
        // and ⋮ never moves; the download, which is in both sets, slides the
        // one slot rather than jumping. The bin is declared before the
        // download so that while it is transparent — and the two slots
        // coincide — the download, later and so on top, takes the taps.
        del-btn := ActionButton {
            x: root.width - root.edge - 2 * root.tap;
            y: (root.bar-h - root.tap) / 2;
            width: root.tap; height: root.tap;
            icon: Icons.trash;
            icon-size: root.glyph;
            foreground: root.fg;
            opacity: root.it.can-redact ? 1 : 0;
            animate opacity { duration: 200ms; }
            // Transparent is not gone: refuse the tap rather than the paint.
            clicked => { if (root.it.can-redact) { root.delete-requested(); } }
        }
        dl-btn := ActionButton {
            x: root.width - root.edge - (root.it.can-redact ? 3 : 2) * root.tap;
            y: (root.bar-h - root.tap) / 2;
            width: root.tap; height: root.tap;
            animate x { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            icon: Icons.download;
            icon-size: root.glyph;
            foreground: root.fg;
            clicked => { root.download-requested(); }
        }
        more-btn := ActionButton {
            x: root.width - root.edge - root.tap;
            y: (root.bar-h - root.tap) / 2;
            width: root.tap; height: root.tap;
            icon: Icons.moreVertical;
            icon-size: root.glyph;
            foreground: root.fg;
            clicked => { root.more-open = !root.more-open; }
        }
    }

    // ---- video scrubber (ImageViewer.qml:620-672) ----
    // It rides the band the reference leaves between the picture's foot (132
    // above the viewer's own) and the reaction row's top (100): 32 clear.
    if root.playing-event != "" : scrub-row := Rectangle {
        x: 16px;
        y: root.height - 132px;
        width: root.width - 32px;
        height: 34px;
        pos-label := Text {
            text: floor(root.play-pos / 60) + ":" + (mod(floor(root.play-pos), 60) < 10 ? "0" : "") + mod(floor(root.play-pos), 60);
            color: root.fg.with-alpha(0.85);
            font-family: Theme.font-ui; font-size: Theme.caption;
            vertical-alignment: center; height: 100%;
        }
        dur-label := Text {
            x: scrub-row.width - self.preferred-width;
            text: root.play-duration > 0
                ? floor(root.play-duration / 60) + ":" + (mod(floor(root.play-duration), 60) < 10 ? "0" : "") + mod(floor(root.play-duration), 60)
                : "--:--";
            color: root.fg.with-alpha(0.85);
            font-family: Theme.font-ui; font-size: Theme.caption;
            vertical-alignment: center; height: 100%;
        }
        // :639-644 — the 18px track between the labels, 10 from each.
        v-track := Rectangle {
            property <float> frac: root.play-duration > 0 ? max(0.0, min(1.0, root.play-pos / root.play-duration)) : 0;
            x: pos-label.preferred-width + 10px;
            y: (34px - 18px) / 2;
            width: dur-label.x - self.x - 10px;
            height: 18px;
            Rectangle {
                y: (18px - 4px) / 2;
                width: 100%; height: 4px; border-radius: 2px;
                background: root.fg.with-alpha(0.25);
                Rectangle { width: v-track.width * v-track.frac; height: 100%; border-radius: 2px; background: root.accent; }
            }
            Rectangle {
                x: v-track.frac * (v-track.width - 13px);
                y: (18px - 13px) / 2;
                width: 13px; height: 13px; border-radius: 6.5px;
                background: root.accent;
            }
            // :659-661 — the hit target is the track grown 10 above and below (38 tall).
            v-scrub := TouchArea {
                y: -10px; height: 38px;
                enabled: root.play-duration > 0;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.scrub-state(true, (max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.seek-requested((max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                        root.scrub-state(false, 0);
                    }
                    if (e.kind == PointerEventKind.cancel) {
                        root.scrub-state(false, 0);
                    }
                }
                moved => {
                    root.scrub-state(true, (max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                }
            }
        }
    }

    // ---- reactions ----
    // Measured off the reference: six emoji and an add-reaction glyph on a 48
    // pitch, each glyph ~24 of ink, their centres 72 above the viewer's foot —
    // and, contrary to the port, no disc under them at rest. The ground shows
    // straight through; only a press or a hover lights a disc. The reference's
    // two leftmost buttons (the image-edit sparkle and the comment bubble) are
    // not ours to have, so the seven that remain are centred on the frame
    // rather than left where the omission would have parked them.
    property <length> re-tap: 48px;
    property <length> re-glyph: 24px;
    /// The add-reaction glyph raises the full emoji picker — the same one the
    /// message sheet's drawer and the attach sheet show — in a drawer over
    /// the picture; a pick reacts and puts the drawer away, the viewer stays.
    in property <[[EmojiItem]]> emoji-rows;
    in property <[int]> emoji-cat-rows;
    /// The gesture bar's height: the drawer's category bar stands off it.
    in property <length> bottom-inset: 0px;
    callback emoji-search(string);
    callback load-emoji;
    /// Read by the window so Android's Back puts the drawer away before the viewer.
    in-out property <bool> picker-open: false;
    /// The quick reactions with their pictures, the same model the message
    /// sheet's pill draws. The phone's text path renders some of these as
    /// tofu — ❤️ is a VS16 pair and was the one the user saw missing — so a
    /// glyph is only ever the stand-in until the picture arrives.
    in property <[EmojiItem]> quick-emoji;
    property <[EmojiItem]> quick: root.quick-emoji.length == 6 ? root.quick-emoji : [
        { glyph: "👍" }, { glyph: "❤️" }, { glyph: "😂" }, { glyph: "😮" }, { glyph: "😢" }, { glyph: "😡" }];
    react-row := HorizontalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - 72px - root.re-tap / 2;
        width: self.preferred-width;
        height: root.re-tap;
        spacing: 0px;
        for e in root.quick : re := Rectangle {
            width: root.re-tap; height: root.re-tap;
            border-radius: root.re-tap / 2;
            background: re-t.pressed || re-t.has-hover ? root.accent.with-alpha(0.25) : transparent;
            // The picture, at the reference's 24 of ink, squarely centred.
            if e.has-img : Image {
                x: (root.re-tap - root.re-glyph) / 2;
                y: (root.re-tap - root.re-glyph) / 2;
                width: root.re-glyph; height: root.re-glyph;
                source: e.img;
                image-fit: contain;
            }
            // No picture yet: the glyph stands in. Emoji are ink-centred, not
            // line-box centred — their variation selectors widen the advance
            // past the visible glyph, so plain centring lands a fraction of
            // the em left of centre (docs/ui-conventions.md "Icons and
            // centring", measured in this row at 5.5 on a 20px glyph — 0.275
            // em). Slint cannot measure text, so the nudge rides the size.
            // ❤️ is drawn bare, without its VS16: the pair is tofu here.
            if !e.has-img : Text {
                x: (root.re-tap - self.preferred-width) / 2 + self.font-size * 0.275;
                y: (root.re-tap - self.preferred-height) / 2;
                width: self.preferred-width; height: self.preferred-height;
                text: e.glyph == "❤️" ? "❤" : e.glyph;
                font-size: root.re-glyph;
            }
            re-t := TouchArea { clicked => { root.react(e.glyph); } }
        }
        ActionButton {
            width: root.re-tap; height: root.re-tap;
            icon: Icons.react;
            icon-size: root.re-glyph;
            foreground: root.fg;
            clicked => { root.load-emoji(); root.picker-open = true; }
        }
    }

    // The emoji drawer: the picker in a bottom sheet over the picture, the
    // message sheet's drawer at its proportions (a 28 crown, an 8 + 24 handle
    // strip, the picker below). Tapping the picture above it puts it away.
    if root.picker-open : picker-scrim := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.picker-open = false; }
    }
    picker-drawer := Rectangle {
        property <length> open-h: root.height * 0.62;
        x: 0; width: 100%;
        height: self.open-h;
        y: root.picker-open ? root.height - self.open-h : root.height;
        animate y { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.y < root.height;
        background: Theme.popup-background.with-alpha(0.98);
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        clip: true;
        // Swallow presses on the drawer's own ground so they never reach the
        // picture's pager underneath.
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: 8px;
            width: 32px; height: 4px; border-radius: 2px;
            background: root.fg.with-alpha(0.4);
        }
        EmojiPicker {
            x: 0; y: 32px; width: 100%;
            height: max(0px, parent.height - 32px);
            bottom-inset: root.bottom-inset;
            fg: root.fg;
            accent: root.accent;
            back-slot: false;
            active: root.picker-open;
            rows: root.emoji-rows;
            cat-rows: root.emoji-cat-rows;
            picked(e) => { root.react(e); root.picker-open = false; }
            search-edited(q) => { root.emoji-search(q); }
        }
    }

    // ImageViewer.qml:101-102, 695-700 — note() holds a toast for 2500ms; its
    // bottom clears the reaction row's top (96) by 12. `toast` is bound by the
    // page hides it rather than clearing it (an assignment would drop the
    // binding); the bridge blanks it first to repeat the same text.
    property <bool> toast-live: root.toast != "";
    changed toast => {
        root.toast-live = root.toast != "";
        if (root.toast-live) { toast-clock.restart(); }
    }
    toast-clock := Timer {
        interval: 2500ms;
        running: false;
        triggered => { root.toast-live = false; self.stop(); }
    }
    if root.toast != "" && root.toast-live : Text {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - 108px - self.preferred-height;
        width: self.preferred-width; height: self.preferred-height;
        text: root.toast;
        color: root.fg.with-alpha(0.7);
        font-family: Theme.font-ui;
        font-size: Theme.caption;
    }

    // ---- ⋮ menu: Forward / Share (ImageViewer.qml:519-564) ----
    in-out property <bool> more-open: false;
    in-out property <bool> fwd-open: false;
    // The card's ground and row pitch. ImageViewer.qml:537-539 lightens the
    // menu ground 1.4 and outlines it 1px in fg@0.12 — a formula that works
    // on the desktop's grey but collapses on the phone's near-black, where
    // #101014 lifted 40 % is still black and only the hairline showed. Every
    // other menu in the port is the popup ground with no border at all
    // (furniture.slint OverflowMenu), so this one is too. Its rows take the
    // same 34 for the same reason: 30 was sized for a 12px body.
    property <color> menu-surface: Theme.popup-background.with-alpha(0.98);
    property <length> menu-row: Theme.body > 13px ? 34px : 30px;
    // :526, :573 — the click-away sink, live only while a card is open.
    menu-scrim := TouchArea {
        width: 100%; height: 100%;
        visible: root.more-open || root.fwd-open;
        clicked => { root.more-open = false; root.fwd-open = false; }
    }
    // Both cards stay instantiated: they fade (110ms) and grow from the top
    // right, 0.85→1 over 140ms OutCubic (:540-544, :586-590).
    more-card := Rectangle {
        x: root.width - self.width - 10px;
        y: 59px;                                    // (bar 64 + tap 48) / 2 + 3
        width: 160px;
        height: 2 * root.menu-row + 12px;           // :530 — two rows + 6 around
        border-radius: 12px;
        background: root.menu-surface;
        transform-origin: { x: self.width, y: 0 };
        opacity: root.more-open ? 1 : 0;
        transform-scale-x: root.more-open ? 1 : 0.85;
        transform-scale-y: root.more-open ? 1 : 0.85;
        animate opacity { duration: 110ms; }
        animate transform-scale-x, transform-scale-y { duration: 140ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.opacity > 0.01;
        TouchArea { }                               // :545 — the card swallows its taps
        // :546-557 — rows at 6 in, icon at 10, label at 36 absolute. The icon
        // box is the glyph's em plus a margin, not the QML's flat 14: a Slint
        // Text clips to its own width (there is no visible overflow), so a
        // 20px phone glyph in a 14px box lost a strip off both sides — the
        // "cut off" icons. Widened around the same centre, so the label
        // still starts where the QML's does.
        fwd-row := Rectangle {
            x: 6px; y: 6px; width: 148px;
            height: root.menu-row; border-radius: 8px;
            background: fr-t.pressed || fr-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
            IconLabel { x: 7px; width: Theme.icon-size + 6px; height: 100%; text: Icons.forward; font-size: Theme.icon-size; color: root.fg; opacity: 0.85; }
            Text { x: 36px; width: parent.width - 36px; height: 100%; text: "Forward"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
            fr-t := TouchArea { clicked => { root.more-open = false; root.fwd-open = true; } }
        }
        share-row := Rectangle {
            x: 6px; y: 6px + root.menu-row; width: 148px;
            height: root.menu-row; border-radius: 8px;
            background: sr-t.pressed || sr-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
            IconLabel { x: 7px; width: Theme.icon-size + 6px; height: 100%; text: Icons.share; font-size: Theme.icon-size; color: root.fg; opacity: 0.85; }
            Text { x: 36px; width: parent.width - 36px; height: 100%; text: "Share"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
            sr-t := TouchArea { clicked => { root.more-open = false; root.share-requested(); } }
        }
    }
    // Forward: pick a room (ImageViewer.qml:566-616).
    fwd-card := Rectangle {
        x: root.width - self.width - 10px;
        y: 59px;
        width: 240px;
        height: min(330px, fwd-col.preferred-height + 12px);
        border-radius: 12px;
        background: root.menu-surface;
        clip: true;
        transform-origin: { x: self.width, y: 0 };
        opacity: root.fwd-open ? 1 : 0;
        transform-scale-x: root.fwd-open ? 1 : 0.85;
        transform-scale-y: root.fwd-open ? 1 : 0.85;
        animate opacity { duration: 110ms; }
        animate transform-scale-x, transform-scale-y { duration: 140ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.opacity > 0.01;
        TouchArea { }                               // :591
        fwd-col := VerticalLayout {
            x: 6px; y: 6px;
            width: fwd-card.width - 12px;
            height: self.preferred-height;
            Text { text: "Forward to"; color: root.fg.with-alpha(0.6); font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; }
            Rectangle { height: 4px; }
            for name[i] in root.forward-names : fwd-item := Rectangle {
                height: root.menu-row; border-radius: 8px;
                background: fi-t.pressed || fi-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
                // :603 — label at 10, width parent − 20.
                Text {
                    x: 10px; width: parent.width - 20px;
                    text: name;
                    color: root.fg;
                    font-family: Theme.font-ui; font-size: Theme.body;
                    vertical-alignment: center; height: 100%;
                    overflow: elide;
                }
                fi-t := TouchArea { clicked => { root.fwd-open = false; root.forward-to(i); } }
            }
        }
    }
}
