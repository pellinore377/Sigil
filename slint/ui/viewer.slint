// ImageViewer — components/ImageViewer.qml. Top bar, a swipeable pager over
// every image in the room, zoom, video playback, quick reactions.
//
// Gesture notes for the integrator (also in WIRING-media.md):
// - Slint's TouchArea is single-pointer: PINCH CANNOT BE EXPRESSED. Zoom
//   rides double-tap, ctrl+wheel/wheel-when-zoomed, and two on-screen buttons
//   (the touch fallback the portability rules require when a gesture is
//   missing). Same zoomAbout() numbers as QML, so behaviour matches per input.
// - Pan-while-zoomed uses moved-deltas — inherently passive, per portability.
// - The QML blurred-backdrop scrim needs a backdrop shader Slint lacks; a
//   solid near-black stands in.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton } from "components.slint";
import { Spinner } from "furniture.slint";

export struct ViewerItem {
    event-id: string,
    kind: string,        // image | video
    sender-name: string,
    is-own: bool,
    ts-label: string,    // formatted Rust-side (fmtTs)
    img: image,          // full image, poster frame for videos
    have-img: bool,
    w: int,
    h: int,
    can-redact: bool,
}

export component ImageViewer inherits Rectangle {
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <[ViewerItem]> items;
    in-out property <int> cur: -1;
    in property <[string]> forward-names;   // first rooms, for the forward card
    in property <string> toast;
    // Video playback (engine decodes; Rust hands frames + clock)
    in property <string> playing-event: "";
    in property <image> video-frame;
    in property <float> play-pos: 0;
    in property <float> play-duration: 0;
    in property <bool> scrubbing: false;

    callback closed;
    callback page-changed(int);      // fetch full image for index
    callback download-requested;
    callback delete-requested;
    callback share-requested;
    callback forward-to(int);
    callback react(string);
    callback toggle-playback;
    callback seek-requested(float);
    callback scrub-state(bool, float);

    visible: root.cur >= 0 && root.items.length > 0;
    background: #0d0d0f;

    property <ViewerItem> it: root.items[max(0, root.cur)];
    property <bool> is-video: root.it.kind == "video";
    property <bool> playing: root.playing-event != "" && root.playing-event == root.it.event-id;

    // ---- zoom (current page only; resets on page change) ----
    property <float> zoom: 1;
    property <length> ox: 0;
    property <length> oy: 0;
    property <bool> zoomed: root.zoom > 1.01;
    in-out property <length> drag-dx: 0;
    property <length> page-w: root.width - 56px;
    property <length> page-h: root.height - 58px - 104px;
    property <length> fit-w: root.it.w > 0 && root.it.h > 0
        ? min(root.page-w, root.page-h * root.it.w / root.it.h) : root.page-w;
    property <length> fit-h: root.it.w > 0 && root.it.h > 0
        ? min(root.page-h, root.page-w * root.it.h / root.it.w) : root.page-h;

    function clamp-offsets() {
        root.ox = max(-max(0px, (root.fit-w * root.zoom - root.page-w) / 2),
                  min(max(0px, (root.fit-w * root.zoom - root.page-w) / 2), root.ox));
        root.oy = max(-max(0px, (root.fit-h * root.zoom - root.page-h) / 2),
                  min(max(0px, (root.fit-h * root.zoom - root.page-h) / 2), root.oy));
    }
    // Zoom about a point (fx/fy relative to the page centre): holding f fixed
    // across a zoom gives o1 = f - (f - o0) * z1/z0 — the QML maths verbatim.
    public function zoom-about(z: float, fx: length, fy: length) {
        if (abs(min(6.0, max(1.0, z)) - root.zoom) < 0.0001) { return; }
        root.ox = fx - (fx - root.ox) * (min(6.0, max(1.0, z)) / root.zoom);
        root.oy = fy - (fy - root.oy) * (min(6.0, max(1.0, z)) / root.zoom);
        root.zoom = min(6.0, max(1.0, z));
        root.clamp-offsets();
    }
    public function reset-zoom() { root.zoom = 1; root.ox = 0; root.oy = 0; }
    function go(idx: int) {
        if (idx < 0 || idx >= root.items.length || idx == root.cur) { return; }
        root.reset-zoom();
        root.cur = idx;
        root.page-changed(idx);
    }

    // ---- stage ----
    stage := Rectangle {
        y: 58px;
        width: 100%;
        height: root.page-h;
        clip: true;

        // Tap outside the picture closes the viewer (ImageViewer.qml:286).
        // Behind `media`, so its own handlers win over the letterbox.
        TouchArea { clicked => { root.closed(); } }

        media := Rectangle {
            x: (stage.width - root.fit-w * root.zoom) / 2 + root.ox + root.drag-dx;
            y: (stage.height - root.fit-h * root.zoom) / 2 + root.oy;
            width: root.fit-w * root.zoom;
            height: root.fit-h * root.zoom;
            border-radius: 16px;
            clip: true;
            if root.it.have-img && !root.playing : Image {
                source: root.it.img;
                width: 100%; height: 100%;
                image-fit: fill;
            }
            if root.playing : Image {
                source: root.video-frame;
                width: 100%; height: 100%;
                image-fit: contain;
            }
            if root.is-video && !root.playing : play-disc := Rectangle {
                x: (media.width - 60px) / 2; y: (media.height - 60px) / 2;
                width: 60px; height: 60px; border-radius: 30px;
                background: #000000.with-alpha(0.55);
                IconLabel { text: Icons.play; filled: false; color: #ffffff; font-size: 26px; width: 100%; height: 100%; }
            }
        }
        if !root.it.have-img && !root.is-video : Spinner {
            x: (stage.width - self.width) / 2; y: (stage.height - self.height) / 2;
        }

        // Swipe / pan / tap / double-tap / wheel — one surface, mode by state.
        property <length> last-x: 0;
        property <length> last-y: 0;
        gesture := TouchArea {
            clicked => {
                if (root.is-video) { root.toggle-playback(); }
            }
            double-clicked => {
                if (root.is-video) { return; }
                if (root.zoomed) { root.reset-zoom(); }
                else {
                    root.zoom-about(2.5, self.mouse-x - stage.width / 2, self.mouse-y - stage.height / 2);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    stage.last-x = self.mouse-x;
                    stage.last-y = self.mouse-y;
                    root.drag-dx = 0;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (!root.zoomed && abs(root.drag-dx / 1px) > stage.width / 4px) {
                        if (root.drag-dx < 0) { root.go(root.cur + 1); }
                        else { root.go(root.cur - 1); }
                    }
                    root.drag-dx = 0;
                }
            }
            moved => {
                if (root.zoomed) {
                    root.ox += self.mouse-x - stage.last-x;
                    root.oy += self.mouse-y - stage.last-y;
                    root.clamp-offsets();
                } else {
                    root.drag-dx = self.mouse-x - self.pressed-x;
                }
                stage.last-x = self.mouse-x;
                stage.last-y = self.mouse-y;
            }
            scroll-event(e) => {
                if (e.modifiers.control || root.zoomed) {
                    root.zoom-about(root.zoom * (e.delta-y > 0 ? 1.25 : 0.8),
                                    self.mouse-x - stage.width / 2,
                                    self.mouse-y - stage.height / 2);
                    return accept;
                }
                if (e.delta-y < 0) { root.go(root.cur + 1); }
                else if (e.delta-y > 0) { root.go(root.cur - 1); }
                return accept;
            }
        }

        // Zoom buttons: the touch fallback for the missing pinch gesture.
        zoom-btns := VerticalLayout {
            x: stage.width - 46px;
            y: stage.height - 96px;
            spacing: 8px;
            zin := Rectangle {
                width: 38px; height: 38px; border-radius: 19px;
                background: #000000.with-alpha(zin-t.pressed ? 0.65 : 0.42);
                Text { text: "+"; color: #ffffff; font-family: Theme.font-ui; font-size: Theme.title; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                zin-t := TouchArea { clicked => { root.zoom-about(root.zoom * 1.5, 0, 0); } }
            }
            zout := Rectangle {
                width: 38px; height: 38px; border-radius: 19px;
                background: #000000.with-alpha(zout-t.pressed ? 0.65 : 0.42);
                opacity: root.zoomed ? 1.0 : 0.4;
                Text { text: "−"; color: #ffffff; font-family: Theme.font-ui; font-size: Theme.title; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                zout-t := TouchArea { clicked => { root.zoom-about(root.zoom / 1.5, 0, 0); } }
            }
        }
    }

    // ---- top bar ----
    top-bar := Rectangle {
        height: 56px;
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px;
            spacing: 8px;
            Rectangle {
                width: 44px;
                ActionButton {
                    y: (56px - self.height) / 2;
                    width: 44px; height: 44px;
                    icon: Icons.close; filled: false;
                    foreground: root.fg;
                    clicked => { root.closed(); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.it.is-own ? "You" : root.it.sender-name; color: root.fg; font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700; overflow: elide; }
                Text { text: root.it.ts-label; color: root.fg.with-alpha(0.55); font-family: Theme.font-ui; font-size: Theme.caption; }
            }
            // 22px PanelActionButtons at spacing 2 (ImageViewer.qml:508).
            Rectangle {
                width: 24px;
                ActionButton {
                    y: (56px - self.height) / 2;
                    width: 22px; height: 22px;
                    icon: Icons.download; filled: false;
                    foreground: root.fg;
                    clicked => { root.download-requested(); }
                }
            }
            if root.it.can-redact : Rectangle {
                width: 24px;
                ActionButton {
                    y: (56px - self.height) / 2;
                    width: 22px; height: 22px;
                    icon: Icons.trash; filled: false;
                    foreground: root.fg;
                    clicked => { root.delete-requested(); }
                }
            }
            Rectangle {
                width: 24px;
                ActionButton {
                    y: (56px - self.height) / 2;
                    width: 22px; height: 22px;
                    icon: Icons.moreVertical; filled: false;
                    foreground: root.fg;
                    clicked => { root.more-open = !root.more-open; }
                }
            }
        }
    }

    // ---- video scrubber ----
    if root.playing-event != "" : scrub-row := Rectangle {
        x: 16px;
        y: root.height - 62px - 34px;
        width: root.width - 32px;
        height: 34px;
        pos-label := Text {
            text: floor(root.play-pos / 60) + ":" + (mod(floor(root.play-pos), 60) < 10 ? "0" : "") + mod(floor(root.play-pos), 60);
            color: root.fg.with-alpha(0.85);
            font-family: Theme.font-ui; font-size: Theme.caption;
            vertical-alignment: center; height: 100%;
        }
        dur-label := Text {
            x: scrub-row.width - self.preferred-width;
            text: root.play-duration > 0
                ? floor(root.play-duration / 60) + ":" + (mod(floor(root.play-duration), 60) < 10 ? "0" : "") + mod(floor(root.play-duration), 60)
                : "--:--";
            color: root.fg.with-alpha(0.85);
            font-family: Theme.font-ui; font-size: Theme.caption;
            vertical-alignment: center; height: 100%;
        }
        v-track := Rectangle {
            property <float> frac: root.play-duration > 0 ? max(0.0, min(1.0, root.play-pos / root.play-duration)) : 0;
            x: pos-label.preferred-width + 10px;
            width: dur-label.x - self.x - 10px;
            height: 100%;
            Rectangle {
                y: (34px - 4px) / 2;
                width: 100%; height: 4px; border-radius: 2px;
                background: root.fg.with-alpha(0.25);
                Rectangle { width: v-track.width * v-track.frac; height: 100%; border-radius: 2px; background: root.accent; }
            }
            Rectangle {
                x: v-track.frac * (v-track.width - 13px);
                y: (34px - 13px) / 2;
                width: 13px; height: 13px; border-radius: 6.5px;
                background: root.accent;
            }
            v-scrub := TouchArea {
                enabled: root.play-duration > 0;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.scrub-state(true, (max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.seek-requested((max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                        root.scrub-state(false, 0);
                    }
                }
                moved => {
                    root.scrub-state(true, (max(0px, min(v-track.width, self.mouse-x)) / v-track.width) * root.play-duration);
                }
            }
        }
    }

    // ---- reactions ----
    react-row := HorizontalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - 54px;
        spacing: 10px;
        for emo in ["👍", "❤️", "😂", "😮", "😢", "😡"] : re := Rectangle {
            width: 42px; height: 42px; border-radius: 21px;
            background: re-t.pressed || re-t.has-hover ? root.accent.with-alpha(0.25) : root.fg.with-alpha(0.08);
            Text { text: emo; font-size: 20px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
            re-t := TouchArea { clicked => { root.react(emo); } }
        }
    }

    if root.toast != "" : Text {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - 58px - 24px;
        text: root.toast;
        color: root.fg.with-alpha(0.7);
        font-family: Theme.font-ui;
        font-size: Theme.caption;
    }

    // ---- ⋮ menu: Forward / Share ----
    in-out property <bool> more-open: false;
    in-out property <bool> fwd-open: false;
    if root.more-open || root.fwd-open : menu-scrim := Rectangle {
        width: 100%; height: 100%;
        TouchArea { clicked => { root.more-open = false; root.fwd-open = false; } }
        if root.more-open : more-card := Rectangle {
            x: root.width - self.width - 10px;
            y: 42px;
            width: 160px;
            height: 72px;
            border-radius: 12px;
            background: Theme.menu-background.brighter(0.4).with-alpha(0.99);
            border-width: 1px; border-color: root.fg.with-alpha(0.12);
            VerticalLayout {
                padding: 6px;
                fwd-row := Rectangle {
                    height: 30px; border-radius: 8px;
                    background: fr-t.pressed || fr-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
                    HorizontalLayout {
                        padding-left: 10px; spacing: 8px;
                        IconLabel { text: Icons.retry; filled: false; color: root.fg; opacity: 0.85; vertical-alignment: center; }
                        Text { text: "Forward"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
                    }
                    fr-t := TouchArea { clicked => { root.more-open = false; root.fwd-open = true; } }
                }
                share-row := Rectangle {
                    height: 30px; border-radius: 8px;
                    background: sr-t.pressed || sr-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
                    HorizontalLayout {
                        padding-left: 10px; spacing: 8px;
                        IconLabel { text: Icons.share; filled: false; color: root.fg; opacity: 0.85; vertical-alignment: center; }
                        Text { text: "Share"; color: root.fg; font-family: Theme.font-ui; font-size: Theme.body; vertical-alignment: center; }
                    }
                    sr-t := TouchArea { clicked => { root.more-open = false; root.share-requested(); } }
                }
            }
        }
        if root.fwd-open : fwd-card := Rectangle {
            x: root.width - self.width - 10px;
            y: 42px;
            width: 240px;
            height: min(330px, fwd-col.preferred-height + 12px);
            border-radius: 12px;
            background: Theme.menu-background.brighter(0.4).with-alpha(0.99);
            border-width: 1px; border-color: root.fg.with-alpha(0.12);
            clip: true;
            fwd-col := VerticalLayout {
                padding: 6px;
                Text { text: "Forward to"; color: root.fg.with-alpha(0.6); font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; }
                Rectangle { height: 4px; }
                for name[i] in root.forward-names : fwd-item := Rectangle {
                    height: 30px; border-radius: 8px;
                    background: fi-t.pressed || fi-t.has-hover ? root.fg.with-alpha(0.1) : transparent;
                    Text {
                        x: 10px; width: 220px;
                        text: name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        vertical-alignment: center; height: 100%;
                        overflow: elide;
                    }
                    fi-t := TouchArea { clicked => { root.fwd-open = false; root.forward-to(i); } }
                }
            }
        }
    }
}
