// Conversation page — ChatPage.qml: back header with call buttons, bubble
// timeline, pill composer with the reply/edit quote inside the input surface,
// typing indicator, pagination spinner, jump-to-latest button, header menu,
// invite banner, the long-press message sheet as an overlay, and the two
// inline composer panels (attachment sheet, voice recorder) that take their
// room from the timeline, not from the composer.
//
// Divergences (all in WIRING-chat.md): chat themes/wallpaper wait for the
// theme store; Enter always newlines on a multi-line TextInput, so sending is
// the send button (the phone convention anyway); no frosted-glass sheet scrim.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton, Avatar, SButton } from "components.slint";
import { Spinner, TouchList } from "furniture.slint";
import { OverflowMenu, MenuEntry } from "furniture.slint";
import { TimelineRow, ReactionChip, ReplyRef, EmojiItem, UserRow, SheetRect } from "model.slint";
import { Bubble } from "bubble.slint";
import { MessageSheet } from "sheet.slint";
import { AttachMenu, StickerItem } from "attach.slint";
import { VoiceRecorder } from "voicerec.slint";
import { EmojiPicker } from "emoji.slint";

export component ChatPage inherits Rectangle {
    in property <string> room-name;
    in property <string> room-subtitle;
    in property <bool> room-encrypted;
    in property <string> room-initials;
    in property <image> room-avatar;
    in property <color> room-tint: Theme.accent;
    in property <[TimelineRow]> items;
    in property <string> typing-line;
    in property <image> typing-avatar;
    in property <string> typing-initials;
    in property <color> typing-tint: Theme.accent;
    in property <bool> is-dm;
    in property <bool> is-invite;
    in property <bool> is-thread;
    in property <string> pagination-state: "idle";  // idle | paginating | timelineStart
    in property <bool> in-call;          // any call, disables the start buttons
    in property <bool> call-here;        // live call in THIS room: Join chip
    in property <[MenuEntry]> sheet-actions;
    in property <[[EmojiItem]]> emoji-rows;
    in property <[EmojiItem]> quick-emoji;
    in property <[int]> emoji-cat-rows;
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <int> boot-epoch-s;
    /// The attach sheet is open under the composer: the + becomes a cancel affordance.
    in-out property <bool> attach-open: false;
    /// The voice recorder is open under the composer.
    in-out property <bool> recorder-open: false;
    /// This page is the one on screen (ChatPage.qml visibleToUser): leaving
    /// closes the attach sheet and gates read-marking.
    in property <bool> visible-to-user: true;
    /// Extra bottom padding while the virtual keyboard is up, from the window.
    in property <length> bottom-inset: 0px;

    // The recorder's feed (VoiceRecorder.qml's own state, ticked by Rust).
    in property <string> rec-state: "idle";      // idle | recording | ready
    in property <float> rec-elapsed;
    in property <float> rec-clip-duration;
    in property <[float]> rec-levels;
    in property <[float]> rec-clip-waveform;
    // The attach sheet's feed.
    in property <[StickerItem]> stickers;
    in property <bool> stickers-loaded;
    in property <string> sticker-dir;
    /// The sheet's page, exposed so the bridge can open a location mode.
    in-out property <string> at-page: "grid";
    // The location picker's feed (attach.slint LocationPages).
    in property <image> lp-map;
    in property <bool> lp-unavailable;
    in property <bool> lp-have-fix;
    in property <float> lp-lat;
    in property <float> lp-lon;
    in property <string> lp-error;
    in property <bool> lp-marked;
    in property <float> lp-mark-lat;
    in property <float> lp-mark-lon;
    in property <image> my-avatar;
    in property <string> my-initials;
    in property <color> my-tint: Theme.accent;
    /// The page is the one on the stack (app.slint's chat holder). The phone
    /// plays its open choreography on the rise and the reverse on the fall;
    /// the desktop card keeps its holder slide.
    in property <bool> opened: true;
    // open-t: header morph and the sheet's rise; footer-t: the composer's,
    // after them. 0 → 1 over 280 + 160ms; back: composer 100, then 220.
    property <float> open-t: 1.0;
    property <float> footer-t: 1.0;
    states [
        closed when root.phone && !root.opened : {
            open-t: 0.0;
            footer-t: 0.0;
            // Linear clocks: the fades take their windows off them, the
            // motion its OutCubic (an InCubic on the way back) from open-e.
            in {
                animate footer-t { duration: 100ms; }
                animate open-t { duration: 220ms; delay: 100ms; }
            }
            out {
                animate open-t { duration: 280ms; }
                animate footer-t { duration: 160ms; delay: 280ms; }
            }
        }
    ]
    property <float> open-e: 1 - (1 - root.open-t) * (1 - root.open-t) * (1 - root.open-t);
    property <float> footer-e: 1 - (1 - root.footer-t) * (1 - root.footer-t) * (1 - root.footer-t);
    // Composer furniture the bridge fills: the @/# autocomplete rows (label =
    // display-name, sub = user-id) and the toast (ChatPage.qml note()); the
    // page clears the toast itself after 2600ms.
    in property <[UserRow]> ac-items;
    in-out property <int> ac-index: 0;
    in-out property <string> toast;

    // Composer staging (page-local, exactly like ChatPage.qml's).
    in-out property <string> reply-to;
    in-out property <string> reply-name;
    in-out property <string> reply-body;
    in-out property <string> edit-of;
    in-out property <string> caption-of;
    // A recorded-but-unsent voice clip staged in the composer (QML voicePath).
    in-out property <bool> voice-staged;
    in property <string> voice-staged-duration;
    in property <[float]> voice-staged-wave;
    in-out property <bool> clip-playing;
    /// Preview progress 0..1 (QML clipFrac): bars up to it draw solid.
    in property <float> clip-frac: 0;
    /// How many bars the clip chip's wave has room for (QML floor(width / 5)),
    /// so the bridge can resample the waveform to fit.
    out property <int> clip-wave-bars: max(8, floor(clip-wave.width / 5px));

    callback back;
    callback send(string);
    callback send-reply(string /*event-id*/, string /*text*/);
    callback send-edit(string /*event-id*/, string /*text*/);
    callback send-caption(string /*event-id*/, string /*text*/);
    callback send-voice(string /*caption*/);
    callback voice-discard;
    callback voice-preview(bool /*play*/);
    /// Tap on the staged clip's wave: play from this fraction of the clip.
    callback clip-seek(float);
    callback composer-edited(string);
    callback start-call(bool /*video*/);
    callback join-call;
    callback nav-requested(string);   // search threads pins chattheme roomsettings
    /// The attach sheet just opened (the toggle closed it otherwise).
    callback open-attach;
    /// The recorder just opened.
    callback open-recorder;
    callback accept-invite;
    callback decline-invite;
    callback paginate;
    callback menu-action(string /*action*/, string /*event-id*/);
    /// A press on a bubble is lasting: the bridge may take the frost's
    /// picture now, with the bubble's rect masked out, so the open has it ready.
    callback sheet-prewarm(string /*event-id*/, SheetRect);
    /// The hold fired: take the bubble's picture for the lifted copy (its
    /// reactions and pin stepped out — `copy-of`) and set the frost from the
    /// prewarmed picture, or from this one when none is ready.
    callback sheet-snapshot(string /*event-id*/, SheetRect);
    /// The row whose picture is being taken this instant (Bubble.copying).
    property <string> copy-of: "";
    in property <image> sheet-backdrop;
    in property <image> sheet-copy;
    /// The window's zones above and below this page (status bar and sync
    /// strip; gesture bar or keyboard) that the sheet's frost must cover too.
    in property <length> bleed-top: 0px;
    in property <length> bleed-bottom: 0px;
    callback react(string, string);
    callback reply-arm(string, string, string); // sheet "reply" → arm composer
    callback open-image(TimelineRow);
    callback play-video(TimelineRow);
    callback open-document(TimelineRow);
    callback open-contact(TimelineRow);
    // the contact card's pills and rows (ContactBody.qml), and a revealed
    // spoiler remembered for the session (RichText.qml:150-151)
    callback contact-save(string, string, bool);
    callback contact-share(string, string);
    callback copy-text(string);
    callback spoiler-revealed(string);
    callback open-audio(TimelineRow);
    callback open-location(TimelineRow);
    callback open-link(string);
    callback open-thread(string);
    callback voice-toggled(string);
    callback voice-seeked(string, float);
    callback vote(string, string);
    callback emoji-search(string);
    callback mark-read;
    // The attach sheet's actions, forwarded to the window's act() channel.
    callback pick-attach-files;
    callback attach-location(string);   // pin | current | live
    callback attach-loc-tap(length, length);  // map tap in the picker's box
    callback attach-loc-zoom(int);
    callback attach-loc-recentre;
    callback attach-loc-retry;
    callback attach-loc-share(float, float, float, string); // lat, lon, ms, mode
    callback insert-emoji(string);
    callback create-poll(string, [string], bool);
    callback send-sticker(int);
    callback load-stickers;
    callback load-emoji;
    // The recorder's.
    callback rec-record;
    callback rec-stop;
    callback rec-restart;
    callback rec-attach;
    callback rec-cancel;
    /// An autocomplete row was tapped.
    callback ac-picked(int);

    public function scroll-to-end() {
        list.stick = true;
        list.viewport-y = min(0px, list.height - list.viewport-height);
    }
    function pin-list() {
        list.viewport-y = min(0px, list.height - list.viewport-height);
    }
    /// Test hook: open the sheet for one row as a long-press would (the
    /// harness cannot reach into the list's bubbles).
    public function sheet-open(it: TimelineRow, x: length, y: length, w: length, h: length) {
        // The corners as Bubble draws them (bubble.slint r-tl … r-br).
        root.open-menu-for(it, {
            x: x, y: y, w: w, h: h,
            r-tl: it.link-only ? 14px : (!it.is-own && !it.group-start) ? 5px : 16px,
            r-bl: it.link-only ? 14px : (!it.is-own && !it.group-end) ? 5px : 16px,
            r-tr: it.link-only ? 14px : (it.is-own && !it.group-start) ? 5px : 16px,
            r-br: it.link-only ? 14px : (it.is-own && !it.group-end) ? 5px : 16px,
        });
    }
    /// The pressed bubble has to be whole before its picture is taken: the
    /// sheet crops the window, so a message half under the header or behind
    /// the composer would carry that chrome into the lifted copy. Nudge the
    /// timeline until it clears both, and say whether anything moved.
    function ensure-visible(r: SheetRect) -> bool {
        if (list.viewport-height <= list.height) { return false; }
        if (r.y < list.absolute-position.y + 6px) {
            list.viewport-y = min(0px,
                list.viewport-y + (list.absolute-position.y + 6px - r.y));
            return true;
        }
        if (r.y + r.h > list.absolute-position.y + list.height - 6px) {
            list.viewport-y = max(list.height - list.viewport-height,
                list.viewport-y - (r.y + r.h - (list.absolute-position.y + list.height - 6px)));
            return true;
        }
        return false;
    }
    /// A hold fired on `it`, drawn at `r` (window coordinates).
    function open-menu-for(it: TimelineRow, r: SheetRect) {
        sheet.item = it;
        // The bubble's picture first, while the original is still drawn and
        // with its reactions and pin stepped out of the frame …
        root.copy-of = it.event-id;
        root.sheet-snapshot(it.event-id, r);
        root.copy-of = "";
        root.menu-action("prepare", it.event-id);
        // … then the sheet, in window coordinates: it subtracts its own
        // absolute-position (safe area, status strip, holder — app.slint:443-492)
        // so the copy takes off exactly on the bubble.
        sheet.open-for(r);
    }
    public function sheet-close() { sheet.open = false; }
    out property <bool> sheet-shown: sheet.shown;
    /// Whatever is staged goes: a voice clip, a caption, an edit, a reply, or plain text.
    public function submit() {
        if (composer-input.text == "" && !root.voice-staged) { return; }
        if (root.voice-staged) { root.send-voice(composer-input.text); }
        else if (root.caption-of != "") { root.send-caption(root.caption-of, composer-input.text); }
        else if (root.edit-of != "") { root.send-edit(root.edit-of, composer-input.text); }
        else if (root.reply-to != "") { root.send-reply(root.reply-to, composer-input.text); }
        else { root.send(composer-input.text); }
        root.clear-composer();
    }
    public function clear-composer() {
        composer-input.text = "";
        root.reply-to = ""; root.reply-name = ""; root.reply-body = ""; root.edit-of = "";
        root.caption-of = "";
        root.voice-staged = false; root.clip-playing = false;
    }
    public function arm-reply(event-id: string, sender: string, body: string) {
        root.reply-to = event-id; root.reply-name = sender; root.reply-body = body;
        root.edit-of = "";
    }
    public function arm-edit(event-id: string, body: string) {
        root.edit-of = event-id; root.reply-to = ""; root.caption-of = "";
        root.reply-name = "Edit message"; root.reply-body = body;
        composer-input.text = body;
    }
    // Panel.messageAction("caption"): the quote shows the filename; the well
    // holds the current caption, ready to edit.
    public function arm-caption(event-id: string, filename: string, cap: string) {
        root.reply-to = ""; root.edit-of = "";
        root.caption-of = event-id;
        root.reply-name = filename != "" ? filename : "Attachment";
        root.reply-body = cap;
        composer-input.text = cap;
        composer-input.focus();
    }
    // ChatPage.qml onInsertEmoji: insert at the cursor, keep focus. Slint has
    // no string slicing, so the splice happens in Rust against these.
    out property <string> composer-text <=> composer-input.text;
    out property <int> composer-cursor <=> composer-input.cursor-position-byte-offset;
    // `take-focus` false restores a draft on room open — pulling focus there
    // would raise the phone's keyboard the moment a room opens.
    public function set-composer(t: string, cursor: int, take-focus: bool) {
        composer-input.text = t;
        composer-input.set-selection-offsets(cursor, cursor);
        if (take-focus) { composer-input.focus(); }
    }

    // ---- the two composer sheets (ChatPage.qml:806-807, :1683, :1785) ----
    // Only one is open at a time, whichever route opened it; the attach sheet
    // resets to its grid on open; the recorder resets through open-recorder
    // (the bridge owns its state). Leaving the page closes the attach sheet;
    // a room change closes both (:2002, :2009).
    public function toggle-attach() {
        root.attach-open = !root.attach-open;
        if (root.attach-open) { root.recorder-open = false; att.reset(); root.open-attach(); }
    }
    public function toggle-recorder() {
        root.recorder-open = !root.recorder-open;
        if (root.recorder-open) { root.attach-open = false; root.open-recorder(); }
    }
    changed attach-open => { if (self.attach-open) { self.recorder-open = false; } }
    changed recorder-open => { if (self.recorder-open) { self.attach-open = false; } }
    changed visible-to-user => {
        if (!self.visible-to-user) { self.attach-open = false; }
        else { root.maybe-mark-read(); }
    }
    changed room-name => { self.attach-open = false; self.recorder-open = false; }
    changed is-thread => { self.attach-open = false; self.recorder-open = false; }

    // Read-marking: 800ms after settling at the bottom, only while on screen
    // (ChatPage.qml:1985-1986 readTimer/maybeMarkRead).
    /// How many loaded rows carry running effects (the bridge counts them);
    /// the shared clock ticks only while there are any and the page shows.
    in property <int> fx-count: 0;
    property <duration> fx-clock: 0ms;
    // Accumulated, not read from animation-tick(): reading the tick marks
    // animations as running and the renderer then draws every vsync.
    fx-timer := Timer {
        interval: 50ms;
        running: root.fx-count > 0 && root.visible-to-user;
        triggered => { root.fx-clock += 50ms; }
    }
    read-timer := Timer {
        interval: 800ms;
        running: false;
        triggered => { self.running = false; root.mark-read(); }
    }
    function maybe-mark-read() {
        if (root.visible-to-user && root.from-end < 4px) {
            read-timer.running = true;
            read-timer.restart();
        }
    }

    // The toast clears itself 2600ms after it was set (ChatPage.qml:839).
    toast-timer := Timer {
        interval: 2600ms;
        running: false;
        triggered => { self.running = false; root.toast = ""; }
    }
    changed toast => { if (self.toast != "") { toast-timer.running = true; toast-timer.restart(); } }

    property <bool> menu-open: false;
    property <bool> quote-armed: root.reply-to != "" || root.edit-of != "" || root.caption-of != "";
    /// A chat theme accent is set for this room (the mixes below are gated on it).
    in property <bool> themed: false;
    // ChatPage.qml convoC: menu.background ÷1.35, then 18% accent ONLY when themed.
    property <bool> phone: Theme.mode != "desktop";
    /// What sits under the status bar and the gesture bar on the phone: the
    /// header's own ground above, the composer's below, so the insets read
    /// as part of the page rather than as bars.
    // On the phone the header's ground starts as the home bar's and settles
    // over the open choreography.
    property <color> top-rest: root.themed ? root.chrome-c : Theme.card-ground;
    out property <color> top-ground: root.phone ? root.top-rest.mix(Theme.background, root.open-e) : root.top-rest;
    // With a panel open the page bottom is the panel, so the gesture zone
    // follows it.
    out property <color> bottom-ground: root.phone
        ? (root.attach-open ? (root.themed ? root.surface-c : Theme.card-ground) : root.convo-c)
        : root.convo-c.with-alpha(0.94).mix(Theme.card-ground, 0.94);
    // ChatPage.qml:20-32 convoC: darker(menu, 1.35), tinted 18% by the
    // accent when themed. The phone's light palette is near white and
    // darkening it reads as grey, so there the sheet sits on the card
    // ground (the platform's lightly elevated surface) instead.
    property <color> convo-base: root.phone && Theme.mode == "light" ? Theme.card-ground : Theme.menu-background.darker(0.35);
    property <color> convo-c: root.themed
        ? root.convo-base.mix(root.accent, 0.82)
        : root.convo-base;
    // surfaceC: ONE literal surface for themed chrome (mix of lighter(menu, 1.35)
    // and the accent at 0.35); chromeC is the header band (ChatPage.qml:47-49).
    property <color> surface-c: root.themed
        ? Theme.menu-background.brighter(0.35).mix(root.accent, 0.65)
        : Theme.popup-background;
    property <color> chrome-c: root.themed ? root.surface-c : Theme.menu-background.brighter(0.35);
    // themedSend: the send disc, the recorder's accent (ChatPage.qml:45).
    property <color> send-c: root.themed ? root.accent.darker(0.15) : root.accent.with-alpha(0.9);
    // chipC / deepChipC (:51-59): the attach sheet's and recorder's control fill.
    property <color> chip-c: root.themed
        ? root.convo-c.with-alpha(0.92)
        : Theme.menu-background.darker(1.1).with-alpha(0.96);
    // deepChipC (ChatPage.qml:56-60) sinks chipC's luminance to 0.19 so a
    // pale chip still grounds the confirm's Cancel; Slint exposes no channel
    // math, so the light palette — the one whose chip is bright (lum ≈ 0.45)
    // — darkens by the measured ratio and the dark ones pass through.
    property <color> deep-chip-c: Theme.mode == "light" ? root.chip-c.darker(1.4) : root.chip-c;
    // A staged voice clip outranks the quote for the extra band (QML: 60 vs 52).
    // On the phone both bands are one height, and a card inside the pill is
    // inset by `chip-pad` with the concentric radius (pill 28 less the inset)
    // so its corners follow the pill's instead of poking through them.
    property <length> chip-pad: root.phone ? 8px : 6px;
    property <length> chip-r: root.phone ? 20px : 14px;
    property <length> quote-h: root.phone
        ? ((root.voice-staged || root.quote-armed) ? 64px : 0px)
        : (root.voice-staged ? 60px : root.quote-armed ? 52px : 0px);
    property <length> chip-h: root.quote-h - 2 * root.chip-pad;
    // inputPill.height (ChatPage.qml:1384): the text's own height between 38
    // and 110 (the QML TextArea's 3px paddings included), plus the quote band.
    // The phone's pill is the platform's (dp): 56 tall, r28, from 16 to a
    // 56 send disc 8 past it and 16 in, 12 above the bottom; the + is a 24
    // glyph in a 48 target 8 inside the pill.
    property <length> well-h: root.phone
        ? min(140px, max(54px, composer-input.preferred-height + 20px)) + root.quote-h
        : min(110px, max(38px, composer-input.preferred-height + 6px)) + root.quote-h;
    property <length> disc: root.phone ? 54px : 38px;
    property <length> attach-box: root.phone ? 48px : 30px;
    // composerBox = pill + 18 (:1222): 8 above, 10 below.
    property <length> composer-h: root.is-invite ? 0px : root.well-h + (root.phone ? 16px : 18px) + root.bottom-inset;
    /// Where the composer stack starts, measured from the page bottom: the
    /// composer plus whichever inline panel is open (:1869-1884).
    property <length> panel-top: root.height - root.composer-h - att-frame.height - rec-frame.height;
    out property <length> from-end: max(0px, (list.viewport-height - list.height) + list.viewport-y);
    /// The timeline's width, so Rust can wrap effect text to the bubble.
    out property <length> timeline-w: list.width;
    /// Put the view back at the same distance from the bottom — how scroll
    /// position survives the bridge rebuilding the model (prepends included).
    public function restore-from-end(d: length) {
        list.viewport-y = min(0px, (list.height - list.viewport-height) + d);
    }

    // Jump-to-latest eases toward the *current* end, re-evaluated every tick
    // (the list grows as rows inflate): ~88% of the gap closed every 0.25s
    // (ChatPage.qml:1853-1866), i.e. 13.7% per 16ms tick.
    property <bool> jumping: false;
    jump-tick := Timer {
        interval: 16ms;
        running: root.jumping;
        triggered => {
            if (!root.jumping) { return; }
            if (abs((min(0px, list.height - list.viewport-height) - list.viewport-y) / 1px) < 0.5) {
                root.jumping = false;
                root.scroll-to-end();
                return;
            }
            list.viewport-y += (min(0px, list.height - list.viewport-height) - list.viewport-y) * 0.137;
        }
    }
    public function jump-to-latest() { root.jumping = true; }

    // The phone's page ground is the header's, so the sheet's rounded top
    // corners reveal the header colour behind them (the platform look).
    background: root.phone ? root.top-ground : Theme.menu-background;

    // The page's three bands, placed by hand so the phone can move the sheet
    // and the composer separately: header, the invite banner, the convo.
    property <length> header-h: root.phone ? 60px : 52px;
    property <length> sheet-y: root.header-h + (root.is-invite ? 52px : 0px);
    Rectangle {
        width: 100%; height: 100%;
        // Header (ChatPage.qml:993-1049): 22px PanelActionButtons; back at 6,
        // avatar 4 after it, title 10 after that and 4 before the trailing
        // buttons, which sit at spacing 0 with an 8px right margin.
        header := Rectangle {
            x: 0; y: 0; width: 100%;
            height: root.header-h;
            // The themed chrome band with 22px top radii (:986-992). The
            // phone's band is the page ground itself (top-ground).
            if root.themed && !root.phone : Rectangle {
                width: 100%; height: 100%;
                border-top-left-radius: 22px; border-top-right-radius: 22px;
                background: root.chrome-c;
            }
            if !root.phone : HorizontalLayout {
                padding-left: 6px; padding-right: 8px;
                spacing: 0;
                Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        filled: true;   // ChatPage.qml:993 Fonts.iconFilled
                        foreground: root.fg;
                        clicked => { root.back(); }
                    }
                    // The tap surface spans the header height for fingers.
                    TouchArea { clicked => { root.back(); } }
                }
                Rectangle { width: 4px; }
                Rectangle {
                    width: 32px;
                    Avatar {
                        x: 0; y: (52px - 32px) / 2;
                        size: 32px;
                        source: root.room-avatar;
                        initials: root.room-initials;
                        tint: root.room-tint;
                        status-backdrop: root.chrome-c;
                    }
                }
                Rectangle { width: 10px; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.is-thread ? "Thread" : root.room-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700;
                        overflow: elide;
                    }
                    if root.room-subtitle != "" || root.typing-line != "" : Text {
                        text: root.typing-line != "" ? root.typing-line
                            : root.is-thread ? root.room-name : root.room-subtitle;
                        // The typing line takes the GLOBAL accent (:1013), not the room's.
                        color: root.typing-line != "" ? Theme.accent : root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: Theme.caption;
                        overflow: elide;
                    }
                }
                Rectangle { width: 4px; }
                // A live call in this room replaces the start-a-call buttons.
                if root.call-here && !root.is-thread : Rectangle {
                    // A cell: the layout owns its children's y, so the chip
                    // centres itself inside this instead.
                    width: join-row.preferred-width + 22px;
                    join-chip := Rectangle {
                        x: 0; y: (52px - 28px) / 2;
                        width: join-row.preferred-width + 22px;
                        height: 28px; border-radius: 14px;
                        background: root.accent.with-alpha(0.9);
                        join-row := HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            IconLabel { text: Icons.phone; filled: true; color: #141414; font-size: Theme.caption; vertical-alignment: center; }
                            Text { text: "Join"; color: #141414; font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.join-call(); } }
                    }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.phone;
                        filled: true;   // ChatPage.qml:1039 Fonts.iconFilled
                        foreground: root.fg;
                        opacity: root.in-call ? 0.4 : 1;
                    }
                    TouchArea { clicked => { if (!root.in-call) { root.start-call(false); } } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.videoOn;
                        filled: true;   // ChatPage.qml:1041 Fonts.iconFilled
                        foreground: root.fg;
                        opacity: root.in-call ? 0.4 : 1;
                    }
                    TouchArea { clicked => { if (!root.in-call) { root.start-call(true); } } }
                }
                if !root.is-thread : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.moreVertical;
                        filled: true;   // ChatPage.qml:1048 Fonts.iconFilled
                        foreground: root.fg;
                    }
                    TouchArea { clicked => { root.menu-open = true; } }
                }
            }
            // The phone's bar (the platform messenger's, dp): 60 tall, a 24px
            // back glyph in a 48 target at 4, the 40 avatar at 56, the title
            // at 108, three 48 targets from the right 8 apart and 8 in. It
            // opens over the home bar: "Sigil" lets go, the account avatar
            // flies to the room's spot and becomes it, the back arrow fades
            // in, the title arrives from the right and the glyphs from past
            // the edge (open-t).
            if root.phone : phone-bar := Rectangle {
                width: 100%; height: 100%;
                clip: true;
                property <float> t: root.open-t;
                property <float> e: root.open-e;
                property <float> late: clamp((self.t - 0.5) / 0.5, 0.0, 1.0);
                property <float> late-e: 1 - (1 - self.late) * (1 - self.late) * (1 - self.late);
                property <float> tail: clamp((self.t - 0.35) / 0.65, 0.0, 1.0);
                property <float> tail-e: 1 - (1 - self.tail) * (1 - self.tail) * (1 - self.tail);
                property <length> dx: 160px * (1 - self.tail-e);
                property <length> title-right: root.is-thread ? self.width - 16px
                    : root.is-invite ? self.width - 64px
                    : root.call-here ? join-pill.x - 8px
                    : self.width - 176px;
                Text {
                    x: 16px; height: 100%;
                    text: "Sigil";
                    color: Theme.menu-text;
                    font-family: Theme.font-ui; font-size: 22px; font-weight: 500;
                    vertical-alignment: center;
                    opacity: max(0.0, 1 - phone-bar.t / 0.4);
                    visible: phone-bar.t < 0.4;
                }
                back-target := Rectangle {
                    x: 4px; y: 6px; width: 48px; height: 48px; border-radius: 24px;
                    opacity: min(1.0, phone-bar.t / 0.536);
                    background: back-t.pressed ? root.fg.with-alpha(0.10)
                              : back-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.back; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    back-t := TouchArea { clicked => { root.back(); } }
                }
                avatar-spot := Rectangle {
                    property <length> from-x: phone-bar.width - 48px;
                    x: self.from-x + (56px - self.from-x) * phone-bar.e;
                    y: 14px - 4px * phone-bar.e;
                    width: 32px + 8px * phone-bar.e; height: self.width;
                    if phone-bar.t < 1 : Avatar {
                        x: 0; y: 0; size: avatar-spot.width;
                        source: root.my-avatar; initials: root.my-initials; tint: root.my-tint;
                        opacity: 1 - phone-bar.e;
                    }
                    Avatar {
                        x: 0; y: 0; size: avatar-spot.width;
                        source: root.room-avatar; initials: root.room-initials; tint: root.room-tint;
                        status-backdrop: root.chrome-c;
                        opacity: phone-bar.e;
                    }
                }
                title-col := VerticalLayout {
                    x: 108px + 24px * (1 - phone-bar.late-e);
                    y: 0; height: 100%;
                    width: max(0px, phone-bar.title-right - 108px);
                    alignment: center;
                    opacity: phone-bar.late;
                    Text {
                        text: root.is-thread ? "Thread" : root.room-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: 17px; font-weight: 500;
                        overflow: elide;
                    }
                    if root.room-subtitle != "" || root.typing-line != "" : Text {
                        text: root.typing-line != "" ? root.typing-line
                            : root.is-thread ? root.room-name : root.room-subtitle;
                        color: root.typing-line != "" ? Theme.accent : root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: 13px;
                        overflow: elide;
                    }
                }
                if !root.is-thread : Rectangle {
                    x: phone-bar.width - 56px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail;
                    background: more-t.pressed ? root.fg.with-alpha(0.10)
                              : more-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.moreVertical; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    more-t := TouchArea { clicked => { root.menu-open = true; } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    x: phone-bar.width - 112px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail * (root.in-call ? 0.4 : 1);
                    background: video-t.pressed ? root.fg.with-alpha(0.10)
                              : video-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.videoOn; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    video-t := TouchArea { clicked => { if (!root.in-call) { root.start-call(true); } } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    x: phone-bar.width - 168px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail * (root.in-call ? 0.4 : 1);
                    background: call-t.pressed ? root.fg.with-alpha(0.10)
                              : call-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.phone; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    call-t := TouchArea { clicked => { if (!root.in-call) { root.start-call(false); } } }
                }
                // A live call in this room: the Join chip before the ⋮.
                join-pill := Rectangle {
                    visible: root.call-here && !root.is-thread;
                    x: phone-bar.width - 64px - self.width + phone-bar.dx;
                    y: 16px;
                    width: join-row-p.preferred-width + 22px;
                    height: 28px; border-radius: 14px;
                    opacity: phone-bar.tail;
                    background: root.accent.with-alpha(0.9);
                    join-row-p := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        IconLabel { text: Icons.phone; filled: true; color: #141414; font-size: Theme.caption; vertical-alignment: center; }
                        Text { text: "Join"; color: #141414; font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.join-call(); } }
                }
            }
        }

        // Invite banner (:1061-1062): "Accept invite" bordered, "Decline" a
        // bare urgent label; centred at spacing 10 in a 52px accent@0.1 band.
        if root.is-invite : invite-bar := Rectangle {
            x: 0; y: root.header-h; width: 100%;
            height: 52px;
            background: Theme.accent.with-alpha(0.1);
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                padding-top: 8px; padding-bottom: 8px;   // 36px buttons centred in 52
                SButton { text: "Accept invite"; foreground: root.fg; bordered: true; clicked => { root.accept-invite(); } }
                SButton { text: "Decline"; foreground: Theme.urgent; bordered: false; clicked => { root.decline-invite(); } }
            }
        }

        // Conversation ground: rounded top corners revealing the header tone,
        // 22px bottom corners unconditionally (:923).
        // Until the sheet arrives the home sheet's ground stands under the
        // header (the page opens over home); the convo covers it at rest.
        if root.phone && root.open-t < 1 : Rectangle {
            x: 0; y: root.sheet-y; width: 100%;
            height: root.height - root.sheet-y;
            background: Theme.card-ground;
            border-top-left-radius: 28px; border-top-right-radius: 28px;
        }
        convo := Rectangle {
            x: 0; width: 100%;
            height: root.height - root.sheet-y;
            // The phone's sheet rises from the page bottom (open-t).
            y: root.sheet-y + (root.height - root.sheet-y) * (1 - root.open-e);
            background: root.convo-c.with-alpha(0.94);
            // The phone keeps the platform messenger's sheet: rounded where it
            // meets the header, square at the bottom, the composer and the
            // gesture zone on the same ground.
            border-top-left-radius: Theme.dbg-no-convo-clip ? 0px : root.phone ? 28px : 24px;
            border-top-right-radius: Theme.dbg-no-convo-clip ? 0px : root.phone ? 28px : 24px;
            border-bottom-left-radius: root.phone ? 0px : 22px;
            border-bottom-right-radius: root.phone ? 0px : 22px;
            clip: true;

            // 46px highlight across the rounded top (ChatPage.qml:966).
            top-sheen := Rectangle {
                x: 0; y: 0; width: 100%; height: 46px;
                background: @linear-gradient(180deg,
                    Theme.menu-background.brighter(0.35).with-alpha(0.3) 0%,
                    transparent 100%);
            }

            VerticalLayout {
                list := TouchList {
                    vertical-stretch: 1;
                    // BottomToTop: short conversations hang from the composer.
                    content-alignment: end;
                    // Media/doc/map cards inflate row heights asynchronously;
                    // while the user is at the bottom, stay at the bottom.
                    property <bool> stick: true;
                    changed viewport-height => {
                        if (self.stick) { root.pin-list(); }
                    }
                    // The panels below take their room from the list: keep
                    // the bottom pinned as it shrinks or grows.
                    changed height => {
                        if (self.stick) { root.pin-list(); }
                    }
                    // Fetch older history a screen and a half early (maybePaginate).
                    changed viewport-y => {
                        list.stick = root.from-end < 12px;
                        if (self.viewport-y > -1.5 * self.height
                            && root.pagination-state == "idle"
                            && self.viewport-height > self.height) {
                            root.paginate();
                        }
                        if (root.from-end < 4px) { root.maybe-mark-read(); }
                    }
                    // ListView footer (the oldest end): 8px of breathing room,
                    // or the 34px pagination spinner in its place (:1198-1201).
                    footer := Rectangle {
                        height: root.pagination-state == "paginating" ? 34px : 8px;
                        if root.pagination-state == "paginating" : Spinner {
                            x: (footer.width - self.width) / 2;
                            y: (34px - self.height) / 2;
                            spin-color: root.fg.with-alpha(0.5);
                            size: Theme.body;
                        }
                    }
                    for item in root.items : Bubble {
                        item: item;
                        fx-clock: root.fx-clock;
                        // a screen's height of slack either side keeps entries smooth
                        on-screen: self.y + self.height > -list.viewport-y - list.height
                            && self.y < -list.viewport-y + 2 * list.height;
                        boot-epoch-s: root.boot-epoch-s;
                        fg: root.fg;
                        accent: root.accent;
                        dm: root.is-dm;
                        encrypted: root.room-encrypted;
                        convo-ground: root.convo-c;
                        // A scrolled timeline makes the prewarmed frost stale
                        // (its hole would sit where the bubble was), so that
                        // press takes its blur from the picture at hold time.
                        hold-started(id, r) => {
                            if (!root.ensure-visible(r)) { root.sheet-prewarm(id, r); }
                        }
                        menu-requested(it, r) => { root.open-menu-for(it, r); }
                        copying: root.copy-of != "" && root.copy-of == item.event-id;
                        // MessageSheet.qml:205 hideSource: the pressed bubble
                        // vanishes for the sheet's whole life, fly-home too —
                        // the copy stands in for it. `hide-source` rises after
                        // the bubble's own picture, so the copy keeps its pixels.
                        sheet-lit: sheet.hide-source && item.event-id != ""
                            && sheet.item.event-id == item.event-id;
                        reply-requested(e, n, b) => { root.arm-reply(e, n, b); }
                        open-image(it) => { root.open-image(it); }
                        play-video(it) => { root.play-video(it); }
                        open-document(it) => { root.open-document(it); }
                        open-contact(it) => { root.open-contact(it); }
                        contact-save(u, n, saved) => { root.contact-save(u, n, saved); }
                        contact-share(u, n) => { root.contact-share(u, n); }
                        copy-text(t) => { root.copy-text(t); }
                        spoiler-revealed(id) => { root.spoiler-revealed(id); }
                        // a themed room tints the bubbles too (BubbleDelegate.qml:39)
                        theme-surface: root.themed ? root.surface-c : transparent;
                        open-audio(it) => { root.open-audio(it); }
                        open-location(it) => { root.open-location(it); }
                        open-link(it) => { root.open-link(it.link-url); }
                        open-url(l) => { root.open-link(l); }
                        open-thread(id) => { root.open-thread(id); }
                        react(id, key) => { root.react(id, key); }
                        voice-toggled(id) => { root.voice-toggled(id); }
                        voice-seeked(id, pos) => { root.voice-seeked(id, pos); }
                        vote(id, opt) => { root.vote(id, opt); }
                    }
                    Rectangle { height: 8px; }
                }

                // Typing indicator (TypingIndicator.qml): folds 0↔38 over 180ms
                // OutCubic while fading over 160ms; always instantiated so the
                // fold can play. The last typer stays for the fade-out.
                typing-row := Rectangle {
                    property <bool> active: root.typing-line != "";
                    height: self.active ? 38px : 0px;
                    animate height { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    opacity: self.active ? 1 : 0;
                    animate opacity { duration: 160ms; }
                    clip: true;
                    changed height => { if (list.stick) { root.pin-list(); } }
                    property <image> shown-avatar;
                    property <string> shown-initials;
                    property <color> shown-tint: Theme.accent;
                    function remember() {
                        if (root.typing-line != "") {
                            self.shown-avatar = root.typing-avatar;
                            self.shown-initials = root.typing-initials;
                            self.shown-tint = root.typing-tint;
                        }
                    }
                    changed active => { self.remember(); }
                    init => { self.remember(); }
                    typing-body := Rectangle {
                        x: 0; y: (typing-row.height - 38px) / 2;
                        width: 100%; height: 38px;
                        HorizontalLayout {
                            alignment: start;
                            padding-left: 14px;
                            spacing: 7px;
                            Rectangle {
                                width: 22px;
                                Avatar {
                                    x: 0; y: (38px - 22px) / 2;
                                    size: 22px;
                                    source: typing-row.shown-avatar;
                                    initials: typing-row.shown-initials;
                                    tint: typing-row.shown-tint;
                                }
                            }
                            // The dots' 30px container is dots.width + 6 (:42):
                            // 3px each side, so avatar→first dot is 10px.
                            Rectangle {
                                width: 3 * 6px + 2 * 5px + 6px;
                                dots := Rectangle {
                                    x: 0; y: (38px - 30px) / 2;
                                    width: 100%; height: 30px;
                                    HorizontalLayout {
                                        padding-left: 3px; padding-right: 3px;
                                        spacing: 5px;
                                        // 900ms cycle: pause i×140, 220 up (OutQuad),
                                        // 260 down (InQuad), rest (TypingIndicator.qml:58-65).
                                        for di in [0, 1, 2] : Rectangle {
                                            width: 6px;
                                            dot := Rectangle {
                                                // only while shown: a live animation-tick() here
                                                // re-rendered every chat at frame rate forever
                                                property <float> t: typing-row.active ? (animation-tick() / 900ms + 3.0 - di * 0.15556).mod(1.0) : 0.0;
                                                property <float> lift: self.t < 0.2444
                                                    ? 1 - (1 - self.t / 0.2444) * (1 - self.t / 0.2444)
                                                    : self.t < 0.5333
                                                        ? 1 - ((self.t - 0.2444) / 0.2889) * ((self.t - 0.2444) / 0.2889)
                                                        : 0;
                                                x: 0; y: (30px - 6px) / 2 - 4px * self.lift;
                                                width: 6px; height: 6px; border-radius: 3px;
                                                background: root.fg.with-alpha(0.55);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Composer — its own tinted band over the convo ground, hidden
                // entirely on an invite (ChatPage.qml:1223). Row margins 10
                // left/right, 10 below, 8 above (:1366-1370).
                composer := Rectangle {
                    height: root.composer-h;
                    visible: !root.is-invite;
                    background: root.phone ? root.convo-c : root.convo-c.with-alpha(0.55);
                    // The phone's pill and disc arrive from below the page
                    // once the sheet has (footer-t); the band stays put.
                    composer-body := Rectangle {
                    x: 0; width: 100%; height: composer.height;
                    y: root.phone ? composer.height * (1 - root.footer-e) : 0px;
                    // inputPill: fill only, no focus border, radius 19; parent
                    // minus the send disc and the 8px spacing.
                    well := Rectangle {
                        x: root.phone ? 8px : 10px; y: 8px;
                        width: composer.width - self.x - root.disc - 8px - (root.phone ? 8px : 10px);
                        height: root.well-h;
                        border-radius: root.phone ? 28px : 19px;
                        background: root.themed ? root.surface-c : root.fg.with-alpha(0.07);

                        // Voice clip chip: a light card inset in the pill. Always
                        // instantiated (visibility-gated) so the wave's width is
                        // readable for clip-wave-bars.
                        clip-chip-band := Rectangle {
                            visible: root.voice-staged;
                            x: 0; y: 0;
                            width: well.width; height: root.quote-h;
                            clip-chip := Rectangle {
                                x: root.chip-pad; y: root.chip-pad;
                                width: clip-chip-band.width - 2 * root.chip-pad;
                                height: root.chip-h;
                                border-radius: root.chip-r;
                                property <color> ink: #17181a;
                                background: root.accent.brighter(0.35);
                                clip-play := Rectangle {
                                    x: root.chip-pad - 1px; y: (root.chip-h - 32px) / 2;
                                    width: 32px; height: 32px; border-radius: 16px;
                                    background: #ffffff.with-alpha(0.9);
                                    IconLabel {
                                        text: root.clip-playing ? Icons.pause : Icons.play;
                                        font-size: Theme.icon-size;   // ChatPage.qml:1559 size: Style.font.icon
                                        color: #1a1a1a;
                                        width: 100%; height: 100%;
                                    }
                                    TouchArea { clicked => {
                                        root.clip-playing = !root.clip-playing;
                                        root.voice-preview(root.clip-playing);
                                    } }
                                }
                                clip-wave := Rectangle {
                                    x: root.chip-pad + 41px; y: (root.chip-h - 26px) / 2;
                                    width: clip-dur.x - self.x - 8px;
                                    height: 26px;
                                    clip: true;
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 2px;
                                        for amp[i] in root.voice-staged-wave : Rectangle {
                                            width: 3px;
                                            Rectangle {
                                                x: 0; y: (26px - self.height) / 2;
                                                width: 3px;
                                                height: max(4px, round(22 * min(1.0, amp)) * 1px);
                                                border-radius: 1.5px;
                                                // Played bars are solid, the rest 0.4 (:1594-1595).
                                                background: (i * 1.0) / max(1, root.voice-staged-wave.length) <= root.clip-frac
                                                    ? clip-chip.ink.with-alpha(0.95) : clip-chip.ink.with-alpha(0.4);
                                            }
                                        }
                                    }
                                    // A tap seeks by x fraction and plays from there (:1600-1610).
                                    wave-t := TouchArea { clicked => {
                                        root.clip-playing = true;
                                        root.clip-seek(max(0.0, min(1.0, self.mouse-x / clip-wave.width)));
                                    } }
                                }
                                clip-dur := Text {
                                    x: clip-close.x - self.preferred-width - 8px;
                                    height: 100%;
                                    text: root.voice-staged-duration;
                                    color: clip-chip.ink.with-alpha(0.85);
                                    font-family: Theme.font-ui; font-size: Theme.caption;
                                    vertical-alignment: center;
                                }
                                clip-close := Rectangle {
                                    x: clip-chip.width - 26px - 8px;
                                    y: (root.chip-h - 26px) / 2;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: clip-chip.ink.with-alpha(0.12);
                                    IconLabel {
                                        text: Icons.close; color: clip-chip.ink;
                                        font-size: Theme.body-small;
                                        width: 100%; height: 100%;
                                    }
                                    TouchArea { clicked => {
                                        root.clip-playing = false;
                                        root.voice-staged = false;
                                        root.voice-discard();
                                    } }
                                }
                            }
                        }
                        // Reply/edit quote lives INSIDE the input surface: a 52px
                        // block whose card is inset 5px, close button inside the
                        // card at the right (ChatPage.qml:1630).
                        if root.quote-armed && !root.voice-staged : quote := Rectangle {
                            x: 0; y: 0;
                            width: well.width; height: root.quote-h;
                            quote-box := Rectangle {
                                x: root.chip-pad; y: root.chip-pad;
                                width: quote.width - 2 * root.chip-pad;
                                height: root.chip-h;
                                border-radius: root.chip-r;
                                background: root.convo-c.with-alpha(0.92);
                                VerticalLayout {
                                    // Text ends 6px before the 26px close at 8 (:1641,:1649).
                                    padding-left: 12px; padding-right: 40px;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: root.caption-of != ""
                                            ? (root.reply-body != "" ? "Edit caption" : "Add caption")
                                            : root.edit-of != "" ? "Edit message" : root.reply-name;
                                        color: root.fg;
                                        font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700;
                                        overflow: elide;
                                    }
                                    if root.reply-body != "" : Text {
                                        text: root.reply-body;
                                        color: root.fg.with-alpha(0.6);
                                        font-family: Theme.font-ui; font-size: Theme.caption;
                                        overflow: elide;
                                    }
                                }
                                quote-close := Rectangle {
                                    x: quote-box.width - self.width - 8px;
                                    y: (root.chip-h - 26px) / 2;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: qc-t.has-hover ? root.fg.with-alpha(0.12) : transparent;
                                    IconLabel {
                                        text: Icons.close; color: root.fg;
                                        font-size: Theme.body-small;
                                        width: 100%; height: 100%;
                                    }
                                    qc-t := TouchArea {
                                        clicked => {
                                            root.reply-to = ""; root.edit-of = ""; root.caption-of = "";
                                            root.reply-name = ""; root.reply-body = "";
                                            composer-input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                        // The attach toggle: 30×30 at the pill's left 6, 4 above
                        // its bottom (:1656-1661); the cancel affordance while the
                        // sheet is open — glyph swap + 90° turn, colour on hover/on.
                        attach-btn := Rectangle {
                            x: root.phone ? 0px : 6px; y: well.height - root.attach-box - (root.phone ? 3px : 4px);
                            width: root.attach-box; height: root.attach-box;
                            IconLabel {
                                x: 0; y: 0; width: root.attach-box; height: root.attach-box;
                                text: root.attach-open ? Icons.cancel : Icons.plusCircle;
                                filled: root.attach-open;
                                transform-origin: { x: root.attach-box / 2, y: root.attach-box / 2 };
                                transform-rotation: root.attach-open ? 90deg : 0deg;
                                animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                                color: at-t.has-hover || root.attach-open ? #c6c6c6 : #c6c6c6.with-alpha(0.85);
                                animate color { duration: 140ms; }
                                font-size: Theme.icon-large;
                            }
                            at-t := TouchArea { clicked => { root.toggle-attach(); } }
                        }
                        // The text: left inset 38 (6 + 30 + 2), right 10 (:1690-1691),
                        // below the quote band; grows with the text and scrolls
                        // past the 110px cap (:1688-1694).
                        input-box := Rectangle {
                            x: root.phone ? 50px : 38px; y: root.quote-h;
                            width: well.width - self.x - (root.phone ? 16px : 10px);
                            height: well.height - root.quote-h;
                            clip: true;
                            input-flick := Flickable {
                                x: 0; y: 0;
                                width: input-box.width; height: input-box.height;
                                viewport-width: self.width;
                                viewport-height: max(self.height, composer-input.preferred-height + 6px);
                                // Shrinking text must not leave the view past its end.
                                changed viewport-height => {
                                    self.viewport-y = max(min(0px, self.height - self.viewport-height), min(0px, self.viewport-y));
                                }
                                composer-input := TextInput {
                                    x: 0; y: 3px;
                                    width: input-flick.width;
                                    height: input-flick.viewport-height - 6px;
                                    color: root.fg;
                                    font-family: Theme.font-ui; font-size: Theme.body;
                                    vertical-alignment: center;
                                    single-line: false;
                                    wrap: word-wrap;
                                    edited => { root.composer-edited(self.text); }
                                    // Keep the caret in view once the text scrolls.
                                    cursor-position-changed(p) => {
                                        if (p.y + 3px + 18px > -input-flick.viewport-y + input-flick.height) {
                                            input-flick.viewport-y = -(p.y + 3px + 18px - input-flick.height);
                                        } else if (p.y + 3px < -input-flick.viewport-y) {
                                            input-flick.viewport-y = -(p.y + 3px);
                                        }
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Return && !event.modifiers.shift) {
                                            root.submit();
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                            if composer-input.text == "" : Text {
                                x: 0; y: 0;
                                height: input-box.height;
                                text: root.voice-staged ? "Add text" : "Message";
                                color: root.fg.with-alpha(0.45);
                                font-family: Theme.font-ui; font-size: Theme.body;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Empty composer → voice button; otherwise send. 38×38 r19,
                    // 10 above the band's bottom (:1752). The two glyphs cross-
                    // fade (130ms) while scaling 0.55→1 with an OutBack overshoot
                    // (180ms); send also turns in from -35° (:1757-1780).
                    send-btn := Rectangle {
                        property <bool> send-mode: composer-input.text != "" || root.voice-staged;
                        x: composer.width - (root.phone ? 8px : 10px) - root.disc;
                        y: composer.height - root.disc - (root.phone ? 8px : 10px) - root.bottom-inset;
                        width: root.disc; height: root.disc; border-radius: root.disc / 2;
                        background: root.send-c;
                        animate background { duration: 120ms; }
                        send-glyph := IconLabel {
                            x: 0; y: 0; width: root.disc; height: root.disc;
                            text: Icons.send;
                            filled: true;   // ChatPage.qml:1768 Fonts.iconFilled
                            color: Theme.background;
                            font-size: Theme.icon-large;
                            opacity: send-btn.send-mode ? 1 : 0;
                            animate opacity { duration: 130ms; }
                            visible: send-btn.send-mode || self.opacity > 0.01;
                            transform-origin: { x: root.disc / 2, y: root.disc / 2 };
                            // Qt OutBack overshoot 2.0 ≈ Slint's ease-out-back (1.56).
                            transform-scale-x: send-btn.send-mode ? 1 : 0.55;
                            transform-scale-y: send-btn.send-mode ? 1 : 0.55;
                            animate transform-scale-x, transform-scale-y { duration: 180ms; easing: ease-out-back; }
                            transform-rotation: send-btn.send-mode ? 0deg : -35deg;
                            animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        }
                        voice-glyph := IconLabel {
                            x: 0; y: 0; width: root.disc; height: root.disc;
                            text: Icons.voiceMemo;
                            filled: true;   // ChatPage.qml:1779 Fonts.iconFilled
                            color: Theme.background;
                            font-size: Theme.icon-large;
                            opacity: send-btn.send-mode ? 0 : 1;
                            animate opacity { duration: 130ms; }
                            visible: !send-btn.send-mode || self.opacity > 0.01;
                            transform-origin: { x: root.disc / 2, y: root.disc / 2 };
                            transform-scale-x: send-btn.send-mode ? 0.55 : 1;
                            transform-scale-y: send-btn.send-mode ? 0.55 : 1;
                            animate transform-scale-x, transform-scale-y { duration: 180ms; easing: ease-out-back; }
                        }
                        send-t := TouchArea {
                            clicked => {
                                if (!send-btn.send-mode) { root.toggle-recorder(); return; }
                                root.submit();
                            }
                        }
                    }
                    }   // composer-body
                }

                // The attachment sheet, inline under the composer (:1795-1820).
                // The FRAME's height animates as a wipe (220ms OutCubic) while
                // the sheet keeps its natural size pinned to the frame's top;
                // the list re-pins to the bottom as the frame moves.
                att-frame := Rectangle {
                    height: root.is-invite ? 0px : root.attach-open ? att.height : 0px;
                    animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    clip: true;
                    changed height => { if (list.stick || root.attach-open) { root.pin-list(); } }
                    att := AttachMenu {
                        x: 0; y: 0;
                        width: att-frame.width;
                        fg: root.fg;
                        // The theme accent proper, not the darker send variant.
                        accent: root.accent;
                        surface: root.themed ? root.surface-c : root.fg.with-alpha(0.07);
                        chip: root.chip-c;
                        themed: root.themed;
                        stickers: root.stickers;
                        stickers-loaded: root.stickers-loaded;
                        sticker-dir: root.sticker-dir;
                        page <=> root.at-page;
                        lp-map: root.lp-map;
                        lp-unavailable: root.lp-unavailable;
                        lp-have-fix: root.lp-have-fix;
                        lp-lat: root.lp-lat;
                        lp-lon: root.lp-lon;
                        lp-error: root.lp-error;
                        lp-marked: root.lp-marked;
                        lp-mark-lat: root.lp-mark-lat;
                        lp-mark-lon: root.lp-mark-lon;
                        my-avatar: root.my-avatar;
                        pick-files => { root.pick-attach-files(); }
                        open-location(mode) => { root.attach-location(mode); }
                        loc-tap(x, y) => { root.attach-loc-tap(x, y); }
                        loc-zoom(d) => { root.attach-loc-zoom(d); }
                        loc-recentre => { root.attach-loc-recentre(); }
                        loc-retry => { root.attach-loc-retry(); }
                        share-location(la, lo, ms, mode) => { root.attach-loc-share(la, lo, ms, mode); }
                        insert-emoji(e) => { root.insert-emoji(e); }
                        create-poll(q, opts, closed) => { root.create-poll(q, opts, closed); }
                        send-sticker(i) => { root.send-sticker(i); }
                        load-stickers => { root.load-stickers(); }
                        load-emoji => { root.load-emoji(); }
                        close-requested => { root.attach-open = false; }
                        // The emoji page body: the one shared picker (AttachMenu.qml:398).
                        EmojiPicker {
                            width: 100%; height: 100%;
                            fg: root.fg;
                            accent: root.accent;
                            chip: root.chip-c;
                            rows: root.emoji-rows;
                            cat-rows: root.emoji-cat-rows;
                            picked(e) => { root.insert-emoji(e); }
                            search-edited(q) => { root.emoji-search(q); }
                        }
                    }
                }

                // The voice recorder, likewise (:1822-1847).
                rec-frame := Rectangle {
                    height: root.is-invite ? 0px : root.recorder-open ? rec.height : 0px;
                    animate height { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    clip: true;
                    changed height => { if (list.stick || root.recorder-open) { root.pin-list(); } }
                    rec := VoiceRecorder {
                        x: 0; y: 0;
                        width: rec-frame.width;
                        fg: root.fg;
                        accent: root.send-c;
                        surface: root.themed ? root.surface-c : root.fg.with-alpha(0.07);
                        chip: root.chip-c;
                        themed: root.themed;
                        state: root.rec-state;
                        elapsed: root.rec-elapsed;
                        clip-duration: root.rec-clip-duration;
                        levels: root.rec-levels;
                        clip-waveform: root.rec-clip-waveform;
                        record => { root.rec-record(); }
                        stop => { root.rec-stop(); }
                        restart => { root.rec-restart(); }
                        attach => { root.rec-attach(); }
                        cancelled => { root.rec-cancel(); root.recorder-open = false; }
                    }
                }
            }
        }
    }

    // Jump-to-latest (:1869-1884): bottom-centred 10 above the composer stack
    // once the gap below exceeds ¾ of a screen; springs in (220ms OutBack)
    // while fading (140ms).
    jump-btn := Rectangle {
        property <bool> shown: root.items.length > 0 && root.from-end > list.height * 0.75;
        property <float> s: self.shown ? 1.0 : 0.0;
        // Qt OutBack overshoot 2.2 ≈ Slint's ease-out-back.
        animate s { duration: 220ms; easing: ease-out-back; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 140ms; }
        visible: self.shown || self.s > 0.01;
        x: (root.width - 38px) / 2;
        y: root.panel-top - 10px - 38px;
        width: 38px; height: 38px; border-radius: 19px;
        transform-origin: { x: 19px, y: 19px };
        transform-scale-x: self.s;
        transform-scale-y: self.s;
        background: root.themed ? root.surface-c : Theme.popup-background;
        IconLabel {
            x: 0; y: 0; width: 38px; height: 38px;
            text: Icons.arrowDown;
            color: root.fg;
            font-size: Theme.icon-size;
        }
        TouchArea { clicked => { root.jump-to-latest(); } }
    }

    // The @/# autocomplete (:1252-1356): flush with the composer's top, full
    // width, top corners 20; an opaque convo ground with two white top
    // gradients (0.07/30px, 0.05/28px); 38px rows r11 with a 24px avatar at 8.
    ac-popup := Rectangle {
        visible: root.ac-items.length > 0;
        x: 0; width: root.width;
        height: root.ac-items.length * 38px + 12px;
        y: root.panel-top - self.height;
        border-top-left-radius: 20px; border-top-right-radius: 20px;
        clip: true;
        background: root.convo-c.with-alpha(1.0);
        Rectangle {
            x: 0; y: 0; width: 100%; height: 30px;
            background: @linear-gradient(180deg, #ffffff.with-alpha(0.07) 0%, transparent 100%);
        }
        Rectangle {
            x: 0; y: 0; width: 100%; height: 28px;
            background: @linear-gradient(180deg, #ffffff.with-alpha(0.05) 0%, transparent 100%);
        }
        VerticalLayout {
            padding: 6px;
            for it[i] in root.ac-items : ac-row := Rectangle {
                height: 38px;
                border-radius: 11px;
                background: i == root.ac-index ? root.fg.with-alpha(0.13) : transparent;
                Avatar {
                    x: 8px; y: (38px - 24px) / 2;
                    size: 24px;
                    source: it.avatar;
                    initials: it.initials;
                    tint: it.tint;
                }
                VerticalLayout {
                    x: 8px + 24px + 8px;
                    width: ac-row.width - 48px;
                    alignment: center;
                    Text {
                        text: it.display-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        overflow: elide;
                    }
                    if it.user-id != "" && it.user-id != it.display-name : Text {
                        text: it.user-id;
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: Theme.caption;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { root.ac-picked(i); } }
            }
        }
    }

    // The toast pill (:1225-1249): 34 tall, rgba(0,0,0,0.82), caption #f2f2f2,
    // 10 above the composer, fading over 180ms OutCubic.
    toast-pill := Rectangle {
        property <bool> shown: root.toast != "";
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.shown || self.opacity > 0.01;
        width: min(composer.width - 40px, toast-text.preferred-width + 28px);
        height: 34px; border-radius: 17px;
        x: (root.width - self.width) / 2;
        y: root.panel-top - 10px - 34px;
        background: #000000.with-alpha(0.82);
        toast-text := Text {
            x: 12px; y: 0;
            width: parent.width - 24px; height: 100%;
            text: root.toast;
            color: #f2f2f2;
            font-family: Theme.font-ui; font-size: Theme.caption;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
        }
    }

    // Header ⋮ menu — 170 wide at y 50 (ChatPage.qml:891-892).
    chat-menu := OverflowMenu {
        width: 100%; height: 100%;
        open <=> root.menu-open;
        top-inset: root.phone ? 56px : 50px;
        card-width: 170px;
        surface: (root.themed ? root.surface-c : Theme.popup-background).with-alpha(0.98);
        fg: root.fg;
        model: [
            { t: "Search", a: "search", icon: Icons.search, danger: false },
            { t: "Threads", a: "threads", icon: Icons.thread, danger: false },
            { t: "Pins", a: "pins", icon: Icons.pin, danger: false },
            { t: "Chat theme", a: "chattheme", icon: Icons.palette, danger: false },
            { t: "Settings", a: "roomsettings", icon: Icons.settings, danger: false },
        ];
        picked(a) => { root.nav-requested(a); }
    }

    // Long-press message sheet.
    sheet := MessageSheet {
        actions: root.sheet-actions;
        backdrop: root.sheet-backdrop;
        copy-image: root.sheet-copy;
        width: 100%; height: 100%;
        // The frost reaches the window's zones around the page.
        bleed-top: root.bleed-top;
        bleed-bottom: root.bleed-bottom;
        // The frost mask and the bottom sheets follow the page's corners: the
        // desktop card's 22, square on the phone (convo above).
        card-radius: root.phone ? 0px : 22px;
        fg: root.fg;
        accent: root.accent;
        // Panel.qml:1370-1373 — a themed room hands the sheet the chat's own
        // surface, chip and deep chip so pill, menu, drawer and confirm sit
        // in the room's tone; unthemed rooms keep the popup ground.
        surface: (root.themed ? root.surface-c : Theme.popup-background).with-alpha(0.98);
        chip: root.chip-c;
        deep-chip: root.deep-chip-c;
        emoji-rows: root.emoji-rows;
        quick-emoji: root.quick-emoji;
        emoji-cat-rows: root.emoji-cat-rows;
        act(action, event-id) => {
            if (action == "reply") {
                root.arm-reply(event-id, sheet.item.sender-name, sheet.item.body);
            } else if (action == "edit") {
                root.arm-edit(event-id, sheet.item.body);
            } else if (action == "caption") {
                root.arm-caption(event-id, sheet.item.media-filename,
                    sheet.item.body != sheet.item.media-filename ? sheet.item.body : "");
            } else if (action == "thread" || action == "openthread") {
                root.open-thread(event-id);
            } else {
                root.menu-action(action, event-id);
            }
        }
        react(id, key) => { root.react(id, key); }
        emoji-search(q) => { root.emoji-search(q); }
        load-emoji => { root.load-emoji(); }
    }
}
