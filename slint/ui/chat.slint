// Conversation page — ChatPage.qml: back header with call buttons, bubble
// timeline, pill composer with the reply/edit quote inside the input surface,
// typing indicator, pagination spinner, jump-to-latest button, header menu,
// invite banner, the long-press message sheet as an overlay, and the two
// inline composer panels (attachment sheet, voice recorder) that take their
// room from the timeline, not from the composer.
//
// Divergences (all in WIRING-chat.md): chat themes/wallpaper wait for the
// theme store; Enter always newlines on a multi-line TextInput, so sending is
// the send button (the phone convention anyway); no frosted-glass sheet scrim.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, ActionButton, Avatar, SButton } from "components.slint";
import { Spinner, TouchList } from "furniture.slint";
import { OverflowMenu, MenuEntry } from "furniture.slint";
import { TimelineRow, ReactionChip, ReplyRef, EmojiItem, UserRow, SheetRect , ComposerCell } from "model.slint";
import { Bubble } from "bubble.slint";
import { MessageSheet } from "sheet.slint";
import { MapTileView } from "pages/map.slint";
import { AttachMenu, StickerItem } from "attach.slint";
import { VoiceRecorder } from "voicerec.slint";
import { EmojiPicker } from "emoji.slint";

export component ChatPage inherits Rectangle {
    in property <string> room-name;
    in property <string> room-subtitle;
    in property <bool> room-encrypted;
    in property <string> room-initials;
    in property <image> room-avatar;
    in property <color> room-tint: Theme.accent;
    in property <[TimelineRow]> items;
    in property <string> typing-line;
    in property <image> typing-avatar;
    in property <string> typing-initials;
    in property <color> typing-tint: Theme.accent;
    in property <bool> is-dm;
    in property <bool> is-invite;
    in property <bool> is-thread;
    in property <string> pagination-state: "idle";  // idle | paginating | timelineStart
    in property <bool> in-call;          // any call, disables the start buttons
    in property <bool> call-here;        // live call in THIS room: Join chip
    in property <[MenuEntry]> sheet-actions;
    in property <[[EmojiItem]]> emoji-rows;
    in property <[EmojiItem]> quick-emoji;
    in property <[int]> emoji-cat-rows;
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <int> boot-epoch-s;
    /// Epoch seconds, now (app.slint), ticked once a second by the bridge.
    in property <int> now-epoch-s;
    /// The attach sheet is open under the composer: the + becomes a cancel affordance.
    in-out property <bool> attach-open: false;
    /// The voice recorder is open under the composer.
    in-out property <bool> recorder-open: false;
    /// This page is the one on screen (ChatPage.qml visibleToUser): leaving
    /// closes the attach sheet and gates read-marking.
    in property <bool> visible-to-user: true;
    /// Extra bottom padding while the virtual keyboard is up, from the window.
    in property <length> bottom-inset: 0px;

    // The recorder's feed (VoiceRecorder.qml's own state, ticked by Rust).
    in property <string> rec-state: "idle";      // idle | recording | ready
    in property <float> rec-elapsed;
    in property <float> rec-clip-duration;
    in property <[float]> rec-levels;
    in property <[float]> rec-clip-waveform;
    // The attach sheet's feed.
    in property <[StickerItem]> stickers;
    in property <bool> stickers-loaded;
    in property <string> sticker-dir;
    /// The sheet's page, exposed so the bridge can open a location mode.
    in-out property <string> at-page: "grid";
    // The location picker's feed (attach.slint LocationPages).
    in property <image> lp-map;
    in property <bool> lp-unavailable;
    in property <bool> lp-have-fix;
    in property <float> lp-lat;
    in property <float> lp-lon;
    in property <string> lp-error;
    in property <bool> lp-marked;
    in property <float> lp-mark-lat;
    in property <float> lp-mark-lon;
    /// The picker's live tile grid and its marker (attach.slint LocationPages).
    in property <[MapTileView]> lp-tiles;
    in property <length> lp-pin-x: -1000px;
    in property <length> lp-pin-y: -1000px;
    in property <image> my-avatar;
    in property <string> my-initials;
    in property <color> my-tint: Theme.accent;
    /// The page is the one on the stack (app.slint's chat holder). The phone
    /// plays its open choreography on the rise and the reverse on the fall;
    /// the desktop card keeps its holder slide.
    in property <bool> opened: true;
    /// The page is arriving over the thread browser rather than over home, so
    /// the bar it morphs out of is the browser's — a back arrow already in
    /// place and the word "Threads", no account face flying in from the right —
    /// and the ground it rises over is the room's, not home's card.
    in property <bool> over-threads: false;
    // open-t: header morph and the sheet's rise; footer-t: the composer's,
    // after them. 0 → 1 over 280 + 160ms; back: composer 100, then 220.
    property <float> open-t: 1.0;
    property <float> footer-t: 1.0;
    states [
        closed when root.phone && !root.opened : {
            open-t: 0.0;
            footer-t: 0.0;
            // Linear clocks: the fades take their windows off them, the
            // motion its OutCubic (an InCubic on the way back) from open-e.
            in {
                animate footer-t { duration: 100ms; }
                animate open-t { duration: 220ms; delay: 100ms; }
            }
            out {
                animate open-t { duration: 280ms; }
                animate footer-t { duration: 160ms; delay: 280ms; }
            }
        }
    ]
    property <float> open-e: 1 - (1 - root.open-t) * (1 - root.open-t) * (1 - root.open-t);
    property <float> footer-e: 1 - (1 - root.footer-t) * (1 - root.footer-t) * (1 - root.footer-t);
    // Composer furniture the bridge fills: the @/# autocomplete rows (label =
    // display-name, sub = user-id) and the toast (ChatPage.qml note()); the
    // page clears the toast itself after 2600ms.
    in property <[UserRow]> ac-items;
    in-out property <int> ac-index: 0;
    in-out property <string> toast;

    // Composer staging (page-local, exactly like ChatPage.qml's).
    in-out property <string> reply-to;
    in-out property <string> reply-name;
    in-out property <string> reply-body;
    in-out property <string> edit-of;
    in-out property <string> caption-of;
    // A recorded-but-unsent voice clip staged in the composer (QML voicePath).
    in-out property <bool> voice-staged;
    in property <string> voice-staged-duration;
    in property <[float]> voice-staged-wave;
    in-out property <bool> clip-playing;
    /// Preview progress 0..1 (QML clipFrac): bars up to it draw solid.
    in property <float> clip-frac: 0;
    /// How many bars the clip chip's wave has room for (QML floor(width / 5)),
    /// so the bridge can resample the waveform to fit.
    out property <int> clip-wave-bars: max(8, floor(clip-wave.width / 5px));

    callback back;
    callback send(string);
    callback send-reply(string /*event-id*/, string /*text*/);
    callback send-edit(string /*event-id*/, string /*text*/);
    callback send-caption(string /*event-id*/, string /*text*/);
    callback send-voice(string /*caption*/);
    callback voice-discard;
    callback voice-preview(bool /*play*/);
    /// Tap on the staged clip's wave: play from this fraction of the clip.
    callback clip-seek(float);
    callback composer-edited(string);
    callback start-call(bool /*video*/);
    callback join-call;
    callback nav-requested(string);   // search threads pins chattheme roomsettings
    /// The attach sheet just opened (the toggle closed it otherwise).
    callback open-attach;
    /// The recorder just opened.
    callback open-recorder;
    callback accept-invite;
    callback decline-invite;
    callback paginate;
    callback menu-action(string /*action*/, string /*event-id*/);
    /// The window's zones above and below this page (status bar and sync
    /// strip; gesture bar or keyboard) that the sheet's scrim must cover too.
    in property <length> bleed-top: 0px;
    in property <length> bleed-bottom: 0px;
    callback react(string, string);
    callback reply-arm(string, string, string); // sheet "reply" → arm composer
    callback open-image(TimelineRow);
    callback play-video(TimelineRow);
    callback open-document(TimelineRow);
    callback open-contact(TimelineRow);
    // the contact card's pills and rows (ContactBody.qml), and a revealed
    // spoiler remembered for the session (RichText.qml:150-151)
    callback contact-save(string, string, bool);
    callback contact-share(string, string);
    callback copy-text(string);
    callback spoiler-revealed(string);
    callback open-audio(TimelineRow);
    callback open-location(TimelineRow);
    callback open-link(string);
    callback open-thread(string);
    /// A row's swipe just passed its detent: the platform's buzz, the moment
    /// the gesture commits (the long-press sheet gets one the same way).
    callback swipe-detent;
    callback voice-toggled(string);
    callback voice-seeked(string, float);
    callback vote(string, string);
    callback emoji-search(string);
    callback mark-read;
    // The attach sheet's actions, forwarded to the window's act() channel.
    callback pick-attach-files;
    callback pick-attach-camera;
    callback pick-attach-gallery;
    callback pick-attach-video;
    callback attach-location(string);   // pin | current | live
    callback attach-loc-tap(length, length);  // map tap in the picker's box
    callback attach-loc-zoom(int);
    callback attach-loc-recentre;
    callback attach-loc-retry;
    callback attach-loc-share(float, float, float, string); // lat, lon, ms, mode
    // The picker's map is the location page's map, gestures and all.
    callback attach-loc-viewport(length, length);
    callback attach-loc-panned(length, length);
    callback attach-loc-zoom-at(int, length, length);
    callback attach-loc-pinch-begin();
    callback attach-loc-pinched(float, length, length);
    callback attach-loc-pinch-end();
    callback insert-emoji(string);
    // question, options, closed, "voters may pick more than one"
    callback create-poll(string, [string], bool, bool);
    callback send-sticker(int);
    callback load-stickers;
    callback load-emoji;
    // The recorder's.
    callback rec-record;
    callback rec-stop;
    callback rec-restart;
    callback rec-attach;
    callback rec-cancel;
    /// An autocomplete row was tapped.
    callback ac-picked(int);

    /// Where the list stood the last time anything but a finger moved it.
    ///
    /// A drag on the conversation shuts whatever panel is open (the reference
    /// does this), and the only thing that must not be mistaken for that drag
    /// is the list moving itself: the pin that follows a panel opening, a row
    /// inflating under the view, the jump-to-latest, the bridge restoring the
    /// offset after a rebuild. Slint's `flicked` already excludes every one of
    /// those — it fires for a finger or a wheel and not for an offset set from
    /// code — and this is the baseline the 8 of slack is measured from, so a
    /// pin landing mid-gesture cannot leave a stale number behind either.
    property <length> list-vy: 0px;
    public function scroll-to-end() {
        list.stick = true;
        list.viewport-y = min(0px, list.height - list.viewport-height);
        root.list-vy = list.viewport-y;
    }
    function pin-list() {
        list.viewport-y = min(0px, list.height - list.viewport-height);
        root.list-vy = list.viewport-y;
    }
    /// Test hook: press one row by event id, exactly as a long-press would —
    /// the row itself fires the menu with its own live rectangle, so the
    /// sheet's hole and glide are measured against the real bubble.
    in-out property <string> debug-press-id;
    /// The held row's y in the list, banked when the hold fires: the rows a
    /// downward lift crosses measure themselves against it.
    property <length> held-y: -1px;
    /// The list's viewport, snapshotted in its `changed` callbacks for the
    /// rows' virtualisation (a binding would loop through the layout).
    property <length> vp-y: 0px;
    property <length> vp-h: 0px;
    public function sheet-open-id(id: string) { root.debug-press-id = id; }
    /// Test hook: open the sheet for one row with a rectangle the harness
    /// names (for cases the live rows cannot stage).
    public function sheet-open(it: TimelineRow, x: length, y: length, w: length, h: length) {
        // The corners as Bubble draws them (bubble.slint r-tl … r-br).
        root.open-menu-for(it, {
            x: x, y: y, w: w, h: h,
            r-tl: it.link-only ? 14px : (!it.is-own && !it.group-start) ? 5px : 16px,
            r-bl: it.link-only ? 14px : (!it.is-own && !it.group-end) ? 5px : 16px,
            r-tr: it.link-only ? 14px : (it.is-own && !it.group-start) ? 5px : 16px,
            r-br: it.link-only ? 14px : (it.is-own && !it.group-end) ? 5px : 16px,
        });
    }
    /// A hold fired on `it`, drawn at `r` (window coordinates).
    function open-menu-for(it: TimelineRow, r: SheetRect) {
        // A hold with the keyboard up puts the keyboard down (Messages does):
        // the sheet needs the whole screen, and the menu would stand on the
        // keyboard's edge otherwise.
        composer-input.clear-focus();
        sheet.item = it;
        // The menu's entries (and the haptic), then the sheet, in window
        // coordinates: it subtracts its own absolute-position (safe area,
        // status strip, holder) so its hole lands exactly on the bubble.
        root.menu-action("prepare", it.event-id);
        // The bubble is the real row, and it is the BUBBLE that moves: the
        // pressed row lifts its bubble by the sheet's `lift` (the row's
        // Bubble binds its y to it) while the list stays exactly where it
        // is; the sheet's hole, pill and menu are laid out around the same
        // number, so all of it travels together.
        sheet.open-for(r);
    }
    public function sheet-close() { sheet.open = false; }
    /// Test hook: the sheet's emoji drawer, as the pill's add-reaction cell raises it.
    public function sheet-open-drawer() { root.load-emoji(); sheet.drawer-open = true; }
    out property <bool> sheet-shown: sheet.shown;
    /// Whatever is staged goes: a voice clip, a caption, an edit, a reply, or plain text.
    public function submit() {
        if (composer-input.text == "" && !root.voice-staged) { return; }
        if (root.voice-staged) { root.send-voice(composer-input.text); }
        else if (root.caption-of != "") { root.send-caption(root.caption-of, composer-input.text); }
        else if (root.edit-of != "") { root.send-edit(root.edit-of, composer-input.text); }
        else if (root.reply-to != "") { root.send-reply(root.reply-to, composer-input.text); }
        else { root.send(composer-input.text); }
        root.clear-composer();
    }
    public function clear-composer() {
        composer-input.text = "";
        root.reply-to = ""; root.reply-name = ""; root.reply-body = ""; root.edit-of = "";
        root.caption-of = "";
        root.voice-staged = false; root.clip-playing = false;
    }
    public function arm-reply(event-id: string, sender: string, body: string) {
        root.reply-to = event-id; root.reply-name = sender; root.reply-body = body;
        root.edit-of = "";
    }
    public function arm-edit(event-id: string, body: string) {
        root.edit-of = event-id; root.reply-to = ""; root.caption-of = "";
        root.reply-name = "Edit message"; root.reply-body = body;
        composer-input.text = body;
    }
    // Panel.messageAction("caption"): the quote shows the filename; the well
    // holds the current caption, ready to edit.
    public function arm-caption(event-id: string, filename: string, cap: string) {
        root.reply-to = ""; root.edit-of = "";
        root.caption-of = event-id;
        root.reply-name = filename != "" ? filename : "Attachment";
        root.reply-body = cap;
        composer-input.text = cap;
        composer-input.focus();
    }
    // ChatPage.qml onInsertEmoji: insert at the cursor, keep focus. Slint has
    // no string slicing, so the splice happens in Rust against these.
    out property <string> composer-text <=> composer-input.text;
    out property <int> composer-cursor <=> composer-input.cursor-position-byte-offset;
    /// The caret moved without an edit (arrow keys, a tap): the bridge
    /// re-judges which runs the caret is inside.
    callback composer-cursor-moved(int);
    /// How wide the typed text may run, for the bridge's layout.
    out property <length> composer-w: input-box.width;
    // The live preview (composer.rs): the typed text as cells, each knowing
    // where it sits as typed and where it settles once its run's markup has
    // gone. While a run has settled the input draws transparent and these
    // cells stand in for it, sliding from one place to the other on
    // `collapse-e`; the caret is drawn here too, at its settled place.
    in property <[ComposerCell]> cp-cells;
    in property <bool> cp-styled: false;
    in property <length> cp-caret-x;
    in property <length> cp-caret-y;
    /// … and where it sat as typed, so it slides with the text.
    in property <length> cp-caret-fx;
    in property <length> cp-caret-fy;
    /// Ticks when another run settles: the collapse starts again from the
    /// as-typed places. Driven off elapsed time (furniture.slint's Beats
    /// explains why a state or a plain animate cannot be trusted here).
    in property <int> cp-epoch: 0;
    property <duration> cp-since: -10s;
    property <bool> cp-playing: false;
    changed cp-epoch => {
        root.cp-since = animation-tick();
        root.cp-playing = true;
        cp-settle.restart();
    }
    property <float> collapse-t: root.cp-playing
        ? clamp((animation-tick() - root.cp-since) / 300ms, 0.0, 1.0) : 1.0;
    property <float> collapse-e: 1 - (1 - root.collapse-t) * (1 - root.collapse-t) * (1 - root.collapse-t);
    cp-settle := Timer {
        interval: 340ms;
        running: root.cp-playing;
        triggered => { root.cp-playing = false; }
    }
    // A selection shows the source whole: the platform's own handles and
    // the input's highlight are drawn at as-typed positions.
    property <bool> cp-selecting: composer-input.anchor-position-byte-offset != composer-input.cursor-position-byte-offset;
    property <bool> cp-live: root.cp-styled && !root.cp-selecting && composer-input.text != "";
    // `take-focus` false restores a draft on room open — pulling focus there
    // would raise the phone's keyboard the moment a room opens.
    public function set-composer(t: string, cursor: int, take-focus: bool) {
        composer-input.text = t;
        composer-input.set-selection-offsets(cursor, cursor);
        if (take-focus) { composer-input.focus(); }
    }

    // ---- the two composer sheets (ChatPage.qml:806-807, :1683, :1785) ----
    // Only one is open at a time, whichever route opened it; the attach sheet
    // resets to its grid on open; the recorder resets through open-recorder
    // (the bridge owns its state). Leaving the page closes the attach sheet;
    // a room change closes both (:2002, :2009).
    // A panel and the keyboard never share the bottom of the page: opening a
    // panel puts the keyboard away (the input lets go of focus), and the
    // input taking focus again — a tap in it — closes whichever panel is up,
    // as the platform messenger does. The attach sheet's own emoji search is
    // a field of its own, so its keyboard leaves the sheet in place.
    public function toggle-attach() {
        root.attach-open = !root.attach-open;
        if (root.attach-open) {
            root.recorder-open = false;
            composer-input.clear-focus();
            att.reset();
            root.open-attach();
        }
    }
    public function toggle-recorder() {
        root.recorder-open = !root.recorder-open;
        if (root.recorder-open) {
            root.attach-open = false;
            composer-input.clear-focus();
            root.open-recorder();
        }
    }
    // However a panel comes up — the toggle, or the bridge setting it — the
    // composer lets go of focus, so the keyboard goes with it.
    // The keyboard's height is banked BEFORE the focus goes (the inset is
    // still the keyboard's at that instant): the panel opens at exactly it.
    changed attach-open => {
        if (self.attach-open) { root.open-kb = root.kb-inset; self.recorder-open = false; composer-input.clear-focus(); }
        else if (!self.recorder-open) { root.open-kb = 0px; }
    }
    changed recorder-open => {
        if (self.recorder-open) { root.open-kb = root.kb-inset; self.attach-open = false; composer-input.clear-focus(); }
        else if (!self.attach-open) { root.open-kb = 0px; }
    }
    changed visible-to-user => {
        if (!self.visible-to-user) { self.attach-open = false; }
        else { root.maybe-mark-read(); }
    }
    changed room-name => { self.attach-open = false; self.recorder-open = false; }
    changed is-thread => { self.attach-open = false; self.recorder-open = false; }

    // Read-marking: 800ms after settling at the bottom, only while on screen
    // (ChatPage.qml:1985-1986 readTimer/maybeMarkRead).
    /// How many loaded rows carry running effects (the bridge counts them);
    /// the shared clock ticks only while there are any and the page shows.
    in property <int> fx-count: 0;
    property <duration> fx-clock: 0ms;
    // Accumulated, not read from animation-tick(): reading the tick marks
    // animations as running and the renderer then draws every vsync.
    fx-timer := Timer {
        interval: 50ms;
        running: root.fx-count > 0 && root.visible-to-user;
        triggered => { root.fx-clock += 50ms; }
    }
    read-timer := Timer {
        interval: 800ms;
        running: false;
        triggered => { self.running = false; root.mark-read(); }
    }
    function maybe-mark-read() {
        if (root.visible-to-user && root.from-end < 4px) {
            read-timer.running = true;
            read-timer.restart();
        }
    }

    // The toast clears itself 2600ms after it was set (ChatPage.qml:839).
    toast-timer := Timer {
        interval: 2600ms;
        running: false;
        triggered => { self.running = false; root.toast = ""; }
    }
    changed toast => { if (self.toast != "") { toast-timer.running = true; toast-timer.restart(); } }

    property <bool> menu-open: false;
    property <bool> quote-armed: root.reply-to != "" || root.edit-of != "" || root.caption-of != "";
    /// A chat theme accent is set for this room (the mixes below are gated on it).
    in property <bool> themed: false;
    // ChatPage.qml convoC: menu.background ÷1.35, then 18% accent ONLY when themed.
    property <bool> phone: Theme.mode != "desktop";
    // ---- swipe a row to reply, or to reply in a thread ----
    // Measured off Google Messages at 1344×2992, density 408 (2.55 px per dp):
    // the disc is 102 px across (40dp) and its near edge stands 52 px (20dp)
    // clear of the bubble's dragged edge, centred on the bubble's own height.
    // The two captures were free drags of 319 px (125dp) and 351 px (138dp),
    // so they fix the geometry but not the detent; 64px commits, and past it
    // the row keeps only 0.42 of every further pixel, to 116px at the stop.
    property <length> swipe-disc: 40px;
    property <length> swipe-gap: 20px;
    property <length> swipe-detent-at: 64px;
    property <length> swipe-limit: 116px;
    /// What sits under the status bar and the gesture bar on the phone: the
    /// header's own ground above, the composer's below, so the insets read
    /// as part of the page rather than as bars.
    // On the phone the header's ground starts as the home bar's and settles
    // over the open choreography.
    property <color> top-rest: root.themed ? root.chrome-c : Theme.card-ground;
    out property <color> top-ground: root.phone ? root.top-rest.mix(Theme.background, root.open-e) : root.top-rest;
    // With a panel open the page bottom is the panel, so the gesture zone
    // follows it. With the composer or the recorder showing the gesture bar
    // keeps nothing of its own: the window paints NO strip there (app.slint
    // :472-476 fills that zone with this colour), so the bar sits on whatever
    // is behind the window instead of on a band of ours.
    // The attach sheet used to be an opaque slab and wanted its own strip
    // carried on under the gesture bar. It is the footer's translucent ground
    // now, running to the screen's edge over a timeline that runs there with
    // it, so it wants what the recorder and the bare composer want: nothing.
    out property <color> bottom-ground: root.phone
        ? (root.is-invite ? root.convo-paint : transparent)
        : root.convo-c.with-alpha(0.94).mix(Theme.card-ground, 0.94);
    // ChatPage.qml:20-32 convoC: darker(menu, 1.35), tinted 18% by the
    // accent when themed. The phone's light palette is near white and
    // darkening it reads as grey, so there the sheet sits on the card
    // ground (the platform's lightly elevated surface) instead.
    property <color> convo-base: root.phone && Theme.mode == "light" ? Theme.card-ground : Theme.menu-background.darker(0.35);
    property <color> convo-c: root.themed
        ? root.convo-base.mix(root.accent, 0.82)
        : root.convo-base;
    /// What the conversation ground ACTUALLY paints. `convo-c` is only the
    /// tone: the sheet draws it at 0.94 over the page ground beneath it
    /// (convo, below), so the colour on screen is that composite, a shade
    /// off convo-c — and off it by more in a themed room, where the ground
    /// under the sheet is the room's chrome. Everything that has to read as
    /// the conversation's own ground (the composer band, the recorder's
    /// stage) takes THIS, and takes it with an alpha: drawn over that same
    /// ground, a translucent convo-paint composites back to convo-paint
    /// exactly where nothing lies behind it, and lets a bubble through where
    /// one does.
    property <color> convo-paint: root.convo-c.mix(
        root.phone ? root.top-ground : Theme.menu-background, 0.94);
    /// How much of the band is ground; the rest is the conversation under it.
    // The footer's ground: 95 % over the timeline on the phone — translucent,
    // not near-transparent. The input well and the disc are opaque on top.
    property <float> band-alpha: root.phone ? 0.95 : 0.55;
    // surfaceC: ONE literal surface for themed chrome (mix of lighter(menu, 1.35)
    // and the accent at 0.35); chromeC is the header band (ChatPage.qml:47-49).
    property <color> surface-c: root.themed
        ? Theme.menu-background.brighter(0.35).mix(root.accent, 0.65)
        : Theme.popup-background;
    property <color> chrome-c: root.themed ? root.surface-c : Theme.menu-background.brighter(0.35);
    // themedSend: the send disc, the recorder's accent (ChatPage.qml:45).
    property <color> send-c: root.themed ? root.accent.darker(0.15) : root.accent.with-alpha(0.9);
    // chipC / deepChipC (:51-59): the attach sheet's and recorder's control fill.
    property <color> chip-c: root.themed
        ? root.convo-c.with-alpha(0.92)
        : Theme.menu-background.darker(1.1).with-alpha(0.96);
    // deepChipC (ChatPage.qml:56-60) sinks chipC's luminance to 0.19 so a
    // pale chip still grounds the confirm's Cancel; Slint exposes no channel
    // math, so the light palette — the one whose chip is bright (lum ≈ 0.45)
    // — darkens by the measured ratio and the dark ones pass through.
    property <color> deep-chip-c: Theme.mode == "light" ? root.chip-c.darker(1.4) : root.chip-c;
    // A staged voice clip outranks the quote for the extra band (QML: 60 vs 52).
    // On the phone both bands are one height, and a card inside the pill is
    // inset by `chip-pad` with the concentric radius (pill 28 less the inset)
    // so its corners follow the pill's instead of poking through them.
    property <length> chip-pad: root.phone ? 8px : 6px;
    property <length> chip-r: root.phone ? 20px : 14px;
    property <length> quote-h: root.phone
        ? ((root.voice-staged || root.quote-armed) ? 64px : 0px)
        : (root.voice-staged ? 60px : root.quote-armed ? 52px : 0px);
    property <length> chip-h: root.quote-h - 2 * root.chip-pad;
    // inputPill.height (ChatPage.qml:1384): the text's own height between 38
    // and 110 (the QML TextArea's 3px paddings included), plus the quote band.
    // The phone's pill is the platform's (dp): 56 tall, r28, from 16 to a
    // 56 send disc 8 past it and 16 in, 12 above the bottom; the + is a 24
    // glyph in a 48 target 8 inside the pill.
    property <length> well-h: root.phone
        ? min(140px, max(54px, composer-input.preferred-height + 20px)) + root.quote-h
        : min(110px, max(38px, composer-input.preferred-height + 6px)) + root.quote-h;
    property <length> disc: root.phone ? 54px : 38px;
    property <length> attach-box: root.phone ? 48px : 30px;
    // ---------------------------------------------------------------- the foot
    //
    // The window hands the page ONE number for the zone it must keep clear
    // (app.slint: max(safe-area.bottom, keyboard)), so split it back apart:
    // no gesture bar or home indicator is anywhere near 96 tall and no
    // keyboard is anywhere near that short, so the threshold is never in
    // doubt. While the keyboard is up the gesture bar is behind it, which is
    // why the gesture share falls to zero rather than staying.
    property <length> gesture-inset: root.bottom-inset > 96px ? 0px : root.bottom-inset;
    property <length> kb-inset: root.bottom-inset > 96px ? root.bottom-inset : 0px;
    /// This keyboard at its DEFAULT height: the tallest one this device has
    /// stood up. The reference (Google Messages) opens every panel under the
    /// composer at EXACTLY the keyboard's height, so that switching keyboard ↔
    /// panel never moves the composer; a keyboard is the user's own choice of
    /// size, so the number is learnt from the device rather than assumed, and
    /// remembered across launches — the first panel of a session opens before
    /// any keyboard has been seen. The tallest and not the last, because a
    /// keyboard dragged short for a moment must not shrink the panels with it.
    /// Measured, remembered and stored by the window (app.slint's
    /// `kb-height-px`, bridge.rs's `keyboardHeightPx`); 400 is what the sheets
    /// stood at before any of this, and what a device with nothing stored gets.
    in property <length> kb-h: 400px;
    // composerBox = pill + 18 (:1222): 8 above, 10 below. The band alone,
    // without whatever it is standing off the bottom of the screen.
    property <length> well-band: root.well-h + (root.phone ? 16px : 18px);
    /// The whole page below the header, less the composer's own band: what a
    /// panel takes when it is taken to full height, which puts the composer
    /// directly under the header, as the reference's expanded sheet does.
    property <length> panel-max: max(0px, root.height - root.sheet-y - root.well-band);
    /// The height a panel is asked to open at. On the phone that is the
    /// remembered keyboard's, which is the whole point; the desktop has no
    /// keyboard to match and its sheets keep their own sizes (zero asks for
    /// nothing, and each panel's own floor is then its natural height).
    /// The keyboard's height at the moment a panel was opened over it (zero
    /// when none was up): a panel opened over the keyboard takes EXACTLY the
    /// keyboard's height, whatever the remembered default, so the composer
    /// does not move as the one replaces the other — a panel aiming at a
    /// taller remembered height animated up while the keyboard slid down,
    /// and the composer dipped between the two.
    property <length> open-kb: 0px;
    property <length> panel-want: !root.phone ? 0px : root.open-kb > 96px ? root.open-kb : root.kb-h;
    /// Where the attach sheet RESTS: that, floored by what the page in front
    /// cannot do without and capped by the page itself. The sheet is handed
    /// this and the full height, and answers with the one it wants — which,
    /// while a finger is on its handle, is wherever the finger has it.
    property <length> att-rest: min(root.panel-max, max(root.panel-want, att.min-h));
    property <length> att-h: root.at-page == "emoji"
        ? (epicker.expanded ? root.panel-max : root.att-rest)
        : att.want-h;
    property <length> rec-h: min(root.panel-max, max(root.panel-want, rec.min-h));
    /// The room the open panel is actually taking right now (mid-animation
    /// included). Only one of the two is ever open.
    property <length> panel-h: att-frame.height + rec-frame.height;
    /// The ONE number the composer stands off the bottom of the screen by:
    /// the keyboard, or the panel, whichever is taller — and since a panel is
    /// opened at the keyboard's own height they are the same number, so the
    /// composer does not move when one replaces the other. The panel is drawn
    /// at the screen's bottom edge whether the keyboard is up or not: while
    /// the keyboard is still sliding away it is simply behind it.
    /// With a panel open the gesture bar is the PANEL's to keep clear (its
    /// own content stands off it from the inside and its ground runs on under
    /// it), so only the keyboard's share is compared.
    ///
    /// `handover` is the one case the two numbers cannot cover between them:
    /// a tap on the text field, which asks for the keyboard while a panel is
    /// standing there. The panel must not go yet — a panel falling to nothing
    /// while the keyboard is still on its way leaves max() reading whichever
    /// of the two is bigger at each instant, and that dips at the crossing:
    /// the composer's bob, the other way round.
    ///
    /// So the panel simply STAYS, at its full height, doing nothing, while the
    /// keyboard's own animation frames come in underneath it. The moment the
    /// keyboard has covered it the panel is dropped in one step, behind the
    /// keyboard where there is nothing to see. The foot is max(panel, keyboard)
    /// throughout and cannot move backwards: the panel's height until the
    /// keyboard passes it, the keyboard's after.
    ///
    /// If the keyboard never comes, or lands SHORTER than the panel — a
    /// keypad, a floating keyboard, a platform that declined — the timer gives
    /// up and the panel closes the ordinary way, with its wipe, and the
    /// composer glides down to whatever the keyboard turned out to be.
    property <bool> handover: false;
    /// The handover ended with the keyboard NOT covering the panel, so the
    /// close is an ordinary wipe and the composer rides it down rather than
    /// dropping. Held just long enough for that wipe to start.
    property <bool> give-up: false;
    give-up-timer := Timer {
        interval: 260ms;
        running: root.give-up;
        triggered => { root.give-up = false; }
    }
    function end-handover(covered: bool) {
        root.handover = false;
        root.give-up = !covered;
        root.attach-open = false;
        root.recorder-open = false;
    }
    handover-timer := Timer {
        interval: 700ms;
        running: root.handover;
        triggered => { root.end-handover(false); }
    }
    changed kb-inset => {
        if (root.handover && root.kb-inset >= root.panel-h) { root.end-handover(true); }
    }
    property <length> foot-h: max(root.panel-h,
        (root.attach-open || root.recorder-open) ? root.kb-inset : root.bottom-inset);
    /// The height the open panel is HEADING for. The frames' own heights are
    /// the animated ones, and they are what the durations below drive, so
    /// nothing a duration reads may be one of them.
    property <length> panel-aim: (root.attach-open ? root.att-h : 0px)
        + (root.recorder-open ? root.rec-h : 0px);
    /// Whether a panel about to change height should just BE there. Read at
    /// the instant the animation starts, which is what makes one expression
    /// enough for every case:
    ///
    ///   opening while the keyboard is up   the panel is going exactly where
    ///                                      the keyboard already is → instant,
    ///                                      and it waits there behind it
    ///   closing because the keyboard has
    ///     covered it (the handover)        aim is 0 under a keyboard →
    ///                                      instant, with nothing on screen
    ///                                      to see it go
    ///   opening from the bare screen       no keyboard → the 220 wipe
    ///   closing to the bare screen         no keyboard → the 220 wipe
    ///   closing under a keyboard that
    ///     landed SHORTER than the panel    `give-up` → the wipe, and the
    ///                                      composer rides it down
    property <bool> panel-instant: !root.give-up
        && root.kb-inset > 0px && root.kb-inset >= root.panel-aim;
    /// Whatever of the foot the panel is not already covering: the composer's
    /// own bottom padding. Zero once a panel has grown to the keyboard's size.
    property <length> composer-inset: root.is-invite ? 0px : root.foot-h - root.panel-h;
    property <length> composer-h: root.is-invite ? 0px : root.well-band + root.composer-inset;
    /// Where the composer stack starts, measured from the page bottom: the
    /// composer plus whichever inline panel is open (:1869-1884). Out, so the
    /// screenshot harness can assert the one thing this is all for — that the
    /// number does not change across keyboard, attach panel and recorder.
    out property <length> panel-top: root.height - root.composer-h - root.panel-h;
    out property <length> from-end: max(0px, (list.viewport-height - list.height) + list.viewport-y);
    /// The timeline's width, so Rust can wrap effect text to the bubble.
    out property <length> timeline-w: list.width;
    /// Put the view back at the same distance from the bottom — how scroll
    /// position survives the bridge rebuilding the model (prepends included).
    public function restore-from-end(d: length) {
        list.viewport-y = min(0px, (list.height - list.viewport-height) + d);
        root.list-vy = list.viewport-y;
    }

    // Jump-to-latest eases toward the *current* end, re-evaluated every tick
    // (the list grows as rows inflate): ~88% of the gap closed every 0.25s
    // (ChatPage.qml:1853-1866), i.e. 13.7% per 16ms tick.
    property <bool> jumping: false;
    jump-tick := Timer {
        interval: 16ms;
        running: root.jumping;
        triggered => {
            if (!root.jumping) { return; }
            if (abs((min(0px, list.height - list.viewport-height) - list.viewport-y) / 1px) < 0.5) {
                root.jumping = false;
                root.scroll-to-end();
                return;
            }
            list.viewport-y += (min(0px, list.height - list.viewport-height) - list.viewport-y) * 0.137;
            root.list-vy = list.viewport-y;
        }
    }
    public function jump-to-latest() { root.jumping = true; }

    // The phone's page ground is the header's, so the sheet's rounded top
    // corners reveal the header colour behind them (the platform look).
    background: root.phone ? root.top-ground : Theme.menu-background;

    // The page's three bands, placed by hand so the phone can move the sheet
    // and the composer separately: header, the invite banner, the convo.
    property <length> header-h: root.phone ? 60px : 52px;
    property <length> sheet-y: root.header-h + (root.is-invite ? 52px : 0px);
    Rectangle {
        width: 100%; height: 100%;
        // Header (ChatPage.qml:993-1049): 22px PanelActionButtons; back at 6,
        // avatar 4 after it, title 10 after that and 4 before the trailing
        // buttons, which sit at spacing 0 with an 8px right margin.
        header := Rectangle {
            x: 0; y: 0; width: 100%;
            height: root.header-h;
            // The themed chrome band with 22px top radii (:986-992). The
            // phone's band is the page ground itself (top-ground).
            if root.themed && !root.phone : Rectangle {
                width: 100%; height: 100%;
                border-top-left-radius: 22px; border-top-right-radius: 22px;
                background: root.chrome-c;
            }
            if !root.phone : HorizontalLayout {
                padding-left: 6px; padding-right: 8px;
                spacing: 0;
                Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.back;
                        filled: true;   // ChatPage.qml:993 Fonts.iconFilled
                        foreground: root.fg;
                        clicked => { root.back(); }
                    }
                    // The tap surface spans the header height for fingers.
                    TouchArea { clicked => { root.back(); } }
                }
                Rectangle { width: 4px; }
                Rectangle {
                    width: 32px;
                    Avatar {
                        x: 0; y: (52px - 32px) / 2;
                        size: 32px;
                        source: root.room-avatar;
                        initials: root.room-initials;
                        tint: root.room-tint;
                        status-backdrop: root.chrome-c;
                    }
                }
                Rectangle { width: 10px; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.is-thread ? "Thread" : root.room-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.subtitle; font-weight: 700;
                        overflow: elide;
                    }
                    if root.room-subtitle != "" || root.typing-line != "" : Text {
                        text: root.typing-line != "" ? root.typing-line
                            : root.is-thread ? root.room-name : root.room-subtitle;
                        // The typing line takes the GLOBAL accent (:1013), not the room's.
                        color: root.typing-line != "" ? Theme.accent : root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: Theme.caption;
                        overflow: elide;
                    }
                }
                Rectangle { width: 4px; }
                // A live call in this room replaces the start-a-call buttons.
                if root.call-here && !root.is-thread : Rectangle {
                    // A cell: the layout owns its children's y, so the chip
                    // centres itself inside this instead.
                    width: join-row.preferred-width + 22px;
                    join-chip := Rectangle {
                        x: 0; y: (52px - 28px) / 2;
                        width: join-row.preferred-width + 22px;
                        height: 28px; border-radius: 14px;
                        background: root.accent.with-alpha(0.9);
                        join-row := HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            IconLabel { text: Icons.phone; filled: true; color: #141414; font-size: Theme.caption; vertical-alignment: center; }
                            Text { text: "Join"; color: #141414; font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.join-call(); } }
                    }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.phone;
                        filled: true;   // ChatPage.qml:1039 Fonts.iconFilled
                        foreground: root.fg;
                        opacity: root.in-call ? 0.4 : 1;
                    }
                    TouchArea { clicked => { if (!root.in-call) { root.start-call(false); } } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.videoOn;
                        filled: true;   // ChatPage.qml:1041 Fonts.iconFilled
                        foreground: root.fg;
                        opacity: root.in-call ? 0.4 : 1;
                    }
                    TouchArea { clicked => { if (!root.in-call) { root.start-call(true); } } }
                }
                if !root.is-thread : Rectangle {
                    width: 22px;
                    ActionButton {
                        x: 0; y: (52px - 22px) / 2;
                        width: 22px; height: 22px;
                        icon: Icons.moreVertical;
                        filled: true;   // ChatPage.qml:1048 Fonts.iconFilled
                        foreground: root.fg;
                    }
                    TouchArea { clicked => { root.menu-open = true; } }
                }
            }
            // The phone's bar (the platform messenger's, dp): 60 tall, a 24px
            // back glyph in a 48 target at 4, the 40 avatar at 56, the title
            // at 108, three 48 targets from the right 8 apart and 8 in. It
            // opens over the home bar: "Sigil" lets go, the account avatar
            // flies to the room's spot and becomes it, the back arrow fades
            // in, the title arrives from the right and the glyphs from past
            // the edge (open-t).
            if root.phone : phone-bar := Rectangle {
                width: 100%; height: 100%;
                clip: true;
                property <float> t: root.open-t;
                property <float> e: root.open-e;
                property <float> late: clamp((self.t - 0.5) / 0.5, 0.0, 1.0);
                property <float> late-e: 1 - (1 - self.late) * (1 - self.late) * (1 - self.late);
                property <float> tail: clamp((self.t - 0.35) / 0.65, 0.0, 1.0);
                property <float> tail-e: 1 - (1 - self.tail) * (1 - self.tail) * (1 - self.tail);
                property <length> dx: 160px * (1 - self.tail-e);
                property <length> title-right: root.is-thread ? self.width - 16px
                    : root.is-invite ? self.width - 64px
                    : root.call-here ? join-pill.x - 8px
                    : self.width - 176px;
                // The word the page is coming out of: home's "Sigil", or the
                // thread browser's "Threads" where that one stood.
                Text {
                    x: root.over-threads ? 56px : 16px; height: 100%;
                    text: root.over-threads ? "Threads" : "Sigil";
                    color: Theme.menu-text;
                    font-family: Theme.font-ui;
                    font-size: root.over-threads ? 19px : 22px;
                    font-weight: 500;
                    vertical-alignment: center;
                    opacity: max(0.0, 1 - phone-bar.t / 0.4);
                    visible: phone-bar.t < 0.4;
                }
                back-target := Rectangle {
                    x: 4px; y: 6px; width: 48px; height: 48px; border-radius: 24px;
                    // The browser already had one, under the very finger that
                    // opened the thread: it does not fade in again.
                    opacity: root.over-threads ? 1.0 : min(1.0, phone-bar.t / 0.536);
                    background: back-t.pressed ? root.fg.with-alpha(0.10)
                              : back-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.back; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    back-t := TouchArea { clicked => { root.back(); } }
                }
                avatar-spot := Rectangle {
                    // Out of home the account's face flies in from the right
                    // and becomes the room's. The browser has no face at all,
                    // so out of it the room's simply grows into place.
                    property <length> from-x: root.over-threads ? 56px : phone-bar.width - 48px;
                    x: self.from-x + (56px - self.from-x) * phone-bar.e;
                    y: 14px - 4px * phone-bar.e;
                    width: 32px + 8px * phone-bar.e; height: self.width;
                    if phone-bar.t < 1 && !root.over-threads : Avatar {
                        x: 0; y: 0; size: avatar-spot.width;
                        source: root.my-avatar; initials: root.my-initials; tint: root.my-tint;
                        opacity: 1 - phone-bar.e;
                    }
                    Avatar {
                        x: 0; y: 0; size: avatar-spot.width;
                        source: root.room-avatar; initials: root.room-initials; tint: root.room-tint;
                        status-backdrop: root.chrome-c;
                        opacity: phone-bar.e;
                    }
                }
                title-col := VerticalLayout {
                    x: 108px + 24px * (1 - phone-bar.late-e);
                    y: 0; height: 100%;
                    width: max(0px, phone-bar.title-right - 108px);
                    alignment: center;
                    opacity: phone-bar.late;
                    Text {
                        text: root.is-thread ? "Thread" : root.room-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: 17px; font-weight: 500;
                        overflow: elide;
                    }
                    if root.room-subtitle != "" || root.typing-line != "" : Text {
                        text: root.typing-line != "" ? root.typing-line
                            : root.is-thread ? root.room-name : root.room-subtitle;
                        color: root.typing-line != "" ? Theme.accent : root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: 13px;
                        overflow: elide;
                    }
                }
                if !root.is-thread : Rectangle {
                    x: phone-bar.width - 56px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail;
                    background: more-t.pressed ? root.fg.with-alpha(0.10)
                              : more-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.moreVertical; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    more-t := TouchArea { clicked => { root.menu-open = true; } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    x: phone-bar.width - 112px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail * (root.in-call ? 0.4 : 1);
                    background: video-t.pressed ? root.fg.with-alpha(0.10)
                              : video-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.videoOn; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    video-t := TouchArea { clicked => { if (!root.in-call) { root.start-call(true); } } }
                }
                if !root.call-here && !root.is-thread && !root.is-invite : Rectangle {
                    x: phone-bar.width - 168px + phone-bar.dx; y: 6px;
                    width: 48px; height: 48px; border-radius: 24px;
                    opacity: phone-bar.tail * (root.in-call ? 0.4 : 1);
                    background: call-t.pressed ? root.fg.with-alpha(0.10)
                              : call-t.has-hover ? root.fg.with-alpha(0.06) : transparent;
                    IconLabel { text: Icons.phone; filled: true; color: root.fg; font-size: 24px; width: 100%; height: 100%; }
                    call-t := TouchArea { clicked => { if (!root.in-call) { root.start-call(false); } } }
                }
                // A live call in this room: the Join chip before the ⋮.
                join-pill := Rectangle {
                    visible: root.call-here && !root.is-thread;
                    x: phone-bar.width - 64px - self.width + phone-bar.dx;
                    y: 16px;
                    width: join-row-p.preferred-width + 22px;
                    height: 28px; border-radius: 14px;
                    opacity: phone-bar.tail;
                    background: root.accent.with-alpha(0.9);
                    join-row-p := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        IconLabel { text: Icons.phone; filled: true; color: #141414; font-size: Theme.caption; vertical-alignment: center; }
                        Text { text: "Join"; color: #141414; font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.join-call(); } }
                }
            }
        }

        // Invite banner (:1061-1062): "Accept invite" bordered, "Decline" a
        // bare urgent label; centred at spacing 10 in a 52px accent@0.1 band.
        if root.is-invite : invite-bar := Rectangle {
            x: 0; y: root.header-h; width: 100%;
            height: 52px;
            background: Theme.accent.with-alpha(0.1);
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                padding-top: 8px; padding-bottom: 8px;   // 36px buttons centred in 52
                SButton { text: "Accept invite"; foreground: root.fg; bordered: true; clicked => { root.accept-invite(); } }
                SButton { text: "Decline"; foreground: Theme.urgent; bordered: false; clicked => { root.decline-invite(); } }
            }
        }

        // Conversation ground: rounded top corners revealing the header tone,
        // 22px bottom corners unconditionally (:923).
        // Until the sheet arrives the home sheet's ground stands under the
        // header (the page opens over home); the convo covers it at rest.
        if root.phone && root.open-t < 1 : Rectangle {
            x: 0; y: root.sheet-y; width: 100%;
            height: root.height - root.sheet-y;
            // Over the thread browser it is the browser's ground standing
            // there instead — the room's, the very tone this page's own sheet
            // is about to paint, so only the rows change.
            background: root.over-threads ? root.convo-paint : Theme.card-ground;
            border-top-left-radius: 28px; border-top-right-radius: 28px;
        }
        convo := Rectangle {
            x: 0; width: 100%;
            height: root.height - root.sheet-y;
            // The phone's sheet rises from the page bottom (open-t).
            y: root.sheet-y + (root.height - root.sheet-y) * (1 - root.open-e);
            // The composite, painted flat, rather than convo-c at 0.94 over
            // the page ground: the same colour on screen to the level, but a
            // colour the composer band can then name and match EXACTLY —
            // convo-paint at any alpha over convo-paint is convo-paint.
            background: root.convo-paint;
            // The phone keeps the platform messenger's sheet: rounded where it
            // meets the header, square at the bottom, the composer and the
            // gesture zone on the same ground.
            border-top-left-radius: Theme.dbg-no-convo-clip ? 0px : root.phone ? 28px : 24px;
            border-top-right-radius: Theme.dbg-no-convo-clip ? 0px : root.phone ? 28px : 24px;
            border-bottom-left-radius: root.phone ? 0px : 22px;
            border-bottom-right-radius: root.phone ? 0px : 22px;
            clip: true;

            // 46px highlight across the rounded top (ChatPage.qml:966).
            top-sheen := Rectangle {
                x: 0; y: 0; width: 100%; height: 46px;
                background: @linear-gradient(180deg,
                    Theme.menu-background.brighter(0.35).with-alpha(0.3) 0%,
                    transparent 100%);
            }

            // The timeline runs the whole height above the panels, and the
            // composer band floats over its bottom. That placement is the
            // whole of the composer's translucency: stacked in a column the
            // list stopped exactly where the band began, so nothing of the
            // conversation was ever behind the band and any alpha on it just
            // blended the convo ground with itself — invisible, however low
            // the alpha went. The band's room is given back as padding at the
            // end of the list instead, so the newest message still rests
            // above it and older ones pass under it as they scroll.
            list := TouchList {
                x: 0; y: 0; width: 100%;
                // The list runs on under BOTH panels — their ground is the
                // footer's now, translucent, and there has to be a
                // conversation behind them for that to show — and gives their
                // room back as end padding, exactly as it does the band's.
                height: convo.height;
                // BottomToTop: short conversations hang from the composer.
                content-alignment: end;
                // Media/doc/map cards inflate row heights asynchronously;
                // while the user is at the bottom, stay at the bottom.
                property <bool> stick: true;
                // Not while the sheet holds the list: its padding changes the
                // viewport on purpose, and the bubble must stay put.
                changed viewport-height => {
                    if (self.stick && !sheet.shown) { root.pin-list(); }
                }
                // The panels below take their room from the list: keep
                // the bottom pinned as it shrinks or grows.
                changed height => {
                    root.vp-h = self.height;
                    if (self.stick && !sheet.shown) { root.pin-list(); }
                }
                init => { root.vp-h = self.height; root.vp-y = self.viewport-y; }
                // A drag on the conversation puts the open panel away — the
                // attachment sheet, the picker, the recorder — and the composer
                // goes back to the bottom while the list carries on scrolling.
                // Reaching past the panel to read is asking for the panel to be
                // gone, and the reference answers it that way.
                //
                // `flicked` is what makes this safe to hang off the list at
                // all: Slint fires it for a finger or a wheel and never for an
                // offset written from code, so the pin that follows the panel's
                // own opening — and the jump, and the bridge's restore — cannot
                // trip it. `list-vy` banks every one of those anyway, and 8 of
                // slack on top rejects the jitter of a press that barely moved.
                flicked => {
                    if ((root.attach-open || root.recorder-open)
                        && abs((self.viewport-y - root.list-vy) / 1px) > 8) {
                        root.attach-open = false;
                        root.recorder-open = false;
                    }
                }
                // Fetch older history a screen and a half early (maybePaginate).
                changed viewport-y => {
                    root.vp-y = self.viewport-y;
                    list.stick = root.from-end < 12px;
                    if (self.viewport-y > -1.5 * self.height
                        && root.pagination-state == "idle"
                        && self.viewport-height > self.height) {
                        root.paginate();
                    }
                    if (root.from-end < 4px) { root.maybe-mark-read(); }
                }
                // ListView footer (the oldest end): 8px of breathing room,
                // or the 34px pagination spinner in its place (:1198-1201).
                footer := Rectangle {
                    height: root.pagination-state == "paginating" ? 34px : 8px;
                    if root.pagination-state == "paginating" : Spinner {
                        x: (footer.width - self.width) / 2;
                        y: (34px - self.height) / 2;
                        spin-color: root.fg.with-alpha(0.5);
                        size: Theme.body;
                    }
                }
                // Each row is the bubble in a wrapper that can travel: drag a
                // message AWAY from its own edge to reply, TOWARDS it to reply
                // in a thread. The gesture lives here rather than in the
                // bubble because it is the whole row that moves — day stamp,
                // sender line, reactions and all — and because the affordance
                // has to be drawn in the space the row leaves behind it.
                for item in root.items : row := Rectangle {
                    // Virtualised: a row carries a live Bubble only while it
                    // stands within a screen and a half of the viewport, and
                    // holds its last measured height as a bare slot otherwise.
                    // Every loaded row fully instantiated was the per-frame
                    // cost on the phone — a frame walked forty bubbles' items
                    // whether or not they were on screen, and grew with every
                    // page of history. `near` is measured against `row.y`
                    // (the rows above) and the remembered height, never this
                    // row's live height, or the two would chase each other.
                    // The row's height is a plain number the live half writes
                    // from its `changed height` (never a binding on `live`):
                    // that is what keeps `near` free to read the layout's own
                    // `y` and the list's viewport without a loop.
                    property <length> known-h: 0px;
                    property <bool> near: row.y + max(row.known-h, 1px) > -list.viewport-y - 1.5 * list.height
                        && row.y < -list.viewport-y + 2.5 * list.height;
                    property <bool> live: row.near || row.known-h == 0px;
                    height: row.known-h;
                    // a narrower or wider list rewraps every message: measure again
                    changed width => { row.known-h = 0px; }
                    /// This row's bubble is the one the sheet holds: it lifts
                    /// out of its slot by the sheet's `lift` and floats over
                    /// its neighbours. NOTHING else moves — not the list, not
                    /// the rows around it, which stay exactly where they are,
                    /// dimmed under the scrim. Rows are drawn in order, so a
                    /// bubble lifting UP (the usual case: a recent message
                    /// making room for its menu) lies over the rows above it
                    /// by itself.
                    property <bool> held: sheet.shown && item.event-id != "" && sheet.item.event-id == item.event-id;
                    changed held => { if (self.held) { root.held-y = self.y; } }
                    /// How far this row's bubble is carried by the sheet.
                    property <length> carry: sheet.shown && self.held ? sheet.lift : 0px;
                    // The harness's long-press: the named row fires its own
                    // menu, with its own rectangle, as a finger would.
                    property <bool> press-me: root.debug-press-id != "" && root.debug-press-id == item.event-id;
                    // A real message only, and not one still on its way out.
                    property <bool> swipeable: root.phone && item.event-id != ""
                        && item.kind != "state" && item.kind != "dayDivider"
                        && !item.is-read-marker
                        && item.send-state != "sending" && item.send-state != "failed";
                    // Matrix has no nested threads: inside one there is nowhere
                    // for the towards-the-edge drag to go.
                    property <bool> can-thread: row.swipeable && !root.is-thread;
                    // The sheet offers Reply for every message it is built for
                    // (actions.rs build_sheet), so the gesture does too: one
                    // path means the same answer to the same question.
                    property <bool> can-answer: row.swipeable;
                    // Theirs hugs the left, so right is away from its edge and
                    // left is towards it; ours hugs the right, so the two are
                    // the other way about.
                    property <bool> allow-right: item.is-own ? row.can-thread : row.can-answer;
                    property <bool> allow-left: item.is-own ? row.can-answer : row.can-thread;
                    /// How far the row stands from home. The gesture assigns it,
                    /// so while `tracking` it follows the finger with no
                    /// animation at all and springs back once it is let go.
                    property <length> off: 0px;
                    property <bool> tracking: false;
                    animate off {
                        duration: row.tracking ? 0ms : 240ms;
                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                    }
                    /// Past the detent: the affordance is lit and letting go acts.
                    property <bool> past: false;
                    /// The finger's travel, resisted: one pixel for one up to
                    /// the detent, 0.42 of each one after it, and never past
                    /// the limit.
                    pure function resist(d: length) -> length {
                        return abs(d / 1px) <= root.swipe-detent-at / 1px
                            ? d
                            : (d > 0px ? 1px : -1px)
                              * min(root.swipe-limit / 1px,
                                    root.swipe-detent-at / 1px
                                    + (abs(d / 1px) - root.swipe-detent-at / 1px) * 0.42);
                    }
                    /// The finger's travel across, from the recogniser (which
                    /// lives in the row's live half and hands the number up).
                    function follow(dx: length) {
                        row.tracking = true;
                        row.off = row.resist(dx);
                        if (abs(row.off / 1px) >= root.swipe-detent-at / 1px) {
                            if (!row.past) { row.past = true; root.swipe-detent(); }
                        } else if (row.past) {
                            row.past = false;
                        }
                    }
                    function spring-home() {
                        row.tracking = false;
                        row.off = 0px;
                        row.past = false;
                    }
                    function commit() {
                        // One path, the message sheet's own: "Reply" arms the
                        // composer, "Reply in thread" is open-thread.
                        if (row.past) {
                            if ((row.off > 0px) == !item.is-own) {
                                root.arm-reply(item.event-id, item.sender-name, item.body);
                            } else {
                                root.open-thread(item.event-id);
                            }
                        }
                        row.spring-home();
                    }
                    // The live half of the row: the bubble, its swipe
                    // recogniser and its affordance, standing only while the
                    // row is near. Its height is what the row stands at while
                    // it lives, and what the row remembers after it goes.
                    if row.live : holder := Rectangle {
                    x: 0; width: 100%;
                    height: bub.height;
                    changed height => { if (self.height > 0px) { row.known-h = self.height; } }
                    init => { if (self.height > 0px) { row.known-h = self.height; } }
                    // The harness's long-press: the named row fires its own
                    // menu, with its own rectangle, as a finger would.
                    property <bool> press-me: row.press-me;
                    changed press-me => {
                        if (self.press-me) { bub.open-menu(); root.debug-press-id = ""; }
                    }
                    /// Everything `col` stacks above the bubble inside the row
                    /// (bubble.slint:228-306), so the affordance can be centred
                    /// on the bubble rather than on the row.
                    property <length> extras:
                          (item.day-label != "" ? 30px : 0px)
                        + (item.is-read-marker ? 20px : 0px)
                        + ((item.show-header && !root.is-dm && !item.is-own) ? 28px : 0px)
                        + (item.group-start ? 10px : 3px)
                        + max(item.reactions.length > 0 ? 13px : 0px, item.pinned ? 4px : 0px);
                    /// …and the mark line `col` stacks below it (:1780-1788),
                    /// so the bubble is the band between the two.
                    property <length> trail:
                        (item.is-own && (item.owns-receipt || item.send-state != "sent"))
                        || bub.details-open
                        ? (root.phone ? 32px : 17px) : 0px;
                    // The affordance rides in from whichever screen edge the
                    // row is heading for, keeping the measured 20px clear of
                    // the bubble's travelling edge — so it needs no bubble
                    // width, only the 14px margin `col` holds either side.
                    if row.off != 0px : disc := Rectangle {
                        x: row.off > 0px
                            ? 14px + row.off - root.swipe-gap - root.swipe-disc
                            : row.width - 14px + root.swipe-gap + row.off;
                        y: holder.extras
                            + (holder.height - holder.extras - holder.trail - root.swipe-disc) / 2;
                        width: root.swipe-disc; height: root.swipe-disc;
                        border-radius: root.swipe-disc / 2;
                        background: root.fg.with-alpha(0.92);
                        opacity: clamp(abs(row.off / 1px) / 46, 0.0, 1.0);
                        transform-origin: { x: root.swipe-disc / 2, y: root.swipe-disc / 2 };
                        transform-scale-x: row.past ? 1.0 : 0.86;
                        transform-scale-y: row.past ? 1.0 : 0.86;
                        animate transform-scale-x, transform-scale-y {
                            duration: 160ms; easing: ease-out-back;
                        }
                        IconLabel {
                            width: 100%; height: 100%;
                            text: (row.off > 0px) == !item.is-own ? Icons.reply : Icons.thread;
                            filled: true;
                            color: Theme.background;
                            font-size: 22px;
                        }
                    }
                    // The recogniser forwards presses to the bubble (so taps,
                    // long-presses and every inner control still work) and only
                    // takes over once the drag has gone 8px across, at which
                    // point the bubble is sent an Exit and its hold is off. It
                    // is the Flickable's own filter that decides a vertical
                    // drag instead, so the two never fight — see the SIGIL
                    // PATCH in vendor/i-slint-core/items/flickable.rs.
                    swipe := SwipeGestureHandler {
                        enabled: row.allow-left || row.allow-right;
                        handle-swipe-left: row.allow-left;
                        handle-swipe-right: row.allow-right;
                        // `moved` also fires below the recogniser's threshold,
                        // while the drag could still turn into a scroll.
                        moved => {
                            if (self.swiping) {
                                row.follow(self.current-position.x - self.pressed-position.x);
                            }
                        }
                        swiped => { row.commit(); }
                        cancelled => { row.spring-home(); }
                        bub := Bubble {
                            x: row.off;
                            // the held bubble moves, and pushes its neighbours; the list does not
                            y: row.carry;
                            width: row.width;
                            item: item;
                            fx-clock: root.fx-clock;
                            // a screen's height of slack either side keeps entries smooth
                            on-screen: row.y + row.height > -list.viewport-y - list.height
                                && row.y < -list.viewport-y + 2 * list.height;
                            boot-epoch-s: root.boot-epoch-s;
                            now-epoch-s: root.now-epoch-s;
                            fg: root.fg;
                            accent: root.accent;
                            dm: root.is-dm;
                            encrypted: root.room-encrypted;
                            convo-ground: root.convo-c;
                            menu-requested(it, r) => { root.open-menu-for(it, r); }
                            reply-requested(e, n, b) => { root.arm-reply(e, n, b); }
                            open-image(it) => { root.open-image(it); }
                            play-video(it) => { root.play-video(it); }
                            open-document(it) => { root.open-document(it); }
                            open-contact(it) => { root.open-contact(it); }
                            contact-save(u, n, saved) => { root.contact-save(u, n, saved); }
                            contact-share(u, n) => { root.contact-share(u, n); }
                            copy-text(t) => { root.copy-text(t); }
                            spoiler-revealed(id) => { root.spoiler-revealed(id); }
                            // a themed room tints the bubbles too (BubbleDelegate.qml:39)
                            theme-surface: root.themed ? root.surface-c : transparent;
                            open-audio(it) => { root.open-audio(it); }
                            open-location(it) => { root.open-location(it); }
                            open-link(it) => { root.open-link(it.link-url); }
                            open-url(l) => { root.open-link(l); }
                            open-thread(id) => { root.open-thread(id); }
                            react(id, key) => { root.react(id, key); }
                            voice-toggled(id) => { root.voice-toggled(id); }
                            voice-seeked(id, pos) => { root.voice-seeked(id, pos); }
                            vote(id, opt) => { root.vote(id, opt); }
                        }
                    }
                    }
                }
                // 8px of breathing room, plus the room the floating
                // composer band and typing row take out of the view.
                Rectangle { height: 8px + root.composer-h + root.panel-h + typing-row.height; }
            }

            // Typing indicator (TypingIndicator.qml): folds 0↔38 over 180ms
            // OutCubic while fading over 160ms; always instantiated so the
            // fold can play. The last typer stays for the fade-out.
            typing-row := Rectangle {
                property <bool> active: root.typing-line != "";
                x: 0; width: 100%;
                y: convo.height - root.panel-h - root.composer-h - self.height;
                height: self.active ? 38px : 0px;
                animate height { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                opacity: self.active ? 1 : 0;
                animate opacity { duration: 160ms; }
                clip: true;
                changed height => { if (list.stick) { root.pin-list(); } }
                property <image> shown-avatar;
                property <string> shown-initials;
                property <color> shown-tint: Theme.accent;
                function remember() {
                    if (root.typing-line != "") {
                        self.shown-avatar = root.typing-avatar;
                        self.shown-initials = root.typing-initials;
                        self.shown-tint = root.typing-tint;
                    }
                }
                changed active => { self.remember(); }
                init => { self.remember(); }
                typing-body := Rectangle {
                    x: 0; y: (typing-row.height - 38px) / 2;
                    width: 100%; height: 38px;
                    HorizontalLayout {
                        alignment: start;
                        padding-left: 14px;
                        spacing: 7px;
                        Rectangle {
                            width: 22px;
                            Avatar {
                                x: 0; y: (38px - 22px) / 2;
                                size: 22px;
                                source: typing-row.shown-avatar;
                                initials: typing-row.shown-initials;
                                tint: typing-row.shown-tint;
                            }
                        }
                        // The dots' 30px container is dots.width + 6 (:42):
                        // 3px each side, so avatar→first dot is 10px.
                        Rectangle {
                            width: 3 * 6px + 2 * 5px + 6px;
                            dots := Rectangle {
                                x: 0; y: (38px - 30px) / 2;
                                width: 100%; height: 30px;
                                HorizontalLayout {
                                    padding-left: 3px; padding-right: 3px;
                                    spacing: 5px;
                                    // 900ms cycle: pause i×140, 220 up (OutQuad),
                                    // 260 down (InQuad), rest (TypingIndicator.qml:58-65).
                                    for di in [0, 1, 2] : Rectangle {
                                        width: 6px;
                                        dot := Rectangle {
                                            // only while shown: a live animation-tick() here
                                            // re-rendered every chat at frame rate forever
                                            property <float> t: typing-row.active ? (animation-tick() / 900ms + 3.0 - di * 0.15556).mod(1.0) : 0.0;
                                            property <float> lift: self.t < 0.2444
                                                ? 1 - (1 - self.t / 0.2444) * (1 - self.t / 0.2444)
                                                : self.t < 0.5333
                                                    ? 1 - ((self.t - 0.2444) / 0.2889) * ((self.t - 0.2444) / 0.2889)
                                                    : 0;
                                            x: 0; y: (30px - 6px) / 2 - 4px * self.lift;
                                            width: 6px; height: 6px; border-radius: 3px;
                                            background: root.fg.with-alpha(0.55);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Composer — its own tinted band over the convo ground, hidden
            // entirely on an invite (ChatPage.qml:1223). Row margins 10
            // left/right, 10 below, 8 above (:1366-1370).
            composer := Rectangle {
                x: 0; width: 100%;
                // Straight on top of whichever panel is open, and standing off
                // the screen's bottom edge by `foot-h` — max(keyboard, panel)
                // — whatever is providing it. That is the one number this
                // whole arrangement exists for: the band's y does not change
                // when the keyboard hands over to a panel, or a panel to
                // another panel, because the two are the same height.
                y: convo.height - root.panel-h - root.composer-h;
                height: root.composer-h;
                visible: !root.is-invite;
                // The conversation's own ground, translucent: over the
                // empty convo it composites back to exactly the ground
                // above it, over a bubble it lets the bubble through.
                background: root.convo-paint.with-alpha(root.band-alpha);
                // The band lies over the timeline now, so it swallows
                // what lands on it: a drag on the composer must not flick
                // the conversation. First child, so the pill, the toggle
                // and the disc still take their own taps.
                band-t := TouchArea { }
                // The phone's pill and disc arrive from below the page
                // once the sheet has (footer-t); the band stays put.
                composer-body := Rectangle {
                x: 0; width: 100%; height: composer.height;
                y: root.phone ? composer.height * (1 - root.footer-e) : 0px;
                // inputPill: fill only, no focus border, radius 19; parent
                // minus the send disc and the 8px spacing.
                well := Rectangle {
                    x: root.phone ? 8px : 10px; y: 8px;
                    width: composer.width - self.x - root.disc - 8px - (root.phone ? 8px : 10px);
                    height: root.well-h;
                    border-radius: root.phone ? 28px : 19px;
                    // Opaque: the same tone the old 7 % ink wash made over the
                    // band, composited here once, so the timeline never shows
                    // through the input while the band around it is translucent.
                    background: root.themed ? root.surface-c : root.convo-paint.mix(root.fg, 0.93);

                    // Voice clip chip: a light card inset in the pill. Always
                    // instantiated (visibility-gated) so the wave's width is
                    // readable for clip-wave-bars.
                    clip-chip-band := Rectangle {
                        visible: root.voice-staged;
                        x: 0; y: 0;
                        width: well.width; height: root.quote-h;
                        clip-chip := Rectangle {
                            x: root.chip-pad; y: root.chip-pad;
                            width: clip-chip-band.width - 2 * root.chip-pad;
                            height: root.chip-h;
                            border-radius: root.chip-r;
                            property <color> ink: #17181a;
                            background: root.accent.brighter(0.35);
                            clip-play := Rectangle {
                                x: root.chip-pad - 1px; y: (root.chip-h - 32px) / 2;
                                width: 32px; height: 32px; border-radius: 16px;
                                background: #ffffff.with-alpha(0.9);
                                IconLabel {
                                    text: root.clip-playing ? Icons.pause : Icons.play;
                                    font-size: Theme.icon-size;   // ChatPage.qml:1559 size: Style.font.icon
                                    color: #1a1a1a;
                                    width: 100%; height: 100%;
                                }
                                TouchArea { clicked => {
                                    root.clip-playing = !root.clip-playing;
                                    root.voice-preview(root.clip-playing);
                                } }
                            }
                            clip-wave := Rectangle {
                                x: root.chip-pad + 41px; y: (root.chip-h - 26px) / 2;
                                width: clip-dur.x - self.x - 8px;
                                height: 26px;
                                clip: true;
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 2px;
                                    for amp[i] in root.voice-staged-wave : Rectangle {
                                        width: 3px;
                                        Rectangle {
                                            x: 0; y: (26px - self.height) / 2;
                                            width: 3px;
                                            height: max(4px, round(22 * min(1.0, amp)) * 1px);
                                            border-radius: 1.5px;
                                            // Played bars are solid, the rest 0.4 (:1594-1595).
                                            background: (i * 1.0) / max(1, root.voice-staged-wave.length) <= root.clip-frac
                                                ? clip-chip.ink.with-alpha(0.95) : clip-chip.ink.with-alpha(0.4);
                                        }
                                    }
                                }
                                // A tap seeks by x fraction and plays from there (:1600-1610).
                                wave-t := TouchArea { clicked => {
                                    root.clip-playing = true;
                                    root.clip-seek(max(0.0, min(1.0, self.mouse-x / clip-wave.width)));
                                } }
                            }
                            clip-dur := Text {
                                x: clip-close.x - self.preferred-width - 8px;
                                height: 100%;
                                text: root.voice-staged-duration;
                                color: clip-chip.ink.with-alpha(0.85);
                                font-family: Theme.font-ui; font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                            clip-close := Rectangle {
                                x: clip-chip.width - 26px - 8px;
                                y: (root.chip-h - 26px) / 2;
                                width: 26px; height: 26px; border-radius: 13px;
                                background: clip-chip.ink.with-alpha(0.12);
                                IconLabel {
                                    text: Icons.close; color: clip-chip.ink;
                                    font-size: Theme.body-small;
                                    width: 100%; height: 100%;
                                }
                                TouchArea { clicked => {
                                    root.clip-playing = false;
                                    root.voice-staged = false;
                                    root.voice-discard();
                                } }
                            }
                        }
                    }
                    // Reply/edit quote lives INSIDE the input surface: a 52px
                    // block whose card is inset 5px, close button inside the
                    // card at the right (ChatPage.qml:1630).
                    if root.quote-armed && !root.voice-staged : quote := Rectangle {
                        x: 0; y: 0;
                        width: well.width; height: root.quote-h;
                        quote-box := Rectangle {
                            x: root.chip-pad; y: root.chip-pad;
                            width: quote.width - 2 * root.chip-pad;
                            height: root.chip-h;
                            border-radius: root.chip-r;
                            background: root.convo-c.with-alpha(0.92);
                            VerticalLayout {
                                // Text ends 6px before the 26px close at 8 (:1641,:1649).
                                padding-left: 12px; padding-right: 40px;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: root.caption-of != ""
                                        ? (root.reply-body != "" ? "Edit caption" : "Add caption")
                                        : root.edit-of != "" ? "Edit message" : root.reply-name;
                                    color: root.fg;
                                    font-family: Theme.font-ui; font-size: Theme.body-small; font-weight: 700;
                                    overflow: elide;
                                }
                                if root.reply-body != "" : Text {
                                    text: root.reply-body;
                                    color: root.fg.with-alpha(0.6);
                                    font-family: Theme.font-ui; font-size: Theme.caption;
                                    overflow: elide;
                                }
                            }
                            quote-close := Rectangle {
                                x: quote-box.width - self.width - 8px;
                                y: (root.chip-h - 26px) / 2;
                                width: 26px; height: 26px; border-radius: 13px;
                                background: qc-t.has-hover ? root.fg.with-alpha(0.12) : transparent;
                                IconLabel {
                                    text: Icons.close; color: root.fg;
                                    font-size: Theme.body-small;
                                    width: 100%; height: 100%;
                                }
                                qc-t := TouchArea {
                                    clicked => {
                                        root.reply-to = ""; root.edit-of = ""; root.caption-of = "";
                                        root.reply-name = ""; root.reply-body = "";
                                        composer-input.text = "";
                                    }
                                }
                            }
                        }
                    }
                    // The attach toggle: 30×30 at the pill's left 6, 4 above
                    // its bottom (:1656-1661); the cancel affordance while the
                    // sheet is open — glyph swap + 90° turn, colour on hover/on.
                    attach-btn := Rectangle {
                        x: root.phone ? 0px : 6px; y: well.height - root.attach-box - (root.phone ? 3px : 4px);
                        width: root.attach-box; height: root.attach-box;
                        IconLabel {
                            x: 0; y: 0; width: root.attach-box; height: root.attach-box;
                            text: root.attach-open ? Icons.cancel : Icons.plusCircle;
                            filled: root.attach-open;
                            transform-origin: { x: root.attach-box / 2, y: root.attach-box / 2 };
                            transform-rotation: root.attach-open ? 90deg : 0deg;
                            animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                            color: at-t.has-hover || root.attach-open ? #c6c6c6 : #c6c6c6.with-alpha(0.85);
                            animate color { duration: 140ms; }
                            font-size: Theme.icon-large;
                        }
                        at-t := TouchArea { clicked => { root.toggle-attach(); } }
                    }
                    // The text: left inset 38 (6 + 30 + 2), right 10 (:1690-1691),
                    // below the quote band; grows with the text and scrolls
                    // past the 110px cap (:1688-1694).
                    input-box := Rectangle {
                        x: root.phone ? 50px : 38px; y: root.quote-h;
                        width: well.width - self.x - (root.phone ? 16px : 10px);
                        height: well.height - root.quote-h;
                        clip: true;
                        input-flick := Flickable {
                            x: 0; y: 0;
                            width: input-box.width; height: input-box.height;
                            viewport-width: self.width;
                            viewport-height: max(self.height, composer-input.preferred-height + 6px);
                            // Shrinking text must not leave the view past its end.
                            changed viewport-height => {
                                self.viewport-y = max(min(0px, self.height - self.viewport-height), min(0px, self.viewport-y));
                            }
                            composer-input := TextInput {
                                x: 0; y: 3px;
                                width: input-flick.width;
                                height: input-flick.viewport-height - 6px;
                                // Transparent while the preview stands in for it:
                                // the text and its caret are drawn by the cells
                                // below, at their settled places. The selection
                                // highlight keeps its own colour.
                                color: root.cp-live ? transparent : root.fg;
                                font-family: Theme.font-ui; font-size: Theme.body;
                                vertical-alignment: center;
                                single-line: false;
                                wrap: word-wrap;
                                edited => { root.composer-edited(self.text); }
                                // The keyboard rising for the composer takes the
                                // bottom of the page: a panel up there closes.
                                changed has-focus => {
                                    if (self.has-focus) {
                                        // A panel standing there does NOT go
                                        // yet: it holds its height until the
                                        // rising keyboard has covered it, and
                                        // is dropped behind it then (root's
                                        // `handover`). Closing it here would
                                        // put a falling panel against a rising
                                        // keyboard, and the composer would sag
                                        // between the two.
                                        if (root.attach-open || root.recorder-open) {
                                            root.handover = true;
                                            // Already covered — the panel was
                                            // sitting behind a keyboard that
                                            // is still up. Nothing to wait for.
                                            if (root.kb-inset >= root.panel-h) {
                                                root.end-handover(true);
                                            }
                                        }
                                    }
                                }
                                // Keep the caret in view once the text scrolls.
                                cursor-position-changed(p) => {
                                    if (p.y + 3px + 18px > -input-flick.viewport-y + input-flick.height) {
                                        input-flick.viewport-y = -(p.y + 3px + 18px - input-flick.height);
                                    } else if (p.y + 3px < -input-flick.viewport-y) {
                                        input-flick.viewport-y = -(p.y + 3px);
                                    }
                                    root.composer-cursor-moved(self.cursor-position-byte-offset);
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        root.submit();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                        // The live preview over the (transparent) input. Each
                        // cell slides from where it was typed to where it
                        // settles; a run's markup fades and shrinks into the
                        // place its content takes; a colour comes on as the
                        // cell lands. It scrolls with the input.
                        if root.cp-live : cp-layer := Rectangle {
                            x: 0; y: 3px + input-flick.viewport-y;
                            width: input-box.width; height: input-flick.viewport-height;
                            for c in root.cp-cells : Text {
                                text: c.ch;
                                x: c.from-x + (c.to-x - c.from-x) * root.collapse-e;
                                y: c.from-y + (c.to-y - c.from-y) * root.collapse-e;
                                color: c.gone ? root.fg.with-alpha(1 - root.collapse-e)
                                    : c.has-color ? root.fg.mix(c.color, 1 - root.collapse-e)
                                    : root.fg;
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui;
                                font-size: c.gone ? Theme.body * (1 - 0.5 * root.collapse-e) : c.size;
                                font-weight: c.bold ? 700 : 400;
                                font-italic: c.italic;
                            }
                            // The caret, at its settled place, on a slow blink
                            // while the run finishes landing.
                            Rectangle {
                                x: root.cp-caret-fx + (root.cp-caret-x - root.cp-caret-fx) * root.collapse-e;
                                y: root.cp-caret-fy + (root.cp-caret-y - root.cp-caret-fy) * root.collapse-e + 2px;
                                width: 2px; height: Theme.body * 1.15;
                                background: root.accent;
                                opacity: composer-input.has-focus ? 1.0 : 0.0;
                            }
                        }
                        if composer-input.text == "" : Text {
                            x: 0; y: 0;
                            height: input-box.height;
                            text: root.voice-staged ? "Add text" : "Message";
                            color: root.fg.with-alpha(0.45);
                            font-family: Theme.font-ui; font-size: Theme.body;
                            vertical-alignment: center;
                        }
                    }
                }
                // Empty composer → voice button; otherwise send. 38×38 r19,
                // 10 above the band's bottom (:1752). The two glyphs cross-
                // fade (130ms) while scaling 0.55→1 with an OutBack overshoot
                // (180ms); send also turns in from -35° (:1757-1780).
                send-btn := Rectangle {
                    property <bool> send-mode: composer-input.text != "" || root.voice-staged;
                    x: composer.width - (root.phone ? 8px : 10px) - root.disc;
                    // The same inset the band itself reserves: none of the
                    // gesture bar's while a panel is open below (the disc
                    // stood a bar's height above the input otherwise).
                    y: composer.height - root.disc - (root.phone ? 8px : 10px) - root.composer-inset;
                    width: root.disc; height: root.disc; border-radius: root.disc / 2;
                    background: root.send-c;
                    animate background { duration: 120ms; }
                    send-glyph := IconLabel {
                        x: 0; y: 0; width: root.disc; height: root.disc;
                        text: Icons.send;
                        filled: true;   // ChatPage.qml:1768 Fonts.iconFilled
                        color: Theme.background;
                        font-size: Theme.icon-large;
                        opacity: send-btn.send-mode ? 1 : 0;
                        animate opacity { duration: 130ms; }
                        visible: send-btn.send-mode || self.opacity > 0.01;
                        transform-origin: { x: root.disc / 2, y: root.disc / 2 };
                        // Qt OutBack overshoot 2.0 ≈ Slint's ease-out-back (1.56).
                        transform-scale-x: send-btn.send-mode ? 1 : 0.55;
                        transform-scale-y: send-btn.send-mode ? 1 : 0.55;
                        animate transform-scale-x, transform-scale-y { duration: 180ms; easing: ease-out-back; }
                        transform-rotation: send-btn.send-mode ? 0deg : -35deg;
                        animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    }
                    voice-glyph := IconLabel {
                        x: 0; y: 0; width: root.disc; height: root.disc;
                        text: Icons.voiceMemo;
                        filled: true;   // ChatPage.qml:1779 Fonts.iconFilled
                        color: Theme.background;
                        font-size: Theme.icon-large;
                        opacity: send-btn.send-mode ? 0 : 1;
                        animate opacity { duration: 130ms; }
                        visible: !send-btn.send-mode || self.opacity > 0.01;
                        transform-origin: { x: root.disc / 2, y: root.disc / 2 };
                        transform-scale-x: send-btn.send-mode ? 0.55 : 1;
                        transform-scale-y: send-btn.send-mode ? 0.55 : 1;
                        animate transform-scale-x, transform-scale-y { duration: 180ms; easing: ease-out-back; }
                    }
                    send-t := TouchArea {
                        clicked => {
                            if (!send-btn.send-mode) { root.toggle-recorder(); return; }
                            root.submit();
                        }
                    }
                }
                }   // composer-body
            }

            // The attachment sheet, inline under the composer (:1795-1820).
            // The FRAME's height animates as a wipe (220ms OutCubic) while
            // the sheet keeps its natural size pinned to the frame's top;
            // the list re-pins to the bottom as the frame moves.
            att-frame := Rectangle {
                x: 0; width: 100%;
                // The footer's own ground behind the panel, at the footer's
                // alpha, over the timeline running beneath: the sheet's
                // opaque card stands on this, as the recorder's does.
                background: root.convo-paint.with-alpha(root.band-alpha);
                // The panel's foot rests on the screen's bottom edge, keyboard
                // or no keyboard — its ground runs on under the gesture bar,
                // and what is pinned to the bottom INSIDE it stands off by
                // `gesture-inset`. It does NOT lift by the keyboard: a panel
                // opened while the keyboard is up is the same height as the
                // keyboard, so it is exactly the strip the keyboard is
                // covering, and it simply waits there behind it. The composer
                // above stands off by `foot-h`, which is that one number
                // whichever of the two is providing it — so nothing moves as
                // one hands over to the other.
                y: convo.height - rec-frame.height - self.height;
                // The panel's height: the remembered keyboard's, or the whole
                // page below the composer once it has been taken up (the emoji
                // picker scrolled, the tile grid's handle dragged). The sheet
                // is laid out AT this height rather than clipped to it — a
                // page shorter than the keyboard has its own room to spend and
                // one taller (the tile grid under a shrunken keyboard) scrolls
                // inside what it got.
                // Held apart from `height` so it does NOT carry the open/close
                // wipe: the body keeps this size while the frame animates over
                // it, as the sheet always has, instead of squashing open and
                // shut.
                property <length> body-h: root.att-h;
                /// What the body is DRAWN at: `body-h` with the grow eased in.
                /// The frame's own wipe below runs on `body-h` direct and this
                /// runs beside it on the same curve, so the two move together
                /// when the body changes size (the picker growing takes the
                /// frame's top up under it) and only the frame moves when the
                /// panel opens and shuts. They must not be chained — a height
                /// animated TOWARDS an animated property never arrives: each
                /// tick restarts it on a target that has moved, and the frame
                /// settles at the value the body had when it began, which for
                /// an opening panel is zero.
                property <length> grown: self.body-h;
                // The grow (and the shrink back) is the body's, not the wipe's:
                // the picker keeps its foot on the screen edge and its grid
                // gets taller under a rising search row, rather than the whole
                // panel sliding up from under the fold. The grid's own offset
                // is untouched by it, so nothing the finger was on moves.
                animate grown {
                    duration: att.dragging ? 0ms : 220ms;
                    easing: cubic-bezier(0.33, 1, 0.68, 1);
                }
                height: root.is-invite ? 0px : root.attach-open ? self.body-h : 0px;
                // No easing while a finger is on the handle: a 220 tween
                // between one frame's height and the next's is exactly the lag
                // that makes a sheet feel unattached to the finger dragging it.
                animate height {
                    duration: (root.panel-instant || att.dragging) ? 0ms : 220ms;
                    easing: cubic-bezier(0.33, 1, 0.68, 1);
                }
                clip: true;
                changed height => { if (list.stick || root.attach-open) { root.pin-list(); } }
                att := AttachMenu {
                    x: 0; y: 0;
                    width: att-frame.width;
                    // The sheet IS the frame: it is laid out at the height the
                    // frame settles on rather than at a natural size the frame
                    // then crops, so a page shorter than the keyboard fills it
                    // and a taller one scrolls inside it.
                    avail: att-frame.grown;
                    // The two heights the sheet moves between: the keyboard's,
                    // where it rests, and the whole page below the composer.
                    // It answers with `want-h` — one of those, or wherever a
                    // finger on its handle currently has it — and decides for
                    // itself, from the two, whether there is anything to drag.
                    rest-h: root.att-rest;
                    full-h: root.panel-max;
                    // The attach sheet keeps its own opaque card ground: only
                    // the footer band and the voice panel are translucent.
                    // The gesture bar is the panel's own to stand off, from the
                    // inside: its ground runs on under it.
                    bottom-inset: root.gesture-inset;
                    // Shut, or showing another page: the tile grid's expansion
                    // latch goes with it, so the next visit opens at the
                    // keyboard's height again (as the picker's does).
                    active: root.attach-open;
                    fg: root.fg;
                    // The theme accent proper, not the darker send variant.
                    accent: root.accent;
                    surface: root.themed ? root.surface-c : root.fg.with-alpha(0.07);
                    chip: root.chip-c;
                    themed: root.themed;
                    stickers: root.stickers;
                    stickers-loaded: root.stickers-loaded;
                    sticker-dir: root.sticker-dir;
                    page <=> root.at-page;
                    lp-map: root.lp-map;
                    lp-unavailable: root.lp-unavailable;
                    lp-have-fix: root.lp-have-fix;
                    lp-lat: root.lp-lat;
                    lp-lon: root.lp-lon;
                    lp-error: root.lp-error;
                    lp-marked: root.lp-marked;
                    lp-mark-lat: root.lp-mark-lat;
                    lp-mark-lon: root.lp-mark-lon;
                    lp-tiles: root.lp-tiles;
                    lp-pin-x: root.lp-pin-x;
                    lp-pin-y: root.lp-pin-y;
                    my-avatar: root.my-avatar;
                    my-initials: root.my-initials;
                    my-tint: root.my-tint;
                    pick-files => { root.pick-attach-files(); }
                    pick-camera => { root.pick-attach-camera(); }
                    pick-gallery => { root.pick-attach-gallery(); }
                    pick-video => { root.pick-attach-video(); }
                    open-location(mode) => { root.attach-location(mode); }
                    loc-tap(x, y) => { root.attach-loc-tap(x, y); }
                    loc-zoom(d) => { root.attach-loc-zoom(d); }
                    loc-recentre => { root.attach-loc-recentre(); }
                    loc-retry => { root.attach-loc-retry(); }
                    share-location(la, lo, ms, mode) => { root.attach-loc-share(la, lo, ms, mode); }
                    loc-viewport(w, h) => { root.attach-loc-viewport(w, h); }
                    loc-panned(dx, dy) => { root.attach-loc-panned(dx, dy); }
                    loc-zoom-at(s, x, y) => { root.attach-loc-zoom-at(s, x, y); }
                    loc-pinch-begin => { root.attach-loc-pinch-begin(); }
                    loc-pinched(f, x, y) => { root.attach-loc-pinched(f, x, y); }
                    loc-pinch-end => { root.attach-loc-pinch-end(); }
                    insert-emoji(e) => { root.insert-emoji(e); }
                    create-poll(q, opts, closed, multi) => { root.create-poll(q, opts, closed, multi); }
                    send-sticker(i) => { root.send-sticker(i); }
                    load-stickers => { root.load-stickers(); }
                    load-emoji => { root.load-emoji(); }
                    close-requested => { root.attach-open = false; }
                    // The emoji page body: the one shared picker (AttachMenu.qml:398).
                    // It sizes itself to the FRAME, not to the sheet: when the
                    // keyboard cuts the frame short the sheet keeps its natural
                    // height and is clipped at the foot, so a picker filling the
                    // sheet would have its category bar cut off. 12 is the
                    // sheet's lead-in over the search row (attach.slint's
                    // emoji-slot, which the picker arrives through).
                    epicker := EmojiPicker {
                        // Placed, not left to the slot: an unplaced child of a
                        // Rectangle is CENTRED in Slint, so a picker shorter
                        // than the sheet floated down the middle of it and had
                        // its category bar cut off by the frame.
                        x: 0px; y: 0px;
                        width: 100%;
                        height: max(0px, att-frame.grown - 12px);
                        bottom-inset: root.gesture-inset;
                        // The picker is built whatever page the sheet is on and
                        // the sheet outlives a close, so this is what tells it
                        // it has been put away: its expansion latch goes with
                        // it and the next visit opens at the resting height.
                        active: root.attach-open && root.at-page == "emoji";
                        fg: root.fg;
                        accent: root.accent;
                        chip: root.chip-c;
                        rows: root.emoji-rows;
                        cat-rows: root.emoji-cat-rows;
                        picked(e) => { root.insert-emoji(e); }
                        search-edited(q) => { root.emoji-search(q); }
                    }
                }
            }

            // The voice recorder, likewise (:1822-1847).
            rec-frame := Rectangle {
                x: 0; width: 100%;
                y: convo.height - self.height;
                // The footer's own ground, at the footer's own alpha, over
                // the timeline running beneath: the recorder paints no
                // ground of its own, so without this the panel showed the
                // bare conversation — a different tone from the band above.
                background: root.convo-paint.with-alpha(root.band-alpha);
                height: root.is-invite ? 0px : root.recorder-open ? rec.height : 0px;
                // The same rule as the attach panel's (root.panel-instant).
                animate height {
                    duration: root.panel-instant ? 0ms : 220ms;
                    easing: cubic-bezier(0.33, 1, 0.68, 1);
                }
                clip: true;
                changed height => { if (list.stick || root.recorder-open) { root.pin-list(); } }
                rec := VoiceRecorder {
                    x: 0; y: 0;
                    // The remembered keyboard's height, floored by the pills
                    // row and a card worth looking at: the card is the only
                    // thing in the recorder's column with a stretch, so a short
                    // keyboard shrinks the card and leaves the pills and the
                    // level band exactly as they are.
                    avail: root.rec-h;
                    width: rec-frame.width;
                    fg: root.fg;
                    accent: root.send-c;
                    surface: root.themed ? root.surface-c : root.fg.with-alpha(0.07);
                    chip: root.chip-c;
                    // The page the recorder's card and pills sit ON — the
                    // conversation's own ground, OPAQUE. The composer band's
                    // alpha belongs to the band, which has the timeline behind
                    // it; the recorder has nothing behind it and derives its
                    // card and pills from this by lifting off it, so any alpha
                    // here would leak straight back through the card.
                    // The panel's ground is the footer's: the same paint at
                    // the same 80 %, with the timeline running on under it
                    // (the list extends beneath the recorder for exactly
                    // this). The card and the pills stay opaque on top.
                    ground: root.convo-paint.with-alpha(root.band-alpha);
                    bottom-inset: root.gesture-inset;
                    themed: root.themed;
                    state: root.rec-state;
                    elapsed: root.rec-elapsed;
                    clip-duration: root.rec-clip-duration;
                    levels: root.rec-levels;
                    clip-waveform: root.rec-clip-waveform;
                    record => { root.rec-record(); }
                    stop => { root.rec-stop(); }
                    restart => { root.rec-restart(); }
                    attach => { root.rec-attach(); }
                    cancelled => { root.rec-cancel(); root.recorder-open = false; }
                }
            }
        }
    }

    // Jump-to-latest (:1869-1884): bottom-centred 10 above the composer stack
    // once the gap below exceeds ¾ of a screen; springs in (220ms OutBack)
    // while fading (140ms).
    jump-btn := Rectangle {
        property <bool> shown: root.items.length > 0 && root.from-end > list.height * 0.75;
        property <float> s: self.shown ? 1.0 : 0.0;
        // Qt OutBack overshoot 2.2 ≈ Slint's ease-out-back.
        animate s { duration: 220ms; easing: ease-out-back; }
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 140ms; }
        visible: self.shown || self.s > 0.01;
        x: (root.width - 38px) / 2;
        y: root.panel-top - 10px - 38px;
        width: 38px; height: 38px; border-radius: 19px;
        transform-origin: { x: 19px, y: 19px };
        transform-scale-x: self.s;
        transform-scale-y: self.s;
        background: root.themed ? root.surface-c : Theme.popup-background;
        IconLabel {
            x: 0; y: 0; width: 38px; height: 38px;
            text: Icons.arrowDown;
            color: root.fg;
            font-size: Theme.icon-size;
        }
        TouchArea { clicked => { root.jump-to-latest(); } }
    }

    // The @/# autocomplete (:1252-1356): flush with the composer's top, full
    // width, top corners 20; an opaque convo ground with two white top
    // gradients (0.07/30px, 0.05/28px); 38px rows r11 with a 24px avatar at 8.
    ac-popup := Rectangle {
        visible: root.ac-items.length > 0;
        x: 0; width: root.width;
        height: root.ac-items.length * 38px + 12px;
        y: root.panel-top - self.height;
        border-top-left-radius: 20px; border-top-right-radius: 20px;
        clip: true;
        // Opaque, and the conversation ground's own colour: it stands on the
        // composer band's top edge, so it has to be the same tone as the band.
        background: root.convo-paint.with-alpha(1.0);
        Rectangle {
            x: 0; y: 0; width: 100%; height: 30px;
            background: @linear-gradient(180deg, #ffffff.with-alpha(0.07) 0%, transparent 100%);
        }
        Rectangle {
            x: 0; y: 0; width: 100%; height: 28px;
            background: @linear-gradient(180deg, #ffffff.with-alpha(0.05) 0%, transparent 100%);
        }
        VerticalLayout {
            padding: 6px;
            for it[i] in root.ac-items : ac-row := Rectangle {
                height: 38px;
                border-radius: 11px;
                background: i == root.ac-index ? root.fg.with-alpha(0.13) : transparent;
                Avatar {
                    x: 8px; y: (38px - 24px) / 2;
                    size: 24px;
                    source: it.avatar;
                    initials: it.initials;
                    tint: it.tint;
                }
                VerticalLayout {
                    x: 8px + 24px + 8px;
                    width: ac-row.width - 48px;
                    alignment: center;
                    Text {
                        text: it.display-name;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body-small;
                        overflow: elide;
                    }
                    if it.user-id != "" && it.user-id != it.display-name : Text {
                        text: it.user-id;
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: Theme.caption;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { root.ac-picked(i); } }
            }
        }
    }

    // The toast pill (:1225-1249): 34 tall, rgba(0,0,0,0.82), caption #f2f2f2,
    // 10 above the composer, fading over 180ms OutCubic.
    toast-pill := Rectangle {
        property <bool> shown: root.toast != "";
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.shown || self.opacity > 0.01;
        width: min(composer.width - 40px, toast-text.preferred-width + 28px);
        height: 34px; border-radius: 17px;
        x: (root.width - self.width) / 2;
        y: root.panel-top - 10px - 34px;
        background: #000000.with-alpha(0.82);
        toast-text := Text {
            x: 12px; y: 0;
            width: parent.width - 24px; height: 100%;
            text: root.toast;
            color: #f2f2f2;
            font-family: Theme.font-ui; font-size: Theme.caption;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
        }
    }

    // Header ⋮ menu — 170 wide at y 50 (ChatPage.qml:891-892).
    chat-menu := OverflowMenu {
        width: 100%; height: 100%;
        open <=> root.menu-open;
        top-inset: root.phone ? 56px : 50px;
        card-width: 170px;
        surface: (root.themed ? root.surface-c : Theme.popup-background).with-alpha(0.98);
        fg: root.fg;
        model: [
            { t: "Search", a: "search", icon: Icons.search, danger: false },
            { t: "Threads", a: "threads", icon: Icons.thread, danger: false },
            { t: "Pins", a: "pins", icon: Icons.pin, danger: false },
            { t: "Chat theme", a: "chattheme", icon: Icons.palette, danger: false },
            { t: "Settings", a: "roomsettings", icon: Icons.settings, danger: false },
        ];
        picked(a) => { root.nav-requested(a); }
    }

    // Long-press message sheet.
    sheet := MessageSheet {
        actions: root.sheet-actions;
        width: 100%; height: 100%;
        // The frost reaches the window's zones around the page.
        bleed-top: root.bleed-top;
        bleed-bottom: root.bleed-bottom;
        // The page runs to the window's bottom edge itself, so `bleed-bottom`
        // is zero and the sheet's own bottom edge IS the screen's: the emoji
        // drawer needs the page's inset to stand its category bar off the
        // gesture bar and to keep clear of the keyboard its search field puts up.
        bottom-inset: root.bottom-inset;
        // The scrim mask and the bottom sheets follow the page's corners: the
        // desktop card's 22, square on the phone (convo above).
        card-radius: root.phone ? 0px : 22px;
        fg: root.fg;
        accent: root.accent;
        // Panel.qml:1370-1373 — a themed room hands the sheet the chat's own
        // surface, chip and deep chip so pill, menu, drawer and confirm sit
        // in the room's tone; unthemed rooms keep the popup ground.
        surface: (root.themed ? root.surface-c : Theme.popup-background).with-alpha(0.98);
        chip: root.chip-c;
        deep-chip: root.deep-chip-c;
        emoji-rows: root.emoji-rows;
        quick-emoji: root.quick-emoji;
        emoji-cat-rows: root.emoji-cat-rows;
        act(action, event-id) => {
            if (action == "reply") {
                root.arm-reply(event-id, sheet.item.sender-name, sheet.item.body);
            } else if (action == "edit") {
                root.arm-edit(event-id, sheet.item.body);
            } else if (action == "caption") {
                root.arm-caption(event-id, sheet.item.media-filename,
                    sheet.item.body != sheet.item.media-filename ? sheet.item.body : "");
            } else if (action == "thread" || action == "openthread") {
                root.open-thread(event-id);
            } else {
                root.menu-action(action, event-id);
            }
        }
        react(id, key) => { root.react(id, key); }
        emoji-search(q) => { root.emoji-search(q); }
        load-emoji => { root.load-emoji(); }
    }
}
