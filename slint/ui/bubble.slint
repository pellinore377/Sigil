// One timeline row — the port of BubbleDelegate.qml. Google-Messages shape:
// own messages right in accent bubbles, others left with an avatar on group
// ends; day chips; tiny state captions; reactions straddle the bubble's top
// corner; the pin sits proud of it; own messages wear a mark line.
//
// Ported except rich-text bodies (no rich text in Slint — WIRING-chat.md).
// SigilText per-glyph effects, link cards, code parts, the contact card,
// the document page (prose and spreadsheet grid), and GIF playback
// (engine-decoded frames) are in. Every block that follows a QML number
// names its source line.

import { Theme } from "style.slint";
import { Icons } from "icons.slint";
import { IconLabel, Avatar, HoldArea } from "components.slint";
import { Spinner } from "furniture.slint";
import { TimelineRow, ReactionChip, PollOption, ContactField, DocRow } from "model.slint";

// ContactBody.qml:184-216 — the card's pill button: primary (Message) in
// accent with dark ink, marked (Saved) in a faint accent, plain in fg@0.12.
component CardButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> marked: false;
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    callback tapped;
    property <color> base: root.primary ? root.accent.with-alpha(0.9)
        : root.marked ? root.accent.with-alpha(0.22)
        : root.fg.with-alpha(0.12);
    width: lbl.preferred-width + 26px;
    height: 32px;
    border-radius: 16px;
    // :197-198 pressed darkens 1.18, hover lightens 1.08 (primary) / 1.6.
    background: t.pressed ? root.base.darker(0.18)
        : t.has-hover ? root.base.brighter(root.primary ? 0.08 : 0.6)
        : root.base;
    animate background { duration: 110ms; }
    // :200-201 press scale 0.97 over 90ms OutCubic.
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: t.pressed ? 0.97 : 1.0;
    transform-scale-y: t.pressed ? 0.97 : 1.0;
    animate transform-scale-x, transform-scale-y { duration: 90ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    lbl := Text {
        text: root.label;
        color: root.primary ? #141414 : root.marked ? root.accent : root.fg;
        font-family: Theme.font-ui; font-size: Theme.body-small;
        font-weight: root.primary ? 700 : 400;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
    }
    t := TouchArea { clicked => { root.tapped(); } }
}

export component Bubble inherits Rectangle {
    in property <TimelineRow> item;
    in property <color> fg: Theme.menu-text;
    in property <color> accent: Theme.accent;
    in property <bool> dm;
    in property <bool> encrypted;
    in property <color> convo-ground: Theme.menu-background;
    /// BubbleDelegate.qml:39 themeSurface — a themed room's bubble tone;
    /// transparent = untherned, the fg mix over the popup ground is used.
    in property <color> theme-surface: transparent;
    /// BubbleDelegate.qml:210 — the page can suppress the unread divider.
    in property <bool> unread-divider-allowed: true;
    /// The message sheet is spotlighting THIS row's bubble: the original
    /// renders invisible while the copy flies (MessageSheet.qml:205
    /// hideSource) and comes back only when the sheet clears — opacity,
    /// not `if`, so the row keeps its height and the copy lands on it.
    in property <bool> sheet-lit: false;
    in-out property <bool> details-open: false;

    callback menu-requested(TimelineRow, length, length, length, length);
    callback reply-requested(string, string, string);
    callback open-image(TimelineRow);
    callback play-video(TimelineRow);
    callback open-document(TimelineRow);
    callback open-contact(TimelineRow);
    callback open-audio(TimelineRow);
    callback open-location(TimelineRow);
    callback open-link(TimelineRow);
    callback open-url(string);
    callback open-thread(string);
    callback react(string, string);
    callback voice-toggled(string);
    callback voice-seeked(string, float);
    callback vote(string, string);
    // ContactBody.qml:22-26 — Save / Share / copy from the card (Message
    // rides `open-contact`).
    callback contact-save(string, string, bool);   // userId, displayName, saved
    callback contact-share(string, string);        // userId, displayName
    callback copy-text(string);
    /// RichText.qml:169 — the spoilers of this event were revealed; remember it.
    callback spoiler-revealed(string);

    property <length> bubble-max: root.width * 0.78;
    property <bool> is-msg: item.kind != "state" && item.kind != "dayDivider" && !item.is-read-marker;
    property <bool> media-kind: item.kind == "image" || item.kind == "sticker" || item.kind == "video";
    // BubbleDelegate.qml:628 — an audio file that carries a waveform draws
    // the voice row; without one it is a track card (:1401).
    property <bool> voice-kind: item.kind == "voice" || (item.kind == "audio" && item.waveform.length > 0);
    property <bool> track-kind: item.kind == "audio" && item.waveform.length == 0;
    property <bool> file-kind: item.kind == "file" || item.kind == "audio";
    // BubbleDelegate fullBleed (:153): media (location included), the doc
    // page, contact and track cards, code parts and the link card run edge
    // to edge.
    property <bool> doc-kind: root.file-kind && !root.voice-kind && item.doc-chip != "";
    property <bool> code-kind: item.parts.length > 0;
    property <bool> link-card: item.link-has && !root.media-kind && !item.link-only;
    property <bool> full-bleed: root.media-kind || item.kind == "location"
        || root.doc-kind || item.kind == "contact" || root.track-kind
        || root.code-kind || root.link-card || item.link-only;
    // A poll draws its own card, so the bubble contributes no padding or fill.
    property <bool> pad-free: root.full-bleed || item.kind == "poll";
    property <int> poll-sum: item.poll-vote-sum;
    property <string> votes-word: item.poll-total == 1 ? "1 vote" : "\{item.poll-total} votes";
    /// Jump landing: a brief accent ring on the message you asked for.
    in property <bool> jump-flash: false;
    /// Epoch seconds at app start (window's boot-epoch-s) for the live countdown.
    in property <int> boot-epoch-s: 0;
    property <int> live-remaining: max(0, item.location-expires-s - root.boot-epoch-s - floor(animation-tick() / 1s));
    // BubbleDelegate.qml:1445-1449 — the link card's caption is the body
    // with the URL taken out; verbatim until the bridge has stripped it.
    property <string> link-caption: item.caption-stripped ? item.caption-body : item.body;
    // BubbleDelegate.qml:1454-1476 textVisible: media, voice, file and
    // audio caption when the body is not just the filename; the link card
    // when words remain beside the link.
    property <bool> caption-visible: root.media-kind
        ? (item.media-filename != "" && item.body != "" && item.body != item.media-filename)
        : item.kind == "voice" ? (item.body != "" && item.body != item.media-filename)
        : (item.kind == "file" || item.kind == "audio")
        ? (item.media-filename != "" && item.body != "" && item.body != item.media-filename)
        : root.link-card ? root.link-caption != ""
        : false;
    property <bool> themed: root.theme-surface.alpha > 0;
    // Opaque pre-blends over the popup surface — the QML mix() math verbatim
    // (BubbleDelegate.qml:406-409); a themed room wears its surface, and a
    // highlight there is blend2(surface, accent, 0.22).
    property <color> bubble-fill: item.is-own ? root.accent.mix(Theme.popup-background, 0.42)
        : item.highlighted ? (root.themed ? root.theme-surface.mix(root.accent, 0.78)
                                          : root.accent.mix(Theme.popup-background, 0.24))
        : (root.themed ? root.theme-surface : Theme.bubble-other);
    property <length> r-big: 16px;
    property <length> r-small: 5px;
    // BubbleDelegate.qml:862 — a link-only card wears its own 14px corners.
    property <length> r-tl: item.link-only ? 14px : (!item.is-own && !item.group-start) ? r-small : r-big;
    property <length> r-bl: item.link-only ? 14px : (!item.is-own && !item.group-end) ? r-small : r-big;
    property <length> r-tr: item.link-only ? 14px : (item.is-own && !item.group-start) ? r-small : r-big;
    property <length> r-br: item.link-only ? 14px : (item.is-own && !item.group-end) ? r-small : r-big;
    property <length> reaction-lift: item.reactions.length > 0 ? 13px : 0px;
    // Media box size, computed once from the event's own dimensions so nothing
    // downstream has to read bubble.width (which would loop through preferred).
    // BubbleDelegate.qml:446-450 (image: 400×300, floors 120×80) and
    // :526-530 (video: 480×320, floors 160×110).
    property <bool> video-kind: item.kind == "video";
    property <float> media-iw: item.thumb-w > 0px ? item.thumb-w / 1px : (root.video-kind ? 480 : 400);
    property <float> media-ih: item.thumb-h > 0px ? item.thumb-h / 1px : (root.video-kind ? 320 : 300);
    property <float> media-s: min(1.0, min(root.bubble-max / 1px / root.media-iw, 300.0 / root.media-ih));
    property <length> media-w: max(root.video-kind ? 160px : 120px, round(root.media-iw * root.media-s) * 1px);
    property <length> media-h: max(root.video-kind ? 110px : 80px, round(root.media-ih * root.media-s) * 1px);
    property <length> pin-lift: item.pinned ? 4px : 0px;
    // Entry: theirs slides in from their side, ours rises out of the composer
    // (BubbleDelegate.qml:58-78 playEntry). Four channels, each on its own
    // clock: dx 300ms OutCubic, dy 320ms OutBack(0.8), scale 320ms
    // OutBack(1.0), opacity 190ms OutCubic. Plays once, on the row that just
    // arrived; the whole row travels (reactions, pin included — :48-57).
    property <float> entry-x: item.is-new ? 0.0 : 1.0;
    property <float> entry-y: item.is-new ? 0.0 : 1.0;
    property <float> entry-s: item.is-new ? 0.0 : 1.0;
    property <float> entry-o: item.is-new ? 0.0 : 1.0;
    animate entry-x { duration: 300ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    animate entry-y { duration: 320ms; easing: cubic-bezier(0.34, 1.26, 0.64, 1); }
    animate entry-s { duration: 320ms; easing: cubic-bezier(0.34, 1.33, 0.64, 1); }
    animate entry-o { duration: 190ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    init => { root.entry-x = 1.0; root.entry-y = 1.0; root.entry-s = 1.0; root.entry-o = 1.0; }

    height: col.preferred-height;
    background: transparent;
    // BubbleDelegate.qml:1106-1110 — the menu spotlights the bubble itself,
    // not the row: `bubble` is in scope now that the row is unconditional.
    public function open-menu() {
        root.menu-requested(item,
            bubble.absolute-position.x, bubble.absolute-position.y,
            bubble.width, bubble.height);
    }

    col := VerticalLayout {
        padding-left: 14px; padding-right: 14px;

        // Session stamp (GM style)
        if item.day-label != "" : Rectangle {
            height: 30px;
            Text {
                text: item.day-label;
                color: root.fg.with-alpha(0.55);
                font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }

        // Unread divider — BubbleDelegate.qml:261-262 gates it on the page's leave.
        if item.is-read-marker && root.unread-divider-allowed : Rectangle {
            height: 20px;
            Rectangle {
                y: 9.5px; width: 100%; height: 1px;
                background: Theme.urgent.with-alpha(0.5);
            }
            unread-pill := Rectangle {
                x: (root.width - 28px - self.width) / 2;
                y: 2px;
                width: unread-text.preferred-width + 14px; height: 16px;
                border-radius: 8px;
                background: Theme.urgent;
                unread-text := Text {
                    text: "Unread";
                    color: Theme.background;
                    font-family: Theme.font-ui; font-size: 9px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: 100%; height: 100%;
                }
            }
        }

        // State caption
        if item.kind == "state" && item.body != "" : Rectangle {
            height: state-text.preferred-height + 10px;
            state-text := Text {
                y: 10px;
                width: 100%;
                text: item.body;
                color: root.fg.with-alpha(0.42);
                font-family: Theme.font-ui; font-size: Theme.caption;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Sender header: avatar beside the name, group starts in group rooms only.
        // BubbleDelegate.qml:288-299 — the 20px row sits at the bottom of the
        // 28px box, 2px up: avatar y 6.
        if root.is-msg && item.show-header && !root.dm && !item.is-own : Rectangle {
            height: 28px;
            Avatar {
                x: 0; y: 6px;
                size: 20px;
                source: item.avatar;
                initials: item.initials;
                tint: item.tint;
            }
            Text {
                x: 27px; y: 6px; height: 20px;
                text: item.sender-name;
                color: root.fg.with-alpha(0.6);
                font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700;
                vertical-alignment: center;
            }
        }

        // Bubble row. Unconditional (height 0 for state rows) so `bubble`
        // is in scope for open-menu.
        brow := Rectangle {
            height: root.is-msg ? bubble.height + (item.group-start ? 10px : 3px) + max(root.reaction-lift, root.pin-lift) : 0px;
            visible: root.is-msg;

            // BubbleDelegate.qml:315-318 — tapping the empty space beside the
            // bubble shows the same details; a hold there opens the menu like
            // one on the bubble (:1107-1111). Declared first, so the bubble,
            // its bodies, the reactions and the reply strip all sit above it.
            HoldArea {
                clicked => {
                    if (!self.fired) { root.details-open = !root.details-open; }
                    self.fired = false;
                }
                held => { root.open-menu(); }
            }

            // BubbleDelegate.qml:48-57 — the entry transform on the whole row.
            entry-wrap := Rectangle {
                x: item.is-own ? 0px : -28px * (1 - root.entry-x);
                y: (item.is-own ? 54px : 4px) * (1 - root.entry-y);
                width: brow.width; height: brow.height;
                opacity: root.entry-o;
                transform-origin: { x: item.is-own ? self.width : 0px, y: self.height };
                transform-scale-x: (item.is-own ? 0.84 : 0.9) + (item.is-own ? 0.16 : 0.1) * root.entry-s;
                transform-scale-y: (item.is-own ? 0.84 : 0.9) + (item.is-own ? 0.16 : 0.1) * root.entry-s;

            bubble := Rectangle {
                x: item.is-own ? brow.width - self.width : 0px;
                y: brow.height - self.height;
                // Invisible for the sheet's lifetime, fly-home included
                // (MessageSheet.qml:205 hideSource); reactions and the pin
                // stay, exactly the srcItem's subtree and no more.
                opacity: root.sheet-lit ? 0.0 : 1.0;
                // QML contentW: media takes its box; doc/track/code/contact and
                // the link card take bubbleMax outright (wrapped text reports a
                // tiny preferred width); text is implicitWidth + 22, 40px floor.
                property <length> content-w: root.media-kind ? root.media-w
                    : item.kind == "location" ? root.bubble-max
                    : root.doc-kind || root.track-kind || item.kind == "contact"
                      || root.code-kind || root.link-card || item.link-only ? root.bubble-max
                    : b-inner.preferred-width + (root.pad-free ? 0px : 22px);
                width: min(root.bubble-max, max(40px, self.content-w));
                height: b-inner.preferred-height + (root.pad-free ? 0px : 20px);
                // cardOnly: a body that IS the link renders the card alone; a
                // caption-less video is its poster (BubbleDelegate.qml:410-411).
                background: item.kind == "poll" || item.link-only
                    || (root.video-kind && !root.caption-visible) ? transparent : root.bubble-fill;
                border-width: root.jump-flash ? 2px : 0px;
                border-color: root.jump-flash ? root.accent.with-alpha(0.9) : transparent;
                animate border-width { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                border-top-left-radius: root.r-tl;
                border-bottom-left-radius: root.r-bl;
                border-top-right-radius: root.r-tr;
                border-bottom-right-radius: root.r-br;
                clip: true;

                // Declared BEFORE the content so every inner TouchArea (media,
                // voice, poll, file, thread chip) sits above it — QML's
                // TapHandlers live on the bubble behind the bodies' MouseAreas.
                // Plain text has no handler of its own and falls through here.
                press-area := TouchArea {
                    clicked => {
                        if (!long-timer.fired) { root.details-open = !root.details-open; }
                        long-timer.fired = false;
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            long-timer.fired = false;
                            long-timer.running = true;
                        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                            long-timer.running = false;
                        }
                    }
                    moved => {
                        if (abs((self.mouse-x - self.pressed-x) / 1px) > 12 || abs((self.mouse-y - self.pressed-y) / 1px) > 12) {
                            long-timer.running = false;
                        }
                    }
                }

                b-inner := VerticalLayout {
                    // BubbleDelegate.qml:421-422 — 10px inset, 4px spacing;
                    // both gone for full-bleed bodies and the poll.
                    x: root.pad-free ? 0px : 10px;
                    y: root.pad-free ? 0px : 10px;
                    width: bubble.width - (root.pad-free ? 0px : 20px);
                    // Its own height: left to the bubble's, the layout would
                    // spread its children into the padding.
                    height: self.preferred-height;
                    spacing: root.full-bleed ? 0px : 4px;

                    // Reply quote — BubbleDelegate.qml:425-435: as tall as
                    // its two lines plus 10.
                    if item.has-reply : reply-strip := Rectangle {
                        height: q.preferred-height + 10px;
                        border-radius: 10px;
                        background: Theme.background.with-alpha(0.35);
                        q := VerticalLayout {
                            padding-left: 10px; padding-right: 8px;
                            alignment: center;
                            Text {
                                text: item.reply.sender-name;
                                color: root.fg.with-alpha(0.75);
                                font-family: Theme.font-ui; font-size: 10px; font-weight: 700;
                            }
                            Text {
                                text: item.reply.kind == "image" ? "📷 Photo" : item.reply.body;
                                color: root.fg.with-alpha(0.55);
                                font-family: Theme.font-ui; font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }

                    // Image / sticker / video poster
                    if root.media-kind : media-box := Rectangle {
                        property <int> gif-frame: 0;
                        width: root.media-w;
                        height: root.media-h;
                        // BubbleDelegate.qml:456 (image 0.08) / :537 (video 0.12).
                        background: root.fg.with-alpha(root.video-kind ? 0.12 : 0.08);
                        if item.thumb.width > 0 && item.gif-frames.length <= 1 : Image {
                            source: item.thumb;
                            width: 100%; height: 100%;
                            image-fit: cover;
                        }
                        // Animated GIF: engine-decoded frames on a per-frame clock
                        // (QML's AnimatedImage; Slint's Image cannot animate).
                        if item.gif-frames.length > 1 : Image {
                            source: item.gif-frames[min(media-box.gif-frame, item.gif-frames.length - 1)];
                            width: 100%; height: 100%;
                            image-fit: cover;
                        }
                        // A Timer cannot sit under an `if`; it idles via `running`.
                        gif-clock := Timer {
                            interval: item.gif-frames.length > 1
                                ? max(20, item.gif-delays[min(media-box.gif-frame, item.gif-delays.length - 1)]) * 1ms
                                : 1000ms;
                            running: item.gif-frames.length > 1;
                            triggered => {
                                media-box.gif-frame = mod(media-box.gif-frame + 1, item.gif-frames.length);
                            }
                        }
                        if item.thumb.width == 0 : Spinner {
                            x: (media-box.width - self.width) / 2;
                            y: (media-box.height - self.height) / 2;
                            spin-color: root.fg.with-alpha(0.5);
                        }
                        if item.kind == "video" : Rectangle {
                            x: (media-box.width - 48px) / 2;
                            y: (media-box.height - 48px) / 2;
                            width: 48px; height: 48px; border-radius: 24px;
                            background: #000000.with-alpha(0.55);
                            IconLabel { text: Icons.play; color: #ffffff; font-size: Theme.icon-large; width: 100%; height: 100%; }
                        }
                        // BubbleDelegate.qml:508-514 — the GIF badge, bottom-left.
                        if item.gif-frames.length > 1 : gif-badge := Rectangle {
                            x: 8px;
                            y: media-box.height - 18px - 8px;
                            width: gif-text.preferred-width + 10px; height: 18px;
                            border-radius: 5px;
                            background: #000000.with-alpha(0.55);
                            gif-text := Text {
                                text: "GIF";
                                color: #ffffff;
                                font-family: Theme.font-ui; font-size: 9px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        TouchArea {
                            clicked => {
                                if (item.kind == "video") { root.play-video(item); }
                                else { root.open-image(item); }
                            }
                        }
                    }

                    // Voice note: play disc + waveform + countdown
                    // (BubbleDelegate.qml:630-692).
                    if root.voice-kind : voice-row := Rectangle {
                        height: 40px;
                        width: min(root.bubble-max, 260px);
                        // :685-689 — counts down while playing, MM:SS with a
                        // leading zero; the bridge's label stands in without
                        // a second count.
                        property <int> dur-s: item.duration-s;
                        property <int> rem: item.voice-playing
                            ? max(0, round(self.dur-s * (1 - item.voice-frac))) : self.dur-s;
                        property <string> mmss: (floor(self.rem / 60) < 10 ? "0" : "") + floor(self.rem / 60)
                            + ":" + (mod(self.rem, 60) < 10 ? "0" : "") + mod(self.rem, 60);
                        vplay := Rectangle {
                            x: 0; y: 3px;
                            width: 34px; height: 34px; border-radius: 17px;
                            // :642 — a themed room lightens its accent 1.45.
                            background: root.themed ? root.accent.brighter(0.45) : #f2f2f2;
                            IconLabel {
                                text: item.voice-playing ? Icons.pause : Icons.play;
                                color: #1a1a1a;
                                font-size: Theme.icon-size;   // BubbleDelegate.qml:643 size: Style.font.icon
                                width: 100%; height: 100%;
                            }
                            TouchArea { clicked => { root.voice-toggled(item.event-id); } }
                        }
                        vdur := Text {
                            x: parent.width - self.width;
                            width: self.preferred-width; height: 100%;
                            text: voice-row.dur-s > 0 ? voice-row.mmss : item.duration;
                            color: root.fg.with-alpha(0.8);
                            font-family: Theme.font-ui; font-size: Theme.caption;
                            vertical-alignment: center;
                        }
                        vwave := Rectangle {
                            x: 42px; y: 7px;
                            width: max(0px, vdur.x - 8px - 42px);
                            height: 26px;
                            clip: true;
                            // :652 — max(8, floor(width/5)) bars; the bridge
                            // resamples to that count (3px bars, 2px gaps).
                            HorizontalLayout {
                                spacing: 2px;
                                alignment: start;
                                for amp[i] in item.waveform : Rectangle {
                                    y: (26px - self.height) / 2;
                                    width: 3px;
                                    height: max(3px, 22px * min(1.0, amp));
                                    border-radius: 1.5px;
                                    background: (i / max(1, item.waveform.length)) <= item.voice-frac
                                        ? root.fg.with-alpha(0.95) : root.fg.with-alpha(0.35);
                                }
                            }
                            TouchArea {
                                clicked => { root.voice-seeked(item.event-id, self.pressed-x / vwave.width); }
                            }
                        }
                    }

                    // Document preview: the first lines drawn as a page — DocThumb.qml.
                    // A PDF arrives drawn (imagePath) instead.
                    if root.doc-kind : doc-card := Rectangle {
                        // DocThumb.qml:265-266 — page aspect, 1.294 (A4) unknown.
                        property <float> aspect: item.doc-aspect > 0 ? item.doc-aspect : 1.294;
                        property <bool> grid: item.doc-rows.length > 0;
                        // DocThumb.qml:286-289 contentHeight.
                        property <length> content-h: item.has-doc-image ? self.width * self.aspect
                            : (self.grid ? sheet-col.preferred-height + 20px : prose-col.preferred-height + 24px) + 14px;
                        property <bool> clipped: self.content-h > self.height + 1px;
                        // fullBleed: the page card spans the bubble (DocThumb at bubbleMax);
                        // BubbleDelegate.qml:702-704 — as tall as it needs, up to a page.
                        width: root.bubble-max;
                        height: min(round(root.bubble-max / 1px * 0.66) * 1px, max(70px, self.content-h));
                        background: #f7f5f0;
                        clip: true;
                        // DocThumb.qml:326-334 — top-anchored, cropped where the fade says more.
                        if item.has-doc-image : Image {
                            source: item.doc-thumb;
                            y: 0; width: 100%;
                            height: doc-card.width * doc-card.aspect;
                            image-fit: contain;
                        }
                        // Always present so the card can size from it (ids inside
                        // `if` are unreachable); invisible under a rendered page.
                        // DocThumb.qml:336-357 — prose: 12px margins, 3px spacing,
                        // each line wraps to at most two lines and elides.
                        prose-col := VerticalLayout {
                            visible: !item.has-doc-image && !doc-card.grid;
                            x: 12px; y: 12px;
                            width: doc-card.width - 24px;
                            height: self.preferred-height;
                            spacing: 3px;
                            // DocThumb: headings 1-2 at bodySmall and bold; body at caption.
                            for line in item.doc-lines : Rectangle {
                                clip: true;
                                height: min(doc-line.preferred-height, 2 * doc-line.font-size * 1.35);
                                doc-line := Text {
                                    width: 100%;
                                    text: line.text;
                                    color: #292625;   // DocThumb.qml:283 ink
                                    font-family: Theme.font-ui;
                                    font-size: line.level >= 1 && line.level <= 2 ? Theme.body-small : Theme.caption;
                                    font-weight: line.level > 0 ? 700 : 400;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                        // DocThumb.qml:360-398 — a spreadsheet: 10px margin,
                        // 18px rows, cells sheet.width/cols wide with 1px
                        // rgba(0,0,0,0.08) borders; the first row is the header.
                        sheet-col := VerticalLayout {
                            visible: doc-card.grid && !item.has-doc-image;
                            x: 10px; y: 10px;
                            width: doc-card.width - 20px;
                            height: self.preferred-height;
                            spacing: 0;
                            for row[ri] in item.doc-rows : HorizontalLayout {
                                spacing: 0;
                                alignment: start;
                                height: 18px;
                                for cell in row.cells : Rectangle {
                                    width: floor((doc-card.width - 20px) / 1px / max(1, row.cells.length)) * 1px;
                                    height: 18px;
                                    background: ri == 0 ? #000000.with-alpha(0.06) : transparent;
                                    border-width: 1px;
                                    border-color: #000000.with-alpha(0.08);
                                    Text {
                                        x: 4px; width: parent.width - 7px; height: 100%;
                                        text: cell;
                                        color: #292625;
                                        font-family: Theme.font-ui; font-size: 8px;
                                        font-weight: ri == 0 ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        // DocThumb.qml:401-409 — 34px paper fade where the page is cut.
                        if doc-card.clipped : Rectangle {
                            y: doc-card.height - 34px;
                            width: 100%; height: 34px;
                            background: @linear-gradient(180deg, #f7f5f000 0%, #f7f5f0 100%);
                        }
                        // DocThumb.qml:411-422 — the kind badge, "PDF · 4" with pages.
                        chip := Rectangle {
                            x: 8px;
                            y: doc-card.height - self.height - 8px;
                            width: chip-text.preferred-width + 10px;
                            height: 16px;
                            border-radius: 4px;
                            background: #000000.with-alpha(0.55);
                            chip-text := Text {
                                text: item.doc-pages > 1 ? "\{item.doc-chip} · \{item.doc-pages}" : item.doc-chip;
                                color: #ffffff;
                                font-family: Theme.font-ui;
                                font-size: 8px;
                                font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        HoldArea { clicked => { if (!self.fired) { root.open-document(item); } self.fired = false; } held => { root.open-menu(); } }
                    }

                    // Music: AudioBody's card — square cover (or bare strip) over
                    // a 52px chrome strip tinted from the art's palette; ink is
                    // computed in Rust by luminance.
                    if root.track-kind : audio-card := Rectangle {
                        width: root.bubble-max;
                        height: root.bubble-max + 52px;
                        clip: true;
                        art-box := Rectangle {
                            y: 0; width: 100%;
                            height: audio-card.width;
                            background: item.audio-have-art ? item.audio-tone.darker(0.3) : root.fg.with-alpha(0.13);
                            if item.audio-have-art : Image {
                                source: item.audio-art;
                                width: 100%; height: 100%;
                                image-fit: cover;
                            }
                            if item.audio-have-art : Rectangle {
                                width: 100%; height: 100%;
                                background: #000000.with-alpha(0.18);
                            }
                            note-btn := Rectangle {
                                x: (art-box.width - 56px) / 2;
                                y: (art-box.height - 56px) / 2;
                                width: 56px; height: 56px; border-radius: 28px;
                                background: item.audio-have-art ? #000000.with-alpha(0.55) : item.audio-tone;
                                // AudioBody.qml:498-499 — press scale 0.92 over 90ms.
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-scale-x: art-tap.pressed ? 0.92 : 1.0;
                                transform-scale-y: art-tap.pressed ? 0.92 : 1.0;
                                animate transform-scale-x, transform-scale-y { duration: 90ms; }
                                IconLabel {
                                    text: Icons.music;   // AudioBody.qml:111 Fonts.icon (outlined)
                                    color: item.audio-have-art ? #ffffff : item.audio-ink;
                                    font-size: 26px;
                                    width: 100%; height: 100%;
                                }
                            }
                            art-tap := HoldArea { clicked => { if (!self.fired) { root.open-audio(item); } self.fired = false; } held => { root.open-menu(); } }
                        }
                        strip := Rectangle {
                            y: audio-card.height - 52px;
                            width: 100%; height: 52px;
                            background: item.audio-tone;
                            VerticalLayout {
                                x: 12px;
                                width: strip.width - 24px;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    // BubbleDelegate.qml:1408-1412 — the title
                                    // without its extension (bridge-stripped).
                                    text: item.audio-title != "" ? item.audio-title
                                        : item.media-filename != "" ? item.media-filename : item.body;
                                    color: item.audio-ink;
                                    font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                                    overflow: elide;
                                }
                                // BubbleDelegate.qml:768-773 — "duration · size".
                                if item.duration != "" || item.media-size != "" : Text {
                                    text: item.duration != "" && item.media-size != ""
                                        ? "\{item.duration} · \{item.media-size}"
                                        : item.duration + item.media-size;
                                    color: item.audio-ink.with-alpha(0.75);
                                    font-family: Theme.font-ui; font-size: Theme.caption;
                                    overflow: elide;
                                }
                            }
                            HoldArea { clicked => { if (!self.fired) { root.open-audio(item); } self.fired = false; } held => { root.open-menu(); } }
                        }
                    }

                    // File row — BubbleDelegate.qml:797-829: 34px, glyph by
                    // kind, name at most bubbleMax-80 wide, "duration · size".
                    if item.kind == "file" && item.doc-chip == "" : file-row := Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                y: 0;
                                width: 34px; height: 34px; border-radius: 17px;
                                background: root.accent.with-alpha(0.25);
                                IconLabel {
                                    text: item.kind == "video" ? Icons.videoOn : item.kind == "file" ? Icons.file : Icons.music;
                                    color: root.fg;
                                    font-size: Theme.icon-size;   // BubbleDelegate.qml:815 size: Style.font.icon
                                    width: 100%; height: 100%;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: item.media-filename != "" ? item.media-filename : item.body;
                                    color: root.fg;
                                    font-family: Theme.font-ui; font-size: Theme.body-small;
                                    width: min(root.bubble-max - 80px, self.preferred-width);
                                    overflow: elide;
                                }
                                if item.duration != "" || item.media-size != "" : Text {
                                    text: item.duration != "" && item.media-size != ""
                                        ? "\{item.duration} · \{item.media-size}"
                                        : item.duration + item.media-size;
                                    color: root.fg.with-alpha(0.5);
                                    font-family: Theme.font-ui; font-size: Theme.caption;
                                }
                            }
                        }
                        // :808-813 — opens only when the engine can preview it.
                        TouchArea {
                            enabled: item.media-previewable;
                            clicked => { root.open-document(item); }
                        }
                    }

                    // Poll (MSC3381) — PollBody.qml. The poll wears its own card
                    // (the bubble behind it is transparent); counts only exist
                    // once disclosed or ended; the pick dot marks your answer.
                    if item.kind == "poll" : poll-card := Rectangle {
                        property <bool> show-counts: item.poll-ended || item.poll-disclosed;
                        property <bool> can-vote: !item.poll-ended;
                        property <int> total-votes: root.poll-sum;
                        width: min(root.bubble-max, 252px);
                        height: poll-col.preferred-height + 24px;
                        border-radius: 16px;
                        // BubbleDelegate.qml:615 — the surface is the bubble's own fill.
                        background: root.bubble-fill;
                        poll-col := VerticalLayout {
                            x: 12px; y: 12px;
                            width: poll-card.width - 24px;
                            spacing: 7px;
                            Text {
                                text: item.poll-question;
                                color: root.fg;
                                font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                                wrap: word-wrap;
                            }
                            for opt in item.poll-options : opt-row := Rectangle {
                                property <float> share: poll-card.show-counts && poll-card.total-votes > 0
                                    ? opt.votes / poll-card.total-votes : 0.0;
                                property <bool> leading: poll-card.show-counts && opt.winner;
                                property <bool> dot-visible: poll-card.can-vote || opt.mine;
                                height: 34px;
                                border-radius: 11px;
                                background: #000000.with-alpha(opt-touch.has-hover && poll-card.can-vote ? 0.30 : 0.22);
                                clip: true;
                                Rectangle {
                                    x: 0; width: opt-row.width * max(0.0, min(1.0, opt-row.share));
                                    height: 100%;
                                    border-radius: 11px;
                                    background: root.accent.with-alpha(opt-row.leading ? 0.55 : 0.28);
                                    animate width { duration: 320ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                                }
                                // Your pick as a filled dot; empty ring while open
                                // (PollBody.qml:124-143: 1.5px ring, outlined tick).
                                if opt-row.dot-visible : pick-dot := Rectangle {
                                    x: 10px; y: (34px - 15px) / 2;
                                    width: 15px; height: 15px; border-radius: 7.5px;
                                    background: opt.mine ? root.accent : transparent;
                                    border-width: opt.mine ? 0px : 1.5px;
                                    border-color: root.fg.with-alpha(0.4);
                                    if opt.mine : IconLabel {
                                        text: Icons.check;
                                        color: Theme.background;
                                        font-size: 9px;
                                        width: 100%; height: 100%;
                                    }
                                }
                                Text {
                                    x: opt-row.dot-visible ? 33px : 12px;
                                    width: tally.x - self.x - 8px;
                                    height: 100%;
                                    text: opt.text;
                                    color: root.fg;
                                    font-family: Theme.font-ui; font-size: Theme.body-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                tally := Text {
                                    x: opt-row.width - self.preferred-width - 11px;
                                    height: 100%;
                                    visible: poll-card.show-counts;
                                    text: poll-card.total-votes <= 0 ? "0"
                                        : "\{opt.votes}  \{round(opt-row.share * 100)}%";
                                    color: root.fg.with-alpha(0.7);
                                    font-family: Theme.font-ui; font-size: 10px;
                                    font-weight: opt-row.leading ? 700 : 400;
                                    vertical-alignment: center;
                                }
                                // PollBody.qml:51-64 — a re-tap retracts and
                                // multi-select toggles; the engine resolves the
                                // answer set from the tapped id.
                                opt-touch := TouchArea {
                                    enabled: poll-card.can-vote;
                                    clicked => { root.vote(item.event-id, opt.id); }
                                }
                            }
                            Text {
                                text: item.poll-ended ? "Final results · \{root.votes-word}"
                                    : !item.poll-disclosed ? "Results hidden until the poll ends · \{root.votes-word}"
                                    : item.poll-max > 1 ? "Pick up to \{item.poll-max} · \{root.votes-word}"
                                    : root.votes-word;
                                color: root.fg.with-alpha(0.5);
                                font-family: Theme.font-ui; font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Contact card — ContactBody.qml:30-237: identity block,
                    // one 34px row per field, Message / Save / Share pills.
                    if item.kind == "contact" : contact-card := Rectangle {
                        width: root.bubble-max;
                        // :45 — inner + 20 (10 above, the rest below).
                        height: c-inner.preferred-height + 20px;
                        property <string> subtitle: item.contact-title != "" && item.contact-org != ""
                            ? "\{item.contact-title} · \{item.contact-org}"
                            : item.contact-title != "" ? item.contact-title
                            : item.contact-org != "" ? item.contact-org
                            : item.contact-id;
                        c-inner := VerticalLayout {
                            x: 14px; y: 10px;
                            width: contact-card.width - 28px;
                            height: self.preferred-height;
                            spacing: 8px;
                            // :76-112 identity: 42px face, name at body/bold,
                            // title · org (or the mxid) at caption@0.6.
                            Rectangle {
                                height: 46px;
                                // The CONTACT's face, not the sender's.
                                Avatar {
                                    x: 0; y: 2px;
                                    size: 42px;
                                    source: item.contact-avatar;
                                    initials: item.contact-initials;
                                    tint: item.contact-tint;
                                }
                                VerticalLayout {
                                    x: 52px;
                                    width: parent.width - 52px;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: item.contact-name != "" ? item.contact-name
                                            : item.contact-id != "" ? item.contact-id : "Contact";
                                        color: root.fg;
                                        font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                                        overflow: elide;
                                    }
                                    if contact-card.subtitle != "" : Text {
                                        text: contact-card.subtitle;
                                        color: root.fg.with-alpha(0.6);
                                        font-family: Theme.font-ui; font-size: Theme.caption;
                                        overflow: elide;
                                    }
                                }
                            }
                            // :115-177 fields: icon at bodySmall@0.45, value in
                            // accent when linkable, label at 8px@0.45, a 26px
                            // copy disc at the right.
                            for f in item.contact-fields : field-row := Rectangle {
                                height: 34px;
                                IconLabel {
                                    x: 0; width: 12px; height: 100%;
                                    text: f.kind == "phone" ? Icons.phone
                                        : f.kind == "email" ? Icons.email
                                        : f.kind == "address" ? Icons.location
                                        : Icons.note;
                                    color: root.fg.with-alpha(0.45);
                                    font-size: Theme.body-small;
                                }
                                VerticalLayout {
                                    x: 21px;
                                    width: parent.width - 21px - 26px - 8px;
                                    alignment: center;
                                    Text {
                                        text: f.value;
                                        color: f.linkable ? root.accent : root.fg;
                                        font-family: Theme.font-ui; font-size: Theme.body-small;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: f.label;
                                        color: root.fg.with-alpha(0.45);
                                        font-family: Theme.font-ui; font-size: 8px;
                                        overflow: elide;
                                    }
                                }
                                TouchArea {
                                    x: 0; width: parent.width - 26px;
                                    enabled: f.linkable;
                                    clicked => { root.open-url(f.url); }
                                }
                                copy-btn := Rectangle {
                                    x: parent.width - 26px; y: 4px;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: cp-area.has-hover ? root.fg.with-alpha(0.12) : transparent;
                                    IconLabel {
                                        text: Icons.copy;
                                        color: root.fg.with-alpha(0.6);
                                        font-size: Theme.caption;
                                        width: 100%; height: 100%;
                                    }
                                    cp-area := TouchArea { clicked => { root.copy-text(f.value); } }
                                }
                            }
                            // :180-236 actions, Matrix contacts only.
                            if item.contact-id != "" : HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                CardButton {
                                    label: "Message"; primary: true;
                                    fg: root.fg; accent: root.accent;
                                    tapped => { root.open-contact(item); }
                                }
                                CardButton {
                                    label: item.contact-saved ? "Saved" : "Save";
                                    marked: item.contact-saved;
                                    fg: root.fg; accent: root.accent;
                                    tapped => { root.contact-save(item.contact-id, item.contact-name, item.contact-saved); }
                                }
                                CardButton {
                                    label: "Share";
                                    fg: root.fg; accent: root.accent;
                                    tapped => { root.contact-share(item.contact-id, item.contact-name); }
                                }
                            }
                        }
                    }

                    // Location card — LocationBody.qml. Slint has no map widget:
                    // the engine's composited map when it has one, else the bare
                    // 40px pin on the bubble's tone.
                    if item.kind == "location" : loc-box := Rectangle {
                        width: root.bubble-max;
                        // BubbleDelegate.qml:579 — round(bubbleMax * 0.62).
                        height: round(root.bubble-max / 1px * 0.62) * 1px;
                        background: root.fg.with-alpha(0.10);
                        clip: true;
                        property <bool> have-map: item.location-map.width > 0;
                        // BubbleDelegate.qml:145-147 — a live share, or `m.self`,
                        // marks the sender rather than a place.
                        property <bool> self-loc: item.location-self || item.location-live || item.location-ended;
                        if loc-box.have-map : Image {
                            source: item.location-map;
                            width: 100%; height: 100%;
                            image-fit: cover;
                        }
                        // LocationBody.qml:311-318 — the offline/pending fallback pin.
                        if !loc-box.have-map : IconLabel {
                            text: Icons.location;
                            filled: true;   // LocationBody.qml:115 Fonts.iconFilled
                            color: root.accent.with-alpha(0.85);
                            font-size: 40px;
                            width: 100%; height: 100%;
                        }
                        // MapView.qml:156-168 — a 48px accent pin whose tip is
                        // the coordinate (the card's centre).
                        if loc-box.have-map : marker := Rectangle {
                            x: (loc-box.width - 48px) / 2;
                            y: loc-box.height / 2 - 48px;
                            width: 48px; height: 48px;
                            // MapView.qml:193-235 — two broadcast rings while
                            // live: scale 0.8→2.2, opacity 0.8→0 over 1700ms
                            // OutCubic, the second 850ms behind.
                            if loc-box.self-loc && item.location-live : Rectangle {
                                for ri in [0, 1] : Rectangle {
                                    property <float> pause: ri * 850;
                                    property <float> t: mod(animation-tick() / 1ms, 1700 + self.pause);
                                    property <float> p: max(0.0, self.t - self.pause) / 1700;
                                    property <float> e: 1 - pow(1 - self.p, 3);
                                    x: 48px * 0.4896 - 21px; y: 48px * 0.4062 - 21px;
                                    width: 42px; height: 42px; border-radius: 21px;
                                    border-width: 2px; border-color: root.accent;
                                    background: transparent;
                                    opacity: self.t < self.pause ? 0 : 0.8 * (1 - self.e);
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale-x: 0.8 + 1.4 * self.e;
                                    transform-scale-y: 0.8 + 1.4 * self.e;
                                }
                            }
                            IconLabel {
                                text: Icons.location;
                                filled: true;   // MapView.qml:165
                                color: root.accent;
                                font-size: 48px;
                                width: 100%; height: 100%;
                            }
                            // MapView.qml:173-280 — your own position: the face
                            // inside the pin's head (centre 0.4896/0.4062, r 0.26).
                            if loc-box.self-loc : Avatar {
                                x: 48px * 0.4896 - 12.5px; y: 48px * 0.4062 - 12.5px;
                                size: 25px;
                                source: item.avatar;
                                initials: item.initials;
                                tint: item.tint;
                            }
                        }
                        // LocationBody.qml:272-282 — an ended share is desaturated;
                        // a grey wash stands in (600ms OutCubic).
                        ended-wash := Rectangle {
                            width: 100%; height: 100%;
                            background: #8a8a8a.with-alpha(0.55);
                            opacity: item.location-ended ? 1.0 : 0.0;
                            animate opacity { duration: 600ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        }
                        // LocationBody.qml:320-375 — the countdown pill: row + 20
                        // wide, 24 tall, background@0.72; 7px dot, red while
                        // live and grey once ended; 10px bold #ececec text.
                        if item.location-live || item.location-ended : live-pill := Rectangle {
                            x: loc-box.width - self.width - 8px;
                            y: 8px;
                            width: live-row.preferred-width + 20px;
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.background.with-alpha(0.72);
                            live-row := HorizontalLayout {
                                x: 10px;
                                width: self.preferred-width;
                                alignment: center;
                                spacing: 5px;
                                Rectangle {
                                    y: (24px - 7px) / 2;
                                    width: 7px; height: 7px; border-radius: 3.5px;
                                    background: item.location-live ? #e8646a : #ececec.with-alpha(0.5);
                                    // :350-355 — pulses 1↔0.3, 800ms each way.
                                    opacity: item.location-live
                                        ? 0.65 + 0.35 * cos(360deg * (mod(animation-tick() / 1ms, 1600.0) / 1600.0))
                                        : 1.0;
                                }
                                Text {
                                    // :360-368 — "Hh MMm" above an hour, else M:SS.
                                    text: !item.location-live ? "Live location ended"
                                        : item.location-expires-s > 0 && root.boot-epoch-s > 0
                                        ? (root.live-remaining >= 3600
                                            ? floor(root.live-remaining / 3600) + "h "
                                              + (floor(mod(root.live-remaining, 3600) / 60) < 10 ? "0" : "")
                                              + floor(mod(root.live-remaining, 3600) / 60) + "m"
                                            : floor(root.live-remaining / 60) + ":" + (mod(root.live-remaining, 60) < 10 ? "0" : "") + mod(root.live-remaining, 60))
                                        : "Live";
                                    color: #ececec;
                                    font-family: Theme.font-ui; font-size: 10px; font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // LocationBody.qml:377-382 — an ended share no longer opens.
                        HoldArea {
                            clicked => { if (!self.fired && !item.location-ended) { root.open-location(item); } self.fired = false; }
                            held => { root.open-menu(); }
                        }
                    }

                    // Link preview card: og image + info over the page accent
                    // (BubbleDelegate's lp loader).
                    if item.link-has && !root.media-kind : link-card-box := Rectangle {
                        width: root.bubble-max;
                        height: (item.link-img.width > 0 ? lp-img.height : 0px) + lp-info.preferred-height;
                        background: item.link-accent;
                        // BubbleDelegate.qml:862-866 — its own 14px corners when it
                        // stands alone; under a caption it takes the bubble's shape.
                        border-radius: item.link-only ? 14px : 0px;
                        clip: true;
                        lp-img := Rectangle {
                            y: 0; width: 100%;
                            height: item.link-img.width > 0
                                ? min(340px, root.bubble-max * (item.link-ih > 0 && item.link-iw > 0 ? item.link-ih / item.link-iw : 0.52))
                                : 0px;
                            clip: true;
                            if item.link-img.width > 0 : Image {
                                source: item.link-img;
                                width: 100%; height: 100%;
                                image-fit: cover;
                            }
                            if item.link-is-video : Rectangle {
                                x: (lp-img.width - 52px) / 2;
                                y: (lp-img.height - 52px) / 2;
                                width: 52px; height: 52px; border-radius: 26px;
                                background: #000000.with-alpha(0.5);
                                IconLabel { text: Icons.play; color: #ffffff; font-size: 24px; width: 100%; height: 100%; }
                            }
                        }
                        lp-info := VerticalLayout {
                            y: lp-img.height;
                            width: 100%;
                            padding: 10px;
                            spacing: 4px;
                            if item.link-title != "" : Rectangle {
                                clip: true;
                                height: min(lp-title.preferred-height, 2 * Theme.body * 1.35);
                                lp-title := Text {
                                    width: 100%;
                                    text: item.link-title;
                                    color: #ffffff;
                                    font-family: Theme.font-ui; font-size: Theme.body; font-weight: 700;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                            }
                            if item.link-desc != "" : Rectangle {
                                clip: true;
                                height: min(lp-desc.preferred-height, 2 * Theme.body-small * 1.35);
                                lp-desc := Text {
                                    width: 100%;
                                    text: item.link-desc;
                                    color: #ffffff.with-alpha(0.8);
                                    font-family: Theme.font-ui; font-size: Theme.body-small;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                padding-top: 2px;
                                fav-sq := Rectangle {
                                    y: (lp-domain.preferred-height - 16px) / 2;
                                    width: 16px; height: 16px; border-radius: 4px;
                                    background: #ffffff.with-alpha(0.9);
                                    Text {
                                        text: item.link-initial;
                                        color: item.link-accent;
                                        font-family: Theme.font-ui; font-size: 9px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: 100%; height: 100%;
                                    }
                                }
                                lp-domain := Text {
                                    text: item.link-domain;
                                    color: #ffffff.with-alpha(0.85);
                                    font-family: Theme.font-ui; font-size: Theme.caption;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HoldArea {
                            clicked => { if (!self.fired) { root.open-link(item); } self.fired = false; }
                            held => { root.open-menu(); }
                        }
                    }

                    // Fenced code: the body laid out as parts — text runs padded
                    // (BubbleDelegate.qml:959-975), code runs on CodeBlock.qml's
                    // dark ground with a lang tag. (Highlight colours need rich
                    // text; flattened for now.)
                    if root.code-kind : parts-col := VerticalLayout {
                        spacing: 0;
                        for part in item.parts : Rectangle {
                            // CodeBlock.qml:449 — max(34, text + pad*2), plus 14
                            // reserved under the text for the badge (:486).
                            height: part.t == "code"
                                ? max(34px, part-code.preferred-height + 22px + (part.lang != "" ? 14px : 0px))
                                : part-text.preferred-height + 17px;
                            background: part.t == "code" ? #242428 : transparent;
                            // :965-966 — text runs: l/r 10, top 8, bottom 9.
                            part-text := Text {
                                x: 10px; y: 8px;
                                width: parent.width - 20px;
                                visible: part.t != "code";
                                text: part.body;
                                color: root.fg;
                                font-family: Theme.font-ui; font-size: Theme.body;
                                wrap: word-wrap;
                            }
                            // CodeBlock.qml:482-500 — Fonts.ui at caption, ink #dbdee3.
                            part-code := Text {
                                x: 11px; y: 11px;
                                width: parent.width - 22px;
                                visible: part.t == "code";
                                text: part.body;
                                color: #dbdee3;
                                font-family: Theme.font-ui; font-size: Theme.caption;
                                wrap: word-wrap;
                            }
                            // CodeBlock.qml:502-516 — the lang badge, bottom-right.
                            if part.t == "code" && part.lang != "" : lang-badge := Rectangle {
                                x: parent.width - self.width - 6px;
                                y: parent.height - 15px - 6px;
                                width: lang-text.preferred-width + 10px;
                                height: 15px;
                                border-radius: 4px;
                                background: #ffffff.with-alpha(0.10);
                                lang-text := Text {
                                    text: part.lang;
                                    color: #ffffff.with-alpha(0.55);
                                    font-family: Theme.font-ui; font-size: 8px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                        }
                    }

                    // Caption under a full-bleed body — BubbleDelegate.qml:1017-1023:
                    // its own padded band (l/r 10, top 8, bottom 10), the bubble's
                    // width, so text never touches the edge. The link card's
                    // caption is the body with the URL removed.
                    if root.caption-visible && root.full-bleed && !(root.link-card && item.has-rich) : caption-band := Rectangle {
                        height: cap-text.preferred-height + 18px;
                        cap-text := Text {
                            x: 10px; y: 8px;
                            width: parent.width - 20px;
                            text: root.link-card ? root.link-caption : item.body;
                            color: root.fg;
                            font-family: Theme.font-ui; font-size: Theme.body;
                            wrap: word-wrap;
                        }
                    }
                    // A voice or plain file caption sits in the padded bubble.
                    if root.caption-visible && !root.full-bleed : Text {
                        text: item.body;
                        color: root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        wrap: word-wrap;
                        width: min(root.bubble-max - 22px, self.preferred-width);
                    }

                    // Body text / utd / redacted
                    // SigilText: the body laid out glyph by glyph in Rust (fx.rs),
                    // each cell at its measured place, so runs wrap at words and
                    // never squash. Motion follows RichText.qml: wave
                    // 1300ms/±1.8px, shake 240ms/±0.8px, pulse 1000ms/×1.18,
                    // glow 1800ms, barrel 1600ms InOutQuad, flip static 180°
                    // with the run reversed, typewriter 45ms per glyph, sparkle
                    // dots, blur that clears on hover, spoilers that wipe open.
                    if item.fx-chars.length > 0 : fx-box := Rectangle {
                        width: item.fx-w;
                        height: item.fx-h;
                        // RichText.qml:150-170 — spoilers: covered until tapped,
                        // then a left-to-right wipe (620ms OutCubic) with a
                        // spread of clamp(len*0.35, 4, 14); remembered per event.
                        property <string> reveal-id: "";
                        property <bool> revealed: item.spoiler-revealed || (self.reveal-id != "" && self.reveal-id == item.id);
                        property <float> reveal: self.revealed ? 1.0 : 0.0;
                        animate reveal { duration: 620ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        property <float> spread: max(4.0, min(14.0, item.fx-chars.length * 0.35));
                        property <float> front: self.reveal * (item.fx-chars.length + self.spread);
                        // RichText.qml:370-377 — blur clears while hovered, 260ms OutCubic.
                        property <float> blur-amt: fx-touch.has-hover ? 0.0 : 1.0;
                        animate blur-amt { duration: 260ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        // RichText.qml:175-181 — the typewriter clock starts on creation.
                        property <duration> t0: 0ms;
                        init => { self.t0 = animation-tick(); }
                        for c in item.fx-chars : fx-cell := Rectangle {
                            x: c.x;
                            y: c.y;
                            width: c.w;
                            height: c.size * 1.3;
                            property <float> tick-ms: (animation-tick() - c.idx * 90ms) / 1ms;
                            property <float> raw-ms: animation-tick() / 1ms;
                            property <color> ink: c.has-color && !c.mark ? c.color : root.fg;
                            // RichText.qml:161-165 revealAt: 1 when fully readable.
                            property <float> shown: c.spoiler
                                ? max(0.0, min(1.0, (fx-box.front - c.idx) / fx-box.spread)) : 1.0;
                            property <bool> covered: c.spoiler && self.shown < 0.999;
                            // RichText.qml:175-181, 252-257 — typewriter: 45ms per
                            // glyph, on or off, no fade.
                            property <bool> typed: c.anim != "typewriter"
                                || (animation-tick() - fx-box.t0) > c.idx * 45ms;
                            // RichText.qml:285-291 — barrel: 1600ms InOutQuad.
                            property <float> bp: mod(self.raw-ms, 1600.0) / 1600.0;
                            property <float> bq: self.bp < 0.5 ? 2 * self.bp * self.bp
                                : 1 - (2 - 2 * self.bp) * (2 - 2 * self.bp) / 2;
                            // `mark` is its own band behind the run, overhanging
                            // 1px above and below (RichText.qml:216-219).
                            if c.mark : Rectangle {
                                y: -1px; width: 100%; height: parent.height + 2px;
                                background: c.mark-color.with-alpha(0.32);
                            }
                            // Glitch: chromatic copies behind the glyph in jitter
                            // windows (530ms cycle, lead -2px, trail +1.5px, alpha 0.7).
                            property <float> glitch-t: mod((animation-tick() / 1ms) + c.idx * 53.0, 530.0);
                            property <bool> glitch-on: c.anim == "glitch" && self.glitch-t < 270.0;
                            if c.anim == "glitch" : Text {
                                text: c.ch; color: #FF2640;
                                opacity: fx-cell.glitch-on ? 0.7 : 0.0;
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui; font-size: c.size;
                                font-weight: c.bold ? 800 : 400; font-italic: c.italic;
                                x: fx-cell.glitch-on ? -2px : 0px; height: 100%; vertical-alignment: center;
                            }
                            if c.anim == "glitch" : Text {
                                text: c.ch; color: #26F2FF;
                                opacity: fx-cell.glitch-on ? 0.7 : 0.0;
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui; font-size: c.size;
                                font-weight: c.bold ? 800 : 400; font-italic: c.italic;
                                x: fx-cell.glitch-on ? 1.5px : 0px; height: 100%; vertical-alignment: center;
                            }
                            // Glow: a soft copy breathing behind the glyph —
                            // RichText.qml:299-310: 1800ms cycle, scale 1.1↔1.5,
                            // opacity 0.05↔0.45.
                            if c.anim == "glow" : Text {
                                property <float> gp: 0.5 - 0.5 * cos(360deg * (mod(fx-cell.raw-ms, 1800.0) / 1800.0));
                                text: c.ch; color: fx-cell.ink;
                                opacity: 0.05 + 0.40 * self.gp;
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui; font-size: c.size;
                                font-weight: c.bold ? 800 : 400; font-italic: c.italic;
                                width: 100%; height: 100%; vertical-alignment: center; horizontal-alignment: center;
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-scale-x: 1.1 + 0.4 * self.gp;
                                transform-scale-y: 1.1 + 0.4 * self.gp;
                            }
                            // Text-blur: ghost copies fake the radius; hover clears it.
                            if c.anim == "blur" : Text {
                                text: c.ch; color: fx-cell.ink.with-alpha(0.3 * fx-box.blur-amt);
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui; font-size: c.size;
                                x: -1.5px * fx-box.blur-amt; y: -1.5px * fx-box.blur-amt; height: 100%; vertical-alignment: center;
                            }
                            if c.anim == "blur" : Text {
                                text: c.ch; color: fx-cell.ink.with-alpha(0.3 * fx-box.blur-amt);
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui; font-size: c.size;
                                x: 1.5px * fx-box.blur-amt; y: 1.5px * fx-box.blur-amt; height: 100%; vertical-alignment: center;
                            }
                            fx-t := Text {
                                text: c.ch;
                                color: fx-cell.ink;
                                font-family: c.mono ? Theme.font-mono : Theme.font-ui;
                                font-size: c.size;
                                font-weight: c.bold ? 800 : 400;
                                font-italic: c.italic;
                                width: 100%; height: 100%;
                                vertical-alignment: center;
                                x: c.anim == "shake" ? sin(360deg * (mod(fx-cell.tick-ms, 240.0) / 240.0)) * 0.8px : 0px;
                                y: c.anim == "wave" ? sin(360deg * (mod(fx-cell.tick-ms, 1300.0) / 1300.0)) * 1.8px : 0px;
                                // RichText.qml:252-257 — typed × shown, and the blur's dimming.
                                opacity: (fx-cell.typed ? 1.0 : 0.0) * fx-cell.shown
                                    * (c.anim == "blur" ? 1 - 0.7 * fx-box.blur-amt : 1.0);
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-rotation: c.anim == "barrel" ? 360deg * fx-cell.bq
                                    : c.anim == "flip" ? 180deg : 0deg;
                                transform-scale-x: c.anim == "pulse" ? 1.0 + 0.18 * (0.5 + 0.5 * sin(360deg * (mod(fx-cell.tick-ms, 1000.0) / 1000.0))) : 1.0;
                                transform-scale-y: c.anim == "pulse" ? 1.0 + 0.18 * (0.5 + 0.5 * sin(360deg * (mod(fx-cell.tick-ms, 1000.0) / 1000.0))) : 1.0;
                            }
                            if c.underline && !fx-cell.covered : Rectangle {
                                y: c.size * 1.15; height: 1px; width: 100%;
                                background: fx-cell.ink;
                            }
                            if c.strike && !fx-cell.covered : Rectangle {
                                y: c.size * 0.72; height: 1px; width: 100%;
                                background: fx-cell.ink;
                            }
                            // Sparkle — RichText.qml:346-368: three 2×2 dots in the
                            // glyph's colour at 0.2/0.5/0.8 of the advance, rising
                            // from 0.6h to -3 over 900ms OutCubic as they fade
                            // 0.9→0, each after a (idx*130 + i*420) % 1300 pause.
                            if c.anim == "sparkle" : Rectangle {
                                width: 100%; height: 100%;
                                for si in [0, 1, 2] : Rectangle {
                                    property <float> pause: mod(c.idx * 130 + si * 420, 1300);
                                    property <float> t: mod(fx-cell.raw-ms, self.pause + 900);
                                    property <float> p: max(0.0, self.t - self.pause) / 900;
                                    property <float> e: 1 - pow(1 - self.p, 3);
                                    width: 2px; height: 2px; border-radius: 1px;
                                    background: fx-cell.ink;
                                    x: fx-cell.width * (0.2 + 0.3 * si);
                                    y: fx-cell.height * 0.6 + (-3px - fx-cell.height * 0.6) * self.e;
                                    opacity: self.t < self.pause ? 0.0 : 0.9 * (1 - self.p);
                                }
                            }
                            // The spoiler cover — RichText.qml:379-393: fg@0.34,
                            // breathing 0.72↔1.0 (520ms each way) until revealed,
                            // then fading with the wipe.
                            if fx-cell.covered : Rectangle {
                                y: 1px; width: 100%; height: parent.height - 2px;
                                border-radius: 2px;
                                background: root.fg.with-alpha(0.34 * (0.86 + 0.14 * sin(360deg * (mod(fx-cell.tick-ms, 1040.0) / 1040.0))));
                                opacity: 1 - fx-cell.shown;
                            }
                        }
                        // RichText.qml:409-414 — a tap reveals the spoilers; otherwise
                        // the tap is the bubble's (details), a hold the menu.
                        fx-touch := HoldArea {
                            clicked => {
                                if (!self.fired) {
                                    if (item.fx-spoiler && !fx-box.revealed) {
                                        fx-box.reveal-id = item.id;
                                        root.spoiler-revealed(item.event-id);
                                    } else {
                                        root.details-open = !root.details-open;
                                    }
                                }
                                self.fired = false;
                            }
                            held => { root.open-menu(); }
                        }
                    }

                    // Markup bodies render through StyledText: bold/italic/code
                    // and tappable links (link-clicked). Plain bodies stay Text.
                    // Under a link card the bubble is pad-free: pad here
                    // (BubbleDelegate.qml:1019-1023: 10 l/r, 8 top, 10 bottom).
                    if root.link-card && item.has-rich : Rectangle { height: 8px; }
                    if item.has-rich && !root.code-kind && !item.link-only : rich-text := StyledText {
                        text: item.rich-body;
                        default-color: root.fg;
                        default-font-family: Theme.font-ui;
                        default-font-size: Theme.body;
                        // BubbleDelegate.qml:163-168 — anchors are the accent itself.
                        link-color: root.accent;
                        width: min(root.bubble-max - 22px, self.preferred-width);
                        x: root.link-card ? 10px : 0px;
                        link-clicked(l) => { root.open-url(l); }
                    }
                    if root.link-card && item.has-rich : Rectangle { height: 10px; }
                    if !item.has-rich && item.fx-chars.length == 0
                        && (item.kind == "text" || item.kind == "notice" || item.kind == "emote"
                        || item.kind == "utd" || item.kind == "redacted" || item.kind == "unsupported")
                        && !root.code-kind && !item.link-only && !root.link-card : body-text := Text {
                        text: item.kind == "utd" ? "🔒 Waiting for keys…"
                            : item.kind == "redacted" ? "Message deleted"
                            : item.kind == "unsupported" ? "Unsupported message"
                            : item.body;
                        color: item.kind == "utd" || item.kind == "redacted"
                            ? root.fg.with-alpha(0.55) : root.fg;
                        font-family: Theme.font-ui; font-size: Theme.body;
                        font-italic: item.kind == "emote" || item.kind == "redacted";
                        wrap: word-wrap;
                        width: min(root.bubble-max - 22px, self.preferred-width);
                    }

                    // Thread summary chip
                    if item.thread-count > 0 : thread-chip := Rectangle {
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.background.with-alpha(0.35);
                        HorizontalLayout {
                            padding-left: 9px; padding-right: 9px;
                            spacing: 6px;
                            IconLabel {
                                text: Icons.thread;
                                color: root.fg.with-alpha(0.75);
                                font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.thread-count == 1 ? "1 reply" : "\{item.thread-count} replies";
                                color: root.fg.with-alpha(0.75);
                                font-family: Theme.font-ui; font-size: Theme.caption; font-weight: 700;
                                vertical-alignment: center;
                            }
                            // Latest reply, one line, between the count and the chevron.
                            if item.thread-latest != "" : Text {
                                text: item.thread-latest;
                                color: root.fg.with-alpha(0.55);
                                font-family: Theme.font-ui; font-size: Theme.caption;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if item.thread-latest == "" : Rectangle { horizontal-stretch: 1; }
                            IconLabel {
                                text: Icons.chevronRight;
                                color: root.fg.with-alpha(0.5);
                                font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.open-thread(item.event-id); } }
                    }
                }

                long-timer := Timer {
                    property <bool> fired: false;
                    interval: 500ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        self.fired = true;
                        root.open-menu();
                    }
                }
            }

            // Reactions straddle the bubble's inner top corner.
            if item.reactions.length > 0 : reaction-row := HorizontalLayout {
                x: item.is-own ? bubble.x - 9px
                              : bubble.x + bubble.width + 9px - self.preferred-width;
                y: bubble.y - self.preferred-height / 2;
                spacing: 2px;
                for chip in item.reactions : r-chip := Rectangle {
                    width: r-lay.preferred-width;
                    height: r-lay.preferred-height;
                    r-lay := HorizontalLayout {
                        spacing: 1px;
                        // The emoji as a picture from the colour font when the
                        // device has one; the renderer draws text from outlines
                        // and would show a grey fallback glyph otherwise.
                        if chip.has-img : Image {
                            source: chip.img;
                            width: chip.mine ? 20px : 18.4px;
                            height: self.width;
                            image-fit: contain;
                        }
                        if !chip.has-img : Text {
                            // femtovg draws U+2764+VS16 as tofu; display the bare
                            // heart, the reaction key itself stays untouched.
                            text: chip.key == "❤️" ? "❤" : chip.key;
                            color: root.fg;
                            // QML scales non-mine chips to 0.92.
                            font-size: chip.mine ? 20px : 18.4px;
                        }
                        if chip.count > 1 : Text {
                            text: "\{chip.count}";
                            color: chip.mine ? root.accent : root.fg.with-alpha(0.65);
                            font-family: Theme.font-ui; font-size: 11px;
                            font-weight: chip.mine ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                    // BubbleDelegate.qml:364-366 — the tap target bleeds 3px.
                    TouchArea {
                        x: -3px; y: -3px;
                        width: parent.width + 6px; height: parent.height + 6px;
                        clicked => { root.react(item.event-id, chip.key); }
                    }
                }
            }

            // Pin marker, proud of the corner away from the sender's side.
            // BubbleDelegate.qml:1128-1131 — fades in over 160ms and pops
            // 0.6→1 over 220ms OutBack(2.2).
            pin-mark := Rectangle {
                x: item.is-own ? bubble.x + bubble.width - 22px : bubble.x + 2px;
                y: bubble.y - 4px;
                width: 20px; height: 20px; border-radius: 10px;
                background: root.accent;
                border-width: 1.5px;
                border-color: Theme.popup-background;
                opacity: item.pinned ? 1.0 : 0.0;
                animate opacity { duration: 160ms; }
                visible: self.opacity > 0.01;
                property <float> pop: item.pinned ? 1.0 : 0.6;
                animate pop { duration: 220ms; easing: cubic-bezier(0.34, 1.9, 0.64, 1); }
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale-x: self.pop;
                transform-scale-y: self.pop;
                IconLabel {
                    text: Icons.pin;
                    color: Theme.background;
                    font-size: Theme.caption;
                    transform-rotation: item.is-own ? 35deg : -35deg;
                    width: 100%; height: 100%;
                }
            }
            }
        }

        // Details / mark line — BubbleDelegate's detailRow (:1242-1311). The
        // mark leads (sending dot, failure, tick, or the stacked reader
        // faces); tapping the bubble grows "· timestamp lock" beside it.
        // Non-own messages get the row too, left-anchored with the mark
        // hidden. Opens over 180ms (height) / 220ms (opacity), OutCubic.
        detail-row := Rectangle {
            property <length> mark-dot: 13px;
            property <bool> wanted: root.is-msg && ((item.is-own && (item.owns-receipt || item.send-state != "sent")) || root.details-open);
            property <bool> show-faces: item.is-own && item.send-state == "sent" && item.readers.length > 0;
            height: self.wanted ? self.mark-dot + 4px : 0px;
            animate height { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            opacity: self.wanted ? 1.0 : 0.0;
            animate opacity { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            visible: self.opacity > 0.01;
            // Spacing lives inside the collapsing cells, not on the layout: an
            // invisible QML Row item takes no space (BubbleDelegate.qml:
            // 1275-1292), but a Slint layout child keeps its slot — with the
            // details closed the mark must sit at the bubble's right edge,
            // rightMargin space(2) only (:1255-1256), not a ghost dot away.
            HorizontalLayout {
                y: (detail-row.height - self.height) / 2;
                height: detail-row.mark-dot + 4px;
                alignment: item.is-own ? end : start;
                spacing: 0;
                padding-right: 2px;
                padding-left: 2px;
                // The mark stack (:1157-1239): ring, bang, tick and faces
                // cross-fade in one box that widens with the readers (200ms).
                if item.is-own : mark-box := Rectangle {
                    width: detail-row.mark-dot + max(0, item.readers.length - 1) * detail-row.mark-dot * 0.68;
                    animate width { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    height: detail-row.mark-dot;
                    IconLabel {
                        x: parent.width - detail-row.mark-dot; width: detail-row.mark-dot; height: 100%;
                        text: Icons.statusDot; color: root.fg.with-alpha(0.55);
                        font-size: 13px;
                        opacity: item.send-state == "sending" ? 1.0 : 0.0;
                        animate opacity { duration: 160ms; }
                        visible: self.opacity > 0.01;
                    }
                    IconLabel {
                        x: parent.width - detail-row.mark-dot; width: detail-row.mark-dot; height: 100%;
                        text: Icons.errorMark; color: Theme.urgent;
                        filled: true;   // BubbleDelegate.qml:1175
                        font-size: 13px;
                        opacity: item.send-state == "failed" ? 1.0 : 0.0;
                        animate opacity { duration: 160ms; }
                        visible: self.opacity > 0.01;
                    }
                    tick := IconLabel {
                        x: parent.width - detail-row.mark-dot; width: detail-row.mark-dot; height: 100%;
                        text: Icons.checkCircle; color: root.accent;
                        filled: true;   // BubbleDelegate.qml:1188
                        font-size: 13px;
                        opacity: item.send-state == "sent" && item.readers.length == 0 ? 1.0 : 0.0;
                        animate opacity { duration: 200ms; }
                        visible: self.opacity > 0.01;
                        // :1184-1186 — scales 0.7→1 as it arrives.
                        property <float> pop: self.opacity < 0.5 ? 0.7 : 1.0;
                        animate pop { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: self.pop;
                        transform-scale-y: self.pop;
                    }
                    // Reader faces (:1193-1237): a fresh one drops from -14 on a
                    // spring and fades in over 180ms.
                    for reader[i] in item.readers : face-slot := Rectangle {
                        property <bool> fresh: i < item.readers-fresh;
                        property <float> land: self.fresh ? 0.0 : 1.0;
                        animate land { duration: 220ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                        property <float> shown: self.fresh ? 0.0 : 1.0;
                        animate shown { duration: 180ms; }
                        init => { self.land = 1.0; self.shown = 1.0; }
                        x: parent.width - detail-row.mark-dot - i * detail-row.mark-dot * 0.68;
                        y: -14px * (1 - self.land);
                        opacity: self.shown;
                        visible: detail-row.show-faces;
                        width: detail-row.mark-dot; height: detail-row.mark-dot;
                        // Faces overlap; each needs something solid behind it.
                        Rectangle {
                            x: -1px; y: -1px;
                            width: detail-row.mark-dot + 2px; height: self.width;
                            border-radius: self.width / 2;
                            background: root.convo-ground;
                        }
                        Avatar {
                            size: detail-row.mark-dot;
                            source: reader.avatar;
                            initials: reader.initials;
                            tint: reader.tint;
                        }
                    }
                }
                // The "·" carries the Row's two 5px gaps (:1261) and collapses
                // with the details so the closed row is the mark alone.
                if item.is-own : dot-cell := Rectangle {
                    clip: true;
                    width: root.details-open ? dot-t.preferred-width + 10px : 0px;
                    animate width { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    dot-t := Text {
                        x: 5px;
                        height: 100%;
                        text: "·";
                        color: root.fg.with-alpha(0.5);
                        font-family: Theme.font-ui; font-size: 10px;
                        vertical-alignment: center;
                        // :1276-1281 — fades with the details, 160ms.
                        opacity: root.details-open ? 1.0 : 0.0;
                        animate opacity { duration: 160ms; }
                    }
                }
                // :1284-1292 — the details grow from nothing: width 220ms
                // OutCubic (clipped), opacity 160ms.
                details-box := Rectangle {
                    clip: true;
                    width: root.details-open ? detail-text.preferred-width : 0px;
                    animate width { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    opacity: root.details-open ? 1.0 : 0.0;
                    animate opacity { duration: 160ms; }
                    detail-text := HorizontalLayout {
                        x: item.is-own ? details-box.width - self.width : 0px;
                        width: self.preferred-width;
                        spacing: 4px;
                        Text {
                            text: item.edited ? "\{item.stamp} · Edited" : item.stamp;
                            color: item.send-state == "failed" ? Theme.urgent : root.fg.with-alpha(0.5);
                            font-family: Theme.font-ui; font-size: 10px;
                            vertical-alignment: center;
                        }
                        IconLabel {
                            text: root.encrypted ? Icons.lock : Icons.lockOff;
                            color: item.send-state == "failed" ? Theme.urgent : root.fg.with-alpha(0.5);
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
