# Build output
core/target/
protocol/target/
server/target/
shared/icongen/target/
omarchy/video/*.so
omarchy/video/.qt-version
*.tmp
__pycache__/

# Fonts are canonical in shared/fonts/ and copied into each frontend's bundle
# at build time. The copy is generated, never edited or committed.
omarchy/fonts/

# Local state must never enter the tree; it lives in ~/.local/state/sigil/.
session.json
store.key
settings.json
store/
*.log

# Editor and OS junk
.vscode/
.idea/
*.swp
*~
.DS_Store

# Android build output and generated artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Cross-compiled engine and its bindings — produced by android/build-engine.sh
android/app/src/main/jniLibs/
android/app/src/main/java/uniffi/
